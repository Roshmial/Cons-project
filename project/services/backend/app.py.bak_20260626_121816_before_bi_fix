def materialize_tender_task_sources(contract: dict[str, Any]) -> dict[str, Any]:
    base_dir = collection_task_artifacts_root('tenders')
    base_dir.mkdir(parents=True, exist_ok=True)
    slug = build_collection_task_slug(contract)
    stamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    task_path = base_dir / f'tender_sources_{slug}_{stamp}.json'
    registry_path = Path('/home/hermes/workspace/tenders/it_tender_sources.json')
    registry = json.loads(registry_path.read_text(encoding='utf-8')) if registry_path.exists() else {'sources': []}
    requested = set(contract.get('source_items') or [])
    alias_map = {
        'zakupki.gov.ru': {'zakupki.gov.ru', 'zakupki', 'goszakupki'},
        'zakupki.mos.ru': {'zakupki.mos.ru', 'zakupki_mos', 'mos_zakupki'},
        'b2b-center.ru': {'b2b-center.ru', 'b2b-center', 'b2b'},
        'fabrikant.ru': {'fabrikant.ru', 'fabrikant'},
        'bidzaar.com': {'bidzaar.com', 'bidzaar'},
        'roseltorg.ru': {'roseltorg.ru', 'roseltorg'},
        'etp.gpb.ru': {'etp.gpb.ru', 'gpb', 'etp_gpb'},
    }
    requested_aliases: set[str] = set()
    for item in requested:
        requested_aliases.add(item)
        requested_aliases.update(alias_map.get(item, set()))
    matched = []
    for item in registry.get('sources') or []:
        candidates = {
            normalize_source_token(safe_text(item.get('name'))),
            normalize_source_token(safe_text(item.get('key'))),
            normalize_source_token(safe_text(item.get('kind'))),
        }
        if not requested_aliases or candidates & requested_aliases:
            matched.append(item)
    payload = {
        'subject': contract.get('subject'),
        'since_date': contract.get('since_date'),
        'output_format': contract.get('output_format'),
        'fields': contract.get('fields') or [],
        'requested_sources': list(contract.get('source_items') or []),
        'matched_sources': matched,
    }
    task_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding='utf-8')
    return {'task_path': str(task_path), 'matched_sources': matched}


def build_existing_file_attachment(path_value: str, *, kind: str = 'collection_artifact', source: str = 'tender_pipeline') -> dict[str, Any]:
    resolved = Path(path_value).expanduser().resolve()
    if not resolved.exists() or not resolved.is_file():
        raise ApiError('artifact_file_missing', 409)
    relative_path = ''
    try:
        relative_path = str(resolved.relative_to(DATA_DIR))
