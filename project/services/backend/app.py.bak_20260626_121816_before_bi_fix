def build_personalization_block(profile: dict[str, Any]) -> str:
    assistant_profile = profile.get("assistant_profile") or {}
    memory_notes = "; ".join(profile["pinned"])
    interaction_memory = "; ".join(profile.get("interaction_memory") or [])
    parts = [
        f"user_name={profile['name']}",
        f"user_role={profile['title']}",
        f"team={profile['team']}",
        f"language={profile['language']}",
        f"timezone={profile['timezone']}",
        f"goals={profile['goals']}",
        f"constraints={profile['constraints']}",
        f"tone={assistant_profile['tone']}",
        f"answer_depth={assistant_profile['answer_depth']}",
        f"interaction_mode={assistant_profile['interaction_mode']}",
    ]
    if assistant_profile.get("about_user"):
        parts.append(f"about_user={assistant_profile['about_user']}")
    if memory_notes:
        parts.append(f"profile_memory={memory_notes}")
    if interaction_memory:
        parts.append(f"interaction_memory={interaction_memory}")
    return "; ".join(parts)


def request_policy_has_explicit_constraints(request_policy: dict[str, Any] | None) -> bool:
    if not isinstance(request_policy, dict) or not request_policy:
        return False
    if safe_text(request_policy.get("source_mode") or ""):
        return True
    if normalize_chat_model_preference(request_policy.get("model_preference")) != "auto":
        return True
    if any(safe_text(item) for item in (request_policy.get("explicit_source_ids") or [])):
        return True
    if any(safe_text(item) for item in (request_policy.get("allowed_source_ids") or request_policy.get("allowed_sources") or [])):
        return True
    connector_targets = request_policy.get("connector_targets") if isinstance(request_policy.get("connector_targets"), dict) else {}
    return any(isinstance(keys, list) and any(safe_text(item) for item in keys) for keys in connector_targets.values())


def build_hermes_system_prompt(profile: dict[str, Any], thread_title: str, request_policy: dict[str, Any] | None = None) -> str:
    policy_text = ""
    if request_policy_has_explicit_constraints(request_policy):
        allowed_sources = request_policy.get("allowed_sources") if isinstance(request_policy.get("allowed_sources"), list) else []
        if not allowed_sources:
            allowed_sources = request_policy.get("allowed_source_ids") if isinstance(request_policy.get("allowed_source_ids"), list) else []
        connector_targets = request_policy.get("connector_targets") if isinstance(request_policy.get("connector_targets"), dict) else {}
