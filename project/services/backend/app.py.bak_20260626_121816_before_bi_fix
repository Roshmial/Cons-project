    intent = infer_external_dashboard_intent(text)
    business_function = infer_business_dashboard_function(text)
    blueprint = build_external_dashboard_blueprint(intent)
    reference_guidance = build_dashboard_reference_guidance(intent, business_function)
    return (
        "Ты строишь клиентский dashboard_result для Hermes Web. "
        "Если пользователь просит собрать данные из интернета, ты можешь использовать web/search-инструменты Hermes. "
        "Нужно вернуть только JSON-объект без markdown и пояснений вокруг. "
