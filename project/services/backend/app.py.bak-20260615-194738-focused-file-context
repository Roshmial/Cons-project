def record_llm_usage_event(
    conn: sqlite3.Connection,
    *,
    user_id: int,
    model_key: str,
    route_mode: str,
    route_reason: str,
    request_excerpt: str,
    actual_cost_usd: float | None = None,
    estimated_cost_usd: float | None = None,
) -> None:
    conn.execute(
        """
        INSERT INTO llm_usage_events (
            usage_date, user_id, model_key, route_mode, route_reason,
            estimated_cost_usd, actual_cost_usd, request_excerpt, created_at
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
        """,
        (
            utc_today_iso(),
            user_id,
            model_key,
            route_mode,
            route_reason,
            float(estimated_cost_usd or 0.0),
            float(actual_cost_usd or 0.0),
            safe_text(request_excerpt)[:300],
            now_iso(),
        ),
    )


def extract_usage_cost_usd(usage_payload: Any) -> float | None:
    if isinstance(usage_payload, dict):
        for key in ("cost", "cost_usd", "total_cost", "estimated_cost"):
            value = usage_payload.get(key)
            if isinstance(value, (int, float)):
                return float(value)
            if isinstance(value, str):
                try:
                    return float(value)
                except ValueError:
                    continue
    return None


def parse_model_candidates(raw_value: str, primary_model: str) -> list[str]:
    items = [safe_text(item).strip() for item in safe_text(raw_value).split(",")]
    ordered: list[str] = []
    for item in [primary_model, *items]:
        if item and item not in ordered:
            ordered.append(item)
    return ordered


HERMES_STANDARD_MODEL_CANDIDATES = parse_model_candidates(HERMES_STANDARD_MODEL_CANDIDATES_RAW, HERMES_API_MODEL)
HERMES_REASONING_MODEL_CANDIDATES = parse_model_candidates(HERMES_REASONING_MODEL_CANDIDATES_RAW, HERMES_REASONING_MODEL)


def resolve_model_attempt_chain(model_name: str) -> list[str]:
    effective_model = safe_text(model_name).strip()
    if not effective_model:
        return [HERMES_API_MODEL]
    candidate_pool = HERMES_REASONING_MODEL_CANDIDATES if effective_model == HERMES_REASONING_MODEL else HERMES_STANDARD_MODEL_CANDIDATES
    if effective_model not in candidate_pool:
        return [effective_model]
    start_index = candidate_pool.index(effective_model)
    return candidate_pool[start_index:]


def is_runtime_error_detail(detail: str) -> bool:
    lowered = safe_text(detail).lower()
    runtime_markers = (
        "runtime error",
        '"error_type":"runtime_error"',
        '"type":"runtime_error"',
        "provider returned error",
    )
    return any(marker in lowered for marker in runtime_markers)


def call_hermes_messages_timeout(*, requested_model: str, attempt_index: int, attempt_count: int) -> int:
    if requested_model == HERMES_REASONING_MODEL:
        return HERMES_REASONING_TIMEOUT
    return HERMES_API_TIMEOUT


def call_hermes_messages(messages: list[dict[str, str]], *, model_name: str | None = None) -> tuple[str, dict[str, Any]]:
    effective_model = safe_text(model_name or HERMES_API_MODEL) or HERMES_API_MODEL
    if APP_MODE != "hermes-api":
        prompt = messages[-1]["content"] if messages else ""
        return build_mock_reply(prompt), {"mode": APP_MODE, "downstream": "mock-hermes", "hermes_model": effective_model}
    if not HERMES_API_KEY:
        raise ApiError("hermes_api_key_missing", 500)
    attempt_models = resolve_model_attempt_chain(effective_model)
    attempt_errors: list[dict[str, Any]] = []
    last_http_error: urllib.error.HTTPError | None = None
    for attempt_index, attempt_model in enumerate(attempt_models):
        payload = {"model": attempt_model, "stream": False, "messages": messages}
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        req = urllib.request.Request(
            f"{HERMES_API_BASE_URL}/chat/completions",
            data=body,
            method="POST",
            headers={"Content-Type": "application/json", "Authorization": f"Bearer {HERMES_API_KEY}"},
        )
        request_timeout = call_hermes_messages_timeout(
            requested_model=effective_model,
            attempt_index=attempt_index,
            attempt_count=len(attempt_models),
        )
        try:
            with urllib.request.urlopen(req, timeout=request_timeout) as resp:
                response_payload = json.loads(resp.read().decode("utf-8"))
            reply_text = extract_assistant_text(response_payload)
            cleaned_text, meta = enrich_assistant_meta({
                "mode": APP_MODE,
                "downstream": "hermes-api-server",
                "hermes_model": response_payload.get("model", attempt_model),
                "usage": response_payload.get("usage", {}),
                "model_attempts": [*attempt_errors, {"model": attempt_model, "status": "success", "timeout_seconds": request_timeout}],
                "fallback_used": attempt_index > 0,
                "requested_model": effective_model,
            }, reply_text)
            return cleaned_text, meta
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode("utf-8", errors="replace")
            should_retry = attempt_index == 0 and len(attempt_models) > 1 and is_runtime_error_detail(detail)
            attempt_errors.append({
                "model": attempt_model,
                "status": "runtime_error_retry" if should_retry else "http_error",
                "code": exc.code,
                "detail": detail[:300],
                "timeout_seconds": request_timeout,
            })
            last_http_error = exc
            if should_retry:
                continue
            raise ApiError(f"hermes_api_http_error: {exc.code}: {detail[:300]}", 502)
        except urllib.error.URLError as exc:
            raise ApiError(f"hermes_api_unreachable: {exc.reason}", 502)
    if last_http_error is not None and attempt_errors:
        last_error = attempt_errors[-1]
        raise ApiError(f"hermes_api_http_error: {last_error.get('code', 502)}: {safe_text(last_error.get('detail'))[:300]}", 502)
    raise ApiError("hermes_api_unknown_error", 502)


def build_reasoning_summary_messages(messages: list[dict[str, str]], task_description: str) -> list[dict[str, str]]:
    summary_prompt = (
        "Сожми диалог и материалы для дальнейшего глубокого reasoning-анализа. "
        "Верни 4 блока: 1) цель пользователя, 2) подтверждённые факты, 3) открытые вопросы и конфликты, 4) что именно нужно решить. "
        "Пиши кратко, без воды, не придумывай факты."
    )
    trimmed = messages[-10:] if len(messages) > 10 else messages
    return [
        {"role": "system", "content": summary_prompt},
        {"role": "user", "content": json.dumps({"task": task_description, "messages": trimmed}, ensure_ascii=False)},
    ]


def build_reasoning_execution_messages(profile: dict[str, Any], thread_title: str, compressed_context: str, task_description: str, request_policy: dict[str, Any] | None = None) -> list[dict[str, str]]:
    system_prompt = build_hermes_system_prompt(profile, thread_title, request_policy)
    user_prompt = (
        "Ниже сжатый контекст, подготовленный перед deep reasoning. Используй его как рабочую основу, "
        "но не превращай гипотезы в факты. Если данных недостаточно — скажи об этом прямо.\n\n"
        f"Сжатый контекст:\n{compressed_context}\n\n"
        f"Текущая задача пользователя:\n{task_description}"
    )
    return [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": user_prompt},
    ]


def call_hermes_api(message_rows: list[sqlite3.Row], profile: dict[str, Any], thread_title: str, request_policy: dict[str, Any] | None = None) -> tuple[str, dict[str, Any]]:
    base_messages = build_hermes_messages(message_rows, profile, thread_title, request_policy)
    task_description = latest_user_message_text(message_rows)
    with db_connect() as conn:
        usage_stats = reasoning_usage_stats(conn, int(profile["id"]))
        route = route_task(task_description, int(profile["id"]), usage_stats, request_policy)
    note_prefix = ""
    if route["model"] == HERMES_REASONING_MODEL:
        compressed_context, prep_meta = call_hermes_messages(
            build_reasoning_summary_messages(base_messages, task_description),
            model_name=HERMES_API_MODEL,
        )
        reasoning_messages = build_reasoning_execution_messages(profile, thread_title, compressed_context, task_description, request_policy)
        reply_text, meta = call_hermes_messages(reasoning_messages, model_name=HERMES_REASONING_MODEL)
        note_prefix = reasoning_engaged_notice(route["route_reason"])
        actual_cost = extract_usage_cost_usd(meta.get("usage"))
        with db_connect() as conn:
            record_llm_usage_event(
                conn,
                user_id=int(profile["id"]),
                model_key=LLM_USAGE_REASONING_MODEL,
                route_mode=route["route_mode"],
                route_reason=route["route_reason"],
                request_excerpt=task_description,
                actual_cost_usd=actual_cost,
                estimated_cost_usd=actual_cost if actual_cost is not None else HERMES_REASONING_COST_FALLBACK_USD,
            )
        meta.update({
            "reasoning_summary_model": prep_meta.get("hermes_model", HERMES_API_MODEL),
            "compressed_context_chars": len(compressed_context),
        })
    else:
        reply_text, meta = call_hermes_messages(base_messages, model_name=HERMES_API_MODEL)
        if route.get("limit_reason"):
            note_prefix = reasoning_limit_notice(route["limit_reason"], usage_stats)
    if note_prefix:
        reply_text = f"{note_prefix}\n\n{reply_text}".strip()
    meta.update(
        {
            "personalization_used": True,
            "thread_title": thread_title,
            "personalization_preview": build_personalization_block(profile),
            "request_policy": request_policy or {},
            "llm_route": route,
        }
    )
    return reply_text, meta


