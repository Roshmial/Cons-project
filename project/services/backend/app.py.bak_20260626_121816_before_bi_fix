    control_like = infer_dynamic_numeric_columns(rows, numeric_columns, ('control', 'coverage', 'compliance'))
    severity_col = None
    for candidate in rows[:1]:
        pass
    lowered_columns = [key for row in rows[:1] if isinstance(row, dict) for key in row.keys()]
    for column in lowered_columns:
        lowered = safe_text(column).lower()
        if any(marker in lowered for marker in ('severity', 'criticality', 'priority', 'crit')):
