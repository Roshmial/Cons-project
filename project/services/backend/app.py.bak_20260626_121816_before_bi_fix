def text_looks_cyrillic(text: Any) -> bool:
    value = safe_text(text)
    if not value:
        return False
    return bool(re.search(r"[А-Яа-яЁё]", value))


def text_contains_synthetic_marker(text: Any) -> bool:
    lowered = safe_text(text).lower()
    if not lowered:
        return False
    return any(marker in lowered for marker in SYNTHETIC_DASHBOARD_MARKERS)


def user_prefers_russian_dashboard(text: str) -> bool:
    return text_looks_cyrillic(text)


