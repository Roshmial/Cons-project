def normalize_source_registry_item(item: dict[str, Any], fallback_index: int = 0) -> dict[str, Any]:
    source_key = safe_text(item.get("source_key") or item.get("id") or f"source_{fallback_index + 1}").lower().replace(" ", "_")
    return {
        "source_key": source_key,
        "name": safe_text(item.get("name") or source_key),
        "source_type": safe_text(item.get("source_type") or "service"),
        "origin": safe_text(item.get("origin") or "internal"),
        "registration_status": safe_text(item.get("registration_status") or "registered"),
        "trust_level": safe_text(item.get("trust_level") or "trusted"),
        "enabled": bool(item.get("enabled", True)),
        "connector_kind": safe_text(item.get("connector_kind") or "custom"),
        "access_mode": safe_text(item.get("access_mode") or "read_only"),
        "usage_scope": safe_text(item.get("usage_scope") or "runtime"),
        "owner": safe_text(item.get("owner") or "platform"),
        "notes": safe_text(item.get("notes") or ""),
        "sort_order": int(item.get("sort_order") or ((fallback_index + 1) * 10)),
    }


def normalize_source_registry(value: Any) -> dict[str, Any]:
    raw = value if isinstance(value, dict) else {}
    items = raw.get("items") if isinstance(raw.get("items"), list) else []
    normalized = [normalize_source_registry_item(item, index) for index, item in enumerate(items) if isinstance(item, dict)]
    normalized.sort(key=lambda item: (int(item.get("sort_order") or 0), item.get("name") or item.get("source_key") or ""))
    return {"version": int(raw.get("version") or 1), "items": normalized}


def normalize_processing_policy(value: Any) -> dict[str, Any]:
    defaults = default_processing_policy_settings()
    raw = value if isinstance(value, dict) else {}
    allowed_modes = [item for item in raw.get("allowed_modes", defaults["allowed_modes"]) if isinstance(item, str)]
    if not allowed_modes:
        allowed_modes = defaults["allowed_modes"]
    default_mode = safe_text(raw.get("default_mode") or defaults["default_mode"])
    if default_mode not in allowed_modes:
        default_mode = allowed_modes[0]
    labels = defaults["mode_labels"] | (raw.get("mode_labels") if isinstance(raw.get("mode_labels"), dict) else {})
    descriptions = defaults["mode_descriptions"] | (raw.get("mode_descriptions") if isinstance(raw.get("mode_descriptions"), dict) else {})
    return {
        "default_mode": default_mode,
        "allow_override": bool(raw.get("allow_override", defaults["allow_override"])),
        "allowed_modes": allowed_modes,
        "mode_labels": labels,
        "mode_descriptions": descriptions,
        "default_external_action": safe_text(raw.get("default_external_action") or defaults["default_external_action"]),
        "source_selection_order": [item for item in raw.get("source_selection_order", defaults["source_selection_order"]) if isinstance(item, str)] or defaults["source_selection_order"],
    }


def processing_policy_runtime_view(policy: dict[str, Any]) -> dict[str, Any]:
    return {
        **policy,
        "mode_options": [
            {
                "value": mode,
                "label": policy["mode_labels"].get(mode, mode),
                "description": policy["mode_descriptions"].get(mode, ""),
            }
            for mode in policy["allowed_modes"]
        ],
    }


def normalize_request_execution_policy(value: Any, processing_policy: dict[str, Any] | None = None) -> dict[str, Any]:
    defaults = default_request_execution_policy()
    raw = value if isinstance(value, dict) else {}
    allowed_modes = (processing_policy or {}).get("allowed_modes") or default_processing_policy_settings()["allowed_modes"]
    search_mode_override = raw.get("search_mode_override")
    search_mode_override = safe_text(search_mode_override) if search_mode_override is not None else None
    if search_mode_override == "":
        search_mode_override = None
    if search_mode_override and search_mode_override not in allowed_modes:
        raise ApiError("processing_mode_invalid", 400)
    selected_source_ids = []
    seen: set[str] = set()
    for item in raw.get("selected_source_ids") or []:
        source_id = safe_text(item)
        if source_id and source_id not in seen:
            selected_source_ids.append(source_id)
            seen.add(source_id)
    allow_external = raw.get("allow_external_for_this_request", defaults["allow_external_for_this_request"])
    if allow_external is not None:
        allow_external = bool(allow_external)
    return {
        "search_mode_override": search_mode_override,
        "selected_source_ids": selected_source_ids,
        "allow_external_for_this_request": allow_external,
        "force_refresh": bool(raw.get("force_refresh", defaults["force_refresh"])),
        "save_results_locally": bool(raw.get("save_results_locally", defaults["save_results_locally"])),
    }


def build_runtime_data_policy(conn: sqlite3.Connection) -> dict[str, Any]:
    registry = normalize_source_registry(get_app_setting_json(conn, "source_registry", default_source_registry_settings()))
    policy = normalize_processing_policy(get_app_setting_json(conn, "processing_policy", default_processing_policy_settings()))
    return {
        "source_registry": registry,
        "processing_policy": processing_policy_runtime_view(policy),
    }


def apply_processing_mode_override(policy: dict[str, Any], requested_mode: str) -> str:
    requested = safe_text(requested_mode)
    allowed_modes = policy.get("allowed_modes") or []
    default_mode = safe_text(policy.get("default_mode") or "registered_only")
    if not requested:
        return default_mode
    if requested not in allowed_modes:
        raise ApiError("processing_mode_invalid", 400)
    if requested != default_mode and not bool(policy.get("allow_override")):
        raise ApiError("processing_mode_override_forbidden", 403)
    return requested


def build_effective_request_execution_policy(processing_policy: dict[str, Any], request_policy: dict[str, Any] | None = None) -> dict[str, Any]:
    normalized = normalize_request_execution_policy(request_policy or {}, processing_policy)
    search_mode = apply_processing_mode_override(processing_policy, normalized.get("search_mode_override") or "")
    allow_external = normalized["allow_external_for_this_request"]
    if allow_external is None:
        allow_external = search_mode in {"registered_plus_external", "external_allowed"}
    effective = {
        **normalized,
        "search_mode_override": search_mode,
        "allow_external_for_this_request": bool(allow_external),
        "search_mode_override_requested": normalized.get("search_mode_override"),
    }
    return effective


def maybe_build_dashboard_artifact(reply_text: str, thread_id: int, created_at: str, policy: dict[str, Any]) -> dict[str, Any] | None:
    text = safe_text(reply_text)
    if not text or not bool(policy.get("save_results_locally")):
        return None
    lowered = text.lower()
    if "дашборд" not in lowered and "dashboard" not in lowered:
        return None
    artifacts_dir = DATA_DIR / "dashboard_artifacts"
    artifacts_dir.mkdir(parents=True, exist_ok=True)
    stamp = created_at.replace(":", "").replace("-", "")
    artifact_path = artifacts_dir / f"dashboard-thread-{thread_id}-{stamp}.md"
    artifact_path.write_text(
        "\n".join(
            [
                "# Dashboard artifact",
                "",
                f"thread_id: {thread_id}",
                f"created_at: {created_at}",
                f"search_mode: {policy.get('search_mode_override') or ''}",
                f"allow_external_for_this_request: {str(bool(policy.get('allow_external_for_this_request'))).lower()}",
                f"selected_source_ids: {', '.join(policy.get('selected_source_ids') or [])}",
                f"force_refresh: {str(bool(policy.get('force_refresh'))).lower()}",
                f"save_results_locally: {str(bool(policy.get('save_results_locally'))).lower()}",
                "",
                "## Assistant response",
                "",
                text,
                "",
            ]
        ),
        encoding="utf-8",
    )
    return {
        "kind": "dashboard_markdown",
        "path": str(artifact_path),
        "file_name": artifact_path.name,
        "created_at": created_at,
    }


def build_source_policy_context(source_registry: dict[str, Any], processing_policy: dict[str, Any], effective_mode: str) -> str:
    labels = processing_policy.get("mode_labels") or {}
    descriptions = processing_policy.get("mode_descriptions") or {}
    enabled_sources = [item for item in source_registry.get("items") or [] if item.get("enabled")]
    internal_sources = [item for item in enabled_sources if item.get("origin") == "internal"]
    external_sources = [item for item in enabled_sources if item.get("origin") != "internal"]

    def fmt(items: list[dict[str, Any]]) -> str:
        if not items:
            return "- не заданы"
        return "\n".join(
            f"- {item['name']} ({item['source_key']}): origin={item['origin']}, trust={item['trust_level']}, registration={item['registration_status']}, access={item['access_mode']}"
            for item in items
        )

    return (
        "Контур источников и политика обработки:\n"
        f"- Текущий режим: {effective_mode} — {labels.get(effective_mode, effective_mode)}\n"
