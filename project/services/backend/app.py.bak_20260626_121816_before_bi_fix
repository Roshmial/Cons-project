def infer_composition_mode(text: str) -> str:
    lowered = safe_text(text).lower()
    if not lowered:
        return ""
    has_explicit_proposal_phrase = regex_matches_any(lowered, COLLECTION_PROPOSAL_TRIGGER_PATTERNS)
    has_cost = regex_matches_any(lowered, COLLECTION_COST_PATTERNS)
    has_resources = regex_matches_any(lowered, COLLECTION_RESOURCE_PATTERNS)
    if has_explicit_proposal_phrase and (has_cost or has_resources):
        return "proposal_bundle"
    if has_explicit_proposal_phrase:
        return "proposal_draft"
    has_estimate_action = regex_matches_any(lowered, COLLECTION_ESTIMATE_ACTION_PATTERNS)
    if has_cost and has_resources and has_estimate_action:
        return "estimate_bundle"
    if has_cost and has_estimate_action:
        return "cost_estimate"
    if has_resources and has_estimate_action:
        return "resource_estimate"
    return ""


def looks_like_proposal_composition_request(text: str) -> bool:
    lowered = safe_text(text).lower()
    if not lowered:
        return False
    if not regex_matches_any(lowered, COLLECTION_PROPOSAL_ACTION_PATTERNS):
        return False
    return bool(infer_composition_mode(text))


def infer_collection_output_format(text: str) -> str:
    if looks_like_proposal_composition_request(text):
        return "md"
    export_format = detect_message_export_format(text)
    if export_format:
        return export_format
    lowered = safe_text(text).lower()
    if re.search(r"\b(csv|xlsx|json|xml)\b", lowered):
        return re.search(r"\b(csv|xlsx|json|xml)\b", lowered).group(1)
    if re.search(r"\bexcel\b|\bэксел\b", lowered):
        return "csv"
    if is_dashboard_request(lowered):
        return "dashboard"
    if re.search(r"\b(таблиц|table)\w*\b", lowered):
        return "table"
    if re.search(r"\bспис(ок|ком)\b", lowered):
        return "list"
    return ""


def infer_collection_analysis_modes(text: str) -> list[str]:
    lowered = safe_text(text).lower()
    if not lowered:
        return []
    modes: list[str] = []
    if regex_matches_any(lowered, COLLECTION_CLASSIFICATION_PATTERNS):
        modes.append('classification')
    if regex_matches_any(lowered, COLLECTION_SELECTION_PATTERNS):
        modes.append('selection')
    if regex_matches_any(lowered, COLLECTION_COMPARISON_PATTERNS):
        modes.append('comparison')
    if not modes and regex_matches_any(lowered, COLLECTION_ANALYSIS_ACTION_PATTERNS):
        modes.append('analysis')
    return modes


def looks_like_collection_request(text: str, attachments: list[dict[str, Any]] | None = None) -> bool:
    lowered = safe_text(text).lower()
    if not lowered:
        return False
    subject = infer_collection_subject(text)
    output_format = infer_collection_output_format(text)
    implicit_web_dashboard = is_policy_research_dashboard_request(text, attachments)
    has_collection_action = regex_matches_any(lowered, COLLECTION_REQUEST_ACTION_PATTERNS)
    has_analysis_action = regex_matches_any(lowered, COLLECTION_ANALYSIS_ACTION_PATTERNS)
    if not has_collection_action and not has_analysis_action and not implicit_web_dashboard:
        return False
    has_data_target = regex_matches_any(lowered, COLLECTION_REQUEST_DATA_TARGET_PATTERNS)
    has_output = bool(infer_collection_output_format(lowered))
    has_source_hint = bool(attachments) or regex_matches_any(lowered, COLLECTION_SOURCE_HINT_PATTERNS)
    return (has_data_target and (has_output or has_source_hint)) or (has_output and has_source_hint) or implicit_web_dashboard


def is_policy_research_dashboard_request(text: str, attachments: list[dict[str, Any]] | None = None) -> bool:
    if attachments:
        return False
    output_format = infer_collection_output_format(text)
    if output_format != 'dashboard':
        return False
    subject = infer_collection_subject(text)
    if not subject:
        return False
    dashboard_intent = infer_external_dashboard_intent(text)
    return dashboard_intent in COLLECTION_RESEARCH_DASHBOARD_INTENTS


def infer_collection_source(text: str, attachments: list[dict[str, Any]] | None = None) -> dict[str, Any]:
    lowered = safe_text(text).lower()
    if attachments:
        first = attachments[0]
        label = safe_text(first.get("original_name") or "Файл пользователя")
        if len(attachments) > 1:
            label = f"Файлы пользователя: {label} и ещё {len(attachments) - 1}"
        return {
            "source_kind": "attachment",
            "source_label": label,
        }
    url_match = re.search(r"https?://\S+|www\.\S+", text, flags=re.IGNORECASE)
    if url_match:
        return {"source_kind": "url", "source_label": url_match.group(0).rstrip(').,;')}
    for rule in COLLECTION_SOURCE_KEYWORD_RULES:
        pattern = safe_text((rule or {}).get("pattern"))
        source_kind = safe_text((rule or {}).get("source_kind"))
        label = safe_text((rule or {}).get("label"))
        if pattern and re.search(pattern, lowered, flags=re.IGNORECASE):
            return {"source_kind": source_kind, "source_label": label}
    if is_policy_research_dashboard_request(text, attachments):
        return {"source_kind": COLLECTION_RESEARCH_DASHBOARD_IMPLICIT_SOURCE_KIND, "source_label": COLLECTION_RESEARCH_DASHBOARD_IMPLICIT_SOURCE_LABEL}
    return {"source_kind": "", "source_label": ""}


def infer_collection_subject(text: str) -> str:
    raw_text = safe_text(text).strip()
    if not raw_text:
        return ""
    quoted = re.search(r"[«\"]([^»\"]{3,160})[»\"]", raw_text)
    if quoted:
        return safe_text(quoted.group(1)).strip()
    for pattern in COLLECTION_SUBJECT_EXPLICIT_PATTERNS:
        match = re.search(pattern, raw_text, flags=re.IGNORECASE)
        if match:
            return safe_text(match.group(1)).strip(" .,!?:;»\"")
    for pattern in COLLECTION_SUBJECT_PATTERNS:
        match = re.search(pattern, raw_text, flags=re.IGNORECASE)
        if match:
            return safe_text(match.group(1)).strip(" .,!?:;»\"")
    normalized = re.sub(r"https?://\S+|www\.\S+", " ", raw_text, flags=re.IGNORECASE)
    normalized = re.sub(r"\b\d+\)\s*", " ", normalized)
    normalized = re.sub(r"\s+", " ", normalized).strip(" .,!?:;»\"")
    lowered = normalized.lower()
    if infer_collection_output_format(raw_text) == 'dashboard':
        dashboard_subject_match = re.search(r'дашборд\s+(?:по|про|для)\s+(.+)$', normalized, flags=re.IGNORECASE)
        if dashboard_subject_match:
            dashboard_subject = safe_text(dashboard_subject_match.group(1)).strip(" .,!?:;»\"")
            if dashboard_subject and dashboard_subject.lower() != lowered:
                return dashboard_subject[:220]
        dashboard_subject = re.sub(r'^(построй|собери|сделай|подготовь|сформируй)\s+дашборд\s+(по|про|для)?\s*', '', normalized, flags=re.IGNORECASE).strip(" .,!?:;»\"")
        if dashboard_subject and dashboard_subject.lower() != lowered:
            return dashboard_subject[:220]
        research_subject = re.sub(
            r'^(проанализируй|анализируй|собери(?:\s+(?:данные|информацию))?|подготовь|сделай|сформируй|расскажи(?:\s+кратко)?)\s+',
            '',
            normalized,
            flags=re.IGNORECASE,
        )
        research_subject = re.sub(
            r'\s+и\s+(построй|сделай|собери|подготовь|сформируй)\s+дашборд.*$',
            '',
            research_subject,
            flags=re.IGNORECASE,
        ).strip(" .,!?:;»\"")
        if research_subject and research_subject.lower() != lowered:
            return research_subject[:220]
    if len(normalized) >= 24 and any(marker in lowered for marker in (
        "подбери",
        "собери",
        "найди",
        "выведи",
        "определи",
        "подготов",
        "сделай",
        "сформир",
    )):
        return normalized[:220]
    return ""


def infer_collection_fields(text: str) -> list[str]:
    raw_text = safe_text(text)
    for pattern in COLLECTION_FIELD_PATTERNS:
        match = re.search(pattern, raw_text, flags=re.IGNORECASE)
        if not match:
            continue
        chunk = safe_text(match.group(1))
        if COLLECTION_FIELD_CUTOFF_PATTERN:
            chunk = re.split(COLLECTION_FIELD_CUTOFF_PATTERN, chunk, maxsplit=1, flags=re.IGNORECASE)[0]
        fields = [
            item.strip(COLLECTION_FIELD_TRIM_CHARS)
            for item in re.split(COLLECTION_FIELD_SPLIT_PATTERN, chunk)
        ]
        fields = [item for item in fields if item and len(item) >= 2]
        if fields:
            return fields
    block_match = re.search(COLLECTION_FIELD_BLOCK_PATTERN, raw_text, flags=re.IGNORECASE) if COLLECTION_FIELD_BLOCK_PATTERN else None
    if block_match:
        lines = [line.strip(" \t\r-—•*0123456789.") for line in block_match.group(1).splitlines()]
        fields = [line.rstrip(" .;:") for line in lines if line and len(line) >= 2]
        if fields:
            return fields
    return []


def infer_budget_hint(text: str) -> str:
