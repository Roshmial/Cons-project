                "INSERT INTO job_recipients (job_id, recipient_type, target_value, label, created_at) VALUES (?, ?, ?, ?, ?)",
                (job_id, recipient["recipient_type"], recipient["target_value"], recipient["label"], ts),
            )


def safe_text(value: Any) -> str:
    return str(value or "").strip()


def safe_filename(value: str, fallback: str = "file") -> str:
    cleaned = secure_filename(safe_text(value))
    return cleaned or fallback


def shorten_text(value: str, limit: int) -> str:
    text = safe_text(value)
    if len(text) <= limit:
        return text
    return text[: max(0, limit - 1)].rstrip() + "…"


def guess_mime_type(filename: str) -> str:
    guessed, _ = mimetypes.guess_type(filename)
    return guessed or "application/octet-stream"


def ensure_upload_dir(user_id: int, thread_id: int) -> Path:
    target = UPLOADS_DIR / f"user_{user_id}" / f"thread_{thread_id}"
    target.mkdir(parents=True, exist_ok=True)
    return target


def _collect_docx_table_lines(table: Any) -> list[str]:
    lines: list[str] = []
    for row in getattr(table, "rows", []) or []:
        cells: list[str] = []
        for cell in getattr(row, "cells", []) or []:
            cell_text = "\n".join(
                paragraph.text.strip()
                for paragraph in getattr(cell, "paragraphs", []) or []
                if paragraph.text and paragraph.text.strip()
            ).strip()
            if cell_text:
                cells.append(cell_text)
        if cells:
            lines.append(" | ".join(cells))
    return lines


def extract_docx_text(file_path: Path) -> tuple[str, str | None]:
    docx_module = load_docx_module()
    if docx_module is None:
        return "", "Извлечение текста из DOCX недоступно: нет python-docx."
    document = docx_module.Document(str(file_path))
    parts: list[str] = []
    for paragraph in document.paragraphs:
        text = safe_text(paragraph.text).strip()
        if text:
            parts.append(text)
    for table in document.tables:
        parts.extend(_collect_docx_table_lines(table))
    for section in getattr(document, "sections", []) or []:
        for area in (getattr(section, "header", None), getattr(section, "footer", None)):
            if not area:
                continue
            for paragraph in getattr(area, "paragraphs", []) or []:
                text = safe_text(paragraph.text).strip()
                if text:
                    parts.append(text)
            for table in getattr(area, "tables", []) or []:
                parts.extend(_collect_docx_table_lines(table))
    if not parts:
        return "", "DOCX прочитан, но текстовых блоков не найдено."
    return "\n".join(parts), None


def extract_xlsx_text(file_path: Path) -> tuple[str, str | None]:
    openpyxl_module = load_openpyxl_module()
    if openpyxl_module is None:
        return "", "Извлечение текста из XLSX недоступно: нет openpyxl."
    workbook = openpyxl_module.load_workbook(filename=str(file_path), data_only=True, read_only=True)
    parts: list[str] = []
    for sheet in workbook.worksheets:
        parts.append(f"[Лист: {sheet.title}]")
        for row in sheet.iter_rows(values_only=True):
            cells = [safe_text(value).strip() for value in row if safe_text(value).strip()]
            if cells:
                parts.append(" | ".join(cells))
    text = "\n".join(part for part in parts if part).strip()
    if not text:
        return "", "XLSX прочитан, но текстовых ячеек не найдено."
    return text, None


def extract_pptx_text(file_path: Path) -> tuple[str, str | None]:
    pptx_module = load_pptx_module()
    if pptx_module is None:
        return "", "Извлечение текста из PPTX недоступно: нет python-pptx."
    presentation = pptx_module.Presentation(str(file_path))
    parts: list[str] = []
    for slide_index, slide in enumerate(presentation.slides, start=1):
        slide_lines: list[str] = [f"[Слайд {slide_index}]"]
        for shape in slide.shapes:
            text = safe_text(getattr(shape, "text", "")).strip()
            if text:
                slide_lines.append(text)
            table = getattr(shape, "table", None)
            if table is not None:
                for row in table.rows:
                    cells = [safe_text(cell.text).strip() for cell in row.cells if safe_text(cell.text).strip()]
                    if cells:
                        slide_lines.append(" | ".join(cells))
        notes_slide = getattr(slide, "notes_slide", None)
        if notes_slide is not None:
            for shape in notes_slide.shapes:
                text = safe_text(getattr(shape, "text", "")).strip()
                if text:
                    slide_lines.append(text)
        if len(slide_lines) > 1:
            parts.append("\n".join(slide_lines))
    text = "\n\n".join(parts).strip()
    if not text:
        return "", "PPTX прочитан, но текстовых блоков не найдено."
    return text, None


def extract_text_from_path(file_path: Path, mime_type: str) -> tuple[str, str | None]:
    suffix = file_path.suffix.lower()
    try:
        if suffix in TEXT_LIKE_EXTENSIONS or mime_type.startswith("text/"):
            return file_path.read_text(encoding="utf-8", errors="replace"), None
        if suffix == ".pdf":
            fitz_module = load_fitz_module()
            if fitz_module is None:
                return "", "Извлечение текста из PDF недоступно: нет PyMuPDF."
            with fitz_module.open(file_path) as pdf:
                text = "\n\n".join(page.get_text("text") for page in pdf)
            return text, None
        if suffix == ".docx":
            return extract_docx_text(file_path)
        if suffix == ".xlsx":
            return extract_xlsx_text(file_path)
        if suffix == ".pptx":
            return extract_pptx_text(file_path)
    except Exception as exc:
        return "", f"Не удалось обработать файл: {exc}"
    return "", "Для этого формата пока сохраняю файл без извлечения текста."


def store_uploaded_file(file_storage: Any, user_id: int, thread_id: int) -> dict[str, Any]:
    original_name = safe_text(getattr(file_storage, "filename", "")) or "file"
    secure_name = safe_filename(original_name, "file")
    file_ext = Path(secure_name).suffix
    stored_name = f"{uuid.uuid4().hex}{file_ext}"
    upload_dir = ensure_upload_dir(user_id, thread_id)
    stored_path = upload_dir / stored_name
    file_storage.save(stored_path)
    size_bytes = stored_path.stat().st_size
    if size_bytes > MAX_UPLOAD_BYTES:
        stored_path.unlink(missing_ok=True)
        raise ApiError("file_too_large", 400)
    mime_type = safe_text(getattr(file_storage, "mimetype", "")) or guess_mime_type(secure_name)
    extracted_text, extraction_note = extract_text_from_path(stored_path, mime_type)
    extracted_text = shorten_text(extracted_text, TEXT_EXTRACT_CHAR_LIMIT)
    preview_text = shorten_text(extracted_text, INLINE_ATTACHMENT_PREVIEW_CHARS)
    return {
        "original_name": original_name,
        "stored_name": stored_name,
        "relative_path": str(stored_path.relative_to(DATA_DIR)),
        "mime_type": mime_type,
        "size_bytes": size_bytes,
        "text_extracted": bool(extracted_text),
        "extraction_note": extraction_note,
        "preview_text": preview_text,
        "extracted_text": extracted_text,
        "preview_excerpt": shorten_text(extracted_text, 220),
    }


def build_attachment_context(attachments: list[dict[str, Any]]) -> str:
    if not attachments:
        return ""
    parts = ["В сообщении приложены файлы:"]
    for index, item in enumerate(attachments, start=1):
        line = f"{index}. {item['original_name']} ({item['mime_type']}, {item['size_bytes']} байт)"
        extracted_text = safe_text(item.get("extracted_text"))
        preview_text = safe_text(item.get("preview_text"))
        if item.get("text_extracted") and (extracted_text or preview_text):
            line += f"\nИзвлечённый текст:\n{extracted_text or preview_text}"
        elif item.get("extraction_note"):
            line += f"\nПримечание: {item['extraction_note']}"
        parts.append(line)
    return "\n\n".join(parts)


def build_user_message_content(text: str, attachments: list[dict[str, Any]]) -> str:
    text_part = safe_text(text)
    attachment_part = build_attachment_context(attachments)
    if text_part and attachment_part:
        return f"{text_part}\n\n{attachment_part}"
    if attachment_part:
        return attachment_part
    return text_part


def normalize_existing_file_ids(raw_value: Any) -> list[int]:
    if raw_value is None:
        return []
    values = raw_value if isinstance(raw_value, list) else [raw_value]
    result: list[int] = []
    for value in values:
        if isinstance(value, str):
            chunks = [part.strip() for part in value.split(',')]
        else:
            chunks = [str(value).strip()]
        for chunk in chunks:
            if not chunk:
                continue
            if chunk.isdigit():
                result.append(int(chunk))
    return list(dict.fromkeys(result))


def attachment_from_user_file_row(row: sqlite3.Row) -> dict[str, Any]:
    preview_text = safe_text(row['preview_text'])
    extracted_text = safe_text(row['extracted_text']) if 'extracted_text' in row.keys() else preview_text
    extraction_note = safe_text(row['extraction_note'])
    return {
        'id': row['id'],
        'source_file_id': row['id'],
        'original_name': row['original_name'],
        'stored_name': row['stored_name'],
        'relative_path': row['relative_path'],
        'mime_type': row['mime_type'],
        'size_bytes': row['size_bytes'],
        'text_extracted': bool(row['text_extracted']),
        'extraction_note': extraction_note,
        'preview_text': preview_text,
        'extracted_text': extracted_text,
        'preview_excerpt': shorten_text(preview_text, 220),
        'reused': True,
        'file_kind': 'reused_file',
        'file_origin': 'profile_reuse',
    }


def derive_file_extraction_status(payload: dict[str, Any]) -> str:
    item = payload if isinstance(payload, dict) else {}
    if item.get('text_extracted') and safe_text(item.get('extraction_note')):
        return 'partial'
    if item.get('text_extracted'):
        return 'recognized'
    return 'not_recognized'


def derive_file_preview_status(payload: dict[str, Any]) -> str:
    item = payload if isinstance(payload, dict) else {}
    if safe_text(item.get('preview_text') or item.get('preview_excerpt') or item.get('extracted_text')):
        return 'available'
    return 'unavailable'


def build_file_extraction_summary(payload: dict[str, Any]) -> str:
    item = payload if isinstance(payload, dict) else {}
    status = derive_file_extraction_status(item)
    note = safe_text(item.get('extraction_note'))
    if status == 'recognized':
        return 'Текст извлечён и готов для использования в ответе.'
    if status == 'partial':
        return note or 'Текст извлечён частично: часть содержимого могла не попасть в preview.'
    return note or 'Текст не удалось извлечь: для этого файла доступно только хранение и открытие.'


def build_file_preview_summary(payload: dict[str, Any]) -> str:
    item = payload if isinstance(payload, dict) else {}
    preview = safe_text(item.get('preview_excerpt') or item.get('preview_text'))
    if preview:
        return preview
    extracted = safe_text(item.get('extracted_text'))
    if extracted:
        return shorten_text(extracted, 220)
    return build_file_extraction_summary(item)


def build_file_preview_lines(payload: dict[str, Any], limit: int = 8) -> list[str]:
    item = payload if isinstance(payload, dict) else {}
    raw = safe_text(item.get('preview_text') or item.get('extracted_text'))
    if not raw:
        return []
    lines = [line.strip() for line in raw.splitlines() if line and line.strip()]
    return lines[: max(1, limit)]


def derive_file_kind(payload: dict[str, Any]) -> str:
    item = payload if isinstance(payload, dict) else {}
    explicit = safe_text(item.get('file_kind')).lower()
    if explicit:
        return explicit
    origin = safe_text(item.get('file_origin')).lower()
    if origin in {'exported_answer', 'message_export'}:
        return 'exported_answer'
    if origin in {'generated_result', 'generated_file_response', 'assistant_generated'} or item.get('assistant_generated'):
        return 'generated_result'
    if item.get('reused') or item.get('source_file_id'):
        return 'reused_file'
    return 'input_file'


def derive_file_origin(payload: dict[str, Any]) -> str:
    item = payload if isinstance(payload, dict) else {}
    explicit = safe_text(item.get('file_origin')).lower()
    if explicit:
        return explicit
    source = safe_text(item.get('source')).lower()
    if source == 'message_export' or item.get('exported_message_id'):
        return 'exported_answer'
    if source == 'generated_file_response' or item.get('generated_from_request') or item.get('assistant_generated'):
        return 'generated_result'
    if item.get('reused') or item.get('source_file_id'):
        return 'profile_reuse'
    return 'user_upload'


def build_file_surface(payload: dict[str, Any], *, used_in_response: bool | None = None) -> dict[str, Any]:
    item = payload if isinstance(payload, dict) else {}
    file_kind = derive_file_kind(item)
    file_origin = derive_file_origin(item)
    extraction_status = derive_file_extraction_status(item)
    preview_status = derive_file_preview_status(item)
    surface = {
        'file_kind': file_kind,
        'file_origin': file_origin,
        'extraction_status': extraction_status,
        'preview_status': preview_status,
        'used_in_response': bool(used_in_response if used_in_response is not None else item.get('used_in_response')),
        'source_file_id': item.get('source_file_id') or item.get('id'),
        'exported_from_message_id': item.get('exported_message_id') or item.get('generated_from_message_id'),
        'generated_from_request': bool(item.get('generated_from_request') or item.get('assistant_generated')),
        'next_actions': ['open_file'],
    }
    if file_kind in {'generated_result', 'exported_answer'}:
        surface['next_actions'].append('download_result')
    elif item.get('source_file_id') or item.get('id'):
        surface['next_actions'].append('reuse_file')
    return surface


def normalize_attachment_payload(item: dict[str, Any], *, used_in_response: bool | None = None) -> dict[str, Any]:
    payload = dict(item or {})
    payload['file_surface'] = build_file_surface(payload, used_in_response=used_in_response)
    payload.setdefault('file_kind', payload['file_surface']['file_kind'])
    payload.setdefault('file_origin', payload['file_surface']['file_origin'])
    payload.setdefault('used_in_response', payload['file_surface']['used_in_response'])
    payload.setdefault('extraction_summary', build_file_extraction_summary(payload))
    payload.setdefault('preview_summary', build_file_preview_summary(payload))
    payload.setdefault('preview_lines', build_file_preview_lines(payload))
    return payload


def build_used_files_payload(attachments: list[dict[str, Any]]) -> list[dict[str, Any]]:
    result: list[dict[str, Any]] = []
    seen: set[str] = set()
    for item in attachments or []:
        if not isinstance(item, dict):
            continue
        normalized = normalize_attachment_payload(item, used_in_response=True)
        key = f"{normalized.get('source_file_id') or ''}:{normalized.get('original_name') or normalized.get('stored_name') or ''}:{normalized.get('relative_path') or normalized.get('local_path') or ''}"
        if key in seen:
            continue
        seen.add(key)
        result.append(normalized)
    return result


def list_thread_files(conn: DBConnection, thread_id: int, user_id: int) -> list[dict[str, Any]]:
    rows = conn.execute(
        """
        SELECT *
        FROM user_files
        WHERE user_id = ? AND thread_id = ?
        ORDER BY created_at DESC, id DESC
        """,
        (user_id, thread_id),
    ).fetchall()
    items: list[dict[str, Any]] = []
    seen_keys: set[str] = set()

    for row in rows:
        payload = serialize_user_file(row)
        payload['thread_file_role'] = 'user_file'
        payload['source_message_id'] = int(row['message_id']) if row['message_id'] is not None else None
        key = f"user_file:{payload.get('id')}"
        if key not in seen_keys:
            seen_keys.add(key)
            items.append(payload)

    message_rows = conn.execute(
        "SELECT id, role, meta_json, created_at FROM messages WHERE thread_id = ? ORDER BY id DESC",
        (thread_id,),
    ).fetchall()
    for row in message_rows:
        meta = json_loads(row['meta_json'], {})
        attachments = meta.get('attachments') if isinstance(meta.get('attachments'), list) else []
        if not attachments:
            continue
        for index, attachment in enumerate(attachments):
            payload = normalize_attachment_payload(attachment)
            payload['source_message_id'] = int(row['id'])
            payload['source_message_role'] = safe_text(row['role']) or 'assistant'
            payload['thread_file_role'] = 'assistant_result' if safe_text(row['role']) == 'assistant' else 'message_attachment'
            payload.setdefault('download_url', f"{API_PREFIX}/messages/{int(row['id'])}/attachments/{index}")
            key = f"message_attachment:{int(row['id'])}:{index}:{payload.get('original_name') or payload.get('stored_name') or ''}"
            if key in seen_keys:
                continue
            seen_keys.add(key)
            items.append(payload)
    return items


def strip_media_tokens(text: str) -> str:
    cleaned_lines: list[str] = []
    for line in str(text or '').splitlines():
        if line.strip().startswith('MEDIA:'):
            continue
        cleaned_lines.append(line)
    return '\n'.join(cleaned_lines).strip()


INTERNAL_REASONING_MARKERS = (
    'we have the payload data',
    'need to extract top_candidates',
    "let's parse them",
    'top_candidates (list of up to 10)',
    'selection_reasons',
    'requires_review_count',
    'digest_payload',
    'payload_path',
    'хорошо, пользователь спрашивает',
    'нужно дать четкий и структурированный ответ',
    'нужно дать чёткий и структурированный ответ',
    'сначала вспомню',
    'из системного промпта',
    'пользователь уже представился в профиле',
    'но в данном вопросе',
    'однако вопрос общий',
    'нужно структурировать ответ',
    'критическое правило честности',
    'включён глубокий reasoning-режим',
    'r1 временно отключён',
    'лимит reasoning-модели исчерпан',
)


def strip_internal_reasoning_prelude(text: str) -> str:
    raw = str(text or '')
    if not raw.strip():
        return ''
    digest_anchor = re.search(r'(Дайджест\s+ИТ-консалтинга\s+за\s+\d{2}\.\d{2}\.\d{4}\s*\nОбработано\s+непустых\s+сообщений:[\s\S]*$)', raw, re.IGNORECASE)
    if digest_anchor:
        anchored = safe_text(digest_anchor.group(1)).strip()
        if anchored:
            return anchored
    direct_notice_stripped = re.sub(
        r'^Примечание:\s+(?:включён\s+глубокий\s+reasoning-режим|R1\s+временно\s+отключён|достигнут\s+ваш\s+суточный\s+лимит\s+R1|достигнут\s+суточный\s+глобальный\s+лимит\s+R1|достигнут\s+суточный\s+бюджет\s+R1|лимит\s+reasoning-модели\s+исчерпан)[^\n]*\n*',
        '',
        raw,
        flags=re.IGNORECASE,
    ).strip()
    if direct_notice_stripped != raw.strip():
        return direct_notice_stripped
    lines = raw.splitlines()
    suspicious_indexes = [
        index for index, line in enumerate(lines[:40])
        if any(marker in line.strip().lower() for marker in INTERNAL_REASONING_MARKERS)
    ]
    if not suspicious_indexes:
        return raw.strip()
    last_suspicious = suspicious_indexes[-1]
    for index in range(last_suspicious + 1, len(lines)):
        candidate = lines[index].strip()
        if not candidate:
            continue
        if candidate.startswith('#'):
            return '\n'.join(lines[index:]).strip()
        if re.match(r'^(обработано|дайджест|сводка|итог|результат)\b', candidate, re.IGNORECASE):
            return '\n'.join(lines[index:]).strip()
        if re.search(r'[А-Яа-яЁё]', candidate):
            return '\n'.join(lines[index:]).strip()
    return raw.strip()


def build_message_display_text(text: str) -> str:
    cleaned = strip_media_tokens(text)
    cleaned = strip_internal_reasoning_prelude(cleaned)
    return cleaned.strip()


def parse_media_paths(text: str) -> list[str]:
    paths: list[str] = []
    for line in str(text or '').splitlines():
        stripped = line.strip()
        if not stripped.startswith('MEDIA:'):
            continue
        candidate = stripped[len('MEDIA:'):].strip()
        if candidate and candidate not in paths:
            paths.append(candidate)
    for match in re.finditer(r'(?:sandbox:)?/(?:home/hermes|tmp)/[^\s<>()\[\]"\']+', str(text or '')):
        candidate = safe_text(match.group(0))
        if candidate and candidate not in paths:
            paths.append(candidate)
    return paths


def ensure_allowed_media_path(path_value: str) -> Path | None:
    raw = safe_text(path_value)
    if raw.startswith('sandbox:'):
        raw = raw[len('sandbox:'):].strip()
    if not raw or not raw.startswith('/'):
        return None
    resolved = Path(raw).expanduser().resolve()
    allowed_roots = [Path('/home/hermes').resolve(), Path('/tmp').resolve()]
    if not any(root == resolved or root in resolved.parents for root in allowed_roots):
        return None
    if not resolved.exists() or not resolved.is_file():
        return None
    return resolved


def build_assistant_media_attachments(text: str) -> list[dict[str, Any]]:
    attachments: list[dict[str, Any]] = []
    for path_value in parse_media_paths(text):
        resolved = ensure_allowed_media_path(path_value)
        if not resolved:
            continue
        attachments.append({
            'original_name': resolved.name,
            'mime_type': guess_mime_type(resolved.name),
            'size_bytes': resolved.stat().st_size,
            'local_path': str(resolved),
            'assistant_generated': True,
            'file_kind': 'generated_result',
            'file_origin': 'assistant_generated',
            'text_extracted': False,
            'extraction_note': 'Файл подготовлен агентом.',
            'preview_excerpt': '',
        })
    return attachments


def sanitize_local_path_leakage(text: str, meta: dict[str, Any] | None = None) -> str:
    cleaned = safe_text(text)
    attachments = []
    if isinstance(meta, dict) and isinstance(meta.get('attachments'), list):
        attachments = meta.get('attachments') or []
    for item in attachments:
        local_path = safe_text((item or {}).get('local_path'))
        original_name = safe_text((item or {}).get('original_name')) or 'файл'
        for candidate in (local_path, f'sandbox:{local_path}' if local_path else ''):
            if candidate:
                cleaned = cleaned.replace(candidate, original_name)
    cleaned = re.sub(r'`?/home/hermes/[^`\s]+`?', 'файл', cleaned)
    cleaned = re.sub(r'`?/tmp/[^`\s]+`?', 'файл', cleaned)
    return cleaned


def looks_like_summary_request(user_text: str) -> bool:
    lowered = safe_text(user_text).lower()
    if not lowered:
        return False
    markers = (
        'суммариз', 'суммари', 'резюмир', 'резюме текста', 'кратко излож', 'краткое содержание',
        'сделай summary', 'summary', 'summarize', 'summarise', 'tl;dr', 'выжимк', 'саммари'
    )
    return any(marker in lowered for marker in markers)


def trim_summary_followup_sections(reply_text: str) -> str:
    text = safe_text(reply_text).rstrip()
    if not text:
        return text
    patterns = (
        r'\n{1,3}Рекомендация по реализации:\s*.*$' ,
        r'\n{1,3}Рекомендация по следующему шагу:\s*.*$',
        r'\n{1,3}Следующий шаг:\s*.*$',
        r'\n{1,3}Если вы сейчас дорабатываете.*$',
        r'\n{1,3}Если хотите, я могу помочь.*$',
        r'\n{1,3}Я могу помочь.*$',
    )
    for pattern in patterns:
        text = re.sub(pattern, '', text, flags=re.IGNORECASE | re.DOTALL)
    return text.rstrip()


def strip_non_executable_action_promises(reply_text: str) -> str:
    text = safe_text(reply_text)
    if not text:
        return ""
    patterns = [
        r"(?is)\n{0,2}\*\*что я сделаю сейчас:?\*\*.*$",
        r"(?im)^\s*что я сделаю сейчас:?\s*$.*",
        r"(?im)^\s*\d+[.)]\s*(проверю|создам|запущу|соберу|выгружу|настрою)\b.*$",
        r"(?im)^\s*(проверю|создам|запущу|соберу|выгружу|настрою)\b.*$",
        r"(?im)^\s*приступаю(?:\s+к\s+[^\n.!?]+)?[.!?]?\s*$",
    ]
    cleaned = text
    for pattern in patterns:
        cleaned = re.sub(pattern, "", cleaned, flags=re.IGNORECASE | re.MULTILINE | re.DOTALL)
    cleaned = re.sub(r"\n{3,}", "\n\n", cleaned)
    return cleaned.strip()


def postprocess_assistant_reply(user_text: str, reply_text: str, meta: dict[str, Any] | None = None) -> str:
    cleaned = sanitize_local_path_leakage(reply_text, meta)
    meta = meta if isinstance(meta, dict) else {}
    message_kind = safe_text(meta.get("message_kind")).lower()
    downstream = safe_text(meta.get("downstream")).lower()
    generated_file = bool(meta.get("generated_from_request")) or message_kind == "file_response"
    actionable_route = bool(message_kind in {"dashboard_result", "clarification_request", "approval_request", "collection_contract"} or generated_file or downstream.startswith("dashboard:"))
    if not actionable_route:
        cleaned = strip_non_executable_action_promises(cleaned)
    if looks_like_summary_request(user_text):
        cleaned = trim_summary_followup_sections(cleaned)
    return cleaned.strip() or safe_text(reply_text).strip()


def enrich_assistant_meta(meta: dict[str, Any], text: str, *, message_id: int | None = None) -> tuple[str, dict[str, Any]]:
    cleaned_text = strip_media_tokens(text)
    parsed_attachments = build_assistant_media_attachments(text)
    if parsed_attachments:
        for item in parsed_attachments:
            local_path = safe_text(item.get('local_path'))
            original_name = safe_text(item.get('original_name')) or 'файл'
            for candidate in (local_path, f'sandbox:{local_path}' if local_path else ''):
                if candidate:
                    cleaned_text = cleaned_text.replace(candidate, original_name)
        if len(parsed_attachments) == 1 and 'прилож' not in cleaned_text.lower():
            cleaned_text = cleaned_text.rstrip()
            if cleaned_text:
                cleaned_text = f"{cleaned_text} Файл приложен к сообщению."
            else:
                cleaned_text = 'Файл приложен к сообщению.'
    payload = dict(meta or {})
    existing = payload.get('attachments') if isinstance(payload.get('attachments'), list) else []
    attachments = existing or parsed_attachments
    if attachments:
        payload['attachments'] = [
            {
                **item,
                **({'download_url': f"{API_PREFIX}/messages/{message_id}/attachments/{index}"} if message_id is not None else {}),
            }
            for index, item in enumerate(attachments)
        ]
    if not safe_text(payload.get('message_kind')):
        downstream = safe_text(payload.get('downstream')).lower()
        if downstream.startswith('hermes-api-server') or payload.get('hermes_model'):
            payload['message_kind'] = 'chat_response'
    payload['display_text'] = build_message_display_text(cleaned_text)
    return cleaned_text, payload


