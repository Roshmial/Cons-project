    global A4, TTFont, pdfmetrics, canvas
    if A4 is None or TTFont is None or pdfmetrics is None or canvas is None:
        try:
            from reportlab.lib.pagesizes import A4 as reportlab_A4  # type: ignore
            from reportlab.pdfbase import pdfmetrics as reportlab_pdfmetrics  # type: ignore
            from reportlab.pdfbase.ttfonts import TTFont as reportlab_TTFont  # type: ignore
