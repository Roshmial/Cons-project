def telegram_post_type(text: str) -> str:
    lowered = safe_text(text).lower()
    if not lowered:
        return "без текста"
    rules = [
        ("исследование", [r"\bисследован", r"\bопрос", r"benchmark", r"ключевые выводы"]),
        ("мероприятие", [r"\bвебинар", r"\bконференц", r"\bфорум", r"\bэфир", r"регистрац"]),
        ("кейс", [r"\bкейс", r"\bвнедр", r"\bреализ", r"\bавтоматизац", r"для клиента"]),
        ("реклама услуг", [r"мы можем помочь", r"обращайтесь", r"оставьте заявку", r"готовы помочь", r"экспертные консультации"]),
        ("интервью/комментарий", [r"\bинтервью", r"\bподкаст", r"эксперт", r"рассказал", r"прокомментир"]),
        ("корпоративная новость", [r"совет директор", r"дивиденд", r"награждени", r"поздравля", r"фотоотчет"]),
        ("обзор рынка", [r"обзор новостей", r"дайджест", r"рынок", r"тренд", r"ландшафт"]),
        ("аналитика", [r"разбор", r"почему", r"риски", r"подход", r"что происходит"]),
        ("продукт/решение", [r"платформ", r"решени", r"сервис", r"продукт", r"модуль"]),
    ]
    best_label = "прочее"
    best_score = 0
    for label, patterns in rules:
        score = 0
        for pattern in patterns:
            score += len(re.findall(pattern, lowered, flags=re.IGNORECASE))
        if score > best_score:
            best_score = score
            best_label = label
    return best_label


def compact_telegram_text(text: str, limit: int = 160) -> str:
    cleaned = re.sub(r"\s+", " ", safe_text(text)).strip()
    if len(cleaned) <= limit:
        return cleaned
    shortened = cleaned[: limit - 1].rsplit(" ", 1)[0].rstrip(" ,;:-")
    return f"{shortened}…"


def normalize_public_error_text(error_text: str) -> str:
    cleaned = safe_text(error_text).strip()
    if not cleaned:
        return "Ошибка runtime: источник не вернул пригодный ответ."
    lowered = cleaned.lower()
    normalized_html = html.unescape(lowered)
    if cleaned == "message_export_unfulfilled_by_model":
        return "Не удалось сформировать файл: модель вернула служебный или непригодный ответ вместо содержимого документа. Повторите запрос."
    if cleaned.startswith("message_export_"):
        return "Не удалось сформировать файл по предыдущему ответу. Повторите запрос после того, как в чате появится содержательный ответ."
    if "timed out" in lowered:
        return "Не удалось сформировать файл: upstream-ответ превысил лимит ожидания."
    html_markers = (
        "<html",
        "<!doctype html",
        "<body",
        "<head",
        '<meta name="viewport"',
        "<style",
        "</html>",
    )
    if any(marker in normalized_html for marker in html_markers):
        return "Ошибка runtime: вместо API-ответа вернулась HTML-страница."
    if len(cleaned) > 500:
        return "Ошибка runtime: источник вернул слишком длинную техническую ошибку."
    return cleaned


def load_recent_telegram_digest_messages(days: int = TELEGRAM_ANALYTICS_WINDOW_DAYS) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    raw_logs_dir = TELEGRAM_ANALYTICS_DIR / "raw_logs"
    summary_files = sorted(raw_logs_dir.glob("*_summary_input.json"), key=lambda path: path.stat().st_mtime, reverse=True)[: max(days, 1)]
    messages: list[dict[str, Any]] = []
    used_files: list[str] = []
    seen_keys: set[tuple[str, int]] = set()
    for path in reversed(summary_files):
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            continue
        for item in payload.get("messages") or []:
            chat = safe_text(item.get("chat"))
            message_id = int(item.get("id") or 0)
            if not chat or not message_id:
                continue
            key = (chat, message_id)
            if key in seen_keys:
                continue
            seen_keys.add(key)
            messages.append(item)
        used_files.append(path.name)
    if messages:
        return messages, {"files": used_files, "source": "summary_input", "days": days}

    fallback_path = raw_logs_dir / "latest_non_empty_for_summary.json"
    if fallback_path.exists():
        payload = json.loads(fallback_path.read_text(encoding="utf-8"))
        if isinstance(payload, list):
            return payload, {"files": [fallback_path.name], "source": "latest_non_empty", "days": days}
    raise ApiError("telegram_analytics_source_missing", 503)


def build_telegram_dashboard_payload(messages: list[dict[str, Any]], source_meta: dict[str, Any]) -> dict[str, Any]:
    if not messages:
        raise ApiError("telegram_analytics_no_messages", 404)
    normalized = []
    total_views = 0
    total_forwards = 0
    day_counter = Counter()
    type_counter = Counter()
    channel_counter = Counter()
    channel_views = defaultdict(int)
    channel_forwards = defaultdict(int)
    for item in messages:
        metadata = item.get("metadata") if isinstance(item.get("metadata"), dict) else {}
        text_value = item.get("text") if item.get("text") is not None else item.get("message")
        text = safe_text(text_value)
        chat = safe_text(item.get("chat")) or "unknown"
        published_at = safe_text(item.get("date"))
        day_label = published_at[:10] if len(published_at) >= 10 else published_at
        views = int(metadata.get("views") or item.get("views") or 0)
        forwards = int(metadata.get("forwards") or item.get("forwards") or 0)
        post_type = telegram_post_type(text)
        day_counter[day_label] += 1
        type_counter[post_type] += 1
        channel_counter[chat] += 1
        channel_views[chat] += views
        channel_forwards[chat] += forwards
        total_views += views
        total_forwards += forwards
        normalized.append({
            "chat": chat, "date": published_at, "day": day_label, "views": views,
            "forwards": forwards, "post_type": post_type, "text": text, "url": safe_text(item.get("original_url")),
        })
    normalized.sort(key=lambda item: (item["views"], item["forwards"], item["date"]), reverse=True)
    total_messages = len(normalized)
    unique_channels = len(channel_counter)
    avg_views = round(total_views / total_messages) if total_messages else 0
    avg_forwards = round(total_forwards / total_messages, 1) if total_messages else 0
    top_type, top_type_count = type_counter.most_common(1)[0]
    top_channel, top_channel_count = channel_counter.most_common(1)[0]
    sorted_days = sorted(day_counter.items())
    max_day_value = max((value for _, value in sorted_days), default=1)
    top_types = type_counter.most_common(5)
    top_type_labels = {label for label, _ in top_types}
    stacked_day_items = []
    day_type_counter = defaultdict(Counter)
    for item in normalized:
        day_type_counter[item["day"]][item["post_type"]] += 1
    series_order = [label for label, _ in top_types]
    if any(label not in top_type_labels for label in type_counter):
        series_order.append("прочее")
    for day, day_total in sorted_days:
        counts = day_type_counter.get(day, Counter())
        aggregated = []
        other_count = 0
        for label in series_order:
            if label == "прочее":
                continue
            value = counts.get(label, 0)
            if value:
                aggregated.append((label, value))
        for label, value in counts.items():
            if label not in top_type_labels:
                other_count += value
        if other_count:
            aggregated.append(("прочее", other_count))
        for label, value in aggregated:
            stacked_day_items.append({
                "label": day[5:] if len(day) >= 10 else day,
                "value": value,
                "ratio": round(value / max_day_value, 3) if max_day_value else 0,
                "meta": f"series={label}; total_day={day_total}; raw_day={day}",
            })
    channel_items = [{"label": label, "value": value, "ratio": round(value / total_messages, 3), "meta": f"просмотры {channel_views[label]}, репосты {channel_forwards[label]}"} for label, value in channel_counter.most_common(6)]
    top_posts = [{"title": compact_telegram_text(item["text"] or item["chat"], 120), "subtitle": f"{item['chat']} · {item['post_type']}", "meta": f"Просмотры {item['views']} · Репосты {item['forwards']} · {item['day']}", "url": item["url"]} for item in normalized[:5]]
    summary = [
        f"За окно {source_meta.get('days', TELEGRAM_ANALYTICS_WINDOW_DAYS)} дн. вижу {total_messages} текстовых постов по {unique_channels} каналам.",
        f"Сильнее всего выделяются тип «{top_type}» ({top_type_count}) и канал {top_channel} ({top_channel_count} постов).",
        f"Средний охват — {avg_views} просмотров на пост, средняя пересылка — {avg_forwards}.",
    ]
    return {
        "reply_text": "\n".join(summary),
        "dashboard": {
            "kind": "telegram_digest_analytics",
            "title": "Дашборд по Telegram-дайджесту",
            "subtitle": f"Источник: {source_meta.get('source')} · файлов: {len(source_meta.get('files') or [])}",
            "summary_cards": [
                {"label": "Постов", "value": str(total_messages), "note": f"Окно {source_meta.get('days', TELEGRAM_ANALYTICS_WINDOW_DAYS)} дн."},
                {"label": "Каналов", "value": str(unique_channels), "note": f"Топ: {top_channel}"},
                {"label": "Средние просмотры", "value": str(avg_views), "note": "На один пост"},
                {"label": "Средние репосты", "value": str(avg_forwards), "note": "На один пост"},
            ],
            "sections": [
                {"kind": "bar_list", "title": "Сообщения по дням с разбивкой по типам", "note": "Каждая колонка — день, внутри — накопительная структура по типам. Не вошедшие в топ типы агрегированы в «прочее».", "items": stacked_day_items},
                {"kind": "bar_list", "title": "Каналы по числу сигналов", "items": channel_items},
                {"kind": "post_list", "title": "Посты с наибольшим охватом", "items": top_posts},
            ],
        },
    }


def dashboard_request_has_user_scope(text: str) -> bool:
    lowered = safe_text(text).lower()
    if not lowered:
        return False
    generic_phrases = (
        "по локальной аналитике",
        "по доступным данным",
        "по доступным локальным данным",
        "по данным",
        "локальный дашборд",
    )
    if any(phrase in lowered for phrase in generic_phrases):
        return False
    scope_tokens = (
        "по ",
        "из ",
        "для ",
        "за ",
        "источник",
        "набор данных",
        "метрик",
        "срез",
        ":",
    )
    return any(token in lowered for token in scope_tokens)


def build_generic_dataset_dashboard_payload(dataset: dict[str, Any], source_meta: dict[str, Any]) -> dict[str, Any]:
    rows = dataset.get("rows") or []
    columns = dataset.get("columns") or []
    numeric_columns = dataset.get("numeric_columns") or []
    categorical_columns = dataset.get("categorical_columns") or []
    row_count = len(rows)
    top_numeric = numeric_columns[0] if numeric_columns else None
    top_categorical = categorical_columns[0] if categorical_columns else None
    summary = [
        f"В файле {source_meta.get('label') or source_meta.get('original_name') or 'dataset'} найдено {row_count} строк и {len(columns)} колонок.",
        f"Числовые колонки: {', '.join(numeric_columns[:5]) if numeric_columns else 'не обнаружены'}.",
        f"Категориальные колонки: {', '.join(categorical_columns[:5]) if categorical_columns else 'не обнаружены'}.",
    ]
    summary_cards = [
        {"label": "Строк", "value": str(row_count), "note": source_meta.get('file_type', 'dataset')},
        {"label": "Колонок", "value": str(len(columns)), "note": source_meta.get('original_name') or 'источник пользователя'},
        {"label": "Числовых", "value": str(len(numeric_columns)), "note": top_numeric or '—'},
        {"label": "Категориальных", "value": str(len(categorical_columns)), "note": top_categorical or '—'},
    ]
    sections = []
    if columns:
        sections.append({
            "kind": "bar_list",
            "title": "Колонки файла",
            "items": [
                {"label": name, "value": 1, "ratio": 1.0, "meta": "numeric" if name in numeric_columns else "categorical" if name in categorical_columns else "mixed"}
                for name in columns[:12]
            ],
        })
    if top_numeric:
        numeric_values = [float(row[top_numeric]) for row in rows if isinstance(row, dict) and row.get(top_numeric) is not None]
        if numeric_values:
            min_v = min(numeric_values)
            max_v = max(numeric_values)
            avg_v = round(sum(numeric_values) / len(numeric_values), 2)
            sections.append({
                "kind": "bar_list",
                "title": f"Профиль числовой колонки: {top_numeric}",
                "items": [
                    {"label": "Минимум", "value": round(min_v, 2), "ratio": 1.0 if max_v == 0 else round((min_v / max_v) if max_v else 0, 3), "meta": top_numeric},
                    {"label": "Среднее", "value": avg_v, "ratio": 1.0 if max_v == 0 else round((avg_v / max_v) if max_v else 0, 3), "meta": top_numeric},
                    {"label": "Максимум", "value": round(max_v, 2), "ratio": 1.0, "meta": top_numeric},
                ],
            })
    if top_categorical:
        counts = Counter(str(row.get(top_categorical) or "∅") for row in rows if isinstance(row, dict))
        total = max(sum(counts.values()), 1)
        sections.append({
            "kind": "bar_list",
            "title": f"Топ значений: {top_categorical}",
            "items": [
                {"label": label[:60], "value": value, "ratio": round(value / total, 3), "meta": f"{round(value / total * 100)}% строк"}
                for label, value in counts.most_common(8)
            ],
        })
    preview_columns = columns[:6]
    preview_rows = []
    for row in rows[:5]:
        if not isinstance(row, dict):
            continue
        preview_rows.append({
            "title": " · ".join(f"{col}: {safe_text(row.get(col))[:32]}" for col in preview_columns if safe_text(row.get(col))),
            "subtitle": source_meta.get('original_name') or source_meta.get('label') or 'dataset',
            "meta": f"Колонок в строке: {len([col for col in preview_columns if safe_text(row.get(col))])}",
        })
    if preview_rows:
        sections.append({"kind": "post_list", "title": "Примеры строк", "items": preview_rows})
    return {
        "reply_text": "\n".join(summary),
        "dashboard": {
            "kind": "generic_dataset_analytics",
            "title": f"Дашборд по файлу: {source_meta.get('label') or source_meta.get('original_name') or 'dataset'}",
            "subtitle": f"Источник: пользовательский файл · тип: {source_meta.get('file_type', 'dataset')}",
            "summary_cards": summary_cards,
            "sections": sections,
        },
    }


def load_dashboard_dataset_from_attachment(attachment: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any]] | None:
    relative_path = safe_text(attachment.get('relative_path'))
    if not relative_path:
        return None
    file_path = (DATA_DIR / relative_path).resolve()
    if not file_path.exists() or not file_path.is_file():
        return None
    suffix = file_path.suffix.lower()
    original_name = safe_text(attachment.get('original_name')) or file_path.name
    if suffix == '.csv':
        with file_path.open('r', encoding='utf-8', errors='replace', newline='') as fh:
            reader = csv.DictReader(fh)
            rows = [dict(row) for row in reader]
            columns = list(reader.fieldnames or [])
        file_type = 'csv'
    elif suffix == '.json':
        payload = json.loads(file_path.read_text(encoding='utf-8', errors='replace'))
        if isinstance(payload, list):
            rows = [item for item in payload if isinstance(item, dict)]
        elif isinstance(payload, dict):
            candidate_lists = [value for value in payload.values() if isinstance(value, list) and value and all(isinstance(item, dict) for item in value)]
            rows = candidate_lists[0] if candidate_lists else [payload]
        else:
            return None
        columns = sorted({key for row in rows if isinstance(row, dict) for key in row.keys()})
        file_type = 'json'
    else:
        return None
    def is_number(value: Any) -> bool:
        if value is None:
            return False
        text_value = safe_text(value).replace(' ', '').replace(',', '.')
        if not text_value:
            return False
        try:
            float(text_value)
            return True
        except ValueError:
            return False
    normalized_rows = []
    for row in rows[:2000]:
        normalized = {}
        for key in columns:
            value = row.get(key) if isinstance(row, dict) else None
            normalized[key] = float(str(value).replace(' ', '').replace(',', '.')) if is_number(value) else safe_text(value)
        normalized_rows.append(normalized)
    numeric_columns = [col for col in columns if any(isinstance(row.get(col), float) for row in normalized_rows)]
    categorical_columns = [col for col in columns if col not in numeric_columns]
    dataset = {
        'rows': normalized_rows,
        'columns': columns,
        'numeric_columns': numeric_columns,
        'categorical_columns': categorical_columns,
    }
    source_meta = {
        'source': 'user_attachment',
        'label': original_name,
        'original_name': original_name,
        'file_type': file_type,
        'relative_path': relative_path,
    }
    return dataset, source_meta


