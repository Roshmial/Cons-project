def build_collection_task_slug(contract: dict[str, Any]) -> str:
    subject = safe_text(contract.get('subject') or 'collection').lower()
    slug = re.sub(r'[^a-z0-9а-яё]+', '-', subject, flags=re.IGNORECASE).strip('-')
    return slug[:48] or 'collection'


