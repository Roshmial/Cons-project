def should_compact_chat_history(messages: list[dict[str, str]]) -> bool:
    if len(messages) >= CHAT_CONTEXT_SUMMARY_TRIGGER_MESSAGES:
        return True
    total_chars = sum(len(safe_text(item.get("content"))) for item in messages)
    return total_chars > CHAT_CONTEXT_CHAR_BUDGET


def build_chat_history_summary_messages(messages: list[dict[str, str]], task_description: str) -> list[dict[str, str]]:
    summary_prompt = (
        "Сожми предыдущую часть пользовательского чата для последующего продолжения разговора. "
        "Верни только 5 блоков: 1) цель пользователя, 2) подтверждённые факты, 3) уже принятые решения, 4) открытые вопросы, 5) незавершённые действия. "
        "Не придумывай факты и явно помечай неопределённость."
    )
    return [
        {"role": "system", "content": summary_prompt},
        {"role": "user", "content": json.dumps({"task": task_description, "messages": messages}, ensure_ascii=False)},
