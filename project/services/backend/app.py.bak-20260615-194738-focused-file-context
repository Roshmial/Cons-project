@app.get(f"{API_PREFIX}/admin/health")
def admin_health() -> Response:
    require_admin()
    with db_connect() as conn:
        users_count = conn.execute("SELECT COUNT(*) AS c FROM users").fetchone()["c"]
        threads_count = conn.execute("SELECT COUNT(*) AS c FROM threads").fetchone()["c"]
        messages_count = conn.execute("SELECT COUNT(*) AS c FROM messages").fetchone()["c"]
        feedback_count = conn.execute("SELECT COUNT(*) AS c FROM feedback").fetchone()["c"]
        job_runs_count = conn.execute("SELECT COUNT(*) AS c FROM job_runs").fetchone()["c"]
        jobs_count = conn.execute("SELECT COUNT(*) AS c FROM jobs").fetchone()["c"]
        active_users_7d = conn.execute(
            """
            SELECT COUNT(DISTINCT t.user_id) AS c
            FROM messages m
            JOIN threads t ON t.id = m.thread_id
            WHERE CAST(m.created_at AS TIMESTAMP) >= CAST(? AS TIMESTAMP)
            """,
            (now_iso(now_utc() - timedelta(days=7)),),
        ).fetchone()["c"]
        failed_job_runs_7d = conn.execute(
            "SELECT COUNT(*) AS c FROM job_runs WHERE status = 'error' AND CAST(started_at AS TIMESTAMP) >= CAST(? AS TIMESTAMP)",
            (now_iso(now_utc() - timedelta(days=7)),),
        ).fetchone()["c"]
        usage_rows = conn.execute("SELECT meta_json FROM messages WHERE meta_json IS NOT NULL AND meta_json != ''").fetchall()
    prompt_tokens = 0
    completion_tokens = 0
    total_tokens = 0
    for row in usage_rows:
        meta = json_loads(row["meta_json"], {})
        usage = meta.get("usage") if isinstance(meta, dict) else None
        if not isinstance(usage, dict):
            continue
        prompt_tokens += int(usage.get("prompt_tokens") or 0)
        completion_tokens += int(usage.get("completion_tokens") or 0)
        total_tokens += int(usage.get("total_tokens") or 0)
    return jsonify(
        {
            "status": "ok",
            "mode": APP_MODE,
            "scheduler_enabled": SCHEDULER_ENABLED,
            "scheduler_poll_seconds": SCHEDULER_POLL_SECONDS,
            "hermes_downstream": {"base_url": HERMES_API_BASE_URL, "configured": bool(HERMES_API_KEY), "model": HERMES_API_MODEL},
            "users": users_count,
            "threads": threads_count,
            "messages": messages_count,
            "prompt_tokens": prompt_tokens,
            "completion_tokens": completion_tokens,
            "total_tokens": total_tokens,
            "feedback": feedback_count,
            "jobs": jobs_count,
            "job_runs": job_runs_count,
            "active_users_7d": active_users_7d,
            "failed_job_runs_7d": failed_job_runs_7d,
            "session_ttl_hours": SESSION_TTL_HOURS,
            "db_path": str(DB_PATH),
        }
    )


def build_admin_overview_timeseries(conn: sqlite3.Connection, granularity: str) -> dict[str, Any]:
    normalized = granularity if granularity in {"day", "week", "month"} else "day"
    now = now_utc()
    if normalized == "day":
        bucket_count = 14
        current_start = now.replace(hour=0, minute=0, second=0, microsecond=0)
    elif normalized == "week":
        bucket_count = 12
        current_start = (now - timedelta(days=now.weekday())).replace(hour=0, minute=0, second=0, microsecond=0)
    else:
        bucket_count = 12
        current_start = now.replace(day=1, hour=0, minute=0, second=0, microsecond=0)

    bucket_starts: list[datetime] = []
    cursor = current_start
    for _ in range(bucket_count):
        bucket_starts.append(cursor)
        if normalized == "month":
            year = cursor.year + (1 if cursor.month == 12 else 0)
            month = 1 if cursor.month == 12 else cursor.month + 1
            cursor = cursor.replace(year=year, month=month, day=1)
        elif normalized == "week":
            cursor = cursor + timedelta(weeks=1)
        else:
            cursor = cursor + timedelta(days=1)

    if normalized == "day":
        bucket_starts = [current_start - timedelta(days=offset) for offset in range(bucket_count - 1, -1, -1)]
    elif normalized == "week":
        bucket_starts = [current_start - timedelta(weeks=offset) for offset in range(bucket_count - 1, -1, -1)]
    else:
        month_cursor = current_start
        bucket_starts = []
        for offset in range(bucket_count - 1, -1, -1):
            year = month_cursor.year
            month = month_cursor.month - offset
            while month <= 0:
                year -= 1
                month += 12
            bucket_starts.append(month_cursor.replace(year=year, month=month, day=1))
        bucket_starts.sort()

    range_start = bucket_starts[0]
    params = (range_start.isoformat(),)

    def fetch_counts(table: str, timestamp_col: str, where_clause: str = "1=1") -> dict[str, int]:
        rows = conn.execute(
            f"""
            SELECT CAST(date_trunc('{normalized}', CAST({timestamp_col} AS TIMESTAMP)) AS TIMESTAMP) AS bucket_start,
                   COUNT(*) AS count_value
            FROM {table}
            WHERE {timestamp_col} IS NOT NULL
              AND CAST({timestamp_col} AS TIMESTAMP) >= CAST(? AS TIMESTAMP)
              AND {where_clause}
            GROUP BY 1
            ORDER BY 1 ASC
            """,
            params,
        ).fetchall()
        counts: dict[str, int] = {}
        for row in rows:
            bucket_value = row["bucket_start"]
            if bucket_value is None:
                continue
            if isinstance(bucket_value, datetime):
                bucket_key = bucket_value.replace(tzinfo=UTC).isoformat()
            else:
                bucket_key = str(bucket_value)
            counts[bucket_key] = int(row["count_value"] or 0)
        return counts

    series_maps = {
        "users": fetch_counts("users", "created_at"),
        "threads": fetch_counts("threads", "created_at"),
        "messages": fetch_counts("messages", "created_at"),
        "job_runs": fetch_counts("job_runs", "started_at"),
        "job_errors": fetch_counts("job_runs", "started_at", "status = 'error'"),
    }

    buckets: list[dict[str, Any]] = []
    for bucket_start in bucket_starts:
        bucket_key = bucket_start.isoformat()
        if normalized == "week":
            bucket_label = f"{bucket_start.strftime('%d.%m')}–{(bucket_start + timedelta(days=6)).strftime('%d.%m')}"
        elif normalized == "month":
            bucket_label = bucket_start.strftime('%m.%Y')
        else:
            bucket_label = bucket_start.strftime('%d.%m')
        item = {"bucket_start": bucket_key, "bucket_label": bucket_label}
        for metric_key, metric_counts in series_maps.items():
            item[metric_key] = int(metric_counts.get(bucket_key, 0))
        buckets.append(item)
    return {"granularity": normalized, "buckets": buckets}


@app.get(f"{API_PREFIX}/admin/overview-timeseries")
def admin_overview_timeseries() -> Response:
    require_admin()
    granularity = str(request.args.get("granularity") or "day").strip()
    with db_connect() as conn:
        payload = build_admin_overview_timeseries(conn, granularity)
