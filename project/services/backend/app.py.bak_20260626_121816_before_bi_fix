def normalize_web_source_url(value: str) -> str:
    raw = safe_text(value).strip()
    if not raw:
        return ''
    if raw.startswith(('http://', 'https://')):
        return raw
    if raw.startswith('www.') or '.' in raw:
        return 'https://' + raw.lstrip('/')
    return raw


def extract_html_meta_description(decoded: str) -> str:
    if not decoded:
        return ''
    beautifulsoup_class = load_beautifulsoup_class()
    if beautifulsoup_class is None:
        patterns = [
            r'<meta[^>]+name=["\']description["\'][^>]+content=["\'](.*?)["\']',
            r'<meta[^>]+property=["\']og:description["\'][^>]+content=["\'](.*?)["\']',
            r'<meta[^>]+content=["\'](.*?)["\'][^>]+name=["\']description["\']',
            r'<meta[^>]+content=["\'](.*?)["\'][^>]+property=["\']og:description["\']',
        ]
        for pattern in patterns:
            match = re.search(pattern, decoded, flags=re.IGNORECASE | re.DOTALL)
            if match:
                value = re.sub(r'\s+', ' ', html.unescape(match.group(1))).strip()
                if value:
                    return value[:1000]
        return ''
    soup = beautifulsoup_class(decoded, 'lxml')
    for attrs in ({'name': 'description'}, {'property': 'og:description'}):
        node = soup.find('meta', attrs=attrs)
        if node:
            value = safe_text(node.get('content')).strip()
            if value:
                return re.sub(r'\s+', ' ', value)[:1000]
    return ''


def html_to_visible_text(payload: bytes, content_type: str) -> tuple[str, str, str]:
    decoded = payload.decode('utf-8', errors='replace')
    if 'html' not in safe_text(content_type).lower() and '<html' not in decoded.lower():
        cleaned = re.sub(r'\s+', ' ', decoded).strip()
        return '', cleaned[:12000], ''
    meta_description = extract_html_meta_description(decoded)
    beautifulsoup_class = load_beautifulsoup_class()
    if beautifulsoup_class is None:
        title_match = re.search(r'<title[^>]*>(.*?)</title>', decoded, flags=re.IGNORECASE | re.DOTALL)
        title = html.unescape(title_match.group(1)).strip() if title_match else ''
        text = re.sub(r'<(script|style)[^>]*>[\s\S]*?</\1>', ' ', decoded, flags=re.IGNORECASE)
        text = re.sub(r'<[^>]+>', ' ', text)
        text = re.sub(r'\s+', ' ', html.unescape(text)).strip()
        return title[:300], text[:12000], meta_description
    soup = beautifulsoup_class(decoded, 'lxml')
    for node in soup(['script', 'style', 'noscript']):
        node.decompose()
    title = safe_text(soup.title.string if soup.title and soup.title.string else '').strip()
    text = soup.get_text('\n', strip=True)
    text = re.sub(r'\n{3,}', '\n\n', text)
    text = re.sub(r'[ \t]{2,}', ' ', text)
    return title[:300], text[:12000], meta_description


def fetch_web_source_document(source: str) -> dict[str, Any]:
    target_url = normalize_web_source_url(source)
    if not target_url:
        raise ApiError('web_collection_source_missing', 409)
    request = urllib.request.Request(
        target_url,
        headers={
            'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) HermesWebCollection/1.0',
            'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,text/plain;q=0.8,*/*;q=0.5',
        },
        method='GET',
    )
    with urllib.request.urlopen(request, timeout=40) as response:
        content_type = safe_text(response.headers.get('Content-Type') or '')
        final_url = safe_text(getattr(response, 'url', target_url) or target_url)
        body = response.read(1024 * 1024)
    title, text, meta_description = html_to_visible_text(body, content_type)
    return {
        'requested_url': source,
        'final_url': final_url,
        'title': title,
        'content_type': content_type,
        'text': text,
        'meta_description': meta_description,
    }


