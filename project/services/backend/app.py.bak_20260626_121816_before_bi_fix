def extract_usage_cost_usd(usage_payload: Any) -> float | None:
    if isinstance(usage_payload, dict):
        for key in ("cost", "cost_usd", "total_cost", "estimated_cost"):
            value = usage_payload.get(key)
            if isinstance(value, (int, float)):
                return float(value)
            if isinstance(value, str):
                try:
                    return float(value)
                except ValueError:
                    continue
    return None


def extract_usage_token_counts(usage_payload: Any) -> dict[str, int]:
    if not isinstance(usage_payload, dict):
        return {}

    def pick_int(*keys: str) -> int | None:
        for key in keys:
            value = usage_payload.get(key)
            if isinstance(value, bool):
                continue
            if isinstance(value, int):
                return int(value)
            if isinstance(value, float):
                return int(value)
            if isinstance(value, str):
                raw = value.strip()
                if raw.isdigit():
                    return int(raw)
        return None

    prompt_tokens = pick_int('prompt_tokens', 'input_tokens')
    completion_tokens = pick_int('completion_tokens', 'output_tokens')
    total_tokens = pick_int('total_tokens')
    if total_tokens is None and (prompt_tokens is not None or completion_tokens is not None):
        total_tokens = int(prompt_tokens or 0) + int(completion_tokens or 0)
    payload: dict[str, int] = {}
    if prompt_tokens is not None:
        payload['prompt_tokens'] = int(prompt_tokens)
    if completion_tokens is not None:
        payload['completion_tokens'] = int(completion_tokens)
    if total_tokens is not None:
        payload['total_tokens'] = int(total_tokens)
    return payload


def estimate_text_token_count(text: str) -> int:
    raw = safe_text(text)
    if not raw:
        return 0
    normalized = re.sub(r'\s+', ' ', raw).strip()
    if not normalized:
        return 0
    char_estimate = math.ceil(len(normalized) / 4)
    piece_estimate = len(re.findall(r"\w+|[^\w\s]", normalized, flags=re.UNICODE))
    return max(1, min(max(char_estimate, piece_estimate // 2), max(char_estimate, piece_estimate)))


def attach_assistant_token_accounting(meta: dict[str, Any], text: str) -> dict[str, Any]:
    payload = dict(meta or {})
    usage_tokens = extract_usage_token_counts(payload.get('usage'))
    accounting = {
        'response_text_tokens_estimated': estimate_text_token_count(text),
        'response_text_tokens_estimator': 'char_div4_with_piece_floor',
        'llm_usage_exact': bool(usage_tokens),
    }
    if usage_tokens:
        accounting.update(usage_tokens)
    payload['token_accounting'] = accounting
    return payload


def parse_model_candidates(raw_value: str, primary_model: str) -> list[str]:
    items = [safe_text(item).strip() for item in safe_text(raw_value).split(",")]
    ordered: list[str] = []
    for item in [primary_model, *items]:
        if item and item not in ordered:
            ordered.append(item)
    return ordered


HERMES_STANDARD_MODEL_CANDIDATES = parse_model_candidates(HERMES_STANDARD_MODEL_CANDIDATES_RAW, HERMES_API_MODEL)
HERMES_REASONING_MODEL_CANDIDATES = parse_model_candidates(HERMES_REASONING_MODEL_CANDIDATES_RAW, HERMES_REASONING_MODEL)


def resolve_model_attempt_chain(model_name: str) -> list[str]:
    effective_model = safe_text(model_name).strip()
    if not effective_model:
        return [HERMES_API_MODEL]
    candidate_pool = HERMES_REASONING_MODEL_CANDIDATES if effective_model == HERMES_REASONING_MODEL else HERMES_STANDARD_MODEL_CANDIDATES
    if effective_model not in candidate_pool:
        return [effective_model]
    start_index = candidate_pool.index(effective_model)
    return candidate_pool[start_index:]


def is_runtime_error_detail(detail: str) -> bool:
    lowered = safe_text(detail).lower()
    runtime_markers = (
        "runtime error",
        '"error_type":"runtime_error"',
        '"type":"runtime_error"',
        "provider returned error",
    )
    return any(marker in lowered for marker in runtime_markers)


def is_timeout_like_exception(exc: BaseException) -> bool:
    if isinstance(exc, (TimeoutError, socket.timeout)):
        return True
    if isinstance(exc, urllib.error.URLError):
        reason = getattr(exc, 'reason', None)
        if isinstance(reason, (TimeoutError, socket.timeout)):
            return True
        if 'timed out' in safe_text(reason).lower():
            return True
    return 'timed out' in safe_text(exc).lower()


def call_hermes_messages_timeout(*, requested_model: str, attempt_index: int, attempt_count: int, retry_index: int = 0) -> int:
    if requested_model == HERMES_REASONING_MODEL:
        return HERMES_REASONING_TIMEOUT
    if retry_index > 0:
        return HERMES_API_RETRY_TIMEOUT
    return HERMES_API_TIMEOUT


def call_hermes_messages(messages: list[dict[str, str]], *, model_name: str | None = None) -> tuple[str, dict[str, Any]]:
    effective_model = safe_text(model_name or HERMES_API_MODEL) or HERMES_API_MODEL
    if APP_MODE != "hermes-api":
        prompt = messages[-1]["content"] if messages else ""
        return build_mock_reply(prompt), {"mode": APP_MODE, "downstream": "mock-hermes", "hermes_model": effective_model}
    if not HERMES_API_KEY:
        raise ApiError("hermes_api_key_missing", 500)
    attempt_models = resolve_model_attempt_chain(effective_model)
    attempt_errors: list[dict[str, Any]] = []
    last_http_error: urllib.error.HTTPError | None = None
    for attempt_index, attempt_model in enumerate(attempt_models):
        retry_budget = HERMES_API_TIMEOUT_RETRY_ATTEMPTS if effective_model != HERMES_REASONING_MODEL else 0
        for retry_index in range(retry_budget + 1):
            payload = {"model": attempt_model, "stream": False, "messages": messages}
            body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
            req = urllib.request.Request(
                f"{HERMES_API_BASE_URL}/chat/completions",
                data=body,
                method="POST",
                headers={"Content-Type": "application/json", "Authorization": f"Bearer {HERMES_API_KEY}"},
            )
            request_timeout = call_hermes_messages_timeout(
                requested_model=effective_model,
                attempt_index=attempt_index,
                attempt_count=len(attempt_models),
                retry_index=retry_index,
            )
            try:
                with urllib.request.urlopen(req, timeout=request_timeout) as resp:
                    response_payload = json.loads(resp.read().decode("utf-8"))
                reply_text = extract_assistant_text(response_payload)
                cleaned_text, meta = enrich_assistant_meta({
                    "mode": APP_MODE,
                    "downstream": "hermes-api-server",
                    "hermes_model": response_payload.get("model", attempt_model),
                    "usage": response_payload.get("usage", {}),
                    "model_attempts": [*attempt_errors, {"model": attempt_model, "status": "success", "timeout_seconds": request_timeout, "retry_index": retry_index}],
                    "fallback_used": attempt_index > 0,
                    "requested_model": effective_model,
                }, reply_text)
                return cleaned_text, meta
            except urllib.error.HTTPError as exc:
                detail = exc.read().decode("utf-8", errors="replace")
                should_retry = retry_index == 0 and attempt_index == 0 and len(attempt_models) > 1 and is_runtime_error_detail(detail)
                attempt_errors.append({
                    "model": attempt_model,
                    "status": "runtime_error_retry" if should_retry else "http_error",
                    "code": exc.code,
                    "detail": detail[:300],
                    "timeout_seconds": request_timeout,
                    "retry_index": retry_index,
                })
                last_http_error = exc
                if should_retry:
                    break
                raise ApiError(f"hermes_api_http_error: {exc.code}: {detail[:300]}", 502)
            except urllib.error.URLError as exc:
                if is_timeout_like_exception(exc):
                    should_retry_same_model = retry_index < retry_budget
                    should_retry_next_model = attempt_index < len(attempt_models) - 1
                    attempt_errors.append({
                        "model": attempt_model,
                        "status": "timeout_retry_same_model" if should_retry_same_model else ("timeout_retry" if should_retry_next_model else "timeout_final_error"),
                        "detail": safe_text(exc.reason or exc)[:300],
                        "timeout_seconds": request_timeout,
                        "retry_index": retry_index,
                    })
                    if should_retry_same_model:
                        continue
                    if should_retry_next_model:
                        break
                raise ApiError(f"hermes_api_unreachable: {exc.reason}", 502)
            except (TimeoutError, socket.timeout) as exc:
                should_retry_same_model = retry_index < retry_budget
                should_retry_next_model = attempt_index < len(attempt_models) - 1
                attempt_errors.append({
                    "model": attempt_model,
                    "status": "timeout_retry_same_model" if should_retry_same_model else ("timeout_retry" if should_retry_next_model else "timeout_final_error"),
                    "detail": safe_text(exc)[:300],
                    "timeout_seconds": request_timeout,
                    "retry_index": retry_index,
                })
                if should_retry_same_model:
                    continue
                if should_retry_next_model:
                    break
                raise ApiError(f"hermes_api_unreachable: {safe_text(exc) or 'timed out'}", 502)
    if last_http_error is not None and attempt_errors:
        last_error = attempt_errors[-1]
        raise ApiError(f"hermes_api_http_error: {last_error.get('code', 502)}: {safe_text(last_error.get('detail'))[:300]}", 502)
    raise ApiError("hermes_api_unknown_error", 502)


def build_reasoning_summary_messages(messages: list[dict[str, str]], task_description: str) -> list[dict[str, str]]:
    summary_prompt = (
        "Сожми диалог и материалы для дальнейшего глубокого reasoning-анализа. "
