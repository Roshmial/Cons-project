def build_generic_dataset_dashboard_payload(dataset: dict[str, Any], source_meta: dict[str, Any], request_text: str = '') -> dict[str, Any]:
    business_payload = build_business_dataset_dashboard_payload(dataset, source_meta, request_text)
    if business_payload is not None:
        return business_payload
    rows = dataset.get("rows") or []
    columns = dataset.get("columns") or []
    numeric_columns = dataset.get("numeric_columns") or []
    categorical_columns = dataset.get("categorical_columns") or []
    row_count = len(rows)
    top_numeric = numeric_columns[0] if numeric_columns else None
    top_categorical = categorical_columns[0] if categorical_columns else None
    summary = [
        f"В файле {source_meta.get('label') or source_meta.get('original_name') or 'dataset'} найдено {row_count} строк и {len(columns)} колонок.",
        f"Числовые колонки: {', '.join(numeric_columns[:5]) if numeric_columns else 'не обнаружены'}.",
        f"Категориальные колонки: {', '.join(categorical_columns[:5]) if categorical_columns else 'не обнаружены'}.",
    ]
    summary_cards = [
        {"label": "Строк", "value": str(row_count), "note": source_meta.get('file_type', 'dataset')},
        {"label": "Колонок", "value": str(len(columns)), "note": source_meta.get('original_name') or 'источник пользователя'},
        {"label": "Числовых", "value": str(len(numeric_columns)), "note": top_numeric or '—'},
        {"label": "Категориальных", "value": str(len(categorical_columns)), "note": top_categorical or '—'},
    ]
    sections = []
    if columns:
        sections.append({
            "kind": "bar_list",
            "title": "Колонки файла",
            "items": [
                {"label": name, "value": 1, "ratio": 1.0, "meta": "numeric" if name in numeric_columns else "categorical" if name in categorical_columns else "mixed"}
                for name in columns[:12]
            ],
        })
    if top_numeric:
        numeric_values = [float(row[top_numeric]) for row in rows if isinstance(row, dict) and row.get(top_numeric) is not None]
        if numeric_values:
            min_v = min(numeric_values)
            max_v = max(numeric_values)
            avg_v = round(sum(numeric_values) / len(numeric_values), 2)
            sections.append({
                "kind": "bar_list",
                "title": f"Профиль числовой колонки: {top_numeric}",
                "items": [
                    {"label": "Минимум", "value": round(min_v, 2), "ratio": 1.0 if max_v == 0 else round((min_v / max_v) if max_v else 0, 3), "meta": top_numeric},
                    {"label": "Среднее", "value": avg_v, "ratio": 1.0 if max_v == 0 else round((avg_v / max_v) if max_v else 0, 3), "meta": top_numeric},
                    {"label": "Максимум", "value": round(max_v, 2), "ratio": 1.0, "meta": top_numeric},
                ],
            })
    if top_categorical:
        counts = Counter(str(row.get(top_categorical) or "∅") for row in rows if isinstance(row, dict))
        total = max(sum(counts.values()), 1)
        sections.append({
            "kind": "bar_list",
            "title": f"Топ значений: {top_categorical}",
            "items": [
                {"label": label[:60], "value": value, "ratio": round(value / total, 3), "meta": f"{round(value / total * 100)}% строк"}
                for label, value in counts.most_common(8)
            ],
        })
    preview_columns = columns[:6]
    preview_rows = []
    for row in rows[:5]:
        if not isinstance(row, dict):
            continue
        preview_rows.append({
            "title": " · ".join(f"{col}: {safe_text(row.get(col))[:32]}" for col in preview_columns if safe_text(row.get(col))),
            "subtitle": source_meta.get('original_name') or source_meta.get('label') or 'dataset',
            "meta": f"Колонок в строке: {len([col for col in preview_columns if safe_text(row.get(col))])}",
        })
    if preview_rows:
        sections.append({"kind": "post_list", "title": "Примеры строк", "items": preview_rows})
    return {
        "reply_text": "\n".join(summary),
        "dashboard": {
            "kind": "generic_dataset_analytics",
            "title": f"Дашборд по файлу: {source_meta.get('label') or source_meta.get('original_name') or 'dataset'}",
            "subtitle": f"Источник: пользовательский файл · тип: {source_meta.get('file_type', 'dataset')}",
            "summary_cards": summary_cards,
            "sections": sections,
        },
    }


def load_dashboard_dataset_from_attachment(attachment: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any]] | None:
    relative_path = safe_text(attachment.get('relative_path'))
    if not relative_path:
        return None
    file_path = (DATA_DIR / relative_path).resolve()
    if not file_path.exists() or not file_path.is_file():
        return None
    suffix = file_path.suffix.lower()
    original_name = safe_text(attachment.get('original_name')) or file_path.name
    if suffix == '.csv':
        with file_path.open('r', encoding='utf-8', errors='replace', newline='') as fh:
            reader = csv.DictReader(fh)
            rows = [dict(row) for row in reader]
            columns = list(reader.fieldnames or [])
        file_type = 'csv'
    elif suffix == '.xlsx':
        with zipfile.ZipFile(file_path, 'r') as archive:
            shared_strings: list[str] = []
            if 'xl/sharedStrings.xml' in archive.namelist():
                shared_root = ET.fromstring(archive.read('xl/sharedStrings.xml'))
                for si in shared_root.findall('.//{*}si'):
                    text = ''.join(node.text or '' for node in si.findall('.//{*}t'))
                    shared_strings.append(text)
            workbook_root = ET.fromstring(archive.read('xl/workbook.xml'))
            sheets = workbook_root.findall('.//{*}sheet')
            if not sheets:
                return None
            first_sheet_id = sheets[0].attrib.get('{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id')
            rels_root = ET.fromstring(archive.read('xl/_rels/workbook.xml.rels'))
            target = None
            for rel in rels_root.findall('.//{*}Relationship'):
                if rel.attrib.get('Id') == first_sheet_id:
                    target = rel.attrib.get('Target')
                    break
            if not target:
                return None
            sheet_path = 'xl/' + target.lstrip('/') if not target.startswith('xl/') else target
            sheet_root = ET.fromstring(archive.read(sheet_path))
            parsed_rows: list[list[str]] = []
            for row_node in sheet_root.findall('.//{*}sheetData/{*}row'):
                cell_map: dict[int, str] = {}
                for cell in row_node.findall('{*}c'):
                    ref = cell.attrib.get('r', '')
                    letters = ''.join(ch for ch in ref if ch.isalpha())
                    col_index = 0
                    for ch in letters:
                        col_index = col_index * 26 + (ord(ch.upper()) - 64)
                    col_index = max(col_index - 1, 0)
                    cell_type = cell.attrib.get('t')
                    raw_value = ''
                    value_node = cell.find('{*}v')
                    inline_node = cell.find('{*}is')
                    if cell_type == 's' and value_node is not None and value_node.text and value_node.text.isdigit():
                        idx = int(value_node.text)
                        raw_value = shared_strings[idx] if 0 <= idx < len(shared_strings) else ''
                    elif inline_node is not None:
                        raw_value = ''.join(node.text or '' for node in inline_node.findall('.//{*}t'))
                    elif value_node is not None and value_node.text is not None:
                        raw_value = value_node.text
                    cell_map[col_index] = raw_value
                if cell_map:
                    width = max(cell_map.keys()) + 1
                    parsed_rows.append([cell_map.get(index, '') for index in range(width)])
            if not parsed_rows:
                return None
            columns = [safe_text(value).strip() or f'col_{idx+1}' for idx, value in enumerate(parsed_rows[0])]
            rows = []
            for raw_row in parsed_rows[1:]:
                row_dict = {}
                for idx, column in enumerate(columns):
                    row_dict[column] = raw_row[idx] if idx < len(raw_row) else ''
                rows.append(row_dict)
        file_type = 'xlsx'
    elif suffix == '.json':
        payload = json.loads(file_path.read_text(encoding='utf-8', errors='replace'))
        if isinstance(payload, list):
            rows = [item for item in payload if isinstance(item, dict)]
        elif isinstance(payload, dict):
            candidate_lists = [value for value in payload.values() if isinstance(value, list) and value and all(isinstance(item, dict) for item in value)]
            rows = candidate_lists[0] if candidate_lists else [payload]
        else:
            return None
        columns = sorted({key for row in rows if isinstance(row, dict) for key in row.keys()})
        file_type = 'json'
    else:
        return None
    def is_number(value: Any) -> bool:
        if value is None:
            return False
        text_value = safe_text(value).replace(' ', '').replace(',', '.')
        if not text_value:
            return False
        try:
            float(text_value)
            return True
        except ValueError:
            return False
    normalized_rows = []
    for row in rows[:2000]:
        normalized = {}
        for key in columns:
            value = row.get(key) if isinstance(row, dict) else None
            normalized[key] = float(str(value).replace(' ', '').replace(',', '.')) if is_number(value) else safe_text(value)
        normalized_rows.append(normalized)
    numeric_columns = [col for col in columns if any(isinstance(row.get(col), float) for row in normalized_rows)]
    categorical_columns = [col for col in columns if col not in numeric_columns]
    dataset = {
        'rows': normalized_rows,
        'columns': columns,
        'numeric_columns': numeric_columns,
        'categorical_columns': categorical_columns,
    }
    source_meta = {
        'source': 'user_attachment',
        'label': original_name,
        'original_name': original_name,
        'file_type': file_type,
        'relative_path': relative_path,
    }
    return dataset, source_meta


