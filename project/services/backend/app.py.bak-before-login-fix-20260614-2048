def strip_media_tokens(text: str) -> str:
    cleaned_lines: list[str] = []
    for line in str(text or '').splitlines():
        if line.strip().startswith('MEDIA:'):
            continue
        cleaned_lines.append(line)
    return '\n'.join(cleaned_lines).strip()


def parse_media_paths(text: str) -> list[str]:
    paths: list[str] = []
    for line in str(text or '').splitlines():
        stripped = line.strip()
        if not stripped.startswith('MEDIA:'):
            continue
        candidate = stripped[len('MEDIA:'):].strip()
        if candidate and candidate not in paths:
            paths.append(candidate)
    return paths


def ensure_allowed_media_path(path_value: str) -> Path | None:
    raw = safe_text(path_value)
    if not raw or not raw.startswith('/'):
        return None
    resolved = Path(raw).expanduser().resolve()
    allowed_roots = [Path('/home/hermes').resolve(), Path('/tmp').resolve()]
    if not any(root == resolved or root in resolved.parents for root in allowed_roots):
        return None
    if not resolved.exists() or not resolved.is_file():
        return None
    return resolved


def build_assistant_media_attachments(text: str) -> list[dict[str, Any]]:
    attachments: list[dict[str, Any]] = []
    for path_value in parse_media_paths(text):
        resolved = ensure_allowed_media_path(path_value)
        if not resolved:
            continue
        attachments.append({
            'original_name': resolved.name,
            'mime_type': guess_mime_type(resolved.name),
            'size_bytes': resolved.stat().st_size,
            'local_path': str(resolved),
            'assistant_generated': True,
            'text_extracted': False,
            'extraction_note': 'Файл подготовлен агентом.',
            'preview_excerpt': '',
        })
    return attachments


def enrich_assistant_meta(meta: dict[str, Any], text: str, *, message_id: int | None = None) -> tuple[str, dict[str, Any]]:
    cleaned_text = strip_media_tokens(text)
    parsed_attachments = build_assistant_media_attachments(text)
    payload = dict(meta or {})
    existing = payload.get('attachments') if isinstance(payload.get('attachments'), list) else []
    attachments = existing or parsed_attachments
    if attachments:
        payload['attachments'] = [
            {
                **item,
                **({'download_url': f"{API_PREFIX}/messages/{message_id}/attachments/{index}"} if message_id is not None else {}),
            }
            for index, item in enumerate(attachments)
        ]
    return cleaned_text, payload


def assistant_profile_dataset_map() -> dict[str, str]:
    return {
        "tone": REFERENCE_DATASET_ASSISTANT_TONES,
        "answer_depth": REFERENCE_DATASET_ASSISTANT_ANSWER_DEPTHS,
        "interaction_mode": REFERENCE_DATASET_ASSISTANT_INTERACTION_MODES,
    }


def reference_label_map(conn: sqlite3.Connection, dataset_key: str) -> dict[str, str]:
    return {
        item["item_key"]: safe_text(item.get("label") or item["item_key"])
        for item in [serialize_reference_item(row) for row in reference_items_for_dataset(conn, dataset_key, include_inactive=False)]
    }


def active_reference_keys(conn: sqlite3.Connection, dataset_key: str) -> set[str]:
    return set(reference_label_map(conn, dataset_key).keys())


def normalize_assistant_profile(profile: dict[str, Any], style: str, option_sets: dict[str, set[str]] | None = None) -> dict[str, str]:
    fallback = default_assistant_profile(style)
    normalized = {
        "tone": safe_text(profile.get("tone") or fallback["tone"]),
        "answer_depth": safe_text(profile.get("answer_depth") or fallback["answer_depth"]),
        "interaction_mode": safe_text(profile.get("interaction_mode") or fallback["interaction_mode"]),
        "about_user": safe_text(profile.get("about_user") or fallback["about_user"]),
    }
    if option_sets:
        for field, allowed in option_sets.items():
            if allowed and normalized[field] not in allowed:
                normalized[field] = fallback[field] if fallback[field] in allowed else sorted(allowed)[0]
    return normalized


def validate_assistant_profile(conn: sqlite3.Connection, profile: dict[str, Any], style: str) -> dict[str, str]:
    option_sets = {
        field: active_reference_keys(conn, dataset_key)
        for field, dataset_key in assistant_profile_dataset_map().items()
    }
    normalized = normalize_assistant_profile(profile, style, option_sets)
    for field, allowed in option_sets.items():
        requested = safe_text(profile.get(field) or "")
        if requested and allowed and requested not in allowed:
            raise ApiError(f"assistant_profile_invalid_{field}", 400)
    return normalized


def assistant_profile_from_row(row: sqlite3.Row, conn: sqlite3.Connection | None = None) -> dict[str, str]:
    profile = json_loads(row["assistant_profile_json"], default_assistant_profile(row["style"]))
    option_sets = None
    if conn is not None:
        option_sets = {
            field: active_reference_keys(conn, dataset_key)
            for field, dataset_key in assistant_profile_dataset_map().items()
        }
    return normalize_assistant_profile(profile, row["style"], option_sets)


def humanize_tone(value: str, labels: dict[str, str] | None = None) -> str:
    mapping = labels or {
        "neutral": "нейтрально",
        "friendly": "дружелюбно",
        "business": "делово",
        "mentor": "как умный коллега",
    }
    return mapping.get(value, value or "не задано")


def humanize_depth(value: str, labels: dict[str, str] | None = None) -> str:
    mapping = labels or {
        "short": "кратко",
        "balanced": "сбалансированно",
        "detailed": "подробно",
    }
    return mapping.get(value, value or "не задано")


def humanize_mode(value: str, labels: dict[str, str] | None = None) -> str:
    mapping = labels or {
        "answer_directly": "сразу по сути",
        "clarify_when_needed": "уточнять при неясности",
