def normalize_days_of_week(values: list[str] | None) -> list[str]:
    items = []
    for item in values or []:
        lowered = safe_text(item).lower()
        if lowered in WEEKDAY_NAMES and lowered not in items:
            items.append(lowered)
    return items


def build_schedule_summary(job: dict[str, Any]) -> str:
    kind = job["schedule_kind"]
    time_of_day = job["time_of_day"]
    timezone_name = job["timezone"]
    if kind == "daily":
        return f"Каждый день в {time_of_day} ({timezone_name})"
    if kind == "weekdays":
        return f"По будням в {time_of_day} ({timezone_name})"
    if kind == "weekly":
        days = ", ".join(job["days_of_week"] or ["mon"])
        return f"Еженедельно: {days} в {time_of_day} ({timezone_name})"
    if kind == "monthly":
        anchor_day = parse_date(job["start_date"]).day if parse_date(job["start_date"]) else 1
        return f"Ежемесячно {anchor_day}-го числа в {time_of_day} ({timezone_name})"
    return f"Запуск в {time_of_day} ({timezone_name})"


def combine_local(date_value: date, time_of_day: str, timezone_name: str) -> datetime:
    tz = ZoneInfo(normalize_timezone(timezone_name))
    hh, mm = normalize_time_of_day(time_of_day).split(":")
    return datetime.combine(date_value, dt_time(hour=int(hh), minute=int(mm)), tzinfo=tz)


def compute_next_run(job: dict[str, Any], from_dt: datetime | None = None) -> str | None:
    if job.get("status") == "paused":
        return None
    kind = safe_text(job.get("schedule_kind") or "daily")
    tz_name = normalize_timezone(job.get("timezone") or "UTC")
    from_point = (from_dt or now_utc()).astimezone(ZoneInfo(tz_name))
    start = parse_date(job.get("start_date")) or from_point.date()
    days = normalize_days_of_week(job.get("days_of_week"))
    monthly_day = start.day
    for offset in range(0, 400):
        candidate_date = from_point.date() + timedelta(days=offset)
        if candidate_date < start:
            continue
        weekday = WEEKDAY_NAMES[candidate_date.weekday()]
        allowed = False
        if kind == "daily":
            allowed = True
        elif kind == "weekdays":
            allowed = candidate_date.weekday() < 5
        elif kind == "weekly":
            allowed = weekday in (days or ["mon"])
        elif kind == "monthly":
            next_day = min(monthly_day, last_day_of_month(candidate_date.year, candidate_date.month))
            allowed = candidate_date.day == next_day
        else:
            allowed = True
        if not allowed:
            continue
        candidate_dt = combine_local(candidate_date, job.get("time_of_day") or "09:00", tz_name)
        if candidate_dt <= from_point + timedelta(seconds=5):
            continue
        return now_iso(candidate_dt.astimezone(UTC))
    return None


def preview_next_runs(job: dict[str, Any], count: int = 3) -> list[str]:
    result: list[str] = []
    cursor = now_utc()
    for _ in range(count):
        next_run = compute_next_run(job, cursor)
        if not next_run:
            break
        result.append(next_run)
        cursor = parse_iso(next_run) + timedelta(minutes=1)
    return result


def last_day_of_month(year: int, month: int) -> int:
    if month == 12:
        next_month = date(year + 1, 1, 1)
    else:
        next_month = date(year, month + 1, 1)
    return (next_month - timedelta(days=1)).day


def get_job_by_id(conn: sqlite3.Connection, job_id: int) -> sqlite3.Row:
    row = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
    if not row:
        raise ApiError("job_not_found", 404)
    return row


def get_job_role(conn: sqlite3.Connection, job_row: sqlite3.Row, auth: AuthUser) -> str | None:
    if auth.role == "admin":
        return "admin"
    if job_row["user_id"] == auth.id:
        return "owner"
    acl = conn.execute("SELECT role FROM job_acl WHERE job_id = ? AND user_id = ?", (job_row["id"], auth.id)).fetchone()
    if acl:
        return acl["role"]
    sub = conn.execute("SELECT 1 FROM job_subscriptions WHERE job_id = ? AND user_id = ?", (job_row["id"], auth.id)).fetchone()
    if sub:
        return "subscriber"
    if job_row["visibility"] == "workspace":
        return "viewer"
    return None


def ensure_can_view_job(conn: sqlite3.Connection, job_row: sqlite3.Row, auth: AuthUser) -> str:
    role = get_job_role(conn, job_row, auth)
    if role:
        return role
    raise JobPermissionError("job_forbidden", 403)


