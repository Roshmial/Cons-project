        'Готово. Собрала материалы и подготовила composition-артефакт по явному запросу на КП / оценку.\n\n'
        f"Режим: {composition_mode}.\n"
        f"Источников / документов обработано: {len(documents)}.\n"
        f"Файл проекта: {proposal_attachment['original_name']}."
    )
    meta = {
        'message_kind': 'collection_composition_result',
        'downstream': f'{base_downstream}:proposal',
        'collection_contract': contract,
        'attachments': [proposal_attachment, *attachments],
        'composition_payload_preview': {
            'title': safe_text(payload.get('title')),
            'executive_summary': safe_text(payload.get('executive_summary'))[:500],
            'confirmed_facts': (payload.get('confirmed_facts') or [])[:5],
            'analogs': (payload.get('analogs') or [])[:5],
            'hypotheses': (payload.get('hypotheses') or [])[:5],
        },
    }
    return reply_text, meta


def build_attachment_collection_documents(attachments: list[dict[str, Any]]) -> list[dict[str, Any]]:
    documents: list[dict[str, Any]] = []
    for item in attachments:
        extracted_text = safe_text(item.get('extracted_text') or item.get('preview_text'))
        if not extracted_text:
            continue
        source_name = safe_text(item.get('original_name') or item.get('stored_name') or 'attachment')
        documents.append({
            'requested_url': source_name,
            'final_url': source_name,
            'title': source_name,
            'text': extracted_text,
        })
    return documents


