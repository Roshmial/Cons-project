def flatten_message_export_lines(message_row: sqlite3.Row, thread_title: str) -> list[str]:
    meta = json_loads(message_row["meta_json"], {})
    lines = [
        f"Чат: {thread_title or 'Без названия'}",
        f"Сообщение: #{message_row['id']}",
        f"Дата: {safe_text(message_row['created_at']) or '—'}",
        "",
        safe_text(message_row["content"]) or "Пустой ответ",
    ]
    dashboard = meta.get("dashboard") if isinstance(meta, dict) else None
    if isinstance(dashboard, dict):
        dashboard_title = safe_text(dashboard.get("title") or dashboard.get("kind") or "")
        summary_cards = dashboard.get("summary_cards") if isinstance(dashboard.get("summary_cards"), list) else []
        sections = dashboard.get("sections") if isinstance(dashboard.get("sections"), list) else []
        if dashboard_title or summary_cards or sections:
            lines.extend(["", "---", "", f"Дашборд: {dashboard_title or 'Аналитика'}"])
        for card in summary_cards:
            if not isinstance(card, dict):
                continue
            label = safe_text(card.get("label") or "Показатель")
            value = safe_text(card.get("value") or "—")
            note = safe_text(card.get("note") or "")
            lines.append(f"- {label}: {value}" + (f" ({note})" if note else ""))
        for section in sections:
            if not isinstance(section, dict):
                continue
            section_title = safe_text(section.get("title") or section.get("kind") or "Раздел")
            lines.extend(["", section_title])
            items = section.get("items") if isinstance(section.get("items"), list) else []
            if not items:
                lines.append("- Нет данных")
                continue
            for item in items:
                if isinstance(item, dict):
                    label = safe_text(item.get("label") or item.get("title") or item.get("name") or item.get("value") or "Пункт")
                    value = safe_text(item.get("value") or item.get("note") or item.get("meta") or "")
                    lines.append(f"- {label}" + (f": {value}" if value else ""))
                else:
                    lines.append(f"- {safe_text(item) or 'Пункт'}")
    return lines


def build_message_export_text(message_row: sqlite3.Row, thread_title: str) -> str:
    return "\n".join(flatten_message_export_lines(message_row, thread_title)).strip() + "\n"


def build_message_export_markdown(message_row: sqlite3.Row, thread_title: str) -> str:
    lines = flatten_message_export_lines(message_row, thread_title)
    title = safe_text(thread_title) or "Без названия"
    parts = [
        f"# {title}",
        "",
        f"- Сообщение: #{message_row['id']}",
        f"- Дата: {safe_text(message_row['created_at']) or '—'}",
        "",
    ]
    body_started = False
    for line in lines[4:]:
        text = safe_text(line)
        if not text:
            parts.append("")
            continue
        if text == "---":
            parts.extend(["", "## Дашборд", ""])
            continue
        if not body_started:
            parts.append(text)
            body_started = True
            continue
        if text.startswith("- "):
            parts.append(text)
            continue
        parts.extend(["", f"### {text}"])
    return "\n".join(parts).strip() + "\n"


def build_message_export_html(message_row: sqlite3.Row, thread_title: str) -> str:
    title = safe_text(thread_title) or "Без названия"
    lines = flatten_message_export_lines(message_row, thread_title)
    body_chunks: list[str] = []
    for line in lines[4:]:
        text = safe_text(line)
        if not text:
            continue
        if text == "---":
            body_chunks.append("<hr />")
            continue
        if text.startswith("- "):
            body_chunks.append(f"<li>{html.escape(text[2:])}</li>")
            continue
        body_chunks.append(f"<p>{html.escape(text)}</p>")
    body_html = "\n".join(body_chunks)
    return (
        "<!doctype html>\n"
        "<html lang=\"ru\">\n"
        "<head>\n"
        "  <meta charset=\"utf-8\" />\n"
        f"  <title>{html.escape(title)}</title>\n"
        "  <style>body{font-family:Arial,sans-serif;max-width:960px;margin:32px auto;padding:0 16px;line-height:1.5;color:#1f2937}"
        "h1{margin-bottom:8px} .meta{color:#6b7280;margin-bottom:20px} ul{padding-left:20px} hr{margin:20px 0}</style>\n"
        "</head>\n"
        "<body>\n"
        f"  <h1>{html.escape(title)}</h1>\n"
        f"  <div class=\"meta\">Сообщение #{int(message_row['id'])} · {html.escape(safe_text(message_row['created_at']) or '—')}</div>\n"
        f"  {body_html}\n"
        "</body>\n"
        "</html>\n"
    )


def build_message_export_payload(message_row: sqlite3.Row, thread_title: str) -> dict[str, Any]:
    meta = json_loads(message_row["meta_json"], {})
    return {
        "thread_title": safe_text(thread_title) or "Без названия",
        "message_id": int(message_row["id"]),
        "created_at": safe_text(message_row["created_at"]) or "",
        "content": safe_text(message_row["content"]) or "",
        "meta": meta if isinstance(meta, dict) else {},
        "text_lines": flatten_message_export_lines(message_row, thread_title),
    }


def build_message_export_json(message_row: sqlite3.Row, thread_title: str) -> str:
    return json.dumps(build_message_export_payload(message_row, thread_title), ensure_ascii=False, indent=2) + "\n"


def build_message_export_csv(message_row: sqlite3.Row, thread_title: str) -> str:
    payload = build_message_export_payload(message_row, thread_title)
    buffer = io.StringIO()
    writer = csv.writer(buffer)
    writer.writerow(["thread_title", "message_id", "created_at", "line_no", "line"])
    for index, line in enumerate(payload["text_lines"], start=1):
        writer.writerow([payload["thread_title"], payload["message_id"], payload["created_at"], index, line])
