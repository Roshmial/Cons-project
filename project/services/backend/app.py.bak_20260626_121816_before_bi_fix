def regex_matches_any(text: str, patterns: tuple[str, ...]) -> bool:
    raw_text = safe_text(text)
    return bool(raw_text) and any(re.search(pattern, raw_text, flags=re.IGNORECASE) for pattern in patterns)


def latest_user_message_text(message_rows: list[sqlite3.Row]) -> str:
