                "user_cost_usd": user_stats["user_cost_usd"],
                "user_remaining_requests": user_stats["user_requests_remaining"],
            },
        }
    finally:
        if owns_conn:
            active_conn.close()


def route_task(task_description: str, user_id: int, usage_stats: dict[str, Any], request_policy: dict[str, Any] | None = None) -> dict[str, Any]:
    policy = request_policy if isinstance(request_policy, dict) else {}
    analysis_mode = safe_text(policy.get("analysis_mode") or "").lower()
    model_preference = normalize_chat_model_preference(policy.get("model_preference"))
    explicit_reasoning = analysis_mode == "deep" or text_matches_any(task_description, LLM_REASONING_EXPLICIT_PATTERNS)
    explicit_standard = analysis_mode == "standard"
    architecture_reasoning = text_matches_any(task_description, LLM_REASONING_ARCHITECTURE_PATTERNS)
    multi_doc_reasoning = text_matches_any(task_description, LLM_REASONING_DOCUMENT_PATTERNS)
    high_stakes_reasoning = text_matches_any(task_description, LLM_REASONING_HIGH_STAKES_PATTERNS)
    reasoning_candidate = explicit_reasoning or architecture_reasoning or multi_doc_reasoning or high_stakes_reasoning
    route_reason = "default"
    if explicit_reasoning:
        route_reason = "explicit_reasoning"
    elif architecture_reasoning:
        route_reason = "architecture_or_tradeoff"
    elif multi_doc_reasoning:
        route_reason = "multi_document_analysis"
    elif high_stakes_reasoning:
        route_reason = "high_stakes_decision"
    if model_preference == CHAT_MODEL_OWL_ALPHA:
        return {"model": HERMES_API_MODEL, "route_mode": "manual_standard", "route_reason": "manual_owl_alpha", "limit_reason": None, "model_preference": model_preference}
    if model_preference == CHAT_MODEL_DEEPSEEK_R1:
        limit_reason = reasoning_limit_block_reason(usage_stats)
        if limit_reason:
            return {"model": HERMES_API_MODEL, "route_mode": "fallback", "route_reason": "manual_deepseek_r1", "limit_reason": limit_reason, "model_preference": model_preference}
        return {"model": HERMES_REASONING_MODEL, "route_mode": "reasoning", "route_reason": "manual_deepseek_r1", "limit_reason": None, "model_preference": model_preference}
    if explicit_standard:
        return {"model": HERMES_API_MODEL, "route_mode": "manual_standard", "route_reason": "manual_standard", "limit_reason": None, "model_preference": model_preference}
    if not HERMES_REASONING_ROUTING_ENABLED:
        return {"model": HERMES_API_MODEL, "route_mode": "default", "route_reason": "routing_disabled", "limit_reason": None, "model_preference": model_preference}
    if HERMES_REASONING_MANUAL_ONLY and not explicit_reasoning:
        return {"model": HERMES_API_MODEL, "route_mode": "default", "route_reason": "manual_only", "limit_reason": None, "model_preference": model_preference}
    if not reasoning_candidate:
        return {"model": HERMES_API_MODEL, "route_mode": "default", "route_reason": "default", "limit_reason": None, "model_preference": model_preference}
    limit_reason = reasoning_limit_block_reason(usage_stats)
    if limit_reason:
        return {"model": HERMES_API_MODEL, "route_mode": "fallback", "route_reason": route_reason, "limit_reason": limit_reason, "model_preference": model_preference}
    return {"model": HERMES_REASONING_MODEL, "route_mode": "reasoning", "route_reason": route_reason, "limit_reason": None, "model_preference": model_preference}


