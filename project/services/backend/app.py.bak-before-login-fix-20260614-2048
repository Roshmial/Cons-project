def now_utc() -> datetime:
    return datetime.now(UTC)


def now_iso(value: datetime | None = None) -> str:
    current = value or now_utc()
    return current.astimezone(UTC).replace(microsecond=0).isoformat()


def parse_iso(value: str | None) -> datetime | None:
    if not value:
        return None
    normalized = value.replace("Z", "+00:00")
    try:
        dt = datetime.fromisoformat(normalized)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=UTC)
    return dt.astimezone(UTC)


def session_expires_at(last_seen_at: str | None) -> datetime | None:
    seen_at = parse_iso(last_seen_at)
    if not seen_at:
        return None
    return seen_at + SESSION_TTL


def should_touch_session(last_seen_at: str | None, *, now: datetime | None = None) -> bool:
    seen_at = parse_iso(last_seen_at)
    if not seen_at:
        return True
    current = now or now_utc()
    return (current - seen_at).total_seconds() >= SESSION_TOUCH_INTERVAL_SECONDS


def parse_date(value: str | None) -> date | None:
    if not value:
        return None
    try:
        return date.fromisoformat(value)
    except ValueError:
        return None


def normalize_time_of_day(value: str | None, fallback: str = "09:00") -> str:
    raw = (value or fallback).strip()
    parts = raw.split(":")
    if len(parts) != 2:
        return fallback
    try:
        hours = int(parts[0])
        minutes = int(parts[1])
    except ValueError:
        return fallback
    if not (0 <= hours <= 23 and 0 <= minutes <= 59):
        return fallback
    return f"{hours:02d}:{minutes:02d}"


def normalize_timezone(value: str | None, fallback: str = "UTC") -> str:
    candidate = (value or fallback).strip() or fallback
    try:
        ZoneInfo(candidate)
        return candidate
    except Exception:
        return fallback


def json_loads(value: str | None, fallback: Any) -> Any:
    if not value:
        return fallback
    try:
        return json.loads(value)
    except json.JSONDecodeError:
        return fallback


class DBRow(dict):
    def __getitem__(self, key):
        if isinstance(key, int):
            return list(self.values())[key]
        return super().__getitem__(key)


class DBCursor:
    def __init__(self, result: duckdb.DuckDBPyConnection | None = None, lastrowid: int | None = None):
        self._result = result
        self.lastrowid = lastrowid

    def _columns(self) -> list[str]:
        if self._result is None or not getattr(self._result, 'description', None):
            return []
        return [item[0] for item in self._result.description]

    def fetchone(self):
        if self._result is None:
            return None
        row = self._result.fetchone()
        if row is None:
            return None
        columns = self._columns()
        if columns:
            return DBRow(zip(columns, row))
        return row

    def fetchall(self):
        if self._result is None:
            return []
        rows = self._result.fetchall()
        columns = self._columns()
        if columns:
            return [DBRow(zip(columns, row)) for row in rows]
        return rows


class DBConnection:
    def __init__(self, path: Path):
        self._conn = duckdb.connect(str(path))
        self._conn.execute(f"CREATE SCHEMA IF NOT EXISTS {APP_DB_SCHEMA}")
        self._conn.execute(f"SET schema='{APP_DB_SCHEMA}'")

    def execute(self, query: str, params: tuple[Any, ...] | list[Any] | None = None) -> DBCursor:
        result = self._conn.execute(query, params or [])
        return DBCursor(result=result)

    def executemany(self, query: str, rows: list[tuple[Any, ...]]) -> None:
        if rows:
            self._conn.executemany(query, rows)

    def executescript(self, script: str) -> None:
        self._conn.execute(script)

    def commit(self) -> None:
        self._conn.commit()

    def rollback(self) -> None:
        self._conn.rollback()

    def close(self) -> None:
        self._conn.close()

    def __enter__(self):
        return self

    def __exit__(self, exc_type, exc, tb):
        try:
            if exc_type is None:
                self.commit()
            else:
                try:
                    self.rollback()
                except duckdb.TransactionException:
                    pass
        finally:
            self.close()


def db_connect() -> DBConnection:
    return DBConnection(DB_PATH)


def get_columns(conn: DBConnection, table: str) -> set[str]:
    rows = conn.execute(
        """
        SELECT column_name AS name
        FROM information_schema.columns
        WHERE table_schema = current_schema() AND table_name = ?
        """,
        (table,),
    ).fetchall()
    return {row["name"] for row in rows}


def ensure_column(conn: DBConnection, table: str, name: str, definition: str) -> None:
    if name not in get_columns(conn, table):
        try:
            conn.execute(f"ALTER TABLE {table} ADD COLUMN {name} {definition}")
        except Exception as error:
            message = str(error)
            if "Adding columns with constraints not yet supported" not in message:
                raise
            relaxed = definition.replace(" NOT NULL", "")
            conn.execute(f"ALTER TABLE {table} ADD COLUMN {name} {relaxed}")
            if "DEFAULT 1" in definition:
                conn.execute(f"UPDATE {table} SET {name} = 1 WHERE {name} IS NULL")
            if "DEFAULT 0" in definition:
                conn.execute(f"UPDATE {table} SET {name} = 0 WHERE {name} IS NULL")


def _legacy_sqlite_sequence_start(table: str) -> int:
    if not LEGACY_SQLITE_PATH.exists():
        return 1
    src = sqlite3.connect(LEGACY_SQLITE_PATH)
    try:
        row = src.execute(
            "SELECT name FROM sqlite_master WHERE type='table' AND name = ?",
            (table,),
        ).fetchone()
        if not row:
            return 1
        max_id = src.execute(f"SELECT COALESCE(MAX(id), 0) FROM {table}").fetchone()[0] or 0
        return int(max_id) + 1
    finally:
        src.close()


def migrate_legacy_sqlite_if_needed(conn: DBConnection) -> None:
    if conn.execute("SELECT COUNT(*) AS c FROM users").fetchone()["c"]:
        return
    if not LEGACY_SQLITE_PATH.exists():
        return

    src = sqlite3.connect(LEGACY_SQLITE_PATH)
    src.row_factory = sqlite3.Row
    try:
        for table, columns in APP_TABLE_COLUMNS.items():
            exists = src.execute(
                "SELECT name FROM sqlite_master WHERE type='table' AND name = ?",
                (table,),
            ).fetchone()
            if not exists:
                continue
            legacy_columns = {
                row[1]
                for row in src.execute(f"PRAGMA table_info({table})").fetchall()
            }
            selected_columns = [column for column in columns if column in legacy_columns]
            if not selected_columns:
                continue
            rows = src.execute(f"SELECT {', '.join(selected_columns)} FROM {table}").fetchall()
            if not rows:
                continue
            placeholders = ', '.join(['?'] * len(columns))
            insert_sql = f"INSERT INTO {table} ({', '.join(columns)}) VALUES ({placeholders})"
            prepared_rows = []
            for row in rows:
                payload: list[Any] = []
                for column in columns:
                    if column in selected_columns:
                        payload.append(row[column])
                    elif column == "version":
                        payload.append(1)
                    elif column == "assistant_profile_json":
                        payload.append(json.dumps(default_assistant_profile(""), ensure_ascii=False))
                    elif column == "display_name":
                        payload.append("")
                    elif column == "self_subscribe_enabled":
                        payload.append(0)
                    elif column == "self_subscribe_scope":
                        payload.append("disabled")
                    elif column == "onboarding_completed":
                        payload.append(0)
                    else:
                        payload.append(None)
                prepared_rows.append(tuple(payload))
            conn.executemany(insert_sql, prepared_rows)
    finally:
        src.close()


