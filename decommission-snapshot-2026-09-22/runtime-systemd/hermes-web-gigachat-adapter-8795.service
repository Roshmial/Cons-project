[Unit]
Description=Hermes Web GigaChat adapter 8795
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/hermes/workspace/hermes-web-mvp-react-8793
ExecStart=/usr/bin/bash /home/hermes/workspace/hermes-web-mvp-react-8793/run_gigachat_adapter_service.sh
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
