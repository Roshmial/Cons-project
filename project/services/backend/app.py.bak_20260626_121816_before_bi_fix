        values = [parse_numeric_like(row.get(col)) for row in rows if isinstance(row, dict)]
        values = [value for value in values if value is not None]
        if values:
            normalized = [value * 100 if value <= 1.0 else value for value in values]
            avg = sum(normalized) / len(normalized)
            summary_cards.append(build_explanatory_summary_card('Покрытие контролей', format_metric_value(avg, as_percent=True), 'Показывает, какая доля проверяемых требований или активов реально закрыта контролями'))
            conclusions.append(f'Среднее покрытие контролей — {format_metric_value(avg, as_percent=True)}.')
    if risk_like:
        col = risk_like[0]
        values = [parse_numeric_like(row.get(col)) for row in rows if isinstance(row, dict)]
