    return (
        f"{base} Функциональный фокус: {function_spec['label']}. "
        f"Для этой функции особое внимание уделяй темам: {function_spec['focus']}. "
        f"Типовые metric groups: {metric_groups or 'primary_metric, key_segments, period_trend'}. "
        f"Предпочтительные секции: {preferred_sections or 'bar_list, timeline_list, text_list'}. "
        f"Функциональная инструкция: {agent_instruction}"
    )


def build_global_dashboard_prompt(text: str, source_meta: dict[str, Any], policy: dict[str, Any]) -> str:
