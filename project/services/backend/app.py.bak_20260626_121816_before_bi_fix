    sort_order = int(payload.get("sort_order") or 0)
    is_active, deleted_at, _ = resolve_reference_item_status(payload, default_status="active")
    extra_payload = {key: value for key, value in payload.items() if key not in {"item_key", "label", "sort_order", "is_active", "status", "deleted_at"}}
    ts = now_iso()
    with db_connect() as conn:
        exists = conn.execute(
            "SELECT id FROM reference_items WHERE scope = ? AND dataset_key = ? AND item_key = ?",
            (REFERENCE_SCOPE_GLOBAL, dataset_key, item_key),
        ).fetchone()
        if exists:
            raise ApiError("reference_item_exists", 409)
        conn.execute(
            """
            INSERT INTO reference_items (scope, dataset_key, item_key, label, payload_json, sort_order, is_active, deleted_at, version, created_at, updated_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, 1, ?, ?)
