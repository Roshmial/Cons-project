def build_hermes_messages(message_rows: list[sqlite3.Row], profile: dict[str, Any], thread_title: str, request_policy: dict[str, Any] | None = None) -> list[dict[str, str]]:
    messages = [{"role": "system", "content": build_hermes_system_prompt(profile, thread_title, request_policy)}]
    for row in message_rows:
        role = row["role"]
        if role in {"user", "assistant", "system"}:
            messages.append({"role": role, "content": row["content"]})
    return messages


def extract_assistant_text(payload: dict[str, Any]) -> str:
    choices = payload.get("choices") or []
    if not choices:
        raise ApiError("hermes_empty_response", 502)
    message = (choices[0] or {}).get("message") or {}
    content = message.get("content", "")
    if isinstance(content, str):
        return content.strip()
    if isinstance(content, list):
        parts: list[str] = []
        for item in content:
            if isinstance(item, dict) and item.get("type") in {"text", "output_text"}:
                parts.append(item.get("text", ""))
        return "\n".join(part for part in parts if part).strip()
    return str(content).strip()


