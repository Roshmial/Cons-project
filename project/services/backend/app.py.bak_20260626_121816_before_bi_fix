def build_it_analytics_dataset_insights(rows: list[dict[str, Any]], numeric_columns: list[str], roles: dict[str, str | None]) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[str]]:
    summary_cards: list[dict[str, Any]] = []
    sections: list[dict[str, Any]] = []
    conclusions: list[str] = []
    incident_like = infer_dynamic_numeric_columns(rows, numeric_columns, ('incident', 'outage', 'alert', 'error'))
    uptime_like = infer_dynamic_numeric_columns(rows, numeric_columns, ('uptime', 'availability'))
    latency_like = infer_dynamic_numeric_columns(rows, numeric_columns, ('latency', 'response', 'duration'))
    mttr_like = infer_dynamic_numeric_columns(rows, numeric_columns, ('mttr', 'restore', 'recovery'))
    date_col = roles.get('date')

    if incident_like:
        col = incident_like[0]
        values = [parse_numeric_like(row.get(col)) for row in rows if isinstance(row, dict)]
        values = [value for value in values if value is not None]
        if values:
            total = sum(values)
            avg = total / max(len(values), 1)
            summary_cards.append(build_explanatory_summary_card('Инциденты', format_metric_value(total), f'Сумма по полю {col}; в среднем {format_metric_value(avg)} на период/строку с числом'))
            conclusions.append(f'Основной объём инцидентов считывается из поля {col}: суммарно {format_metric_value(total)}.')
            if date_col:
                by_period: dict[str, float] = defaultdict(float)
                for row in rows:
                    if not isinstance(row, dict):
                        continue
                    bucket = month_bucket_from_value(row.get(date_col))
                    amount = parse_numeric_like(row.get(col))
                    if amount is not None:
                        by_period[bucket] += amount
                if by_period:
                    sections.append({'kind': 'timeline_list', 'title': 'Динамика инцидентов по периодам', 'note': 'Показывает, растёт ли нагрузка инцидентов или остаётся стабильной.', 'items': [{'label': bucket, 'value': round(value, 2), 'meta': 'Чем выше значение, тем больше объём инцидентов в периоде'} for bucket, value in sorted(by_period.items())[:12]]})
    if uptime_like:
        col = uptime_like[0]
        values = [parse_numeric_like(row.get(col)) for row in rows if isinstance(row, dict)]
        values = [value for value in values if value is not None]
        if values:
            normalized = [value * 100 if value <= 1.0 else value for value in values]
            avg = sum(normalized) / len(normalized)
            summary_cards.append(build_explanatory_summary_card('Средняя доступность', format_metric_value(avg, as_percent=True), 'Показывает, какую долю времени сервисы были доступны пользователю'))
            conclusions.append(f'Средняя доступность по доступным строкам — {format_metric_value(avg, as_percent=True)}.')
    if latency_like:
        col = latency_like[0]
        values = [parse_numeric_like(row.get(col)) for row in rows if isinstance(row, dict)]
        values = [value for value in values if value is not None]
        if values:
            avg = sum(values) / len(values)
            ordered_values = sorted(values)
            p95_index = min(max(math.ceil(len(ordered_values) * 0.95) - 1, 0), len(ordered_values) - 1)
            p95_like = ordered_values[p95_index]
            summary_cards.append(build_explanatory_summary_card('Типичная задержка', format_metric_value(avg), f'Среднее по полю {col}; верхний хвост около {format_metric_value(p95_like)}'))
            sections.append({'kind': 'bar_list', 'title': 'Профиль производительности', 'note': 'Помогает отличить нормальную среднюю скорость от редких тяжёлых просадок.', 'items': [{'label': 'Среднее', 'value': round(avg, 2), 'ratio': 0 if p95_like == 0 else round(avg / p95_like, 3), 'meta': 'Типичная задержка'}, {'label': 'Почти максимум', 'value': round(p95_like, 2), 'ratio': 1.0, 'meta': 'Приближение к p95 без сложной статистики'}]})
            conclusions.append(f'Задержка в среднем составляет {format_metric_value(avg)}, при этом тяжёлые случаи доходят примерно до {format_metric_value(p95_like)}.')
    if mttr_like:
        col = mttr_like[0]
        values = [parse_numeric_like(row.get(col)) for row in rows if isinstance(row, dict)]
        values = [value for value in values if value is not None]
        if values:
            avg = sum(values) / len(values)
            summary_cards.append(build_explanatory_summary_card('MTTR', format_metric_value(avg), 'Среднее время восстановления: чем меньше, тем быстрее команда возвращает сервис в норму'))
            conclusions.append(f'MTTR по доступным наблюдениям — {format_metric_value(avg)}.')
    return summary_cards, sections, conclusions


def build_security_dataset_insights(rows: list[dict[str, Any]], numeric_columns: list[str], roles: dict[str, str | None]) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[str]]:
    summary_cards: list[dict[str, Any]] = []
