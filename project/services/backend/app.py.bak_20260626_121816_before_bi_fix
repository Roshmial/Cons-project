def seed_app_settings(conn: sqlite3.Connection) -> None:
    existing = conn.execute("SELECT value_json FROM app_settings WHERE setting_key = ?", ("chat_notice",)).fetchone()
    legacy_default = {
        "enabled": True,
        "text": "Внимание! Работа ведется с использованием внешней LLM-модели. Не загружайте и не обсуждайте конфиденциальную информацию.",
    }
    if not existing:
        set_app_setting_json(conn, "chat_notice", default_chat_notice_settings())
    else:
        current = json_loads(existing[0], default_chat_notice_settings())
        if current == legacy_default:
            set_app_setting_json(conn, "chat_notice", default_chat_notice_settings())
    policy = get_app_setting_json(conn, DASHBOARD_POLICY_SETTING_KEY, default_dashboard_policy_settings())
    set_app_setting_json(conn, DASHBOARD_POLICY_SETTING_KEY, normalize_dashboard_policy(policy))


def seed_reference_data(conn: sqlite3.Connection) -> None:
    ts = now_iso()
    for dataset_key, meta in DEFAULT_REFERENCE_DATA.items():
        existing_catalog = conn.execute(
            "SELECT id FROM reference_catalogs WHERE scope = ? AND dataset_key = ?",
            (REFERENCE_SCOPE_GLOBAL, dataset_key),
        ).fetchone()
        if existing_catalog:
            continue
        conn.execute(
            "INSERT INTO reference_catalogs (scope, dataset_key, label, description, is_system, created_at, updated_at) VALUES (?, ?, ?, ?, 1, ?, ?)",
            (REFERENCE_SCOPE_GLOBAL, dataset_key, safe_text(meta.get("label") or dataset_key), safe_text(meta.get("description") or ""), ts, ts),
        )
        seed_items = default_data_source_definitions() if dataset_key == REFERENCE_DATASET_DATA_SOURCES else (meta.get("items") or [])
        for index, item in enumerate(seed_items):
            payload = {key: value for key, value in item.items() if key not in {"item_key", "label"}}
            conn.execute(
                """
                INSERT INTO reference_items (scope, dataset_key, item_key, label, payload_json, sort_order, is_active, deleted_at, created_at, updated_at)
                VALUES (?, ?, ?, ?, ?, ?, 1, NULL, ?, ?)
                """,
                (
                    REFERENCE_SCOPE_GLOBAL,
                    dataset_key,
                    safe_text(item.get("item_key") or f"{dataset_key}_{index + 1}"),
                    safe_text(item.get("label") or item.get("item_key") or f"{dataset_key}_{index + 1}"),
                    json.dumps(payload, ensure_ascii=False),
                    index,
                    ts,
                    ts,
                ),
            )


def build_data_source_inventory() -> list[dict[str, Any]]:
    inventory = []
    hermes_configured = bool(HERMES_API_BASE_URL and HERMES_API_KEY)
    discovered_targets = discover_connector_targets()
    for index, item in enumerate(default_data_source_definitions()):
        item_key = safe_text(item.get("item_key"))
        available = True
        availability_reason = "built_in"
        payload: dict[str, Any] = {
            **item,
            "sort_order": index,
        }
        if item_key == "web_research" and not hermes_configured:
            available = False
            availability_reason = "hermes_api_not_configured"
        elif item_key in {"internal_connector", "external_connector"}:
            child_connectors = discovered_targets.get(item_key, [])
            available = any(bool(child.get("available")) for child in child_connectors)
            availability_reason = "connectors_detected" if available else "no_available_connectors"
            payload["child_connectors"] = child_connectors
        payload["available"] = available
        payload["availability_reason"] = availability_reason
        inventory.append(payload)
    return inventory


def sync_data_source_registry(conn: sqlite3.Connection, actor_user_id: int | None = None) -> dict[str, Any]:
    ts = now_iso()
    inventory = build_data_source_inventory()
    created = 0
    updated = 0
    active_keys = {safe_text(item.get("item_key")) for item in inventory if safe_text(item.get("item_key"))}
    for index, item in enumerate(inventory):
        item_key = safe_text(item.get("item_key"))
        label = safe_text(item.get("label") or item_key)
        payload = {key: value for key, value in item.items() if key not in {"item_key", "label", "sort_order"}}
        existing = conn.execute(
            "SELECT id, label, payload_json, sort_order, is_active, deleted_at, version FROM reference_items WHERE scope = ? AND dataset_key = ? AND item_key = ?",
            (REFERENCE_SCOPE_GLOBAL, REFERENCE_DATASET_DATA_SOURCES, item_key),
        ).fetchone()
        if not existing:
            conn.execute(
                """
                INSERT INTO reference_items (scope, dataset_key, item_key, label, payload_json, sort_order, is_active, deleted_at, version, created_at, updated_at)
                VALUES (?, ?, ?, ?, ?, ?, 1, NULL, 1, ?, ?)
                """,
                (REFERENCE_SCOPE_GLOBAL, REFERENCE_DATASET_DATA_SOURCES, item_key, label, json.dumps(payload, ensure_ascii=False), index, ts, ts),
            )
            created += 1
            if actor_user_id is not None:
                write_reference_item_change_log(conn, REFERENCE_DATASET_DATA_SOURCES, item_key, actor_user_id, "sync_create")
            continue
        current_payload = json_loads(existing["payload_json"], {})
        next_payload = {**current_payload, **payload}
        label_changed = safe_text(existing["label"]) != label
        sort_changed = int(existing["sort_order"] or 0) != index
        payload_changed = current_payload != next_payload
        reactivated = not bool(existing["is_active"]) or bool(existing["deleted_at"])
        if not (label_changed or sort_changed or payload_changed or reactivated):
            continue
        next_version = int(existing["version"] or 1) + 1
        conn.execute(
            """
            UPDATE reference_items
            SET label = ?, payload_json = ?, sort_order = ?, is_active = 1, deleted_at = NULL, version = ?, updated_at = ?
            WHERE id = ?
            """,
            (label, json.dumps(next_payload, ensure_ascii=False), index, next_version, ts, existing["id"]),
        )
        updated += 1
        if actor_user_id is not None:
            write_reference_item_change_log(conn, REFERENCE_DATASET_DATA_SOURCES, item_key, actor_user_id, "sync_update")
    stale_rows = conn.execute(
        "SELECT id, item_key, version FROM reference_items WHERE scope = ? AND dataset_key = ? AND is_active = 1 AND deleted_at IS NULL",
        (REFERENCE_SCOPE_GLOBAL, REFERENCE_DATASET_DATA_SOURCES),
    ).fetchall()
    deactivated = 0
    for row in stale_rows:
        item_key = safe_text(row["item_key"])
        if item_key in active_keys:
            continue
        next_version = int(row["version"] or 1) + 1
        conn.execute(
            "UPDATE reference_items SET is_active = 0, version = ?, updated_at = ? WHERE id = ?",
            (next_version, ts, row["id"]),
        )
        deactivated += 1
        if actor_user_id is not None:
            write_reference_item_change_log(conn, REFERENCE_DATASET_DATA_SOURCES, item_key, actor_user_id, "sync_deactivate")
    return {
        "inventory": inventory,
        "created": created,
        "updated": updated,
        "deactivated": deactivated,
    }


def apply_connector_group_overrides_to_data_sources(data_sources: list[dict[str, Any]]) -> list[dict[str, Any]]:
    items = [dict(item) for item in data_sources]
    if not items:
        return items
    override_map: dict[str, str] = {}
    connector_index: dict[str, dict[str, Any]] = {}
    connector_origin: dict[str, str] = {}
    for item in items:
        override_map.update(normalize_connector_group_overrides(item.get("connector_group_overrides")))
        group_key = safe_text(item.get("item_key"))
        child_items = item.get("child_connectors") if isinstance(item.get("child_connectors"), list) else []
        if group_key not in {"internal_connector", "external_connector"}:
            continue
        for child in child_items:
            child_copy = dict(child)
            child_key = safe_text(child_copy.get("connector_key"))
            if not child_key:
                continue
            connector_index[child_key] = child_copy
            connector_origin[child_key] = group_key
    if not connector_index:
        return items
    grouped_children = {"internal_connector": [], "external_connector": []}
    for child_key, child in connector_index.items():
        target_group = override_map.get(child_key) or connector_origin.get(child_key) or "external_connector"
        if target_group not in grouped_children:
            target_group = connector_origin.get(child_key) or "external_connector"
        child_copy = dict(child)
        child_copy["contour_group"] = target_group
        child_copy["effective_scope"] = "local" if target_group == "internal_connector" else "global"
        grouped_children[target_group].append(child_copy)
    for item in items:
        group_key = safe_text(item.get("item_key"))
        if group_key not in grouped_children:
            continue
        next_children = grouped_children[group_key]
        item["child_connectors"] = next_children
        item["connector_group_overrides"] = dict(override_map)
        item["available"] = any(bool(child.get("available")) for child in next_children)
        item["availability_reason"] = "connectors_detected" if item["available"] else "no_available_connectors"
    return items


def reference_items_for_dataset(conn: sqlite3.Connection, dataset_key: str, include_inactive: bool = False) -> list[sqlite3.Row]:
    sql = """
        SELECT id, dataset_key, item_key, label, payload_json, sort_order, is_active, deleted_at, version, created_at, updated_at
        FROM reference_items
        WHERE scope = ? AND dataset_key = ?
    """
    params: list[Any] = [REFERENCE_SCOPE_GLOBAL, dataset_key]
    if not include_inactive:
        sql += " AND is_active = 1 AND deleted_at IS NULL"
    sql += " ORDER BY sort_order ASC, id ASC"
    return conn.execute(sql, params).fetchall()


def serialize_reference_item(row: sqlite3.Row) -> dict[str, Any]:
    payload = json_loads(row["payload_json"], {})
    keys = set(row.keys()) if hasattr(row, "keys") else set()
    deleted_at = row["deleted_at"] if "deleted_at" in keys else None
    is_active = bool(row["is_active"])
    status = "deleted" if deleted_at else ("inactive" if not is_active else "active")
    data = {
        "id": row["id"],
        "dataset_key": row["dataset_key"],
        "item_key": row["item_key"],
        "label": row["label"],
        "sort_order": row["sort_order"],
        "is_active": is_active,
        "deleted_at": deleted_at,
        "status": status,
        "version": row["version"] if "version" in row.keys() else 1,
        "created_at": row["created_at"],
        "updated_at": row["updated_at"],
    }
    if isinstance(payload, dict):
        data.update(payload)
    return data


def resolve_reference_item_status(payload: dict[str, Any], *, default_status: str = "active") -> tuple[int, str | None, str]:
    requested_status = safe_text(payload.get("status") or default_status).lower() or default_status
    if requested_status not in {"active", "inactive", "deleted"}:
        requested_status = default_status
    if "deleted_at" in payload:
        deleted_at_raw = safe_text(payload.get("deleted_at") or "")
        if deleted_at_raw:
            requested_status = "deleted"
    if "is_active" in payload and requested_status != "deleted":
        requested_status = "active" if bool(payload.get("is_active")) else "inactive"
    is_active = 1 if requested_status == "active" else 0
    deleted_at = now_iso() if requested_status == "deleted" else None
    return is_active, deleted_at, requested_status


def write_user_change_log(conn: sqlite3.Connection, user_id: int, actor_user_id: int | None, change_type: str) -> None:
