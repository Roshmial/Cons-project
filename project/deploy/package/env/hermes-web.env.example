# Hermes gateway / API Server
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_CORS_ORIGINS=http://127.0.0.1:8793
API_SERVER_KEY=[REDACTED]

# Backend
HERMES_WEB_BACKEND_HOST=127.0.0.1
HERMES_WEB_BACKEND_PORT=8791
HERMES_WEB_CORS_ALLOW_ORIGIN=http://127.0.0.1:8793,http://localhost:8793
HERMES_WEB_MODE=hermes-api
HERMES_WEB_ENABLE_DEMO_DATA=1
HERMES_WEB_BACKEND_THREADS=8
HERMES_WEB_CHAT_PROCESSOR_MAX_CONCURRENCY=4
HERMES_WEB_HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
HERMES_WEB_HERMES_API_AUTH_MODE=bearer
HERMES_WEB_HERMES_API_KEY=[REDACTED]
HERMES_WEB_HERMES_API_MODEL=hermes-agent
HERMES_WEB_COPILOTKIT_RUNTIME_BASE_URL=http://127.0.0.1:8794

# GigaChat adapter
GIGACHAT_ADAPTER_HOST=127.0.0.1
GIGACHAT_ADAPTER_PORT=8795
GIGACHAT_ADAPTER_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_ADAPTER_API_BASE_URL=https://api.giga.chat/v1
GIGACHAT_ADAPTER_SCOPE=GIGACHAT_API_B2B
GIGACHAT_ADAPTER_CREDENTIALS=[REDACTED]
GIGACHAT_ADAPTER_TIMEOUT_SECONDS=60
GIGACHAT_ADAPTER_VERIFY_SSL=1
GIGACHAT_ADAPTER_TOKEN_SKEW_SECONDS=60
GIGACHAT_ADAPTER_CA_CERT_FILE=$HOME/.hermes/certs/gigachat/russian-trusted-ca-bundle.crt

# Frontend
HERMES_WEB_FRONTEND_BACKEND_BASE=http://127.0.0.1:8791
HERMES_WEB_FRONTEND_PORT=8793
VITE_COPILOTKIT_RUNTIME_URL=/api/copilotkit

# CopilotKit runtime
COPILOTKIT_RUNTIME_PORT=8794
COPILOTKIT_RUNTIME_BASE_URL=http://127.0.0.1:8642/v1
COPILOTKIT_RUNTIME_MODEL=hermes-agent
COPILOTKIT_RUNTIME_ALLOWED_ORIGINS=http://127.0.0.1:8793,http://localhost:8793
COPILOTKIT_RUNTIME_API_KEY=[REDACTED]

# Browser smoke / acceptance
HERMES_WEB_FRONTEND_URL=http://127.0.0.1:8793/
HERMES_WEB_BACKEND_API=http://127.0.0.1:8791/api
HERMES_WEB_BROWSER_RUNTIME_ROOT=$HOME/.local/browser-runtime/root
HERMES_WEB_BROWSER_LIB_ROOT=$HOME/.hermes/browser-libs/root
HERMES_WEB_SMOKE_EMAIL=[SET_REAL_USER]
HERMES_WEB_SMOKE_PASSWORD=[SET_REAL_PASSWORD]
HERMES_WEB_SMOKE_FILE=$HOME/hermes-web-smoke-note.txt
