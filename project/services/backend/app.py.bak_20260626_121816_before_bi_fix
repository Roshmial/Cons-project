def summarize_cohort_or_retention(rows: list[dict[str, Any]], columns: list[str], retention_col: str | None) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:
    if not retention_col:
        return None, None
    values = normalize_percent_like_values(collect_numeric_values(rows, retention_col))
    if not values:
        return None, None
    avg = sum(values) / len(values)
    card = build_explanatory_summary_card('Retention', format_metric_value(avg, as_percent=True), 'Показывает, какая доля пользователей возвращается в следующем периоде или когорте')
    cohort_col = find_first_matching_column(columns, ('cohort', 'period', 'month', 'week'))
    if not cohort_col:
        return card, None
    points: list[dict[str, Any]] = []
    for row in rows[:12]:
        if not isinstance(row, dict):
            continue
        label = safe_text(row.get(cohort_col))
        value = parse_numeric_like(row.get(retention_col))
        if not label or value is None:
            continue
        normalized = value * 100 if value <= 1.0 else value
        points.append({'label': label, 'value': round(normalized, 2), 'meta': 'Retention по когорте/периоду'})
    section = {'kind': 'timeline_list', 'title': 'Retention по когортам / периодам', 'note': 'Показывает, удерживается ли ценность продукта между когортами или периодами.', 'items': points} if points else None
    return card, section


def infer_funnel_chain_columns(numeric_columns: list[str], step_markers: list[tuple[str, tuple[str, ...]]]) -> list[tuple[str, str]]:
    chain: list[tuple[str, str]] = []
    used: set[str] = set()
    for label, markers in step_markers:
        col = find_first_matching_numeric_column([c for c in numeric_columns if c not in used], markers)
        if col:
            chain.append((label, col))
            used.add(col)
    return chain


def build_funnel_section(rows: list[dict[str, Any]], funnel_chain: list[tuple[str, str]], *, title: str, note: str) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:
    if len(funnel_chain) < 2:
        return None, None
    totals: list[tuple[str, float]] = []
    for label, col in funnel_chain:
        values = collect_numeric_values(rows, col)
        if not values:
            continue
        totals.append((label, sum(values)))
    if len(totals) < 2:
        return None, None
    items = [{'label': label, 'value': round(total, 2), 'meta': f'Суммарный объём этапа ({col})'} for (label, total), (_, col) in zip(totals, funnel_chain)]
    section = {'kind': 'bar_list', 'title': title, 'note': note, 'items': items}
    first_total = totals[0][1]
    last_total = totals[-1][1]
    card = None
    if first_total > 0:
        rate = (last_total / first_total) * 100
        card = build_explanatory_summary_card('Сквозная конверсия воронки', format_metric_value(rate, as_percent=True), 'Показывает, какая доля потока доходит от первого этапа до последнего')
    return card, section


def build_inflow_outflow_cards(rows: list[dict[str, Any]], inflow_col: str | None, outflow_col: str | None, backlog_col: str | None = None) -> list[dict[str, Any]]:
    cards: list[dict[str, Any]] = []
    inflow_values = collect_numeric_values(rows, inflow_col)
    outflow_values = collect_numeric_values(rows, outflow_col)
    if inflow_values and outflow_values:
        inflow = sum(inflow_values)
        outflow = sum(outflow_values)
        delta = inflow - outflow
        cards.append(build_explanatory_summary_card('Inflow vs Outflow', format_metric_value(delta), 'Показывает, накапливается ли поток быстрее, чем система успевает его обработать'))
        if inflow > 0:
            cards.append(build_explanatory_summary_card('Flow clearance rate', format_metric_value((outflow / inflow) * 100, as_percent=True), 'Показывает, какая доля входящего потока была обработана/закрыта'))
    backlog_values = collect_numeric_values(rows, backlog_col)
    if backlog_values and inflow_values and outflow_values:
        cards.append(build_explanatory_summary_card('Pressure on backlog', format_metric_value(sum(backlog_values)), 'Читать вместе с inflow/outflow: высокий backlog при inflow > outflow означает нарастающую перегрузку'))
    return cards


def build_concentration_card(rows: list[dict[str, Any]], category_col: str | None, numeric_col: str | None, *, label: str, note: str) -> dict[str, Any] | None:
    if not category_col:
        return None
    items = aggregate_numeric_by_category(rows, category_col, numeric_col, limit=50) if numeric_col else top_category_items(rows, category_col, limit=50)
    if not items:
        return None
    total = sum(float(item.get('value') or 0) for item in items)
    if total <= 0:
        return None
    top_share = (float(items[0].get('value') or 0) / total) * 100
    return build_explanatory_summary_card(label, format_metric_value(top_share, as_percent=True), note)


def append_concentration_section(sections: list[dict[str, Any]], rows: list[dict[str, Any]], category_col: str | None, numeric_col: str | None, *, title: str, note: str, topn: int = 5) -> bool:
    if not category_col:
        return False
    items = aggregate_numeric_by_category(rows, category_col, numeric_col, limit=topn) if numeric_col else top_category_items(rows, category_col, limit=topn)
    if not items:
        return False
    total = sum(float(item.get('value') or 0) for item in items)
    if total > 0:
        items = [dict(item, meta=f"Доля {round((float(item.get('value') or 0) / total) * 100, 1)}%") for item in items]
    sections.append({'kind': 'bar_list', 'title': title, 'note': note, 'items': items})
    return True


def append_time_series_section(sections: list[dict[str, Any]], rows: list[dict[str, Any]], date_col: str | None, value_col: str | None, *, title: str, note: str, meta: str, limit: int = 12) -> bool:
    if not date_col or not value_col:
        return False
    totals: dict[str, float] = defaultdict(float)
    for row in rows:
        if not isinstance(row, dict):
            continue
        bucket = month_bucket_from_value(row.get(date_col))
        amount = parse_numeric_like(row.get(value_col))
        if amount is None:
            continue
        totals[bucket] += amount
    if not totals:
        return False
    sections.append({
        'kind': 'timeline_list',
        'title': title,
        'note': note,
        'items': [{'label': bucket, 'value': round(value, 2), 'meta': meta} for bucket, value in sorted(totals.items())[:limit]],
    })
    return True


def append_category_split_section(sections: list[dict[str, Any]], rows: list[dict[str, Any]], category_col: str | None, numeric_col: str | None, *, title: str, note: str, topn: int = 8, pie: bool = False) -> bool:
    if not category_col:
        return False
    items = aggregate_numeric_by_category(rows, category_col, numeric_col, limit=topn) if numeric_col else top_category_items(rows, category_col, limit=topn)
    if not items:
        return False
    sections.append({
        'kind': 'pie_list' if pie else 'bar_list',
        'title': title,
        'note': note,
        'items': items,
    })
    return True


def build_sales_dataset_insights(rows: list[dict[str, Any]], numeric_columns: list[str], roles: dict[str, str | None], columns: list[str]) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[str]]:
    amount_col = roles.get('amount') if roles.get('amount') in numeric_columns else find_first_matching_numeric_column(numeric_columns, ('amount', 'revenue', 'value', 'deal', 'price'))
    date_col = roles.get('date')
    manager_col = roles.get('manager') or find_first_matching_column(columns, ('manager', 'owner', 'sales'))
    stage_col = roles.get('stage') or roles.get('status')
    funnel_chain = infer_funnel_chain_columns(numeric_columns, [('Lead', ('lead', 'lead_count')), ('Qualified', ('qualified', 'mql', 'sql')), ('Won', ('won', 'closed won', 'customer'))])
    summary_cards, sections, conclusions = [], [], []
    values = collect_numeric_values(rows, amount_col)
    if values:
        total = sum(values)
        avg = total / len(values)
        summary_cards.append(build_explanatory_summary_card('Выручка / объём сделок', format_metric_value(total), f'Суммарный объём по полю {amount_col}; средний чек/сделка — {format_metric_value(avg)}'))
        conclusions.append(f'Суммарный объём продаж по доступному набору — {format_metric_value(total)}.')
    if append_time_series_section(sections, rows, date_col, amount_col, title='Динамика продаж по периодам', note='Показывает, растёт ли общий объём продаж или колеблется по месяцам.', meta='Объём продаж по периоду'):
        conclusions.append('Есть динамика продаж по периодам.')
    if append_category_split_section(sections, rows, manager_col, amount_col, title='Вклад менеджеров в продажи', note='Помогает увидеть, на ком держится основной объём выручки.'):
        conclusions.append(f'Вклад менеджеров читается по полю {manager_col}.')
    if append_category_split_section(sections, rows, stage_col, amount_col, title='Сумма по стадиям воронки', note='Показывает, на каких стадиях сосредоточен денежный объём.'):
        conclusions.append(f'Стадии воронки читаются по полю {stage_col}.')
    funnel_card, funnel_section = build_funnel_section(rows, funnel_chain, title='Сквозная воронка продаж', note='Показывает, как сжимается поток между ключевыми этапами продаж.')
    if funnel_card:
        summary_cards.append(funnel_card)
    if funnel_section:
        sections.append(funnel_section)
    return summary_cards, sections, conclusions


def build_marketing_dataset_insights(rows: list[dict[str, Any]], numeric_columns: list[str], roles: dict[str, str | None], columns: list[str]) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[str]]:
    leads_col = find_first_matching_numeric_column(numeric_columns, ('lead', 'signup', 'mql', 'sql'))
    cost_col = find_first_matching_numeric_column(numeric_columns, ('cost', 'spend', 'budget', 'cpc', 'cac'))
    conversion_col = find_first_matching_numeric_column(numeric_columns, ('conversion', 'conv', 'ctr', 'rate'))
    won_col, pipeline_col = infer_ratio_components(numeric_columns, ('won', 'converted', 'customer', 'sql'), ('lead', 'signup', 'mql', 'visitor'))
    funnel_chain = infer_funnel_chain_columns(numeric_columns, [('Lead', ('lead', 'signup', 'visitor')), ('MQL', ('mql',)), ('SQL', ('sql', 'qualified')), ('Won', ('won', 'customer', 'converted'))])
    channel_col = roles.get('channel') or find_first_matching_column(columns, ('channel', 'source', 'campaign', 'utm'))
    date_col = roles.get('date')
    summary_cards, sections, conclusions = [], [], []
    lead_values = collect_numeric_values(rows, leads_col)
    if lead_values:
        total = sum(lead_values)
        summary_cards.append(build_explanatory_summary_card('Лиды / отклики', format_metric_value(total), f'Суммарный поток лидов по полю {leads_col}'))
        conclusions.append(f'Общий поток лидов по доступным строкам — {format_metric_value(total)}.')
    cost_values = collect_numeric_values(rows, cost_col)
    if cost_values:
        total = sum(cost_values)
        summary_cards.append(build_explanatory_summary_card('Маркетинговые затраты', format_metric_value(total), f'Суммарные расходы по полю {cost_col}'))
    if lead_values and cost_values and sum(lead_values) > 0:
        cpl = sum(cost_values) / sum(lead_values)
        summary_cards.append(build_explanatory_summary_card('Стоимость лида', format_metric_value(cpl), 'Показывает, сколько в среднем стоит один лид'))
        conclusions.append(f'Средняя стоимость лида составляет {format_metric_value(cpl)}.')
    conv_values = collect_numeric_values(rows, conversion_col)
    if conv_values:
        avg = sum(normalize_percent_like_values(conv_values)) / len(conv_values)
        summary_cards.append(build_explanatory_summary_card('Средняя конверсия', format_metric_value(avg, as_percent=True), 'Показывает, какая доля трафика или лидов переходит в следующий шаг'))
    else:
        ratio_card = build_rate_card_from_ratio(collect_numeric_values(rows, won_col), collect_numeric_values(rows, pipeline_col), label='Конверсия по воронке', note='Вычислена как отношение результата верхнего этапа к входящему потоку')
        if ratio_card:
            summary_cards.append(ratio_card)
    append_category_split_section(sections, rows, channel_col, leads_col or cost_col, title='Эффективность каналов', note='Показывает, какие каналы дают основной объём и где сосредоточены затраты.', pie=True)
