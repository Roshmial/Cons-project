def build_product_dataset_insights(rows: list[dict[str, Any]], numeric_columns: list[str], roles: dict[str, str | None], columns: list[str]) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[str]]:
    activation_col = find_first_matching_numeric_column(numeric_columns, ('activation', 'activated'))
