def normalize_days_of_week(values: list[str] | None) -> list[str]:
    items = []
    for item in values or []:
        lowered = safe_text(item).lower()
        if lowered in WEEKDAY_NAMES and lowered not in items:
            items.append(lowered)
    return items


def looks_like_recurring_job_request(text: str) -> bool:
    lowered = safe_text(text).lower()
    if not lowered:
        return False
    if not regex_matches_any(lowered, MONITORING_REQUEST_ACTION_PATTERNS):
        return False
    if regex_matches_any(lowered, MONITORING_REQUEST_SCHEDULE_PATTERNS):
        return True
    setup_target = regex_matches_any(lowered, MONITORING_REQUEST_TARGET_PATTERNS)
    return setup_target and bool(re.search(r"\b(кажд|регулярн|по будням|ежедневн|еженедельн|ежемесячн)\w*", lowered))


def infer_schedule_from_text(text: str) -> dict[str, Any]:
    lowered = safe_text(text).lower()
    schedule_kind = safe_text(MONITORING_DEFAULT_SCHEDULE.get("schedule_kind") or "weekly")
    days = list(MONITORING_DEFAULT_SCHEDULE.get("days_of_week") or ["mon"])
    time_of_day = safe_text(MONITORING_DEFAULT_SCHEDULE.get("time_of_day") or "09:00")
    timezone = safe_text(MONITORING_DEFAULT_SCHEDULE.get("timezone") or "Europe/Moscow")
    for rule in MONITORING_SCHEDULE_KIND_RULES:
        marker = safe_text((rule or {}).get("match"))
        if marker and marker in lowered:
            schedule_kind = safe_text((rule or {}).get("schedule_kind") or schedule_kind)
            days = list((rule or {}).get("days_of_week") or [])
            break
    if schedule_kind == "weekly":
        for rule in MONITORING_WEEKDAY_RULES:
            marker = safe_text((rule or {}).get("match"))
            if marker and marker in lowered:
                days = list((rule or {}).get("days_of_week") or days)
                break
    time_match = re.search(MONITORING_TIME_PATTERN, lowered)
    if time_match:
        time_of_day = f"{int(time_match.group(1)):02d}:{time_match.group(2)}"
    return {
        "schedule_kind": schedule_kind,
        "days_of_week": days,
        "time_of_day": time_of_day,
        "timezone": timezone,
    }


def looks_like_recurring_job_followup(text: str) -> bool:
    lowered = safe_text(text).lower()
    if not lowered:
        return False
    if looks_like_recurring_job_request(lowered):
        return True
    has_action = regex_matches_any(lowered, MONITORING_REQUEST_ACTION_PATTERNS)
    has_setup_target = regex_matches_any(lowered, MONITORING_FOLLOWUP_TARGET_PATTERNS)
    refers_to_existing_topic = regex_matches_any(lowered, MONITORING_FOLLOWUP_REFERENCE_PATTERNS)
    has_schedule_hint = regex_matches_any(lowered, MONITORING_REQUEST_SCHEDULE_PATTERNS)
    return (has_action and has_setup_target and refers_to_existing_topic) or (has_action and has_schedule_hint)


def infer_research_subject_from_thread(messages: list[sqlite3.Row], current_user_message_id: int, current_user_text: str = '') -> str:
    explicit_current_subject = infer_collection_subject(current_user_text)
    if explicit_current_subject:
        return explicit_current_subject.strip().rstrip(" ?.!")
    prior_user_messages = [
        safe_text(row["content"])
        for row in messages
        if row["role"] == "user" and int(row["id"]) != int(current_user_message_id)
    ]
    for candidate in reversed(prior_user_messages):
        lowered = candidate.lower()
        if looks_like_recurring_job_followup(lowered):
            continue
        explicit_subject = infer_collection_subject(candidate)
        if explicit_subject:
            return explicit_subject.strip().rstrip(" ?.!")
        if len(candidate.strip()) >= 8:
            return candidate.strip().rstrip(" ?.!")
    return "отслеживай тему из текущего чата"


def build_recent_recurring_request_context(messages: list[sqlite3.Row], current_user_message_id: int, window: int = 6) -> str:
    current_id = int(current_user_message_id)
    recent_rows = [row for row in messages if int(row["id"]) <= current_id]
    if not recent_rows:
        return ""
    recent_rows = recent_rows[-window:]
    chunks: list[str] = []
    for row in recent_rows:
        role = safe_text(row["role"] or "")
        meta = json_loads(row["meta_json"], {}) if "meta_json" in row.keys() else {}
        text = safe_text(meta.get("user_text") if role == "user" else row["content"])
        if not text:
            continue
        chunks.append(text.strip())
    return "\n".join(chunks).strip()


def should_prioritize_recurring_job_route(
    message_rows: list[sqlite3.Row],
    current_user_message_id: int,
    user_text: str,
) -> bool:
    lowered = safe_text(user_text).lower()
    if not lowered:
        return False
    if looks_like_recurring_job_request(user_text) or looks_like_recurring_job_followup(user_text):
        return True
    if not regex_matches_any(lowered, MONITORING_REQUEST_SCHEDULE_PATTERNS):
        return False
    recent_context = build_recent_recurring_request_context(message_rows, current_user_message_id)
    return bool(recent_context and looks_like_recurring_job_followup(recent_context))


def maybe_create_recurring_job_from_chat(
    conn: sqlite3.Connection,
    task: sqlite3.Row,
    user_row: sqlite3.Row,
    message_rows: list[sqlite3.Row],
    user_text: str,
) -> tuple[str, dict[str, Any]] | None:
    recent_context = build_recent_recurring_request_context(message_rows, int(task["user_message_id"]))
    if looks_like_recurring_job_request(user_text):
        schedule_source_text = user_text
    elif looks_like_recurring_job_followup(user_text):
        schedule_source_text = recent_context or user_text
    elif regex_matches_any(safe_text(user_text).lower(), MONITORING_REQUEST_SCHEDULE_PATTERNS) and recent_context and looks_like_recurring_job_followup(recent_context):
        schedule_source_text = f"{recent_context}\n{user_text}".strip()
    else:
        return None
    auth = AuthUser(id=int(user_row["id"]), role=safe_text(user_row["role"] or "user"), email=safe_text(user_row["email"]))
    schedule = infer_schedule_from_text(schedule_source_text)
    subject = infer_research_subject_from_thread(message_rows, int(task["user_message_id"]), user_text)
    subject_short = subject[:120]

    def normalize_recurring_subject(value: str) -> str:
        return re.sub(r"\s+", " ", safe_text(value).strip().lower())

    normalized_subject = normalize_recurring_subject(subject_short)
    existing_rows = conn.execute(
        """
        SELECT *
        FROM jobs
        WHERE user_id = ? AND job_type = 'research_watch' AND status IN ('active', 'paused')
        ORDER BY id DESC
        """,
        (int(user_row["id"]),),
    ).fetchall()
    for existing_row in existing_rows:
        existing = row_to_job_dict(conn, existing_row, auth=auth, include_details=True)
        existing_subject = normalize_recurring_subject((existing.get("parameters") or {}).get("subject") or "")
        if existing_subject != normalized_subject:
            continue
        if safe_text(existing.get("schedule_kind") or "") != safe_text(schedule["schedule_kind"] or ""):
            continue
        if normalize_time_of_day(existing.get("time_of_day") or "09:00") != normalize_time_of_day(schedule["time_of_day"] or "09:00"):
            continue
        if normalize_timezone(existing.get("timezone") or "Europe/Moscow") != normalize_timezone(schedule["timezone"] or "Europe/Moscow"):
            continue
        if normalize_days_of_week(existing.get("days_of_week")) != normalize_days_of_week(schedule["days_of_week"]):
            continue
        summary = safe_text(existing.get("schedule_summary") or build_schedule_summary(existing))
        reply_text = (
            f"Такая задача уже есть: «{existing['name']}».\n\n"
            f"Расписание: {summary}.\n"
            f"Тема мониторинга: {subject_short}.\n\n"
            "Новый дубликат не создаю. Если нужно, могу отдельно изменить расписание или формулировку существующей задачи."
        )
        meta = {
            "message_kind": "job_reused",
            "created_job_id": existing["id"],
            "created_job_name": existing["name"],
            "schedule_summary": summary,
            "job_preview": existing,
            "downstream": "chat:job_reused",
        }
        return reply_text, meta

    payload = {
        "name": f"Мониторинг: {subject_short}",
        "description": f"Регулярный мониторинг по запросу из чата: {subject_short}",
        "job_type": "research_watch",
        "visibility": "private",
        "status": "active",
        "schedule_kind": schedule["schedule_kind"],
        "days_of_week": schedule["days_of_week"],
        "time_of_day": schedule["time_of_day"],
        "timezone": schedule["timezone"],
        "start_date": now_utc().astimezone(ZoneInfo(schedule["timezone"])).date().isoformat(),
        "prompt_template": build_default_job_template("research_watch"),
        "parameters": {
            "subject": subject_short,
            "angle": "упоминания в СМИ, значимые события, сигналы рынка и изменения позиции",
            "output": "структурированная краткая сводка без лишней воды",
        },
        "recipients": [{"recipient_type": "owner", "target_value": "self", "label": "Только владелец"}],
    }
    created = create_or_update_job(conn, auth, payload)
    summary = safe_text(created.get("schedule_summary") or build_schedule_summary(created))
    reply_text = (
        f"Готово. Создала задачу «{created['name']}».\n\n"
        f"Расписание: {summary}.\n"
        f"Тема мониторинга: {subject_short}.\n\n"
        "Если нужно, могу потом отдельно скорректировать день, время или формулировку самой задачи."
    )
    meta = {
        "message_kind": "job_created",
        "created_job_id": created["id"],
        "created_job_name": created["name"],
        "schedule_summary": created.get("schedule_summary") or summary,
        "job_preview": created,
        "downstream": "chat:job_created",
    }
    return reply_text, meta


def build_schedule_summary(job: dict[str, Any]) -> str:
    kind = job["schedule_kind"]
    time_of_day = job["time_of_day"]
    timezone_name = job["timezone"]
    if kind == "daily":
        return f"Каждый день в {time_of_day} ({timezone_name})"
    if kind == "weekdays":
        return f"По будням в {time_of_day} ({timezone_name})"
    if kind == "weekly":
        days = ", ".join(job["days_of_week"] or ["mon"])
        return f"Еженедельно: {days} в {time_of_day} ({timezone_name})"
    if kind == "monthly":
        anchor_day = parse_date(job["start_date"]).day if parse_date(job["start_date"]) else 1
        return f"Ежемесячно {anchor_day}-го числа в {time_of_day} ({timezone_name})"
    return f"Запуск в {time_of_day} ({timezone_name})"


def combine_local(date_value: date, time_of_day: str, timezone_name: str) -> datetime:
    tz = ZoneInfo(normalize_timezone(timezone_name))
    hh, mm = normalize_time_of_day(time_of_day).split(":")
    return datetime.combine(date_value, dt_time(hour=int(hh), minute=int(mm)), tzinfo=tz)


def compute_next_run(job: dict[str, Any], from_dt: datetime | None = None) -> str | None:
    if job.get("status") == "paused":
        return None
    kind = safe_text(job.get("schedule_kind") or "daily")
    tz_name = normalize_timezone(job.get("timezone") or "UTC")
    from_point = (from_dt or now_utc()).astimezone(ZoneInfo(tz_name))
    start = parse_date(job.get("start_date")) or from_point.date()
    days = normalize_days_of_week(job.get("days_of_week"))
    monthly_day = start.day
    for offset in range(0, 400):
        candidate_date = from_point.date() + timedelta(days=offset)
        if candidate_date < start:
            continue
        weekday = WEEKDAY_NAMES[candidate_date.weekday()]
        allowed = False
        if kind == "daily":
            allowed = True
        elif kind == "weekdays":
            allowed = candidate_date.weekday() < 5
        elif kind == "weekly":
            allowed = weekday in (days or ["mon"])
        elif kind == "monthly":
            next_day = min(monthly_day, last_day_of_month(candidate_date.year, candidate_date.month))
            allowed = candidate_date.day == next_day
        else:
            allowed = True
        if not allowed:
            continue
        candidate_dt = combine_local(candidate_date, job.get("time_of_day") or "09:00", tz_name)
        if candidate_dt <= from_point + timedelta(seconds=5):
            continue
        return now_iso(candidate_dt.astimezone(UTC))
    return None


def preview_next_runs(job: dict[str, Any], count: int = 3) -> list[str]:
    result: list[str] = []
    cursor = now_utc()
    for _ in range(count):
        next_run = compute_next_run(job, cursor)
        if not next_run:
            break
        result.append(next_run)
        cursor = parse_iso(next_run) + timedelta(minutes=1)
    return result


def last_day_of_month(year: int, month: int) -> int:
    if month == 12:
        next_month = date(year + 1, 1, 1)
    else:
        next_month = date(year, month + 1, 1)
    return (next_month - timedelta(days=1)).day


def get_job_by_id(conn: sqlite3.Connection, job_id: int) -> sqlite3.Row:
    row = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
    if not row:
        raise ApiError("job_not_found", 404)
    return row


def get_job_role(conn: sqlite3.Connection, job_row: sqlite3.Row, auth: AuthUser) -> str | None:
    if auth.role == "admin":
        return "admin"
    if job_row["user_id"] == auth.id:
        return "owner"
    acl = conn.execute("SELECT role FROM job_acl WHERE job_id = ? AND user_id = ?", (job_row["id"], auth.id)).fetchone()
    if acl:
        return acl["role"]
    recipient_rows = fetch_job_recipients(conn, int(job_row["id"]))
    for item in recipient_rows:
        recipient_type = item["recipient_type"]
        if recipient_type == "fixed_user":
            try:
                if int(item["target_value"]) == int(auth.id):
                    return "recipient"
            except (TypeError, ValueError):
                continue
        if recipient_type == "fixed_thread":
            try:
                thread_id = int(item["target_value"])
            except (TypeError, ValueError):
                continue
            thread_row = conn.execute("SELECT user_id FROM threads WHERE id = ?", (thread_id,)).fetchone()
            if thread_row and thread_row["user_id"] is not None and int(thread_row["user_id"]) == int(auth.id):
                return "recipient"
    sub = conn.execute("SELECT 1 FROM job_subscriptions WHERE job_id = ? AND user_id = ?", (job_row["id"], auth.id)).fetchone()
    if sub:
        return "subscriber"
    if job_row["visibility"] == "workspace":
        return "viewer"
    return None


def ensure_can_view_job(conn: sqlite3.Connection, job_row: sqlite3.Row, auth: AuthUser) -> str:
    role = get_job_role(conn, job_row, auth)
    if role:
        return role
    raise JobPermissionError("job_forbidden", 403)


def ensure_can_edit_job(conn: sqlite3.Connection, job_row: sqlite3.Row, auth: AuthUser) -> str:
    role = ensure_can_view_job(conn, job_row, auth)
    if role in {"owner", "admin"}:
        return role
    raise JobPermissionError("job_edit_forbidden", 403)


def ensure_can_manage_job(conn: sqlite3.Connection, job_row: sqlite3.Row, auth: AuthUser) -> str:
    role = ensure_can_view_job(conn, job_row, auth)
    if role in {"owner", "admin"}:
        return role
    raise JobPermissionError("job_manage_forbidden", 403)


def ensure_can_run_job(conn: sqlite3.Connection, job_row: sqlite3.Row, auth: AuthUser) -> str:
