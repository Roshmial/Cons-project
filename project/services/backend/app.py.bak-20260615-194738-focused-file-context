    else:
        pinned = [safe_text(value) for value in str(pinned_raw).replace("\n", "|").split("|") if safe_text(value)]
    style = safe_text(item.get("style") or "Коротко и по делу")
    profile = default_assistant_profile(style)
    nested_profile = item.get("assistant_profile") if isinstance(item.get("assistant_profile"), dict) else {}
    if nested_profile:
        profile.update(
            {
                "tone": safe_text(nested_profile.get("tone") or profile["tone"]),
                "answer_depth": safe_text(nested_profile.get("answer_depth") or profile["answer_depth"]),
                "interaction_mode": safe_text(nested_profile.get("interaction_mode") or profile["interaction_mode"]),
                "about_user": safe_text(nested_profile.get("about_user") or profile["about_user"]),
            }
        )
    about_user = safe_text(item.get("about_user"))
    if about_user:
        profile["about_user"] = about_user
    return {
        "email": email,
        "role": role,
        "name": name,
        "timezone": timezone_name,
        "language": language,
        "team": safe_text(item.get("team") or ""),
        "title": safe_text(item.get("title") or ""),
        "goals": safe_text(item.get("goals") or ""),
        "style": style,
        "constraints": safe_text(item.get("constraints") or ""),
        "pinned": pinned,
        "assistant_profile": profile,
        "password": safe_text(item.get("password") or ""),
    }


def upsert_import_users(conn: sqlite3.Connection, rows: list[dict[str, Any]], default_password: str) -> dict[str, Any]:
    created = 0
    updated = 0
    skipped = 0
    imported: list[dict[str, Any]] = []
    ts = now_iso()
    for raw in rows:
        normalized = normalize_import_user(raw)
        normalized["assistant_profile"] = validate_assistant_profile(conn, normalized["assistant_profile"], normalized["style"])
        existing = conn.execute("SELECT * FROM users WHERE lower(email) = ?", (normalized["email"],)).fetchone()
        password_value = normalized["password"] or default_password or "temporary-pass-123"
        if len(password_value) < MIN_PASSWORD_LENGTH:
            raise ApiError("import_password_too_short", 400)
        assistant_profile_json = json.dumps(normalized["assistant_profile"], ensure_ascii=False)
        pinned_json = json.dumps(normalized["pinned"], ensure_ascii=False)
        if existing:
            current_version = int(existing["version"] or 1)
            next_version = current_version + 1
            updated_row = conn.execute(
                """
                UPDATE users
                SET role = ?, name = ?, timezone = ?, language = ?, team = ?, title = ?,
                    goals = ?, style = ?, constraints_text = ?, pinned_json = ?, assistant_profile_json = ?, version = ?, updated_at = ?
                WHERE id = ? AND version = ?
                RETURNING id
                """,
                (
                    normalized["role"],
                    normalized["name"],
                    normalized["timezone"],
                    normalized["language"],
                    normalized["team"],
                    normalized["title"],
                    normalized["goals"],
                    normalized["style"],
                    normalized["constraints"],
                    pinned_json,
                    assistant_profile_json,
                    next_version,
                    ts,
                    existing["id"],
                    current_version,
                ),
            ).fetchone()
            if not updated_row:
                skipped += 1
                imported.append({"email": normalized["email"], "status": "skipped_version_conflict"})
                continue
            write_user_change_log(conn, int(existing["id"]), None, "import_update")
            updated += 1
            imported.append({"email": normalized["email"], "status": "updated"})
            continue
        new_id = conn.execute(
            """
            INSERT INTO users (
                email, password_hash, role, name, timezone, language, team, title,
                goals, style, constraints_text, pinned_json, assistant_profile_json,
                version, onboarding_completed, created_at, updated_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, 0, ?, ?)
            RETURNING id
            """,
            (
                normalized["email"],
                generate_password_hash(password_value),
                normalized["role"],
                normalized["name"],
                normalized["timezone"],
                normalized["language"],
                normalized["team"],
                normalized["title"],
                normalized["goals"],
                normalized["style"],
                normalized["constraints"],
                pinned_json,
                assistant_profile_json,
                ts,
                ts,
            ),
        ).fetchone()[0]
        write_user_change_log(conn, int(new_id), None, "import_create")
        created += 1
        imported.append({"email": normalized["email"], "status": "created"})
    return {"created": created, "updated": updated, "skipped": skipped, "items": imported}


def get_user_with_stats(conn: sqlite3.Connection, user_id: int) -> dict[str, Any]:
    row = conn.execute(
        """
        SELECT u.*, 
               COUNT(DISTINCT t.id) AS thread_count,
               COUNT(DISTINCT j.id) AS job_count
        FROM users u
        LEFT JOIN threads t ON t.user_id = u.id
        LEFT JOIN jobs j ON j.user_id = u.id
        WHERE u.id = ?
        GROUP BY u.id, u.email, u.password_hash, u.role, u.name, u.timezone, u.language, u.team, u.title, u.goals, u.style, u.constraints_text, u.pinned_json, u.assistant_profile_json, u.version, u.onboarding_completed, u.is_active, u.deleted_at, u.created_at, u.updated_at
        """,
        (user_id,),
    ).fetchone()
    if not row:
        raise ApiError("user_not_found", 404)
    payload = user_to_dict(row, conn)
    payload.update(
        {
            "thread_count": row["thread_count"],
            "job_count": row["job_count"],
            "created_at": row["created_at"],
            "updated_at": row["updated_at"],
        }
    )
    return payload


def save_admin_user(conn: sqlite3.Connection, payload: dict[str, Any], existing_user_id: int | None = None, actor_user_id: int | None = None) -> dict[str, Any]:
    normalized = normalize_import_user(payload)
    normalized["assistant_profile"] = validate_assistant_profile(conn, normalized["assistant_profile"], normalized["style"])
    password_value = safe_text(payload.get("password") or "")
    expected_version = payload.get("version")
    current = None
    if existing_user_id is not None:
        current = conn.execute("SELECT * FROM users WHERE id = ?", (existing_user_id,)).fetchone()
        if not current:
            raise ApiError("user_not_found", 404)
        if expected_version is not None and int(current["version"] or 1) != int(expected_version):
            raise ApiError("version_conflict", 409)
    duplicate = conn.execute("SELECT id FROM users WHERE lower(email) = ?", (normalized["email"],)).fetchone()
    if duplicate and (existing_user_id is None or duplicate["id"] != existing_user_id):
        raise ApiError("email_already_exists", 409)
    assistant_profile_json = json.dumps(normalized["assistant_profile"], ensure_ascii=False)
    pinned_json = json.dumps(normalized["pinned"], ensure_ascii=False)
    ts = now_iso()
    if current is None:
        if len(password_value) < MIN_PASSWORD_LENGTH:
            raise ApiError("password_too_short", 400)
        requested_status = safe_text(payload.get("status") or "active").lower() or "active"
        is_active = 1 if requested_status == "active" else 0
        deleted_at = ts if requested_status == "deleted" else None
        new_id = conn.execute(
            """
            INSERT INTO users (
                email, password_hash, role, name, timezone, language, team, title,
                goals, style, constraints_text, pinned_json, assistant_profile_json,
                version, onboarding_completed, is_active, deleted_at, created_at, updated_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, 0, ?, ?, ?, ?)
            RETURNING id
            """,
            (
                normalized["email"],
                generate_password_hash(password_value),
                normalized["role"],
                normalized["name"],
                normalized["timezone"],
                normalized["language"],
                normalized["team"],
                normalized["title"],
                normalized["goals"],
                normalized["style"],
                normalized["constraints"],
                pinned_json,
                assistant_profile_json,
                is_active,
                deleted_at,
                ts,
                ts,
            ),
        ).fetchone()[0]
        write_user_change_log(conn, int(new_id), actor_user_id, "create")
        return get_user_with_stats(conn, int(new_id))
    next_version = int(current["version"] or 1) + 1
    requested_status = safe_text(payload.get("status") or ("deleted" if current["deleted_at"] else ("inactive" if not bool(current["is_active"]) else "active"))).lower() or "active"
    is_active = 1 if requested_status == "active" else 0
    deleted_at = ts if requested_status == "deleted" else None
    updated = conn.execute(
        """
        UPDATE users
        SET email = ?, role = ?, name = ?, timezone = ?, language = ?, team = ?, title = ?,
            goals = ?, style = ?, constraints_text = ?, pinned_json = ?, assistant_profile_json = ?, version = ?, updated_at = ?, is_active = ?, deleted_at = ?
        WHERE id = ? AND version = ?
        RETURNING id
        """,
        (
            normalized["email"],
            normalized["role"],
            normalized["name"],
            normalized["timezone"],
            normalized["language"],
            normalized["team"],
            normalized["title"],
            normalized["goals"],
            normalized["style"],
            normalized["constraints"],
            pinned_json,
            assistant_profile_json,
            next_version,
            ts,
            is_active,
            deleted_at,
            existing_user_id,
            int(current["version"] or 1),
        ),
    ).fetchone()
    if not updated:
        raise ApiError("version_conflict", 409)
    if password_value:
        if len(password_value) < MIN_PASSWORD_LENGTH:
            raise ApiError("password_too_short", 400)
        conn.execute("UPDATE users SET password_hash = ?, updated_at = ? WHERE id = ?", (generate_password_hash(password_value), ts, existing_user_id))
        revoke_user_sessions(conn, int(existing_user_id))
    write_user_change_log(conn, int(existing_user_id), actor_user_id, "update")
    return get_user_with_stats(conn, int(existing_user_id))


def bulk_update_user_status(conn: sqlite3.Connection, *, user_ids: list[int], status: str, actor_user_id: int | None = None) -> list[dict[str, Any]]:
    normalized_ids: list[int] = []
    seen_ids: set[int] = set()
    for raw_id in user_ids:
        try:
            numeric_id = int(raw_id)
        except (TypeError, ValueError):
            continue
        if numeric_id <= 0 or numeric_id in seen_ids:
            continue
        seen_ids.add(numeric_id)
        normalized_ids.append(numeric_id)
    if not normalized_ids:
        raise ApiError("user_ids_required", 400)
    requested_status = safe_text(status).lower()
    if requested_status not in {"active", "inactive", "deleted"}:
        raise ApiError("user_status_invalid", 400)
    placeholders = ", ".join(["?"] * len(normalized_ids))
    rows = conn.execute(
        f"SELECT * FROM users WHERE id IN ({placeholders}) ORDER BY id ASC",
        tuple(normalized_ids),
    ).fetchall()
    found_ids = {int(row["id"]) for row in rows}
    if len(found_ids) != len(normalized_ids):
        raise ApiError("user_not_found", 404)
    if requested_status in {"inactive", "deleted"}:
        active_admin_total = conn.execute(
            "SELECT COUNT(*) FROM users WHERE role = 'admin' AND is_active = 1 AND deleted_at IS NULL"
        ).fetchone()[0]
        selected_active_admins = sum(1 for row in rows if row["role"] == "admin" and bool(row["is_active"]) and not row["deleted_at"])
        if active_admin_total and selected_active_admins >= active_admin_total:
            raise ApiError("last_active_admin_required", 400)
    ts = now_iso()
    is_active = 1 if requested_status == "active" else 0
    deleted_at = ts if requested_status == "deleted" else None
    change_type = {
        "active": "bulk_activate",
        "inactive": "bulk_inactivate",
        "deleted": "bulk_delete",
    }[requested_status]
    for row in rows:
        next_version = int(row["version"] or 1) + 1
        conn.execute(
            """
            UPDATE users
            SET is_active = ?, deleted_at = ?, version = ?, updated_at = ?
            WHERE id = ?
            """,
            (is_active, deleted_at, next_version, ts, int(row["id"])),
        )
        write_user_change_log(conn, int(row["id"]), actor_user_id, change_type)
    return [get_user_with_stats(conn, user_id) for user_id in normalized_ids]


def bulk_update_reference_item_status(
    conn: sqlite3.Connection,
    *,
    dataset_key: str,
    item_keys: list[str],
    status: str,
    actor_user_id: int | None = None,
) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    if dataset_key not in REFERENCE_DATASETS:
        raise ApiError("reference_dataset_not_found", 404)
    normalized_keys: list[str] = []
    seen_keys: set[str] = set()
    for raw_key in item_keys:
        item_key = safe_text(raw_key)
        if not item_key or item_key in seen_keys:
            continue
        seen_keys.add(item_key)
        normalized_keys.append(item_key)
    if not normalized_keys:
        raise ApiError("reference_item_keys_required", 400)
    requested_status = safe_text(status).lower()
    if requested_status not in {"active", "inactive", "deleted"}:
        raise ApiError("reference_item_status_invalid", 400)
    placeholders = ", ".join(["?"] * len(normalized_keys))
    rows = conn.execute(
        f"""
        SELECT *
        FROM reference_items
        WHERE scope = ? AND dataset_key = ? AND item_key IN ({placeholders})
        ORDER BY sort_order ASC, id ASC
        """,
        (REFERENCE_SCOPE_GLOBAL, dataset_key, *normalized_keys),
    ).fetchall()
    found_keys = {safe_text(row["item_key"]) for row in rows}
    if len(found_keys) != len(normalized_keys):
        raise ApiError("reference_item_not_found", 404)
    ts = now_iso()
    is_active = 1 if requested_status == "active" else 0
    deleted_at = ts if requested_status == "deleted" else None
    change_type = {
        "active": "bulk_activate",
        "inactive": "bulk_inactivate",
        "deleted": "bulk_delete",
    }[requested_status]
    for row in rows:
        next_version = int(row["version"] or 1) + 1
        conn.execute(
            """
            UPDATE reference_items
            SET is_active = ?, deleted_at = ?, version = ?, updated_at = ?
            WHERE scope = ? AND dataset_key = ? AND item_key = ?
            """,
            (is_active, deleted_at, next_version, ts, REFERENCE_SCOPE_GLOBAL, dataset_key, row["item_key"]),
        )
        write_reference_item_change_log(conn, dataset_key, row["item_key"], actor_user_id, change_type)
    dataset_payload = build_reference_payload(conn, include_inactive=True).get(dataset_key)
    updated_items_by_key = {item["item_key"]: item for item in (dataset_payload or {}).get("items", [])}
    ordered_items = [updated_items_by_key[item_key] for item_key in normalized_keys if item_key in updated_items_by_key]
    return ordered_items, dataset_payload


