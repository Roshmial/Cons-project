def load_json_policy(path: Path, *, label: str) -> dict[str, Any]:
    payload = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(payload, dict):
        raise RuntimeError(f"Invalid {label} policy at {path}")
    return payload


def load_chat_routing_policy() -> dict[str, Any]:
