def can_self_subscribe_job(conn: sqlite3.Connection, job_row: sqlite3.Row, auth: AuthUser) -> bool:
    enabled = bool(job_row["self_subscribe_enabled"])
    scope = safe_text(job_row["self_subscribe_scope"] or "disabled")
    if not enabled or scope == "disabled":
        return False
    if auth.role == "admin" or job_row["user_id"] == auth.id:
        return False
    if scope == "workspace":
        user_row = conn.execute("SELECT is_active, deleted_at FROM users WHERE id = ?", (auth.id,)).fetchone()
        return bool(user_row and user_row["deleted_at"] is None and int(user_row["is_active"] or 0) == 1)
    if scope == "visible_users":
        return bool(get_job_role(conn, job_row, auth))
    return False


