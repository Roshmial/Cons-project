        ('Activation', activation_col, 'Показывает долю пользователей, дошедших до первого ценного действия'),
        ('Feature adoption', adoption_col, 'Показывает, насколько продуктовые функции реально используются'),
        ('Conversion', conversion_col, 'Показывает, какая доля пользователей проходит в целевой шаг'),
