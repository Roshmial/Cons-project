    funnel_card, funnel_section = build_funnel_section(rows, funnel_chain, title='Продуктовая воронка', note='Показывает, как пользователи проходят путь от входа к активации и удержанию.')
    if funnel_card:
        summary_cards.append(funnel_card)
    if funnel_section:
        sections.append(funnel_section)
    concentration_card = build_concentration_card(rows, feature_col, adoption_col or activation_col, label='Концентрация по feature', note='Показывает, не опирается ли продуктовый usage только на один модуль')
    if concentration_card:
        summary_cards.append(concentration_card)
    append_time_series_section(sections, rows, date_col, adoption_col or activation_col or retention_col, title='Продуктовая динамика по периодам', note='Показывает, усиливается ли использование продукта со временем.', meta='Продуктовый объём по периоду')
    return summary_cards, sections, conclusions


