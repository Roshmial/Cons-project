def get_job_role(conn: sqlite3.Connection, job_row: sqlite3.Row, auth: AuthUser) -> str | None:
    if auth.role == "admin":
        return "admin"
    if job_row["user_id"] == auth.id:
        return "owner"
    acl = conn.execute("SELECT role FROM job_acl WHERE job_id = ? AND user_id = ?", (job_row["id"], auth.id)).fetchone()
    if acl:
        return acl["role"]
    sub = conn.execute("SELECT 1 FROM job_subscriptions WHERE job_id = ? AND user_id = ?", (job_row["id"], auth.id)).fetchone()
    if sub:
        return "subscriber"
    if job_row["visibility"] == "workspace":
        return "viewer"
    return None


