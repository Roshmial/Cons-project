@app.post(f"{API_PREFIX}/threads/<int:thread_id>/messages")
def post_message(thread_id: int) -> Response:
    auth = require_auth()
    is_multipart = (request.content_type or "").startswith("multipart/form-data")
    payload = request.form if is_multipart else (request.get_json(force=True, silent=True) or {})
    text = safe_text(payload.get("content"))
    uploaded_files = request.files.getlist("files") if is_multipart else []
    uploaded_files = [item for item in uploaded_files if getattr(item, "filename", None)]
    existing_file_ids = normalize_existing_file_ids(request.form.getlist("existing_file_ids") if is_multipart else payload.get("existing_file_ids"))
    source_mode_override = safe_text(request.form.get("source_mode") if is_multipart else payload.get("source_mode"))
    analysis_mode_override = safe_text(request.form.get("analysis_mode") if is_multipart else payload.get("analysis_mode"))
    model_preference_override = normalize_chat_model_preference(request.form.get("model_preference") if is_multipart else payload.get("model_preference"))
    explicit_source_ids_override = request.form.getlist("explicit_source_ids") if is_multipart else payload.get("explicit_source_ids")
    if not isinstance(explicit_source_ids_override, list):
        explicit_source_ids_override = []
    allowed_source_ids_override = request.form.getlist("allowed_source_ids") if is_multipart else payload.get("allowed_source_ids")
    if not isinstance(allowed_source_ids_override, list):
        allowed_source_ids_override = []
    connector_targets_override_raw = request.form.get("connector_targets_json") if is_multipart else payload.get("connector_targets")
    if isinstance(connector_targets_override_raw, str):
        connector_targets_override = json_loads(connector_targets_override_raw, {})
    elif isinstance(connector_targets_override_raw, dict):
        connector_targets_override = connector_targets_override_raw
    else:
        connector_targets_override = {}
    normalized_explicit_source_ids = [safe_text(item) for item in explicit_source_ids_override if safe_text(item)]
    normalized_legacy_allowed_source_ids = [safe_text(item) for item in allowed_source_ids_override if safe_text(item)]
    dashboard_policy_override = {
        "source_mode": source_mode_override,
        "analysis_mode": analysis_mode_override,
        "model_preference": model_preference_override,
        "explicit_source_ids": normalized_explicit_source_ids,
        "allowed_source_ids": normalized_legacy_allowed_source_ids,
        "connector_targets": connector_targets_override,
    }
    if len(uploaded_files) + len(existing_file_ids) > MAX_UPLOAD_FILES:
        raise ApiError("too_many_files", 400)
    if not text and not uploaded_files and not existing_file_ids:
        raise ApiError("content_required", 400)
    uploaded_attachments = [store_uploaded_file(item, auth.id, thread_id) for item in uploaded_files]
    last_error: duckdb.TransactionException | None = None
    for attempt in range(3):
        try:
            with db_connect() as conn:
                get_thread_or_404(conn, thread_id, auth.id)
                existing_rows = []
                if existing_file_ids:
                    placeholders = ",".join(["?"] * len(existing_file_ids))
                    existing_rows = conn.execute(
                        f"SELECT * FROM user_files WHERE user_id = ? AND id IN ({placeholders}) ORDER BY created_at DESC, id DESC",
                        [auth.id, *existing_file_ids],
                    ).fetchall()
                    found_ids = {row['id'] for row in existing_rows}
                    if len(found_ids) != len(set(existing_file_ids)):
                        raise ApiError("file_not_found", 404)
                existing_attachments = []
                if existing_file_ids:
                    row_map = {row['id']: row for row in existing_rows}
                    existing_attachments = [attachment_from_user_file_row(row_map[file_id]) for file_id in existing_file_ids if file_id in row_map]
                attachments = [*uploaded_attachments, *existing_attachments]
                message_content = build_user_message_content(text, attachments)
                if not message_content:
                    raise ApiError("content_required", 400)
                ts = now_iso()
                user_meta = json.dumps({"attachments": attachments, "user_text": text}, ensure_ascii=False)
                user_msg = conn.execute(
                    "INSERT INTO messages (thread_id, role, content, created_at, meta_json) VALUES (?, 'user', ?, ?, ?) RETURNING id",
                    (thread_id, message_content, ts, user_meta),
                )
                user_message_id = int(user_msg.fetchone()[0])
                if uploaded_attachments:
                    save_user_file_records(conn, user_id=auth.id, thread_id=thread_id, message_id=user_message_id, attachments=uploaded_attachments, created_at=ts)
                assistant_msg = conn.execute(
                    "INSERT INTO messages (thread_id, role, content, created_at, meta_json) VALUES (?, 'assistant', ?, ?, ?) RETURNING id",
                    (thread_id, "Готовлю ответ…", ts, json.dumps({"pending": True}, ensure_ascii=False)),
                )
                assistant_id = int(assistant_msg.fetchone()[0])
                task_row = enqueue_chat_task(
                    conn,
                    thread_id=thread_id,
                    user_id=auth.id,
                    user_message_id=user_message_id,
                    assistant_message_id=assistant_id,
                    request_policy=dashboard_policy_override,
                )
                preview_source = text or (attachments[0]["original_name"] if attachments else "Сообщение")
                conn.execute("UPDATE threads SET preview = ?, updated_at = ? WHERE id = ?", (preview_source[:140], now_iso(), thread_id))
                assistant_row = conn.execute("SELECT * FROM messages WHERE id = ?", (assistant_id,)).fetchone()
            return jsonify({
                "user_message_id": user_message_id,
                "user_attachments": attachments,
                "assistant_message": serialize_message(assistant_row),
                "chat_task": {
                    "id": int(task_row["id"]),
                    "status": task_row["status"],
                    "assistant_message_id": int(task_row["assistant_message_id"]),
                },
            }), 201
        except duckdb.TransactionException as exc:
            last_error = exc
            if attempt >= 2:
                raise
            time.sleep(0.05 * (attempt + 1))
    if last_error is not None:
        raise last_error
    raise ApiError("message_enqueue_failed", 500)


@app.get(f"{API_PREFIX}/messages/<int:message_id>/attachments/<int:attachment_index>")
def download_message_attachment(message_id: int, attachment_index: int) -> Response:
    auth = require_auth()
    with db_connect() as conn:
        row = conn.execute(
            """
            SELECT m.*, t.user_id
            FROM messages m
            JOIN threads t ON t.id = m.thread_id
            WHERE m.id = ? AND t.user_id = ?
            """,
            (message_id, auth.id),
        ).fetchone()
    if not row:
        raise ApiError("message_not_found", 404)
    attachments = json_loads(row["meta_json"], {}).get("attachments") or []
    if attachment_index < 0 or attachment_index >= len(attachments):
        raise ApiError("attachment_not_found", 404)
    attachment = attachments[attachment_index]
    local_path = ensure_allowed_media_path(attachment.get("local_path"))
    if not local_path:
        relative_path = safe_text(attachment.get("relative_path"))
        if relative_path:
            candidate = (DATA_DIR / relative_path).resolve()
            try:
                candidate.relative_to(DATA_DIR.resolve())
            except ValueError:
                candidate = None
            if candidate and candidate.exists() and candidate.is_file():
                local_path = candidate
    if not local_path:
        raise ApiError("attachment_not_found", 404)
    return send_file(
        local_path,
        as_attachment=True,
        download_name=safe_text(attachment.get("original_name")) or local_path.name,
        mimetype=safe_text(attachment.get("mime_type")) or guess_mime_type(local_path.name),
    )


