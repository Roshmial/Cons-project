def build_global_dashboard_reply(text: str, source_meta: dict[str, Any], policy: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    if APP_MODE != "hermes-api":
        payload = build_mock_global_dashboard_payload(text, source_meta, policy)
    else:
        hermes_text, _ = call_hermes_messages([
            {"role": "system", "content": "Ты backend-маршрут Hermes Web для построения внешних dashboard-ответов."},
            {"role": "user", "content": build_global_dashboard_prompt(text, source_meta, policy)},
        ])
        payload = extract_json_object(hermes_text)
    reply_text = safe_text(payload.get("reply_text") or "Подготовила внешний дашборд.")
    dashboard = payload.get("dashboard") if isinstance(payload.get("dashboard"), dict) else {}
    dashboard = normalize_external_dashboard_payload(dashboard, reply_text, source_meta, policy, text)
    if user_prefers_russian_dashboard(text) and not text_looks_cyrillic(reply_text):
        reply_text = f"Собрала структурированный дашборд по теме: {safe_text(text)[:120] or 'внешнее исследование'}. Числовые блоки без подтверждённых источников исключены; сохранены только содержательные и честно ограниченные секции."
    meta = {
        "mode": APP_MODE,
        "downstream": f"dashboard:{safe_text(source_meta.get('route') or source_meta.get('item_key') or 'external')}",
        "message_kind": "dashboard_result",
        "dashboard_builder": safe_text(source_meta.get("item_key") or "external_dashboard"),
        "dashboard_label": safe_text(source_meta.get("label") or source_meta.get("item_key") or "Внешний источник"),
        "dashboard_grammar": EXTERNAL_DASHBOARD_GRAMMAR_VERSION,
        "analytics_source": source_meta,
        "dashboard_policy": policy,
        "dashboard": dashboard,
    }
    return reply_text, meta


def maybe_build_local_dashboard_reply(text: str, attachments: list[dict[str, Any]] | None = None) -> tuple[str, dict[str, Any]] | None:
    if not is_dashboard_request(text):
        return None
    for attachment in attachments or []:
        loaded = load_dashboard_dataset_from_attachment(attachment)
        if loaded is None:
            continue
        dataset, source_meta = loaded
        payload = build_generic_dataset_dashboard_payload(dataset, source_meta, text)
        return payload['reply_text'], {
            'mode': 'local-analytics',
            'downstream': 'dashboard:user_attachment',
            'message_kind': 'dashboard_result',
            'dashboard_builder': 'user_attachment_dataset',
            'dashboard_label': source_meta['label'],
            'analytics_source': source_meta,
            'dashboard': payload['dashboard'],
        }
    builder = resolve_dashboard_builder(text)
    if builder is None:
        if dashboard_request_has_user_scope(text):
            return None
        return build_dashboard_clarification_reply()
    messages, source_meta = builder["loader"]()
    payload = builder["payload_builder"](messages, source_meta)
    meta = {
        "mode": "local-analytics",
        "downstream": f"dashboard:{builder['id']}",
        "message_kind": "dashboard_result",
        "dashboard_builder": builder["id"],
        "dashboard_label": builder["label"],
        "analytics_source": source_meta,
        "dashboard": payload["dashboard"],
    }
    return payload["reply_text"], meta


def maybe_build_dashboard_reply(
    conn: sqlite3.Connection,
    text: str,
    attachments: list[dict[str, Any]] | None = None,
    policy_override: dict[str, Any] | None = None,
) -> tuple[str, dict[str, Any]] | None:
    if not is_dashboard_request(text):
        return None
    policy_ctx = resolve_dashboard_policy_context(conn, policy_override)
    policy = policy_ctx["policy"]
    local_reply = maybe_build_local_dashboard_reply(text, attachments)
    local_reply_kind = None
    if local_reply is not None:
        _, local_meta = local_reply
        local_reply_kind = local_meta.get("message_kind")
    if local_reply is not None and local_reply_kind != "clarification_request" and policy["source_mode"] != DASHBOARD_SOURCE_MODE_GLOBAL_ONLY:
        reply_text, meta = local_reply
        meta["dashboard_policy"] = policy
        return reply_text, meta
    if policy["source_mode"] == DASHBOARD_SOURCE_MODE_LOCAL_ONLY:
        if local_reply is not None:
            reply_text, meta = local_reply
            meta["dashboard_policy"] = policy
            return reply_text, meta
        prompt, meta = build_dashboard_clarification_reply(allow_global_fallback=False)
        meta["dashboard_policy"] = policy
        meta["policy_blocked_global"] = True
        return prompt, meta
    global_candidates = [item for item in policy_ctx["allowed_sources"] if safe_text(item.get("scope")) == "global" and bool(item.get("supports_dashboard"))]
    if not global_candidates:
        if local_reply is not None:
            reply_text, meta = local_reply
            meta["dashboard_policy"] = policy
            return reply_text, meta
        prompt, meta = build_dashboard_clarification_reply(allow_global_fallback=True)
        meta["dashboard_policy"] = policy
        return prompt, meta
    preferred_key = policy.get("default_global_source")
    global_source = next((item for item in global_candidates if item["item_key"] == preferred_key), global_candidates[0])
    prefers_global_sources = dashboard_request_prefers_global_sources(text)
    if local_reply is not None and policy["source_mode"] == DASHBOARD_SOURCE_MODE_LOCAL_FIRST:
        reply_text, meta = local_reply
        if local_reply_kind == "clarification_request":
            if prefers_global_sources:
                return build_global_dashboard_reply(text, global_source, policy)
            prompt, meta = build_dashboard_clarification_reply(allow_global_fallback=True)
            meta["dashboard_policy"] = policy
            return prompt, meta
        meta["dashboard_policy"] = policy
        return reply_text, meta
    return build_global_dashboard_reply(text, global_source, policy)


def build_mock_reply(prompt: str) -> str:
