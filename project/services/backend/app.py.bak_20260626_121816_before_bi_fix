def sanitize_about_user_text(text: Any) -> str:
    normalized = re.sub(r"\s+", " ", safe_text(text)).strip(" ;,.-")
    if not normalized:
        return ""
    return normalized if is_allowed_interaction_memory_item(normalized) else ""


def is_allowed_interaction_memory_item(text: str) -> bool:
    normalized = re.sub(r"\s+", " ", safe_text(text)).strip(" ;,.-")
    lowered = normalized.casefold()
    if not normalized:
        return False
    if len(normalized) < 12 or len(normalized) > 160:
        return False
    if len(re.findall(r"\d", normalized)) >= 4:
        return False
    if any(marker in lowered for marker in MEMORY_FORBIDDEN_PATTERNS):
        return False
    if ROLE_MEMORY_RE.search(normalized):
        return True
    if not any(marker in lowered for marker in MEMORY_ALLOWED_PATTERNS):
        return False
    return any(marker in lowered for marker in MEMORY_SCOPE_PATTERNS)


def extract_json_object_from_text(text: str) -> dict[str, Any] | None:
    raw = safe_text(text).strip()
    if not raw:
        return None
    candidates = [raw]
    fenced = re.search(r"```(?:json)?\s*(\{.*?\})\s*```", raw, flags=re.DOTALL)
    if fenced:
        candidates.insert(0, fenced.group(1))
    first = raw.find("{")
    last = raw.rfind("}")
    if first >= 0 and last > first:
        candidates.append(raw[first : last + 1])
    for candidate in candidates:
        try:
            payload = json.loads(candidate)
        except Exception:
            continue
        if isinstance(payload, dict):
            return payload
    return None


def heuristic_memory_candidates_from_messages(message_rows: list[sqlite3.Row]) -> list[str]:
    candidates: list[str] = []
    for row in message_rows:
        if row["role"] != "user":
            continue
        text = safe_text(row["content"]).strip()
        if not text:
            continue
        for sentence in MEMORY_SENTENCE_SPLIT_RE.split(text):
            cleaned = re.sub(r"\s+", " ", sentence).strip(" -•\t\r\n")
            lowered = cleaned.casefold()
            if not cleaned:
                continue
            if len(cleaned) < 12 or len(cleaned) > 140:
                continue
            if len(re.findall(r"\d", cleaned)) >= 4:
                continue
            if cleaned.count(",") >= 2 or cleaned.count(";") >= 2:
                continue
            if ":" in cleaned and ("," in cleaned or "|" in cleaned):
                continue
            if any(token in lowered for token in MEMORY_HINT_PATTERNS):
                candidates.append(cleaned)
    return normalize_memory_items(candidates)


def build_memory_writeback_messages(profile: dict[str, Any], message_rows: list[sqlite3.Row]) -> list[dict[str, str]]:
    transcript = [
        {"role": row["role"], "content": safe_text(row["content"])[:1000]}
        for row in message_rows
        if row["role"] in {"user", "assistant"}
    ]
    prompt = (
        "Извлеки только устойчивые правила взаимодействия с пользователем, которые полезно помнить в следующих диалогах. "
        "Подходят: предпочтения по формату и стилю ответов, повторяющиеся ограничения в коммуникации, как лучше уточнять, как лучше оформлять результат. "
        "Не сохраняй предметное содержание рабочих задач, KPI, метрики, CSV-строки, списки критериев, отраслевые факты, ссылки, IDs, временные поручения, результаты конкретного запроса, бытовые детали и любую чувствительную информацию. "
        "Если не видно устойчивого правила взаимодействия, верни пустой список. Верни строгий JSON-объект вида {\"memories\": [\"...\"]}. Максимум 3 новых пункта, каждый краткий, декларативный, на русском."
    )
    payload = {
        "existing_profile_memory": profile.get("pinned") or [],
        "existing_interaction_memory": profile.get("interaction_memory") or [],
        "messages": transcript[-8:],
    }
    return [
        {"role": "system", "content": prompt},
        {"role": "user", "content": json.dumps(payload, ensure_ascii=False)},
    ]


def llm_memory_candidates_from_messages(profile: dict[str, Any], message_rows: list[sqlite3.Row]) -> list[str]:
    if APP_MODE != "hermes-api" or not HERMES_API_KEY:
        return []
    try:
        reply_text, _meta = call_hermes_messages(build_memory_writeback_messages(profile, message_rows), model_name=HERMES_API_MODEL)
    except Exception:
        return []
    payload = extract_json_object_from_text(reply_text) or {}
    return normalize_memory_items(payload.get("memories") if isinstance(payload, dict) else [])


def merge_interaction_memory(existing: list[str], new_items: list[str]) -> list[str]:
    merged = normalize_memory_items(existing)
    existing_keys = {item.casefold() for item in merged}
    for item in normalize_memory_items(new_items):
        key = item.casefold()
        if key in existing_keys:
            continue
        merged.append(item)
        existing_keys.add(key)
    return normalize_memory_items(merged[-MEMORY_MAX_ITEMS:])


def maybe_update_user_interaction_memory(conn: sqlite3.Connection, user_row: sqlite3.Row, message_rows: list[sqlite3.Row]) -> bool:
    if not MEMORY_WRITEBACK_ENABLED or not message_rows:
        return False
    profile = user_to_dict(user_row, conn)
    existing_memory = profile.get("interaction_memory") or []
    candidates = heuristic_memory_candidates_from_messages(message_rows)
    llm_candidates = llm_memory_candidates_from_messages(profile, message_rows)
    merged = merge_interaction_memory(existing_memory, [*candidates, *llm_candidates])
    last_processed_message_id = max(int(row["id"]) for row in message_rows)
    changed = merged != existing_memory
    conn.execute(
        "UPDATE users SET interaction_memory_json = ?, memory_last_processed_message_id = ?, updated_at = ? WHERE id = ?",
        (json.dumps(merged, ensure_ascii=False), last_processed_message_id, now_iso(), user_row["id"]),
    )
    if changed:
        write_user_change_log(conn, int(user_row["id"]), int(user_row["id"]), "interaction_memory_auto_update")
    return changed


def process_interaction_memory_writeback_once(max_users: int | None = None) -> int:
    if not MEMORY_WRITEBACK_ENABLED:
        return 0
    limit = max(1, int(max_users or MEMORY_WRITEBACK_BATCH_USERS))
    processed = 0
    with db_connect() as conn:
        rows = conn.execute(
            """
            SELECT u.*
            FROM users u
            WHERE u.deleted_at IS NULL
              AND EXISTS (
                    SELECT 1
                    FROM threads t
                    JOIN messages m ON m.thread_id = t.id
                    WHERE t.user_id = u.id
                      AND m.id > COALESCE(u.memory_last_processed_message_id, 0)
                      AND m.role IN ('user', 'assistant')
                )
            ORDER BY COALESCE(u.memory_last_processed_message_id, 0) ASC, u.id ASC
            LIMIT ?
            """,
            (limit,),
        ).fetchall()
        for user_row in rows:
            message_rows = conn.execute(
                """
                SELECT m.*
                FROM messages m
                JOIN threads t ON t.id = m.thread_id
                WHERE t.user_id = ?
                  AND m.id > COALESCE(?, 0)
                  AND m.role IN ('user', 'assistant')
                ORDER BY m.id ASC
                LIMIT 12
                """,
                (user_row["id"], user_row["memory_last_processed_message_id"]),
            ).fetchall()
            if not message_rows:
                continue
            maybe_update_user_interaction_memory(conn, user_row, message_rows)
            processed += 1
    return processed


def reasoning_usage_stats(conn: sqlite3.Connection, user_id: int, usage_date: str | None = None) -> dict[str, Any]:
    current_date = usage_date or utc_today_iso()
    global_row = conn.execute(
        "SELECT COUNT(*) AS request_count, COALESCE(SUM(COALESCE(actual_cost_usd, estimated_cost_usd)), 0) AS total_cost "
        "FROM llm_usage_events WHERE usage_date = ? AND model_key = ?",
        (current_date, LLM_USAGE_REASONING_MODEL),
    ).fetchone()
    user_row = conn.execute(
        "SELECT COUNT(*) AS request_count, COALESCE(SUM(COALESCE(actual_cost_usd, estimated_cost_usd)), 0) AS total_cost "
        "FROM llm_usage_events WHERE usage_date = ? AND model_key = ? AND user_id = ?",
        (current_date, LLM_USAGE_REASONING_MODEL, user_id),
    ).fetchone()
    global_requests = int(global_row["request_count"] or 0)
    global_cost = float(global_row["total_cost"] or 0.0)
    user_requests = int(user_row["request_count"] or 0)
    user_cost = float(user_row["total_cost"] or 0.0)
    return {
        "date": current_date,
        "global_requests": global_requests,
        "global_cost_usd": global_cost,
        "user_requests": user_requests,
        "user_cost_usd": user_cost,
        "global_requests_remaining": max(HERMES_REASONING_DAILY_MAX_REQUESTS - global_requests, 0),
        "user_requests_remaining": max(HERMES_REASONING_DAILY_MAX_PER_USER - user_requests, 0),
        "global_cost_remaining_usd": max(HERMES_REASONING_DAILY_MAX_COST_USD - global_cost, 0.0),
    }


def reasoning_limit_block_reason(stats: dict[str, Any]) -> str | None:
    if not HERMES_REASONING_ENABLED:
        return "reasoning_disabled"
    if stats["global_requests"] >= HERMES_REASONING_DAILY_MAX_REQUESTS:
        return "global_request_limit"
    if stats["user_requests"] >= HERMES_REASONING_DAILY_MAX_PER_USER:
        return "user_request_limit"
    if stats["global_cost_usd"] >= HERMES_REASONING_DAILY_MAX_COST_USD:
        return "global_cost_limit"
    return None


def normalize_chat_model_preference(value: Any) -> str:
    normalized = safe_text(value).strip().lower().replace("-", "_")
    alias_map = {
        "": CHAT_MODEL_AUTO,
        "automatic": CHAT_MODEL_AUTO,
        "auto": CHAT_MODEL_AUTO,
        "owl": CHAT_MODEL_OWL_ALPHA,
        "owl_alpha": CHAT_MODEL_OWL_ALPHA,
        "openrouter/owl_alpha": CHAT_MODEL_OWL_ALPHA,
        "openrouter/owl-alpha": CHAT_MODEL_OWL_ALPHA,
        "deepseek": CHAT_MODEL_DEEPSEEK_R1,
        "deepseek_r1": CHAT_MODEL_DEEPSEEK_R1,
        "deepseek/deepseek_r1_0528": CHAT_MODEL_DEEPSEEK_R1,
        "deepseek/deepseek_r1-0528": CHAT_MODEL_DEEPSEEK_R1,
        "deepseek/deepseek-r1-0528": CHAT_MODEL_DEEPSEEK_R1,
        "r1": CHAT_MODEL_DEEPSEEK_R1,
    }
    resolved = alias_map.get(normalized, normalized)
    if resolved not in CHAT_MODEL_SELECTOR_VALUES:
        return CHAT_MODEL_AUTO
    return resolved


def build_llm_routing_state(user_id: int | None = None, *, conn: sqlite3.Connection | None = None) -> dict[str, Any]:
    owns_conn = conn is None
    active_conn = conn or db_connect()
    try:
        global_stats = reasoning_usage_stats(active_conn, 0)
        user_stats = reasoning_usage_stats(active_conn, int(user_id or 0))
        deepseek_blocked_reason = reasoning_limit_block_reason(user_stats)
        deepseek_available = deepseek_blocked_reason is None
        return {
            "default_model": HERMES_API_MODEL,
            "reasoning_model": HERMES_REASONING_MODEL,
            "routing_enabled": HERMES_REASONING_ROUTING_ENABLED,
            "manual_only": HERMES_REASONING_MANUAL_ONLY,
            "reasoning_enabled": HERMES_REASONING_ENABLED,
            "selector": {
                "default": CHAT_MODEL_AUTO,
                "options": [
                    {"value": CHAT_MODEL_AUTO, "label": "Автоматически", "model": None, "enabled": True},
                    {"value": CHAT_MODEL_OWL_ALPHA, "label": "owl alpha", "model": HERMES_API_MODEL, "enabled": True},
                    {"value": CHAT_MODEL_DEEPSEEK_R1, "label": "DeepSeek R1", "model": HERMES_REASONING_MODEL, "enabled": deepseek_available, "blocked_reason": deepseek_blocked_reason},
                ],
            },
            "limits": {
                "global_requests_per_day": HERMES_REASONING_DAILY_MAX_REQUESTS,
                "per_user_requests_per_day": HERMES_REASONING_DAILY_MAX_PER_USER,
