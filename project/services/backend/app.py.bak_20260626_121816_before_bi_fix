def issue_session(conn: sqlite3.Connection, user_id: int) -> str:
    token = secrets.token_urlsafe(32)
    ts = now_iso()
    conn.execute(
        "INSERT INTO sessions (token, user_id, created_at, last_seen_at, revoked_at) VALUES (?, ?, ?, ?, NULL)",
        (token, user_id, ts, ts),
    )
    return token


def revoke_user_sessions(conn: sqlite3.Connection, user_id: int, *, except_token: str | None = None) -> None:
    ts = now_iso()
    if except_token:
        conn.execute(
            "UPDATE sessions SET revoked_at = ? WHERE user_id = ? AND revoked_at IS NULL AND token <> ?",
            (ts, user_id, except_token),
        )
        return
    conn.execute("UPDATE sessions SET revoked_at = ? WHERE user_id = ? AND revoked_at IS NULL", (ts, user_id))


def maintenance_session_cleanup(conn: sqlite3.Connection) -> None:
    now_ts = now_iso()
    conn.execute(
        """
        UPDATE sessions
        SET revoked_at = ?
        WHERE revoked_at IS NULL
          AND CAST(last_seen_at AS TIMESTAMP) < CAST(? AS TIMESTAMP)
        """,
        (now_ts, now_iso(now_utc() - SESSION_TTL)),
    )
    conn.execute(
        """
        DELETE FROM sessions
        WHERE revoked_at IS NOT NULL
          AND CAST(revoked_at AS TIMESTAMP) < CAST(? AS TIMESTAMP)
        """,
        (now_iso(now_utc() - timedelta(days=30)),),
    )


def maybe_run_session_cleanup(conn: sqlite3.Connection, *, force: bool = False) -> None:
    now_mono = time.monotonic()
    with _session_write_lock:
        last_run = float(_session_cleanup_state.get("last_run_monotonic") or 0.0)
        if not force and (now_mono - last_run) < SESSION_TOUCH_INTERVAL_SECONDS:
            return
        maintenance_session_cleanup(conn)
        _session_cleanup_state["last_run_monotonic"] = now_mono


def maybe_run_interaction_memory_writeback(force: bool = False) -> int:
    now_mono = time.monotonic()
    last_run = float(_interaction_memory_state.get("last_run_monotonic") or 0.0)
    if not force and (now_mono - last_run) < MEMORY_WRITEBACK_POLL_SECONDS:
        return 0
    processed = process_interaction_memory_writeback_once()
    _interaction_memory_state["last_run_monotonic"] = now_mono
    return processed


AUTH_COOKIE_NAME = os.getenv("HERMES_WEB_AUTH_COOKIE_NAME", "hermes_web_token")


def try_get_auth_token() -> str | None:
    auth = request.headers.get("Authorization", "")
    if auth.startswith("Bearer "):
        return auth.split(" ", 1)[1].strip()
    cookie_token = safe_text(request.cookies.get(AUTH_COOKIE_NAME))
    if cookie_token:
        return cookie_token
    query_token = safe_text(request.args.get("access_token") or request.args.get("token"))
    if query_token and request.method == "GET":
        return query_token
    return None


def get_auth_token() -> str:
    token = try_get_auth_token()
    if not token:
        raise ApiError("auth_required", 401)
    return token


def append_access_token(url: str, token: str | None) -> str:
    clean_url = safe_text(url)
    if not clean_url or not token:
        return clean_url
    parts = urllib.parse.urlsplit(clean_url)
    query = urllib.parse.parse_qsl(parts.query, keep_blank_values=True)
    if any(key == 'access_token' for key, _ in query):
        return clean_url
    query.append(('access_token', token))
    return urllib.parse.urlunsplit((parts.scheme, parts.netloc, parts.path, urllib.parse.urlencode(query), parts.fragment))


def authorize_attachment_payload(payload: dict[str, Any]) -> dict[str, Any]:
    token = try_get_auth_token()
    attachments = payload.get('attachments') if isinstance(payload.get('attachments'), list) else []
    if not attachments or not token:
        return payload
    updated = []
    changed = False
    for item in attachments:
        if not isinstance(item, dict):
            updated.append(item)
            continue
        download_url = safe_text(item.get('download_url'))
        authorized_url = append_access_token(download_url, token)
        if authorized_url != download_url:
            changed = True
            updated.append({**item, 'download_url': authorized_url})
        else:
            updated.append(item)
    if not changed:
        return payload
    return {**payload, 'attachments': updated}


def require_auth(*, touch: bool | None = None) -> AuthUser:
    token = get_auth_token()
    touch_session = True if touch is None else touch
    last_db_error: Exception | None = None
    for attempt in range(3):
        try:
            with db_connect() as conn:
                if touch_session:
                    try:
                        maybe_run_session_cleanup(conn)
                    except duckdb.TransactionException:
                        pass
                row = conn.execute(
                    """
                    SELECT u.id, u.role, u.email, s.last_seen_at
                    FROM sessions s
                    JOIN users u ON u.id = s.user_id
                    WHERE s.token = ? AND s.revoked_at IS NULL
                    """,
                    (token,),
                ).fetchone()
                if not row:
                    raise ApiError("invalid_token", 401)
                current_now = now_utc()
                expires_at = session_expires_at(row["last_seen_at"])
                if not expires_at or expires_at <= current_now:
                    with _session_write_lock:
                        conn.execute("UPDATE sessions SET revoked_at = ? WHERE token = ? AND revoked_at IS NULL", (now_iso(current_now), token))
                    raise ApiError("invalid_token", 401)
                if touch_session and should_touch_session(row["last_seen_at"], now=current_now):
                    try:
                        with _session_write_lock:
                            conn.execute("UPDATE sessions SET last_seen_at = ? WHERE token = ?", (now_iso(current_now), token))
                    except duckdb.TransactionException:
                        pass
            return AuthUser(id=row["id"], role=row["role"], email=row["email"])
        except (duckdb.IOException, duckdb.BinderException, duckdb.TransactionException) as exc:
            last_db_error = exc
            if attempt == 2:
                break
            time.sleep(0.1 * (attempt + 1))
    if last_db_error is not None:
        raise ApiError("auth_backend_temporarily_unavailable", 503)
    raise ApiError("invalid_token", 401)


def require_admin() -> AuthUser:
    auth = require_auth()
    if auth.role != "admin":
        raise ApiError("admin_required", 403)
    return auth


