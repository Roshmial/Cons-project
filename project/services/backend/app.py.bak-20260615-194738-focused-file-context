def build_message_export_xml(message_row: sqlite3.Row, thread_title: str) -> str:
    payload = build_message_export_payload(message_row, thread_title)
    lines_xml = "\n".join(
        f"    <line number=\"{index}\">{html.escape(safe_text(line))}</line>"
        for index, line in enumerate(payload["text_lines"], start=1)
    )
    return (
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
        f"<assistant_message id=\"{payload['message_id']}\">\n"
        f"  <thread_title>{html.escape(payload['thread_title'])}</thread_title>\n"
        f"  <created_at>{html.escape(payload['created_at'])}</created_at>\n"
        f"  <content>{html.escape(payload['content'])}</content>\n"
        "  <text_lines>\n"
        f"{lines_xml}\n"
        "  </text_lines>\n"
        "</assistant_message>\n"
    )


def build_message_export_rtf(message_row: sqlite3.Row, thread_title: str) -> str:
    def rtf_escape(value: Any) -> str:
        text = safe_text(value)
        escaped = text.replace('\\', r'\\').replace('{', r'\{').replace('}', r'\}')
        result: list[str] = []
        for ch in escaped:
            code = ord(ch)
            if code > 127:
                if code > 32767:
                    code -= 65536
                result.append(f"\\u{code}?")
            elif ch == '\n':
                result.append(r'\par ')
            else:
                result.append(ch)
        return ''.join(result)

    payload = build_message_export_payload(message_row, thread_title)
    paragraphs = [
        r"{\rtf1\ansi\deff0",
        r"{\fonttbl{\f0 Arial;}}",
        r"\fs24",
        rtf_escape(payload["thread_title"]) + r"\par",
        rtf_escape(f"Сообщение #{payload['message_id']}") + r"\par",
        rtf_escape(f"Дата: {payload['created_at'] or '—'}") + r"\par\par",
    ]
    for line in payload["text_lines"][4:]:
        paragraphs.append(rtf_escape(line) + r"\par")
    paragraphs.append("}")
    return "\n".join(paragraphs)


def build_message_export_docx(message_row: sqlite3.Row, thread_title: str) -> io.BytesIO:
    if docx is None:
        raise ApiError("export_dependency_missing_docx", 503)
    document = docx.Document()
    document.add_heading(thread_title or "Чат", level=1)
    document.add_paragraph(f"Сообщение #{message_row['id']}")
    document.add_paragraph(f"Дата: {safe_text(message_row['created_at']) or '—'}")
    for block in build_message_export_text(message_row, thread_title).split("\n\n"):
        text = safe_text(block)
        if text:
            document.add_paragraph(text)
    buffer = io.BytesIO()
    document.save(buffer)
    buffer.seek(0)
    return buffer


def xlsx_column_name(index: int) -> str:
    value = max(1, int(index))
    parts: list[str] = []
    while value > 0:
        value, remainder = divmod(value - 1, 26)
        parts.append(chr(65 + remainder))
    return "".join(reversed(parts))


