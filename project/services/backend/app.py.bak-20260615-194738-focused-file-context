    email = safe_text(payload.get("email") or payload.get("login")).lower()
    password = payload.get("password") or ""
    if not email or not password:
        raise ApiError("email_and_password_required", 400)
    last_error: duckdb.TransactionException | None = None
    for attempt in range(3):
        try:
            with db_connect() as conn:
                maybe_run_session_cleanup(conn)
                row = conn.execute("SELECT * FROM users WHERE lower(email) = ?", (email,)).fetchone()
                if not row or not check_password_hash(row["password_hash"], password):
                    raise ApiError("invalid_credentials", 401)
                if row["deleted_at"]:
                    raise ApiError("user_deleted", 403)
                if not bool(row["is_active"]):
                    raise ApiError("user_inactive", 403)
                with _session_write_lock:
                    revoke_user_sessions(conn, int(row["id"]))
                    token = issue_session(conn, row["id"])
                user = user_to_dict(row, conn)
            response = jsonify({"token": token, "user": user})
            response.set_cookie(
                AUTH_COOKIE_NAME,
                token,
                max_age=SESSION_TTL_HOURS * 3600,
                httponly=True,
                samesite="Lax",
                secure=bool(request.is_secure),
            )
            return response
        except duckdb.TransactionException as exc:
            last_error = exc
            if attempt >= 2:
                raise
            time.sleep(0.05 * (attempt + 1))
    if last_error is not None:
        raise last_error
    raise ApiError("login_failed", 500)


