def infer_team_constraints(text: str) -> list[str]:
    raw = safe_text(text)
    constraints: list[str] = []
    for pattern in COLLECTION_TEAM_CONSTRAINT_PATTERNS:
        match = re.search(pattern, raw, flags=re.IGNORECASE)
        if not match:
            continue
        value = safe_text(match.group(1)).strip(" .,!?:;»\"")
        if value and value not in constraints:
            constraints.append(value)
    return constraints


def normalize_source_token(value: str) -> str:
    token = safe_text(value).strip().strip(',;')
    token = token.replace('https://', '').replace('http://', '').replace('www.', '')
    token = token.strip('/').strip()
    return token.lower()


def extract_telegram_channels(text: str) -> list[str]:
    raw = safe_text(text)
    candidates: list[str] = []
    candidates.extend(re.findall(r'(?:https?://)?t\.me/([A-Za-z0-9_]{4,})', raw, flags=re.IGNORECASE))
    candidates.extend(re.findall(r'(?<!\w)@([A-Za-z0-9_]{4,})', raw))
    seen: set[str] = set()
    result: list[str] = []
    for item in candidates:
        normalized = safe_text(item).strip().lstrip('@')
        key = normalized.lower()
        if not normalized or key in seen:
            continue
        seen.add(key)
        result.append(normalized)
    return result


def extract_domain_sources(text: str) -> list[str]:
    raw = safe_text(text)
    candidates = re.findall(r'(?:https?://)?(?:www\.)?([A-Za-z0-9.-]+\.[A-Za-z]{2,})(?:/[^\s,;)]*)?', raw, flags=re.IGNORECASE)
    known = ['bidzaar.com', 'roseltorg.ru', 'fabrikant.ru', 'b2b-center.ru', 'etp.gpb.ru', 'zakupki.mos.ru', 'zakupki.gov.ru']
    for domain in known:
        if domain.lower() in raw.lower():
            candidates.append(domain)
    seen: set[str] = set()
    result: list[str] = []
    for item in candidates:
        normalized = normalize_source_token(item)
        if not normalized or '.' not in normalized or normalized in seen:
            continue
        seen.add(normalized)
        result.append(normalized)
    return result


def extract_web_sources(text: str) -> list[str]:
    raw = safe_text(text)
    url_candidates = re.findall(r'https?://[^\s,;)]+' , raw, flags=re.IGNORECASE)
    cleaned_urls: list[str] = []
    seen_urls: set[str] = set()
    for item in url_candidates:
        normalized = safe_text(item).rstrip(').,;')
        if not normalized:
            continue
        key = normalized.lower()
        if key in seen_urls:
            continue
        seen_urls.add(key)
        cleaned_urls.append(normalized)
    if cleaned_urls:
        return cleaned_urls
    return extract_domain_sources(text)


def extract_attachment_source_items(attachments: list[dict[str, Any]] | None) -> list[str]:
    result: list[str] = []
    for item in attachments or []:
        name = safe_text((item or {}).get('original_name'))
        if name and name not in result:
            result.append(name)
    return result


def infer_attachment_subject(text: str, attachments: list[dict[str, Any]] | None) -> str:
    explicit = infer_collection_subject(text)
    if explicit:
        return explicit
    items = extract_attachment_source_items(attachments)
    if not items:
        return ''
    if len(items) == 1:
        return items[0]
    return f"Набор файлов ({len(items)})"


def build_web_source_manifest_items(source_items: list[str] | list[dict[str, Any]], query: str = '') -> list[dict[str, Any]]:
    items: list[dict[str, Any]] = []
    for index, item in enumerate(source_items, start=1):
        source = item if isinstance(item, dict) else {'url': item}
        normalized_url = normalize_web_source_url(source.get('requested_url') or source.get('url') or '')
        parsed = urllib.parse.urlparse(normalized_url)
        domain = safe_text(source.get('domain') or parsed.netloc).lower()
        path = safe_text(source.get('path') or parsed.path) or '/'
        items.append({
            'requested_url': normalized_url,
            'url': normalized_url,
            'title': safe_text(source.get('title') or ''),
            'snippet': safe_text(source.get('snippet') or ''),
            'domain': domain,
            'path': path,
            'query': safe_text(source.get('query') or query),
            'source_rank': source.get('source_rank') or index,
            'availability_level': safe_text(source.get('availability_level') or ('snippet_only' if safe_text(source.get('snippet')) else 'discovered_only')),
        })
    return items


def materialize_web_search_task_sources(contract: dict[str, Any], source_items: list[str] | list[dict[str, Any]], query: str = '') -> dict[str, Any]:
    base_dir = collection_task_artifacts_root('web')
    base_dir.mkdir(parents=True, exist_ok=True)
    slug = build_collection_task_slug(contract)
    stamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    task_path = base_dir / f'web_sources_{slug}_{stamp}.json'
    items = build_web_source_manifest_items(source_items, query=query)
    payload = {
        'kind': 'web_sources',
        'subject': contract.get('subject'),
        'output_format': contract.get('output_format'),
        'fields': contract.get('fields') or [],
        'since_date': contract.get('since_date') or '',
        'query': safe_text(query),
        'items': items,
    }
    task_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding='utf-8')
    return {'kind': 'web_sources', 'path': str(task_path), 'query': safe_text(query), 'items': items}


