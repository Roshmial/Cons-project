def canonicalize_dashboard_source_key(value: Any) -> str:
    key = safe_text(value)
    return LEGACY_DASHBOARD_SOURCE_ALIASES.get(key, key)


def normalize_connector_group_overrides(value: Any) -> dict[str, str]:
    raw = value if isinstance(value, dict) else {}
    normalized: dict[str, str] = {}
    for connector_key, group_key in raw.items():
        child_key = safe_text(connector_key)
        target_group = safe_text(group_key)
        if child_key and target_group in {"internal_connector", "external_connector"}:
            normalized[child_key] = target_group
    return normalized


def normalize_dashboard_policy(value: Any) -> dict[str, Any]:
    payload = value if isinstance(value, dict) else {}
    defaults = default_dashboard_policy_settings()
    source_mode = safe_text(payload.get("source_mode") or DASHBOARD_SOURCE_MODE_LOCAL_FIRST).lower()
    if source_mode not in DASHBOARD_SOURCE_MODES:
        source_mode = DASHBOARD_SOURCE_MODE_LOCAL_FIRST
    allowed_raw = payload.get("allowed_sources") if isinstance(payload.get("allowed_sources"), list) else []
    allowed_sources: list[str] = []
    for item in allowed_raw:
        key = canonicalize_dashboard_source_key(item)
        if key and key not in allowed_sources:
            allowed_sources.append(key)
    if not allowed_sources:
        allowed_sources = list(defaults["allowed_sources"])
    default_global_source = safe_text(payload.get("default_global_source") or "web_research") or "web_research"
    if default_global_source not in allowed_sources:
        default_global_source = "web_research" if "web_research" in allowed_sources else allowed_sources[0]
    requested_targets = payload.get("connector_targets") if isinstance(payload.get("connector_targets"), dict) else {}
    connector_defaults = defaults["connector_targets"] if isinstance(defaults.get("connector_targets"), dict) else {}
    connector_targets: dict[str, list[str]] = {}
    for group_key in {"internal_connector", "external_connector"}:
        if group_key in requested_targets and isinstance(requested_targets.get(group_key), list):
            raw_group = requested_targets.get(group_key)
        else:
            raw_group = connector_defaults.get(group_key, [])
        normalized_group: list[str] = []
        for item in raw_group:
            child_key = safe_text(item)
            if child_key and child_key not in normalized_group:
                normalized_group.append(child_key)
        if group_key not in requested_targets and not normalized_group:
            normalized_group = [safe_text(item) for item in connector_defaults.get(group_key, []) if safe_text(item)]
        connector_targets[group_key] = normalized_group
    return {
        "source_mode": source_mode,
        "allowed_sources": allowed_sources,
        "default_global_source": default_global_source,
        "connector_targets": connector_targets,
        "notes": safe_text(payload.get("notes") or defaults.get("notes") or ""),
    }


