    policy: dict[str, Any],
    user_text: str,
) -> dict[str, Any]:
    def has_data_bearing_visual_items(sections: list[dict[str, Any]]) -> bool:
        for section in sections:
            if safe_text(section.get("kind")) not in {"bar_list", "pie_list", "bubble_list", "timeline_list", "matrix_list"}:
                continue
            items = section.get("items") or []
            if not isinstance(items, list):
                continue
            for item in items:
                if isinstance(item, dict):
                    ratio = item.get("ratio")
                    value = item.get("value")
                    if isinstance(ratio, (int, float)) and float(ratio) > 0:
                        return True
                    if isinstance(value, (int, float)) and float(value) > 0:
                        return True
                    if isinstance(value, str) and value.strip().isdigit() and int(value.strip()) > 0:
                        return True
        return False

    intent = infer_external_dashboard_intent(user_text)
    business_function = infer_business_dashboard_function(user_text)
    blueprint = build_external_dashboard_blueprint(intent)
    force_russian = user_prefers_russian_dashboard(user_text)
    if force_russian and not text_looks_cyrillic(reply_text):
        reply_text = f"Собрала структурированный дашборд по теме: {safe_text(user_text)[:120] or 'внешнее исследование'}. Числовые блоки без подтверждённых источников исключены; сохранены только содержательные и честно ограниченные секции."
    normalized_sections = []
    for index, section in enumerate(dashboard.get("sections") or []):
        normalized = normalize_dashboard_section(section, index)
        if normalized is not None:
            if force_russian and section_is_clearly_english(normalized):
                continue
            if normalized.get("kind") in {"bar_list", "pie_list", "bubble_list"} and (
                text_contains_synthetic_marker(normalized.get("title"))
                or text_contains_synthetic_marker(normalized.get("note"))
                or section_items_contain_synthetic_markers(normalized)
            ):
                continue
            normalized_sections.append(normalized)
    if intent == "history_evolution":
        normalized_sections = [
            section
            for section in normalized_sections
            if section.get("kind") not in {"pie_list", "bubble_list"}
        ]
    normalized_sections = prioritize_dashboard_sections(normalized_sections, blueprint, user_text)
    visual_data_available = has_data_bearing_visual_items(normalized_sections)
    if len(normalized_sections) < blueprint["minimum_sections"]:
        existing_signatures = {
            (safe_text(section.get("kind")), safe_text(section.get("title")).strip().lower())
            for section in normalized_sections
        }
        for section in build_intent_aware_minimal_sections(intent, reply_text, user_text, source_meta, policy):
            signature = (safe_text(section.get("kind")), safe_text(section.get("title")).strip().lower())
            if signature in existing_signatures:
                continue
            normalized_sections.append(section)
            existing_signatures.add(signature)
    existing_kinds = {section["kind"] for section in normalized_sections}
    for visual_kind in blueprint["visual_sections"]:
        if not visual_data_available and not (intent == "history_evolution" and visual_kind in {"timeline_list", "matrix_list"}):
            break
        if visual_kind in existing_kinds:
            continue
        if visual_kind == "timeline_list":
            normalized_sections.append({
                "kind": "timeline_list",
                "title": "Ключевые этапы и поворотные точки",
                "note": "Нужно добрать подтверждённые периоды и этапы, чтобы усилить хронологию.",
                "items": [{"label": "Текущий срез", "value": safe_text(user_text)[:140] or "Запрос пользователя"}],
            })
        elif visual_kind == "matrix_list":
            normalized_sections.append({
                "kind": "matrix_list",
                "title": "Сегменты, критерии или смысловые сдвиги",
                "note": "Матрица добавлена как содержательный каркас, а не как техническая заглушка.",
                "items": [{"label": "Фокус", "value": safe_text(user_text)[:140] or "Запрос пользователя"}],
            })
        elif visual_kind == "bar_list" and intent == "market_overview":
            normalized_sections.append({
                "kind": "bar_list",
                "title": "Игроки, сигналы и рыночные акценты",
                "note": "Минимальный market-overview каркас без synthetic-метрик.",
                "items": [{"label": "Тема", "value": safe_text(user_text)[:140] or "Рынок", "meta": "Нужны подтверждённые рыночные сигналы"}],
            })
        elif visual_kind == "post_list" and intent == "evidence_board":
            normalized_sections.append({
                "kind": "post_list",
                "title": "Опорные подтверждения",
                "note": "Нужно добрать больше прямых evidence-фрагментов для richer board.",
                "items": [{"title": safe_text(user_text)[:140] or "Тема", "subtitle": "Пока это минимальный evidence-first контур"}],
            })
    normalized_sections = prioritize_dashboard_sections(normalized_sections, blueprint, user_text)
    summary_cards = []
    for card in dashboard.get("summary_cards") or []:
        if not isinstance(card, dict):
            continue
        label = safe_text(card.get("label"))
        value = safe_text(card.get("value"))
        if not label or not value:
            continue
        if force_russian and not text_looks_cyrillic(f"{label} {value} {safe_text(card.get('note'))}"):
            continue
        if text_contains_synthetic_marker(label) or text_contains_synthetic_marker(value) or text_contains_synthetic_marker(card.get("note")):
            continue
        normalized_card = {"label": label, "value": value}
        note = safe_text(card.get("note"))
        if note:
            normalized_card["note"] = note
        summary_cards.append(normalized_card)
    if not summary_cards:
        summary_cards = build_intent_aware_summary_cards(intent, source_meta, policy, blueprint, business_function)
    else:
        existing_labels = {safe_text(card.get('label')).strip().lower() for card in summary_cards if isinstance(card, dict)}
        function_card = build_business_function_context_card(business_function)
        source_shape_card = build_source_shape_card(source_meta)
        for extra_card in (function_card, source_shape_card):
            if safe_text(extra_card.get('label')).strip().lower() not in existing_labels:
                summary_cards.append(extra_card)
                existing_labels.add(safe_text(extra_card.get('label')).strip().lower())
    normalized_sources = []
    for source in dashboard.get("sources") or []:
        if not isinstance(source, dict):
            continue
        label = safe_text(source.get("label") or source.get("title") or source.get("url"))
        url = safe_text(source.get("url"))
        if not label and not url:
            continue
        normalized_source = {}
        if label:
            normalized_source["label"] = label
        if url:
            normalized_source["url"] = url
        normalized_sources.append(normalized_source)
    if not normalized_sources:
        source_label = safe_text(source_meta.get("label") or source_meta.get("item_key") or "Внешний источник")
        normalized_sources.append({"label": source_label})
    normalized_title = safe_text(dashboard.get("title") or source_meta.get("label") or ("Внешний дашборд" if force_russian else "External dashboard"))
    normalized_subtitle = safe_text(dashboard.get("subtitle") or f"Adaptive grammar v1 · {blueprint['goal']} · source shape: {infer_structured_source_shape(source_meta)}")
    normalized_notes = ("" if (force_russian and not text_looks_cyrillic(dashboard.get("notes"))) or text_contains_synthetic_marker(dashboard.get("notes")) else safe_text(dashboard.get("notes") or ""))
    if force_russian and not text_looks_cyrillic(normalized_title):
        normalized_title = f"Дашборд по теме: {safe_text(user_text)[:80] or 'внешнее исследование'}"
    if force_russian and not text_looks_cyrillic(normalized_subtitle):
        normalized_subtitle = f"Adaptive grammar v1 · {blueprint['goal']} · source shape: {infer_structured_source_shape(source_meta)}"
    if force_russian and not text_looks_cyrillic(reply_text):
        reply_text = f"Собрала структурированный дашборд по теме: {safe_text(user_text)[:120] or 'внешнее исследование'}. Числовые блоки без подтверждённых источников исключены; сохранены только содержательные и честно ограниченные секции."
    return {
        "kind": safe_text(dashboard.get("kind") or "external_research_dashboard"),
        "grammar_version": EXTERNAL_DASHBOARD_GRAMMAR_VERSION,
        "intent": intent,
        "business_function": business_function,
        "selection_policy": {
            "goal": blueprint["goal"],
            "priority_blocks": blueprint["priority_blocks"],
            "minimum_sections": blueprint["minimum_sections"],
        },
        "title": normalized_title,
        "subtitle": normalized_subtitle,
        "summary_cards": summary_cards,
        "sections": normalized_sections,
        "sources": normalized_sources,
        "notes": normalized_notes,
    }


def build_dashboard_reference_guidance(intent: str, business_function: str) -> str:
    references = get_dashboard_grammar_reference()
    chunks: list[str] = []
    shared_item = references.get("dashboard_semantic_core")
    if isinstance(shared_item, dict):
        guidance = shared_item.get('guidance') if isinstance(shared_item.get('guidance'), list) else []
        if guidance:
            chunks.append(' '.join(safe_text(item) for item in guidance if safe_text(item)))
    intent_item = references.get(f"dashboard_{intent}")
    if isinstance(intent_item, dict):
        goal = safe_text(intent_item.get('goal') or '')
        if goal:
            chunks.append(f"Reference goal: {goal}.")
        preferred_sections = intent_item.get('preferred_sections') if isinstance(intent_item.get('preferred_sections'), list) else []
        if preferred_sections:
            chunks.append(f"Reference preferred sections: {', '.join(safe_text(item) for item in preferred_sections if safe_text(item))}.")
        guidance = intent_item.get('guidance') if isinstance(intent_item.get('guidance'), list) else []
        if guidance:
            chunks.append(' '.join(safe_text(item) for item in guidance if safe_text(item)))
    function_item = references.get(f"dashboard_{business_function}")
    if isinstance(function_item, dict):
        guidance = function_item.get('guidance') if isinstance(function_item.get('guidance'), list) else []
        if guidance:
            chunks.append(' '.join(safe_text(item) for item in guidance if safe_text(item)))
    return ' '.join(chunk for chunk in chunks if chunk)


def build_external_dashboard_intent_prompt(intent: str, business_function: str = 'general_business') -> str:
    function_spec = build_business_function_spec(business_function)
    intent_rules = {
        'review': 'Для review собери содержательный обзор темы: 1) рамка и определение, 2) ключевые части или этапы, 3) практический смысл, 4) ограничения и оговорки. Если запрос обзорно-исторический, не своди его только к chronology dump.',
        'market_overview': 'Для market_overview сначала собери рыночную рамку: 1) контекст рынка/категории, 2) ключевые игроки, 3) позиционирование и продукты, 4) сигналы спроса/динамики, 5) ограничения и риски. Не подменяй обзор рынка общими best practices.',
        'comparison': 'Для comparison строй dashboard вокруг сравнения по критериям: объекты сравнения, различия, trade-offs, сильные и слабые стороны, где данных не хватает. Если чисел мало, используй matrix_list и text_list, а не псевдографики.',
        'trend': 'Для trend покажи динамику по периодам, поворотные точки, драйверы изменений и последствия. Если есть даты/периоды — используй timeline_list как один из первых блоков.',
        'segmentation': 'Для segmentation сначала выдели сегменты, затем покажи отличия, характерные признаки и ограничения сегментации. Не смешивай сегментацию с generic market overview.',
        'history_evolution': 'Для history_evolution отделяй этапы от смысловых сдвигов: timeline для хронологии, matrix для того, что менялось по ролям, подходам, архитектуре или модели потребления.',
        'evidence_board': 'Для evidence_board показывай не общую сводку, а evidence-first структуру: что подтверждено, какими примерами, где gaps и насколько выводы устойчивы.',
    }
    base = intent_rules.get(intent, 'Сначала определи аналитическую задачу и собери dashboard вокруг фактов, различий, ограничений и полезных выводов, а не вокруг универсального шаблона.')
