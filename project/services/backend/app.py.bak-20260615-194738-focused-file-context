def now_utc() -> datetime:
    return datetime.now(UTC)


def now_iso(value: datetime | None = None) -> str:
    current = value or now_utc()
    return current.astimezone(UTC).replace(microsecond=0).isoformat()


def parse_iso(value: str | None) -> datetime | None:
    if not value:
        return None
    normalized = value.replace("Z", "+00:00")
    try:
        dt = datetime.fromisoformat(normalized)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=UTC)
    return dt.astimezone(UTC)


def session_expires_at(last_seen_at: str | None) -> datetime | None:
    seen_at = parse_iso(last_seen_at)
    if not seen_at:
        return None
    return seen_at + SESSION_TTL


def should_touch_session(last_seen_at: str | None, *, now: datetime | None = None) -> bool:
    seen_at = parse_iso(last_seen_at)
    if not seen_at:
        return True
    current = now or now_utc()
    return (current - seen_at).total_seconds() >= SESSION_TOUCH_INTERVAL_SECONDS


def parse_date(value: str | None) -> date | None:
    if not value:
        return None
    try:
        return date.fromisoformat(value)
    except ValueError:
        return None


def normalize_time_of_day(value: str | None, fallback: str = "09:00") -> str:
    raw = (value or fallback).strip()
    parts = raw.split(":")
    if len(parts) != 2:
        return fallback
    try:
        hours = int(parts[0])
        minutes = int(parts[1])
    except ValueError:
        return fallback
    if not (0 <= hours <= 23 and 0 <= minutes <= 59):
        return fallback
    return f"{hours:02d}:{minutes:02d}"


def normalize_timezone(value: str | None, fallback: str = "UTC") -> str:
    candidate = (value or fallback).strip() or fallback
    try:
        ZoneInfo(candidate)
        return candidate
    except Exception:
        return fallback


def json_loads(value: str | None, fallback: Any) -> Any:
    if not value:
        return fallback
    try:
        return json.loads(value)
    except json.JSONDecodeError:
        return fallback


class DBRow(dict):
    def __getitem__(self, key):
        if isinstance(key, int):
            return list(self.values())[key]
        return super().__getitem__(key)


class DBCursor:
    def __init__(self, result: Any | None = None, lastrowid: int | None = None):
        self._result = result
        self.lastrowid = lastrowid

    def _columns(self) -> list[str]:
        if self._result is None or not getattr(self._result, 'description', None):
            return []
        return [item[0] for item in self._result.description]

    def fetchone(self):
        if self._result is None:
            return None
        row = self._result.fetchone()
        if row is None:
            return None
        columns = self._columns()
        if columns:
            return DBRow(zip(columns, row))
        return row

    def fetchall(self):
        if self._result is None:
            return []
        rows = self._result.fetchall()
        columns = self._columns()
        if columns:
            return [DBRow(zip(columns, row)) for row in rows]
        return rows


def _translate_qmark_to_pyformat(query: str) -> str:
    parts: list[str] = []
    in_single = False
    in_double = False
    i = 0
    while i < len(query):
        char = query[i]
        if char == "'" and not in_double:
            parts.append(char)
            if in_single and i + 1 < len(query) and query[i + 1] == "'":
                parts.append(query[i + 1])
                i += 2
                continue
            in_single = not in_single
            i += 1
            continue
        if char == '"' and not in_single:
            parts.append(char)
            if in_double and i + 1 < len(query) and query[i + 1] == '"':
                parts.append(query[i + 1])
                i += 2
                continue
            in_double = not in_double
            i += 1
            continue
        if char == '?' and not in_single and not in_double:
            parts.append('%s')
        else:
            parts.append(char)
        i += 1
    return ''.join(parts)


def _split_sql_script(script: str) -> list[str]:
    statements: list[str] = []
    current: list[str] = []
    in_single = False
    in_double = False
    i = 0
    while i < len(script):
        char = script[i]
        current.append(char)
        if char == "'" and not in_double:
            if in_single and i + 1 < len(script) and script[i + 1] == "'":
                current.append(script[i + 1])
                i += 2
                continue
            in_single = not in_single
        elif char == '"' and not in_single:
            if in_double and i + 1 < len(script) and script[i + 1] == '"':
                current.append(script[i + 1])
                i += 2
                continue
            in_double = not in_double
        elif char == ';' and not in_single and not in_double:
            statement = ''.join(current).strip()
            if statement:
                statements.append(statement)
            current = []
        i += 1
    tail = ''.join(current).strip()
    if tail:
        statements.append(tail)
    return statements


class DBConnection:
    def __init__(self, path: Path | None = None, dsn: str | None = None):
        last_error: Exception | None = None
        self._conn = None
        self.driver = DB_DRIVER
        self._path = path or DB_PATH
        self._dsn = dsn or DB_DSN
        for attempt in range(DB_CONNECT_RETRY_ATTEMPTS):
            conn = None
            try:
                if self.driver == 'postgres':
                    if psycopg is None:
                        raise RuntimeError('psycopg is required for postgres backend')
                    conn = psycopg.connect(self._dsn, autocommit=False)
                    with conn.cursor() as cur:
                        cur.execute(f"CREATE SCHEMA IF NOT EXISTS {APP_DB_SCHEMA}")
                        cur.execute(f"SET search_path TO {APP_DB_SCHEMA}")
                else:
                    conn = duckdb.connect(str(self._path))
                    global _duckdb_schema_initialized
                    if not _duckdb_schema_initialized:
                        with _duckdb_schema_init_lock:
                            if not _duckdb_schema_initialized:
                                conn.execute(f"CREATE SCHEMA IF NOT EXISTS {APP_DB_SCHEMA}")
                                _duckdb_schema_initialized = True
                    conn.execute(f"SET schema='{APP_DB_SCHEMA}'")
                self._conn = conn
                last_error = None
                break
            except Exception as exc:
                last_error = exc
                try:
                    if conn is not None:
                        conn.close()
                except Exception:
                    pass
                if attempt == DB_CONNECT_RETRY_ATTEMPTS - 1:
                    break
                time.sleep(DB_CONNECT_RETRY_DELAY_SECONDS * (attempt + 1))
        if self._conn is None:
            assert last_error is not None
            raise last_error

    def execute(self, query: str, params: tuple[Any, ...] | list[Any] | None = None) -> DBCursor:
        if self.driver == 'postgres':
            cur = self._conn.cursor()
            cur.execute(_translate_qmark_to_pyformat(query), list(params or []))
            return DBCursor(result=cur)
        result = self._conn.execute(query, params or [])
        return DBCursor(result=result)

    def executemany(self, query: str, rows: list[tuple[Any, ...]]) -> None:
        if not rows:
            return
        if self.driver == 'postgres':
            with self._conn.cursor() as cur:
                cur.executemany(_translate_qmark_to_pyformat(query), rows)
            return
        self._conn.executemany(query, rows)

    def executescript(self, script: str) -> None:
        if self.driver == 'postgres':
            with self._conn.cursor() as cur:
                for statement in _split_sql_script(script):
                    cur.execute(statement)
            return
        self._conn.execute(script)

    def commit(self) -> None:
        self._conn.commit()

    def rollback(self) -> None:
        self._conn.rollback()

    def close(self) -> None:
        self._conn.close()

    def __enter__(self):
        if self.driver != 'postgres':
            _duckdb_request_lock.acquire()
        return self

    def __exit__(self, exc_type, exc, tb):
        try:
            if exc_type is None:
                self.commit()
            else:
                try:
                    self.rollback()
                except Exception:
                    pass
        finally:
            try:
                self.close()
            finally:
                if self.driver != 'postgres':
                    _duckdb_request_lock.release()


def db_connect() -> DBConnection:
