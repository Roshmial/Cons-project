    for field in [*base_fields, 'source_url', 'record_type', 'source_status', 'title', 'domain', 'query', 'source_rank', 'availability_level', 'snippet', 'error_reason']:
        if field and field not in column_order:
            column_order.append(field)
    combined: list[dict[str, Any]] = []
    for row in rows:
        normalized = {field: safe_text(row.get(field)) for field in column_order}
        normalized['record_type'] = 'document_row'
        normalized['source_status'] = safe_text(normalized.get('source_status') or 'available')
        combined.append(normalized)
    for row in shortlist_rows:
        normalized = {field: safe_text(row.get(field)) for field in column_order}
        normalized['record_type'] = safe_text(normalized.get('record_type') or 'source_shortlist')
        normalized['source_status'] = safe_text(normalized.get('source_status') or 'unavailable')
        combined.append(normalized)
    return combined, column_order


def build_proposal_composition_prompt(contract: dict[str, Any], documents: list[dict[str, Any]], rows: list[dict[str, Any]]) -> list[dict[str, str]]:
    docs_payload = [
        {
            'source': safe_text(item.get('final_url') or item.get('requested_url') or item.get('title')),
            'title': safe_text(item.get('title')),
            'text_excerpt': safe_text(item.get('text'))[:6000],
        }
        for item in documents[:8]
    ]
    rows_payload = rows[:20]
    system_prompt = (
        'Ты готовишь проект коммерческого предложения или оценку по собранным материалам. '
        'Нельзя выдумывать факты. Нужно жёстко разделять: confirmed_facts, analogs, hypotheses. '
        'Если точных данных нет, пиши аккуратную гипотезу или открытый вопрос. '
        'Верни строго JSON без markdown. '
        'Формат: '
        '{"title":"...","executive_summary":"...","confirmed_facts":[...],"analogs":[...],'
        '"hypotheses":[...],"workstreams":[{"name":"...","scope":"...","estimate_hours":"...","team_role":"...","notes":"..."}],'
        '"cost_notes":[...],"resource_plan":[...],"risks":[...],"open_questions":[...]}'
    )
    user_prompt = json.dumps({
        'composition_mode': contract.get('composition_mode'),
        'subject': contract.get('subject'),
        'source_kind': contract.get('source_kind'),
        'request_text': contract.get('request_text'),
        'fields': contract.get('fields') or [],
        'budget_hint': contract.get('budget_hint') or '',
        'timeline_hint': contract.get('timeline_hint') or '',
        'team_constraints': contract.get('team_constraints') or [],
        'documents': docs_payload,
        'rows_preview': rows_payload,
    }, ensure_ascii=False)
    return [
        {'role': 'system', 'content': system_prompt},
        {'role': 'user', 'content': user_prompt},
    ]


def compose_proposal_payload(contract: dict[str, Any], documents: list[dict[str, Any]], rows: list[dict[str, Any]]) -> dict[str, Any]:
    reply_text, _ = call_hermes_messages(build_proposal_composition_prompt(contract, documents, rows), model_name=HERMES_API_MODEL)
    payload = extract_json_object(reply_text)
    if not isinstance(payload, dict):
        raise ApiError('proposal_composition_invalid_payload', 502)
    return payload


def render_proposal_markdown(contract: dict[str, Any], payload: dict[str, Any]) -> str:
    title = safe_text(payload.get('title') or contract.get('subject') or 'Проект КП')
    summary = safe_text(payload.get('executive_summary'))
    lines = [f'# {title}', '']
    if summary:
        lines.extend(['## Краткий вывод', summary, ''])
    lines.extend([
        '## Параметры запроса',
        f"- Режим композиции: {safe_text(contract.get('composition_mode')) or 'не указан'}",
        f"- Источник: {safe_text(contract.get('source_label')) or safe_text(contract.get('source_kind'))}",
        f"- Тема: {safe_text(contract.get('subject'))}",
        f"- Бюджет / cost hint: {safe_text(contract.get('budget_hint')) or 'не указан'}",
        f"- Срок / timeline hint: {safe_text(contract.get('timeline_hint')) or 'не указан'}",
        '',
    ])
    team_constraints = contract.get('team_constraints') or []
    if team_constraints:
        lines.append('## Ограничения по команде')
        for item in team_constraints:
            lines.append(f"- {safe_text(item)}")
        lines.append('')
    sections = [
        ('Подтверждённые факты', 'confirmed_facts'),
        ('Аналоги', 'analogs'),
        ('Гипотезы и допущения', 'hypotheses'),
        ('Заметки по стоимости', 'cost_notes'),
        ('Ресурсный план', 'resource_plan'),
        ('Риски', 'risks'),
        ('Открытые вопросы', 'open_questions'),
    ]
    for section_title, key in sections:
        items = payload.get(key) or []
        if not items:
            continue
        lines.append(f'## {section_title}')
        for item in items:
            lines.append(f"- {safe_text(item)}")
        lines.append('')
    workstreams = payload.get('workstreams') or []
    if workstreams:
        lines.append('## Workstreams / состав работ')
        for item in workstreams:
            if not isinstance(item, dict):
                continue
            name = safe_text(item.get('name') or 'Workstream')
            scope = safe_text(item.get('scope'))
            hours = safe_text(item.get('estimate_hours'))
            team_role = safe_text(item.get('team_role'))
            notes = safe_text(item.get('notes'))
            lines.append(f"### {name}")
            if scope:
                lines.append(f"- Scope: {scope}")
            if hours:
                lines.append(f"- Estimate hours: {hours}")
            if team_role:
                lines.append(f"- Team role: {team_role}")
            if notes:
                lines.append(f"- Notes: {notes}")
            lines.append('')
    return '\n'.join(lines).strip() + '\n'


def build_proposal_artifact_attachment(contract: dict[str, Any], payload: dict[str, Any]) -> dict[str, Any]:
    subject = build_collection_task_slug(contract)
    stamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    base_dir = collection_task_artifacts_root(contract.get('source_kind') or 'web') / 'artifacts'
    base_dir.mkdir(parents=True, exist_ok=True)
    file_path = base_dir / f'proposal_{subject}_{stamp}.md'
    file_path.write_text(render_proposal_markdown(contract, payload), encoding='utf-8')
    return {
        'kind': 'proposal_artifact',
        'original_name': file_path.name,
        'stored_name': file_path.name,
        'relative_path': str(file_path.relative_to(DATA_DIR)),
        'local_path': str(file_path),
        'mime_type': 'text/markdown',
        'size_bytes': file_path.stat().st_size,
        'download_url': f"{API_PREFIX}/artifacts/collection/{urllib.parse.quote(file_path.name)}",
    }


def maybe_attach_proposal_artifact(contract: dict[str, Any], documents: list[dict[str, Any]], rows: list[dict[str, Any]], attachments: list[dict[str, Any]], base_downstream: str) -> tuple[str, dict[str, Any]] | None:
    composition_mode = safe_text(contract.get('composition_mode'))
    if not composition_mode:
        return None
    payload = compose_proposal_payload(contract, documents, rows)
    proposal_attachment = build_proposal_artifact_attachment(contract, payload)
