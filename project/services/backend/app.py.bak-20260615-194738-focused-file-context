def normalize_job_payload(payload: dict[str, Any], owner_profile: dict[str, Any]) -> dict[str, Any]:
    name = safe_text(payload.get("name"))
    if not name:
        raise ApiError("job_name_required", 400)
    display_name = safe_text(payload.get("display_name"))
    job_type = safe_text(payload.get("job_type") or "daily_brief")
    with db_connect() as conn:
        runtime_refs = get_cached_runtime_reference_views(conn)
    job_templates = runtime_refs["job_templates"]
    if job_type not in job_templates:
        raise ApiError("job_type_invalid", 400)
    visibility = safe_text(payload.get("visibility") or "private")
    if visibility not in {"private", "shared", "workspace"}:
        raise ApiError("job_visibility_invalid", 400)
    status = safe_text(payload.get("status") or "active")
    if status not in {"active", "paused"}:
        raise ApiError("job_status_invalid", 400)
    schedule_kind = safe_text(payload.get("schedule_kind") or "daily")
    if schedule_kind not in {"daily", "weekdays", "weekly", "monthly"}:
        raise ApiError("job_schedule_invalid", 400)
    time_of_day = normalize_time_of_day(payload.get("time_of_day"), "09:00")
    timezone_name = normalize_timezone(payload.get("timezone"), owner_profile["timezone"] or "UTC")
    start_date = parse_date(payload.get("start_date")) or now_utc().astimezone(ZoneInfo(timezone_name)).date()
    days_of_week = normalize_days_of_week(payload.get("days_of_week") if isinstance(payload.get("days_of_week"), list) else [])
    if schedule_kind == "weekly" and not days_of_week:
        days_of_week = [WEEKDAY_NAMES[start_date.weekday()]]
    description = safe_text(payload.get("description"))
    parameters = payload.get("parameters") if isinstance(payload.get("parameters"), dict) else {}
    self_subscribe_enabled = bool(payload.get("self_subscribe_enabled"))
    self_subscribe_scope = safe_text(payload.get("self_subscribe_scope") or ("visible_users" if self_subscribe_enabled else "disabled"))
    if self_subscribe_scope not in {"disabled", "visible_users", "workspace"}:
        raise ApiError("job_self_subscribe_scope_invalid", 400)
    if not self_subscribe_enabled:
        self_subscribe_scope = "disabled"
    template = safe_text(payload.get("prompt_template"))
    if not template:
        template = build_default_job_template(job_type)
    access_items = []
    for item in payload.get("access") or []:
        if not isinstance(item, dict):
            continue
        try:
            user_id = int(item.get("user_id"))
        except (TypeError, ValueError):
            continue
        role = safe_text(item.get("role") or "viewer")
        if role not in {"viewer", "editor"}:
            continue
        access_items.append({"user_id": user_id, "role": role})
    recipients = []
    for item in payload.get("recipients") or []:
        if not isinstance(item, dict):
            continue
        recipient_type = safe_text(item.get("recipient_type") or item.get("type") or "owner")
        if recipient_type not in {"owner", "subscribers", "fixed_user", "fixed_thread", "workspace"}:
            continue
        target_value = safe_text(item.get("target_value") or item.get("value") or ("self" if recipient_type == "owner" else recipient_type))
        label = safe_text(item.get("label") or target_value)
        recipients.append({"recipient_type": recipient_type, "target_value": target_value, "label": label})
    if not recipients:
        recipients = [{"recipient_type": "owner", "target_value": "self", "label": "Только владелец"}]
    schedule_preview_source = {
        "schedule_kind": schedule_kind,
        "days_of_week": days_of_week,
        "time_of_day": time_of_day,
        "start_date": start_date.isoformat(),
        "timezone": timezone_name,
        "status": status,
    }
    return {
        "name": name,
        "display_name": display_name,
        "description": description,
        "job_type": job_type,
        "visibility": visibility,
        "status": status,
        "schedule_kind": schedule_kind,
        "days_of_week": days_of_week,
        "time_of_day": time_of_day,
        "start_date": start_date.isoformat(),
        "timezone": timezone_name,
        "prompt_template": template,
        "parameters": parameters,
        "self_subscribe_enabled": self_subscribe_enabled,
        "self_subscribe_scope": self_subscribe_scope,
        "access": access_items,
        "recipients": recipients,
        "next_run_at": compute_next_run(schedule_preview_source),
        "next_runs_preview": preview_next_runs(schedule_preview_source),
        "schedule_summary": build_schedule_summary(schedule_preview_source),
    }


def build_default_job_template(job_type: str) -> str:
    if job_type == "daily_brief":
        return "Собери короткий рабочий бриф. Фокус: {focus}. Формат: {format}. Учитывай: {notes}."
    if job_type == "decision_review":
        return "Разбери тему: {topic}. Критерии: {criteria}. На выходе нужен: {outcome}."
    if job_type == "research_watch":
        return "Подготовь обзор по теме {subject}. Угол: {angle}. Форма результата: {output}."
    return "Сделай задачу: {goal}. Контекст: {context}."


def save_job_relations(conn: sqlite3.Connection, job_id: int, payload: dict[str, Any]) -> None:
    conn.execute("DELETE FROM job_acl WHERE job_id = ?", (job_id,))
    conn.execute("DELETE FROM job_recipients WHERE job_id = ?", (job_id,))
    ts = now_iso()
    for item in payload["access"]:
        conn.execute(
            "INSERT INTO job_acl (job_id, user_id, role, created_at) VALUES (?, ?, ?, ?)",
            (job_id, item["user_id"], item["role"], ts),
        )
    for item in payload["recipients"]:
        conn.execute(
            "INSERT INTO job_recipients (job_id, recipient_type, target_value, label, created_at) VALUES (?, ?, ?, ?, ?)",
            (job_id, item["recipient_type"], item["target_value"], item["label"], ts),
        )


def create_or_update_job(
    conn: sqlite3.Connection,
    auth: AuthUser,
    payload: dict[str, Any],
    job_id: int | None = None,
    expected_version: int | None = None,
) -> dict[str, Any]:
    user_row = conn.execute("SELECT * FROM users WHERE id = ?", (auth.id,)).fetchone()
    owner_profile = user_to_dict(user_row, conn)
    current_job_row = get_job_by_id(conn, job_id) if job_id is not None else None
    if current_job_row is not None and expected_version is not None and int(current_job_row["version"] or 1) != int(expected_version):
        raise ApiError("version_conflict", 409)
    normalized = normalize_job_payload(payload, owner_profile)
    ts = now_iso()
    if job_id is None:
        cur = conn.execute(
            """
            INSERT INTO jobs (
                user_id, name, display_name, description, job_type, visibility, status, schedule_kind,
                days_of_week_json, time_of_day, start_date, timezone, prompt_template,
                parameters_json, self_subscribe_enabled, self_subscribe_scope, version, next_run_at, created_at, updated_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, ?, ?, ?) RETURNING id
            """,
            (
                auth.id,
                normalized["name"],
                normalized["display_name"],
                normalized["description"],
                normalized["job_type"],
                normalized["visibility"],
                normalized["status"],
                normalized["schedule_kind"],
                json.dumps(normalized["days_of_week"], ensure_ascii=False),
                normalized["time_of_day"],
                normalized["start_date"],
                normalized["timezone"],
                normalized["prompt_template"],
                json.dumps(normalized["parameters"], ensure_ascii=False),
                1 if normalized["self_subscribe_enabled"] else 0,
                normalized["self_subscribe_scope"],
                normalized["next_run_at"],
                ts,
                ts,
            ),
        )
        job_id = cur.fetchone()[0]
    else:
        current_version = int(current_job_row["version"] or 1) if current_job_row is not None else 1
        next_version = current_version + 1
        updated = conn.execute(
            """
            UPDATE jobs
            SET name = ?, display_name = ?, description = ?, job_type = ?, visibility = ?, status = ?, schedule_kind = ?,
