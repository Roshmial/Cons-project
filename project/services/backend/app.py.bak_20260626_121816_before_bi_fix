    if funnel_card:
        summary_cards.append(funnel_card)
    if funnel_section:
        sections.append(funnel_section)
    concentration_card = build_concentration_card(rows, channel_col, leads_col or cost_col, label='Концентрация по каналу', note='Показывает, насколько результат зависит от одного ведущего канала')
    if concentration_card:
        summary_cards.append(concentration_card)
    append_time_series_section(sections, rows, date_col, leads_col or cost_col, title='Динамика маркетингового потока', note='Показывает, как меняется маркетинговая активность по периодам.', meta='Маркетинговый объём по периоду')
    return summary_cards, sections, conclusions


def build_finance_dataset_insights(rows: list[dict[str, Any]], numeric_columns: list[str], roles: dict[str, str | None], columns: list[str]) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[str]]:
    income_col = find_first_matching_numeric_column(numeric_columns, ('income', 'revenue', 'profit', 'sales'))
    expense_col = find_first_matching_numeric_column(numeric_columns, ('expense', 'cost', 'opex', 'spend'))
    budget_col, actual_pair_col = infer_plan_actual_pair(numeric_columns)
    actual_col = actual_pair_col or income_col
    category_col = find_first_matching_column(columns, ('category', 'cost center', 'department', 'article'))
    grouping_col = infer_grouping_dimension(columns, ('category', 'department', 'cost center', 'team', 'vendor', 'period'))
    date_col = roles.get('date')
    summary_cards, sections, conclusions = [], [], []
    income_values = collect_numeric_values(rows, income_col)
    expense_values = collect_numeric_values(rows, expense_col)
    if income_values:
        summary_cards.append(build_explanatory_summary_card('Доходы', format_metric_value(sum(income_values)), f'Суммарные доходы по полю {income_col}'))
    if expense_values:
        summary_cards.append(build_explanatory_summary_card('Расходы', format_metric_value(sum(expense_values)), f'Суммарные расходы по полю {expense_col}'))
    if income_values and expense_values:
        margin = sum(income_values) - sum(expense_values)
        summary_cards.append(build_explanatory_summary_card('Баланс', format_metric_value(margin), 'Разница между доходами и расходами в доступной выборке'))
        conclusions.append(f'Баланс по набору составляет {format_metric_value(margin)}.')
    budget_values = collect_numeric_values(rows, budget_col)
    actual_values = collect_numeric_values(rows, actual_col)
    if budget_values and actual_values:
        delta = sum(actual_values) - sum(budget_values)
        delta_pct = compute_safe_ratio([delta], [sum(budget_values)])
        note = 'Показывает отклонение факта от плана'
        if delta_pct is not None:
            note = f'{note}; относительное отклонение — {format_metric_value(delta_pct * 100 if delta_pct <= 1.0 else delta_pct, as_percent=True)}'
        summary_cards.append(build_explanatory_summary_card('Plan vs Actual', format_metric_value(delta), note))
