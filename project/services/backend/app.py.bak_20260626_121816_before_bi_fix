    return [value for value in values if value is not None]


def normalize_percent_like_values(values: list[float]) -> list[float]:
    if not values:
        return []
    bounded_share_count = sum(1 for value in values if 0 <= value <= 1.0)
    percent_like_count = sum(1 for value in values if 1.0 < value <= 100.0)
    if bounded_share_count and not percent_like_count:
        return [round(value * 100, 4) if 0 <= value <= 1.0 else round(value, 4) for value in values]
    if percent_like_count >= bounded_share_count:
        return [round(value, 4) for value in values]
    normalized: list[float] = []
    for value in values:
        if 0 <= value <= 1.0:
            normalized.append(round(value * 100, 4))
        else:
            normalized.append(round(value, 4))
    return normalized


