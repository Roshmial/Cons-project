:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: #18263d;
  background: #f4f7fb;
  line-height: 1.45;
  font-weight: 400;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; min-height: 100vh; background: linear-gradient(180deg, #f8fafc 0%, #eef3f9 100%); }
button, input, textarea, select { font: inherit; }
button { cursor: pointer; }
button:disabled { cursor: not-allowed; opacity: 0.58; }
pre { white-space: pre-wrap; word-break: break-word; }

.loading-screen {
  min-height: 100vh;
  display: grid;
  place-items: center;
  color: #4c6385;
}

.auth-layout, .app-layout {
  min-height: 100vh;
}

.auth-layout {
  display: grid;
  grid-template-columns: minmax(320px, 1.15fr) minmax(340px, 460px);
  gap: 28px;
  padding: 40px;
  align-items: stretch;
  max-width: 1320px;
  margin: 0 auto;
}

.auth-card, .messages-panel, .sidebar, .main-panel, .panel-card {
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid #d8e0ec;
  box-shadow: 0 10px 28px rgba(28, 52, 84, 0.08);
}

.auth-card, .panel-card { border-radius: 24px; padding: 24px; }
.hero-card { display: flex; flex-direction: column; justify-content: center; }
.auth-hero-card {
  gap: 16px;
  padding: 36px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(246, 250, 255, 0.98) 100%);
}
.auth-hero-card h1 {
  margin-bottom: 0;
  font-size: clamp(34px, 4vw, 48px);
  line-height: 1.04;
  letter-spacing: -0.03em;
}
.auth-hero-lead {
  margin-bottom: 0;
  max-width: 760px;
  font-size: 18px;
  line-height: 1.55;
  color: #415775;
}
.auth-feature-list {
  gap: 10px;
  max-width: 720px;
  color: #2f4360;
}
.auth-service-note {
  margin-top: 8px;
  display: inline-flex;
  width: fit-content;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border-radius: 999px;
  background: #edf4ff;
  color: #35537a;
}
.auth-form-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 18px;
  padding: 32px;
}
.auth-card-head {
  display: grid;
  gap: 8px;
}
.auth-card-head h2 {
  margin-bottom: 0;
}
.auth-form-note {
  margin-bottom: 0;
  line-height: 1.5;
}
.eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: 12px; color: #62728d; }
h1, h2, h3, p { margin-top: 0; }
.stack { display: flex; flex-direction: column; gap: 14px; }
.gap16 { gap: 16px; }
label { display: flex; flex-direction: column; gap: 6px; color: #364861; }
input, textarea {
  width: 100%;
  border: 1px solid #d8e0ec;
  border-radius: 14px;
  padding: 10px 12px;
  background: #fff;
}
textarea { resize: vertical; }
select {
  width: 100%;
  border: 1px solid #d8e0ec;
  border-radius: 14px;
  padding: 10px 12px;
  background: #fff;
}
.primary-btn, .ghost-btn, .thread-item, .nav-btn, .job-card {
  border: none;
  border-radius: 14px;
  padding: 9px 13px;
}
.primary-btn { background: linear-gradient(135deg, #2f6df6, #4f8dff); color: #fff; }
.ghost-btn, .nav-btn { background: #eef3f9; color: #18263d; }
.primary-btn:hover:not(:disabled) { filter: brightness(0.98); }
.ghost-btn:hover:not(:disabled), .nav-btn:hover:not(:disabled) { background: #e6edf7; }
.nav-btn.active, .job-card.active { background: #e8f0ff; border: 1px solid #95aed6; }
.banner, .global-banner { margin: 12px 16px 0; border-radius: 14px; padding: 12px 14px; }
.banner.error, .global-banner.error { background: rgba(207, 79, 102, 0.1); color: #9b3348; border: 1px solid rgba(207, 79, 102, 0.24); }
.global-banner.ok { background: rgba(45, 165, 106, 0.1); color: #1d7650; border: 1px solid rgba(45, 165, 106, 0.24); }
.feature-list, .bullet-list { margin: 0; padding-left: 18px; display: grid; gap: 8px; }
.service-note, .muted { color: #62728d; }
.small { font-size: 12px; }

.app-layout {
  display: flex;
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
}

.sidebar {
  width: 280px;
  flex: 0 0 280px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  border-radius: 0;
  border-top: none;
  border-bottom: none;
  border-left: none;
  background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(247,250,254,0.98) 100%);
}
.sidebar-user-block { display: grid; gap: 4px; }
.sidebar-user-block h2 { margin-bottom: 0; word-break: break-word; }

.nav-stack { display: grid; gap: 8px; }
.sidebar-actions { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: center; }
.sidebar-actions .primary-btn { min-width: 0; }
.sidebar-actions .ghost-btn { white-space: nowrap; }
.thread-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  overflow: auto;
  max-height: 42vh;
}

.thread-item {
  text-align: left;
  background: transparent;
  border: 1px solid transparent;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 10px 12px;
}
.thread-item.active { background: #eef4ff; border-color: #c8d8f3; }
.thread-item.unread { background: #f8fbff; border-color: #d7e4fb; }
.thread-item:hover { background: #f6f9fd; }
.thread-item-modal { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: start; }
.thread-item-button-reset { padding: 0; border: none; background: transparent; box-shadow: none; width: 100%; }
.thread-item-top, .thread-item-bottom { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.thread-title-stack { display: grid; gap: 4px; min-width: 0; }
.thread-state-chip { display: inline-flex; width: fit-content; align-items: center; padding: 2px 8px; border-radius: 999px; background: #eef3f9; color: #50637f; font-size: 11px; }
.thread-item strong { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.thread-item span { color: #62728d; font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.thread-date { flex: 0 0 auto; font-size: 10px; color: #7a8aa5; }
.thread-unread-dot { width: 8px; height: 8px; border-radius: 999px; background: #2f6df6; flex: 0 0 auto; }
.sidebar-footer { margin-top: auto; display: flex; flex-direction: column; gap: 8px; }

.main-panel {
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
  flex-direction: column;
  height: 100vh;
  min-height: 0;
  border-radius: 0;
  border-top: none;
  border-right: none;
  border-bottom: none;
  overflow: hidden;
}

.screen-shell {
  display: flex;
  flex-direction: column;
  min-height: 0;
  height: 100%;
}
.chat-screen { overflow: hidden; flex: 1 1 auto; }
.screen-shell.scrollable { overflow: auto; padding: 18px 20px 20px; gap: 18px; }
.section-head {
  padding: 18px 22px;
  border-bottom: 1px solid #d8e0ec;
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
  background: rgba(255,255,255,0.88);
}
.chat-topbar {
  position: static;
  top: auto;
  z-index: 1;
  display: grid;
  gap: 10px;
  padding: 0 16px;
  background: linear-gradient(180deg, rgba(244, 248, 252, 0.98) 0%, rgba(244, 248, 252, 0.92) 100%);
  backdrop-filter: blur(10px);
}
.chat-screen .section-head {
  position: static;
  top: auto;
  z-index: auto;
  backdrop-filter: none;
}
.section-head.compact { padding: 0; border-bottom: none; background: transparent; }
.chat-header-main { display: grid; gap: 6px; }
.chat-header-meta { display: flex; gap: 8px; flex-wrap: wrap; }
.chat-header-actions .ghost-btn { background: #f5f8fc; }
.head-actions { display: flex; gap: 10px; flex-wrap: wrap; }
.messages-panel {
  overflow: auto;
  padding: 16px 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  border: 1px solid #dce4f0;
  border-radius: 22px;
  box-shadow: none;
  background: linear-gradient(180deg, #f3f7fc 0%, #eef3f9 100%);
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
}
.message-bubble {
  max-width: min(75%, 1280px);
  border-radius: 18px;
  padding: 14px 16px;
  box-shadow: 0 10px 28px rgba(28, 52, 84, 0.08);
}
.message-bubble.assistant { background: #fff; border: 1px solid #d8e0ec; }
.message-bubble.user { background: linear-gradient(135deg, #2f6df6, #4f8dff); color: #fff; align-self: flex-end; }
.message-bubble.pending { opacity: 0.88; border-style: dashed; }
.message-bubble.error { border-color: #efc2c2; background: #fff7f7; }
.message-bubble.user .message-meta,
.message-bubble.user .message-role { color: rgba(255,255,255,0.88); opacity: 1; }
.message-bubble.user .attachment-list,
.message-bubble.user .attachment-list li { color: #fff; }
.message-bubble.user .attachment-list a,
.message-bubble.user .attachment-list span {
  color: #fff;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 2px;
}
.message-bubble.user .attachment-list a:hover { color: #e7f0ff; }
.message-bubble.message-kind-clarification_request,
.message-bubble.message-kind-approval_request {
  border-left: 4px solid #2f6df6;
}
.message-role { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; opacity: .8; margin-bottom: 8px; }
.message-content { white-space: pre-wrap; }
.message-export-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.message-export-error { margin-top: 8px; }
.message-meta { margin-top: 10px; font-size: 12px; opacity: .7; }
.attachment-list { margin: 10px 0 0; padding-left: 18px; }
.attachment-list a { color: #1f4ea8; text-decoration: none; }
.attachment-list a:hover { text-decoration: underline; }
.attachment-link-btn {
  appearance: none;
  border: 0;
  background: transparent;
  padding: 0;
  margin: 0;
  color: #1f4ea8;
  text-decoration: none;
  cursor: pointer;
  font: inherit;
}
.attachment-link-btn:hover { text-decoration: underline; }
.message-bubble.user .attachment-link-btn {
  color: #fff;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 2px;
}
.message-bubble.user .attachment-link-btn:hover { color: #e7f0ff; }
.message-artifact {
  margin-top: 12px;
  padding: 12px 14px;
  border-radius: 14px;
  border: 1px solid rgba(47, 109, 246, 0.18);
  background: rgba(248, 251, 255, 0.96);
  display: grid;
  gap: 8px;
}
.clarification-options { display: flex; gap: 8px; flex-wrap: wrap; }
.clarification-action-btn { background: #fff; border-color: #cfe0fb; color: #183b7a; }
.clarification-action-btn:hover:not(:disabled) { background: #eef4ff; }
.clarification-action-btn:disabled { opacity: 0.6; cursor: progress; }

.composer {
  border-top: 1px solid #d8e0ec;
  background: #fff;
  padding: 14px 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.chat-workspace { display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: 8px; padding: 14px 16px 16px; min-height: 0; flex: 1 1 auto; align-items: stretch; overflow: hidden; }
.chat-sidepanel { display: flex; flex-direction: column; min-height: 0; overflow: visible; padding-bottom: 0; position: sticky; bottom: 0; z-index: 3; margin-top: 6px; }
.chat-composer-card { border: 1px solid #dde5f0; border-radius: 18px; box-shadow: 0 8px 22px rgba(28, 52, 84, 0.08); gap: 6px; padding: 8px 10px; width: min(100%, 980px); margin: 0 auto; background: rgba(255,255,255,0.98); }
.sticky-composer { position: sticky; bottom: 0; top: auto; }
.composer-shell { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: center; }
.composer-main { display: grid; gap: 4px; min-width: 0; }
.composer-summary { display: grid; gap: 2px; }
.composer-summary-compact h3 { margin-bottom: 0; font-size: 17px; }
.composer-summary-compact .eyebrow { margin-bottom: 0; opacity: 0.9; }
.composer-toolbar { display: flex; align-items: center; align-self: center; gap: 6px; flex-wrap: nowrap; justify-content: flex-end; }
.composer-popover-anchor { position: relative; }
.composer-popover { position: absolute; right: 0; bottom: calc(100% + 8px); z-index: 20; min-width: 220px; max-width: min(420px, 82vw); padding: 10px; border: 1px solid #dce5f3; border-radius: 16px; background: rgba(255,255,255,0.985); box-shadow: 0 18px 40px rgba(28, 52, 84, 0.14); display: grid; gap: 10px; }
.composer-params-popover { min-width: 280px; }
.composer-files-popover { min-width: 168px; max-width: 220px; }
.composer-files-popover.with-profile-list { min-width: min(520px, 88vw); max-width: min(640px, 92vw); }
.composer-popover-title { font-size: 12px; font-weight: 700; color: #183b7a; letter-spacing: 0.02em; }
.composer-tool-btn { min-height: 44px; padding: 0 12px; border-radius: 14px; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; background: #f7faff; border-color: #dbe4f0; }
.composer-tool-btn:hover { background: #eef4ff; }
.composer-tool-btn-icon { width: 44px; min-width: 44px; justify-content: center; padding: 0; }
.composer-tool-icon { font-size: 15px; line-height: 1; }
.composer-menu-icon { display: inline-flex; flex-direction: column; justify-content: center; gap: 4px; width: 18px; }
.composer-menu-icon span { display: block; width: 18px; height: 2px; border-radius: 999px; background: #516887; }
.file-label-inline { cursor: pointer; }
.file-label-inline input { display: none; }
.composer-popover-actions { display: flex; gap: 8px; flex-wrap: wrap; }
.composer-popover-actions-vertical { flex-direction: column; align-items: stretch; }
.composer-popover-action-btn { min-height: 36px; padding: 0 12px; border-radius: 12px; width: 100%; justify-content: center; }
.composer-popover-action-btn.active { background: #e8f0ff; border-color: #95aed6; }
.composer-params-stack { display: grid; gap: 8px; }
.composer-params-section { display: grid; gap: 6px; padding: 8px 10px; border-radius: 12px; background: #f8fbff; border: 1px solid #e2eaf5; }
.composer-params-section-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; color: #183b7a; font-size: 12px; }
.composer-send-btn { min-width: 44px; min-height: 44px; padding: 0 14px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; font-size: 18px; }
.composer-textarea { min-height: 44px !important; height: 44px; max-height: 240px; padding: 11px 12px; border-radius: 14px; resize: none; line-height: 1.35; overflow-y: auto; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.composer-steps { display: flex; gap: 12px; flex-wrap: wrap; }
.composer-step { display: inline-flex; align-items: center; gap: 8px; padding: 0; border-radius: 0; background: transparent; border: none; font-size: 13px; color: #4d6383; }
.composer-step strong { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 999px; background: #e8f0ff; color: #1f4ea8; }
.composer-operation-block { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: end; }
.composer-operation-block label { display: grid; gap: 6px; }
.composer-operation-block .ghost-btn { white-space: nowrap; }
.composer-operation-hint { margin-top: -4px; }
.composer-selection-summary { margin-top: -2px; }
.composer-section-head { display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
.existing-file-list-compact { grid-template-columns: 1fr; max-height: 320px; overflow: auto; }
.file-row { border-radius: 12px; padding: 8px 10px; background: transparent; border: 1px solid transparent; }
.file-card-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.ghost-btn-xs { padding: 6px 10px; border-radius: 10px; font-size: 12px; }
.file-row.selected { background: #eef4ff; border-color: #c8d8f3; }
.context-disclosure summary { cursor: pointer; font-weight: 600; color: #183b7a; }
.context-disclosure[open] { background: #fbfcfe; }

.chat-onboarding-points > div { display: grid; grid-template-columns: 22px 1fr; gap: 10px; align-items: start; }
.chat-onboarding-points strong { color: #2f6df6; }
.starter-prompts-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 8px; }
.starter-prompt-btn { text-align: left; border: 1px solid #d7e4fb; background: #f8fbff; border-radius: 14px; padding: 10px 12px; color: #183b7a; }
.starter-prompt-btn-accent { background: #2f6df6; border-color: #2f6df6; color: #fff; }
.starter-prompt-btn:hover { background: #eef4ff; }
.starter-prompt-btn-accent:hover { background: #2459cc; }
.chat-guide-banner.compact { margin: 0; padding: 9px 12px; display: flex; gap: 6px; align-items: flex-start; position: static; z-index: auto; background: rgba(255,255,255,0.94); border: 1px solid #e7dcc0; border-radius: 14px; }
.chat-inline-warning { display: flex; align-items: flex-start; gap: 6px; padding: 10px 12px; border-radius: 14px; background: rgba(239, 164, 29, 0.10); color: #7f5a00; border: 1px solid rgba(239, 164, 29, 0.20); }
.inline-label-separator { color: #7a8aa5; }
.chat-low-activity-hint { margin-top: 4px; display: grid; gap: 6px; padding: 14px 16px; border-radius: 16px; background: rgba(255,255,255,0.72); border: 1px dashed #c8d8f3; color: #4d6383; }
.composer-row { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
.composer-row.wrap { flex-wrap: wrap; }
.file-label {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: #eef3f9;
  border-radius: 14px;
}
.file-label input { display: none; }
.existing-files-block { display: grid; gap: 10px; }
.existing-file-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
.existing-file-card {
  display: flex;
  flex-direction: row;
  gap: 10px;
  align-items: flex-start;
  background: #f8fbff;
  border: 1px solid #dce5f3;
  border-radius: 14px;
  padding: 10px 12px;
}
.existing-file-card input { width: auto; margin-top: 4px; }

.empty-box {
  border: 1px dashed #b9c8de;
  background: #fbfcfe;
  border-radius: 18px;
  padding: 18px;
  color: #62728d;
}
.empty-box.large { padding: 22px; }
.chat-welcome-card { gap: 16px; }
.chat-welcome-card h3,
.chat-welcome-card p { margin: 0; }
.chat-welcome-card .starter-prompts-grid { margin-top: 4px; }
.chat-welcome-card .chat-inline-warning { margin-top: 6px; }
.interaction-setup-points { margin-top: 4px; }
.onboarding-actions { justify-content: flex-end; }
.onboarding-reference-grid { margin-top: 8px; }
.profile-tabs { row-gap: 8px; }
.profile-response-note { margin-top: -4px; }
.grid { display: grid; gap: 18px; }
.grid.two-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid.jobs-cols { grid-template-columns: minmax(280px, 360px) 1fr; }
.table-list { display: grid; gap: 10px; }
.table-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
  border: 1px solid #e1e8f3;
  border-radius: 14px;
  padding: 12px 14px;
  background: #fbfcfe;
}
.job-card {
  text-align: left;
  background: #f8fbff;
  border: 1px solid #dce5f3;
  display: grid;
  gap: 4px;
}
.summary-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 12px;
}
.summary-box {
  border: 1px solid #dce5f3;
  background: #f8fbff;
  border-radius: 16px;
  padding: 14px;
  display: grid;
  gap: 6px;
}
.summary-box span { color: #62728d; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
.summary-box strong { font-size: 18px; }
.summary-grid-tight { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
.details-box {
  border: 1px solid #dce5f3;
  background: #fbfcfe;
  border-radius: 16px;
  padding: 12px 14px;
}
.profile-summary-layout { align-items: start; }
.profile-hero-card { gap: 16px; }
.profile-hero-top { display: flex; justify-content: space-between; gap: 14px; align-items: flex-start; }
.profile-health-chip { padding: 10px 12px; border-radius: 999px; background: #edf5ff; color: #1f4ea8; font-size: 13px; font-weight: 600; }
.profile-next-step { display: grid; gap: 6px; padding: 14px 16px; border-radius: 16px; background: #f6f9fd; border: 1px solid #dce5f3; }
.profile-quick-links { display: flex; gap: 10px; flex-wrap: wrap; }
.profile-files-list { gap: 12px; }
.profile-file-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: 18px; }
.profile-file-main { display: grid; gap: 6px; min-width: 0; }
.profile-file-summary { line-height: 1.45; }
.profile-file-actions { display: flex; align-items: flex-start; justify-content: flex-end; }
.job-card-status { color: #183b7a; font-weight: 600; }
