def is_timestamp_stale(timestamp_value: str | None, *, threshold_seconds: int, now: datetime | None = None) -> bool:
    started = parse_iso(timestamp_value)
    if not started:
        return False
    current = now or now_utc()
    return (current - started).total_seconds() >= max(1, int(threshold_seconds))


def recover_stuck_chat_tasks(*, now: datetime | None = None) -> int:
    current = now or now_utc()
    recovered = 0
    with db_connect() as conn:
        rows = conn.execute(
            "SELECT id, assistant_message_id, started_at FROM chat_tasks WHERE status = 'running' AND finished_at IS NULL"
        ).fetchall()
        for row in rows:
            if not is_timestamp_stale(row["started_at"], threshold_seconds=CHAT_TASK_STUCK_SECONDS, now=current):
                continue
            conn.execute(
                "UPDATE chat_tasks SET status = 'pending', started_at = NULL, last_error = '' WHERE id = ?",
                (row["id"],),
            )
            pending_meta = build_pending_assistant_meta(int(row["id"]), status_label="Восстановлено после тайм-аута обработки")
            pending_meta["recovered_after_stuck"] = True
            conn.execute(
                "UPDATE messages SET content = ?, meta_json = ? WHERE id = ?",
                ("Готовлю ответ…", json.dumps(pending_meta, ensure_ascii=False), row["assistant_message_id"]),
            )
            recovered += 1
    return recovered


