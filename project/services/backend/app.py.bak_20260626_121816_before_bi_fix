                "time_of_day": job["time_of_day"],
                "start_date": job["start_date"],
                "timezone": job["timezone"],
                "status": job["status"],
            }
        )
        cur = conn.execute(
            """
            INSERT INTO jobs (
                user_id, name, display_name, description, job_type, visibility, status, schedule_kind,
                days_of_week_json, time_of_day, start_date, timezone, prompt_template,
                parameters_json, next_run_at, created_at, updated_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) RETURNING id
            """,
            (
                job["user_id"],
                job["name"],
                safe_text(job.get("display_name")),
                job["description"],
                job["job_type"],
                job["visibility"],
                job["status"],
                job["schedule_kind"],
                json.dumps(job["days"], ensure_ascii=False),
                job["time_of_day"],
                job["start_date"],
                job["timezone"],
                job["prompt_template"],
