def extract_assistant_text(payload: dict[str, Any]) -> str:
    choices = payload.get("choices") or []
    if not choices:
        raise ApiError("hermes_empty_response", 502)
    message = (choices[0] or {}).get("message") or {}
    content = message.get("content", "")
    if isinstance(content, str):
        return content.strip()
    if isinstance(content, list):
        parts: list[str] = []
        for item in content:
            if isinstance(item, dict) and item.get("type") in {"text", "output_text"}:
                parts.append(item.get("text", ""))
        return "\n".join(part for part in parts if part).strip()
    return str(content).strip()


def call_hermes_messages(messages: list[dict[str, str]]) -> tuple[str, dict[str, Any]]:
    if APP_MODE != "hermes-api":
        prompt = messages[-1]["content"] if messages else ""
        return build_mock_reply(prompt), {"mode": APP_MODE, "downstream": "mock-hermes"}
    if not HERMES_API_KEY:
        raise ApiError("hermes_api_key_missing", 500)
    payload = {"model": HERMES_API_MODEL, "stream": False, "messages": messages}
    body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    req = urllib.request.Request(
        f"{HERMES_API_BASE_URL}/chat/completions",
        data=body,
        method="POST",
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {HERMES_API_KEY}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=HERMES_API_TIMEOUT) as resp:
            response_payload = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        raise ApiError(f"hermes_api_http_error: {exc.code}: {detail[:300]}", 502)
    except urllib.error.URLError as exc:
        raise ApiError(f"hermes_api_unreachable: {exc.reason}", 502)
    reply_text = extract_assistant_text(response_payload)
    cleaned_text, meta = enrich_assistant_meta({
        "mode": APP_MODE,
        "downstream": "hermes-api-server",
        "hermes_model": response_payload.get("model", HERMES_API_MODEL),
        "usage": response_payload.get("usage", {}),
    }, reply_text)
    return cleaned_text, meta


def call_hermes_api(
    message_rows: list[sqlite3.Row],
    profile: dict[str, Any],
    thread_title: str,
    extra_system_context: str = "",
    runtime_meta: dict[str, Any] | None = None,
) -> tuple[str, dict[str, Any]]:
    reply_text, meta = call_hermes_messages(
