def infer_business_dashboard_function(text: str, columns: list[str] | None = None) -> str:
    lowered = safe_text(text).lower()
    column_values = [safe_text(column).lower() for column in (columns or [])]
    scores: dict[str, int] = {}
    for function_name, raw_spec in BUSINESS_DASHBOARD_FUNCTION_SPECS.items():
        spec = raw_spec if isinstance(raw_spec, dict) else {}
        request_markers = [safe_text(item).lower() for item in (spec.get('request_markers') or []) if safe_text(item)]
        column_markers = [safe_text(item).lower() for item in (spec.get('column_markers') or []) if safe_text(item)]
        score = 0
        for marker in request_markers:
            if marker in lowered:
                score += 3
        for marker in column_markers:
            if any(marker in column for column in column_values):
                score += 1
        scores[function_name] = score
    if not scores:
        return BUSINESS_DASHBOARD_DEFAULT_FUNCTION
    best_name, best_score = max(scores.items(), key=lambda item: item[1])
    return best_name if best_score > 0 else BUSINESS_DASHBOARD_DEFAULT_FUNCTION


def build_business_function_spec(function_name: str) -> dict[str, Any]:
    default_spec = BUSINESS_DASHBOARD_FUNCTION_SPECS.get(BUSINESS_DASHBOARD_DEFAULT_FUNCTION)
    if not isinstance(default_spec, dict):
        default_spec = {
            'label': 'Бизнес-метрики',
            'focus': 'ключевые метрики, структура, динамика и ограничения',
            'summary_cards': ['Метрики', 'Срезы', 'Динамика', 'Ограничения'],
