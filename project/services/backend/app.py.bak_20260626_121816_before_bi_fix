    with db_connect() as conn:
        row = conn.execute("SELECT * FROM jobs WHERE id = ?", (local_job_id,)).fetchone() if local_job_id is not None else None
        if row:
            role = ensure_can_edit_job(conn, row, auth)
            existing = row_to_job_dict(conn, row, auth=auth, include_details=True)
            if role == "editor":
                assert_editor_update_allowed(payload)
            merged = merge_job_update_payload(existing, payload)
            expected_version = payload.get("version")
            job = create_or_update_job(conn, auth, merged, job_id=local_job_id, expected_version=(int(expected_version) if expected_version is not None else None))
            job["source_of_truth"] = "local_jobs"
            job["read_only"] = False
            return jsonify({"status": "updated", "job": job})
    if auth.role == "admin":
        hermes_job = hermes_get_job(job_id)
        if hermes_job:
            with db_connect() as conn:
                updates = {}
                if payload.get("status") == "paused":
                    updated = hermes_pause_job(job_id)
                elif payload.get("status") == "active":
                    updated = hermes_resume_job(job_id)
                else:
                    if "recipients" in payload:
                        replace_hermes_job_recipients(conn, job_id, payload.get("recipients") or [])
                        hermes_job = hermes_get_job(job_id) or hermes_job
                        sync_hermes_job_threads(conn, hermes_job)
                    if "display_name" in payload and "name" not in payload:
                        alias = safe_text(payload.get("display_name") or "")
                        if alias:
                            updates["name"] = alias
                    for key in ("name", "schedule", "prompt", "deliver", "enabled_toolsets", "skills", "workdir", "profile", "script"):
                        if key in payload:
                            updates[key] = payload[key]
                    updated = hermes_update_job(job_id, updates) if updates else hermes_job
                if updated:
                    reconcile_hermes_job_delivery(conn, updated)
                    sync_hermes_job_threads(conn, updated)
                    hermes_recipients = fetch_hermes_job_recipients(conn, job_id, hermes_job=updated)
                    return jsonify({"status": "updated", "job": hermes_job_to_web(updated, include_details=True, recipients=hermes_recipients, read_only=False)})
