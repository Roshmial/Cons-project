@app.get(f"{API_PREFIX}/jobs")
def jobs_list() -> Response:
    auth = require_auth()
    scope = safe_text(request.args.get("scope") or "all")
    with db_connect() as conn:
        rows = conn.execute("SELECT * FROM jobs ORDER BY updated_at DESC, id DESC").fetchall()
        owner_rows = conn.execute("SELECT id, name, email FROM users").fetchall()
        owners = {row["id"]: dict(row) for row in owner_rows}
        acl_rows = conn.execute("SELECT job_id, role FROM job_acl WHERE user_id = ?", (auth.id,)).fetchall()
        acl_map = {row["job_id"]: row["role"] for row in acl_rows}
        subscription_rows = conn.execute("SELECT job_id FROM job_subscriptions WHERE user_id = ?", (auth.id,)).fetchall()
        subscribed_job_ids = {row["job_id"] for row in subscription_rows}
        subscriber_rows = conn.execute("SELECT job_id, COUNT(*) AS c FROM job_subscriptions GROUP BY job_id").fetchall()
        subscriber_counts = {row["job_id"]: int(row["c"]) for row in subscriber_rows}
        recipient_rows = conn.execute("SELECT job_id, COUNT(*) AS c FROM job_recipients GROUP BY job_id").fetchall()
        recipient_counts = {row["job_id"]: int(row["c"]) for row in recipient_rows}
        visible = []
        for row in rows:
            role = "admin" if auth.role == "admin" else (
                "owner" if row["user_id"] == auth.id else acl_map.get(row["id"]) or ("subscriber" if row["id"] in subscribed_job_ids else ("viewer" if row["visibility"] == "workspace" else None))
            )
            if not role:
                continue
            days = normalize_days_of_week(json_loads(row["days_of_week_json"], []))
            self_subscribe_scope = safe_text(row["self_subscribe_scope"] or "disabled")
            item = {
                "id": row["id"],
                "name": row["name"],
                "display_name": safe_text(row["display_name"] if "display_name" in row.keys() else ""),
                "description": row["description"],
                "job_type": row["job_type"],
                "visibility": row["visibility"],
                "status": row["status"],
                "schedule_kind": row["schedule_kind"],
                "days_of_week": days,
                "time_of_day": row["time_of_day"],
                "start_date": row["start_date"],
                "timezone": row["timezone"],
                "prompt_template": row["prompt_template"],
                "parameters": json_loads(row["parameters_json"], {}),
                "self_subscribe_enabled": bool(row["self_subscribe_enabled"]),
                "self_subscribe_scope": self_subscribe_scope,
                "version": int(row["version"] or 1),
                "next_run_at": row["next_run_at"],
                "next_runs_preview": preview_next_runs({"schedule_kind": row["schedule_kind"], "days_of_week": days, "time_of_day": row["time_of_day"], "start_date": row["start_date"], "timezone": row["timezone"], "status": row["status"]}),
                "last_run_at": row["last_run_at"],
                "last_run_status": row["last_run_status"],
                "last_run_summary": row["last_run_summary"],
                "last_error": row["last_error"],
                "schedule_summary": build_schedule_summary({"schedule_kind": row["schedule_kind"], "days_of_week": days, "time_of_day": row["time_of_day"], "start_date": row["start_date"], "timezone": row["timezone"]}),
                "owner": owners.get(row["user_id"]),
                "role": role,
                "is_subscribed": row["id"] in subscribed_job_ids,
                "can_self_subscribe": bool(auth.role != "admin" and row["user_id"] != auth.id and bool(row["self_subscribe_enabled"]) and self_subscribe_scope in {"workspace", "visible_users"} and (self_subscribe_scope != "visible_users" or role is not None)),
                "subscriber_count": subscriber_counts.get(row["id"], 0),
                "recipients_count": recipient_counts.get(row["id"], 0),
                "created_at": row["created_at"],
                "updated_at": row["updated_at"],
            }
            item["source_of_truth"] = "local_jobs"
            item["read_only"] = False
            visible.append(item)
    if auth.role == "admin":
        with db_connect() as conn:
            for hermes_job in list_cached_hermes_jobs():
                reconcile_hermes_job_delivery(conn, hermes_job)
                sync_hermes_job_threads(conn, hermes_job)
                hermes_recipients = fetch_hermes_job_recipients(conn, str(hermes_job.get("id") or ""), hermes_job=hermes_job)
                visible.append(hermes_job_to_web(hermes_job, include_details=False, recipients=hermes_recipients, read_only=False))
    if scope == "paused":
        visible = [item for item in visible if item["status"] == "paused"]
    elif scope == "issues":
        visible = [item for item in visible if item.get("last_run_status") == "error"]
    visible.sort(key=lambda item: (item.get("updated_at") or "", item.get("id") or ""), reverse=True)
    return jsonify({"jobs": visible})


