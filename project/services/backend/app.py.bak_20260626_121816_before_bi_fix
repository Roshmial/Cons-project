def format_metric_value(value: float | int | None, *, as_percent: bool = False, digits: int = 1) -> str:
    if value is None:
        return '—'
    numeric = float(value)
    if as_percent:
        return f"{round(numeric, digits)}%"
    if abs(numeric) >= 1000:
        return f"{round(numeric):,}".replace(',', ' ')
    if numeric.is_integer():
        return str(int(numeric))
    return str(round(numeric, digits)).replace('.', ',')


