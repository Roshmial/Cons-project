def maybe_compact_chat_messages(base_messages: list[dict[str, str]], task_description: str, profile: dict[str, Any], thread_title: str, request_policy: dict[str, Any] | None = None) -> tuple[list[dict[str, str]], dict[str, Any]]:
    if not should_compact_chat_history(base_messages):
        return base_messages, {"history_compacted": False}
    if len(base_messages) <= CHAT_CONTEXT_RECENT_MESSAGES + 1:
        return base_messages, {"history_compacted": False}
    recent_messages = base_messages[-CHAT_CONTEXT_RECENT_MESSAGES:]
    older_messages = base_messages[1:-CHAT_CONTEXT_RECENT_MESSAGES]
    if not older_messages:
        return base_messages, {"history_compacted": False}
    compressed_context, summary_meta = call_hermes_messages(
        build_chat_history_summary_messages(older_messages, task_description),
        model_name=HERMES_API_MODEL,
    )
    compacted_messages = [
        {"role": "system", "content": build_hermes_system_prompt(profile, thread_title, request_policy)},
        {"role": "system", "content": "Сводка предыдущей части этого же чата:\n" + compressed_context},
        *recent_messages,
    ]
    return compacted_messages, {
        "history_compacted": True,
        "history_summary_model": summary_meta.get("hermes_model", HERMES_API_MODEL),
        "history_summary_chars": len(compressed_context),
        "history_messages_before_compaction": len(base_messages),
        "history_messages_after_compaction": len(compacted_messages),
    }


def call_hermes_api(message_rows: list[sqlite3.Row], profile: dict[str, Any], thread_title: str, request_policy: dict[str, Any] | None = None) -> tuple[str, dict[str, Any]]:
    base_messages = build_hermes_messages(message_rows, profile, thread_title, request_policy)
    task_description = latest_user_message_text(message_rows)
    with db_connect() as conn:
        usage_stats = reasoning_usage_stats(conn, int(profile["id"]))
        route = route_task(task_description, int(profile["id"]), usage_stats, request_policy)
    note_prefix = ""
    if route["model"] == HERMES_REASONING_MODEL:
        compressed_context, prep_meta = call_hermes_messages(
            build_reasoning_summary_messages(base_messages, task_description),
            model_name=HERMES_API_MODEL,
        )
        reasoning_messages = build_reasoning_execution_messages(profile, thread_title, compressed_context, task_description, request_policy)
        reply_text, meta = call_hermes_messages(reasoning_messages, model_name=HERMES_REASONING_MODEL)
        reply_text, meta = enforce_russian_retry(reasoning_messages, reply_text, meta, profile, model_name=HERMES_REASONING_MODEL)
        note_prefix = reasoning_engaged_notice(route["route_reason"])
        actual_cost = extract_usage_cost_usd(meta.get("usage"))
        with db_connect() as conn:
            record_llm_usage_event(
                conn,
                user_id=int(profile["id"]),
                model_key=LLM_USAGE_REASONING_MODEL,
                route_mode=route["route_mode"],
                route_reason=route["route_reason"],
                request_excerpt=task_description,
                actual_cost_usd=actual_cost,
                estimated_cost_usd=actual_cost if actual_cost is not None else HERMES_REASONING_COST_FALLBACK_USD,
            )
        meta.update({
            "reasoning_summary_model": prep_meta.get("hermes_model", HERMES_API_MODEL),
            "compressed_context_chars": len(compressed_context),
        })
    else:
        if should_use_focused_followup_context(message_rows, request_policy):
            effective_messages = build_focused_followup_messages(message_rows, profile, thread_title, request_policy)
            compaction_meta = {"history_compacted": False, "focused_followup_context": True}
        else:
            effective_messages, compaction_meta = maybe_compact_chat_messages(base_messages, task_description, profile, thread_title, request_policy)
        reply_text, meta = call_hermes_messages(effective_messages, model_name=HERMES_API_MODEL)
        reply_text, meta = enforce_russian_retry(effective_messages, reply_text, meta, profile, model_name=HERMES_API_MODEL)
        meta.update(compaction_meta)
        if route.get("limit_reason"):
            note_prefix = reasoning_limit_notice(route["limit_reason"], usage_stats)
    if note_prefix:
        reply_text = f"{note_prefix}\n\n{reply_text}".strip()
    meta.update(
        {
            "personalization_used": True,
            "thread_title": thread_title,
            "personalization_preview": build_personalization_block(profile),
            "request_policy": request_policy or {},
            "llm_route": route,
        }
    )
    return reply_text, meta


def is_dashboard_request(text: str) -> bool:
    lowered = safe_text(text).lower()
    if not lowered:
        return False
    # Важно: слова вроде "аналитика", "глубокая аналитика", "Telegram"
    # сами по себе не должны уводить обычный текстовый запрос в dashboard-flow.
    # Dashboard route включаем только по явному запросу на дашборд/витрину/сводку.
    negative_phrases = (
        "без дашборда",
        "без dashboard",
        "не нужен дашборд",
        "не нужен dashboard",
        "не делай дашборд",
        "не делай dashboard",
        "не как дашборд",
    )
    if any(phrase in lowered for phrase in negative_phrases):
        return False
    intent_tokens = (
        "дашборд",
        "dashboard",
        "сводк",
        "витрин",
        "построй дашборд",
        "построить дашборд",
        "собери дашборд",
    )
    return any(token in lowered for token in intent_tokens)


def dashboard_builder_definitions() -> list[dict[str, Any]]:
    return []


def resolve_dashboard_builder(text: str) -> dict[str, Any] | None:
    lowered = safe_text(text).lower()
    if not lowered:
        return None
    for builder in dashboard_builder_definitions():
        if any(token in lowered for token in builder.get("keywords") or []):
            return builder
    return None


