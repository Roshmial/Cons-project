def infer_external_dashboard_intent(text: str) -> str:
    lowered = safe_text(text).lower()
    if any(token in lowered for token in ["review", "обзор", "что такое", "как устроен", "общая картина", "разбор темы"]):
        return "review"
    if any(token in lowered for token in ["истори", "эволюц", "развити", "этап", "поколен", "196", "197", "198", "199", "dss", "olap", "self-service", "self service", "competency center", "competency centres", "competency centers"]):
        return "history_evolution"
    if any(token in lowered for token in ["рынок", "market", "landscape", "конкурент", "игрок", "supplier landscape", "vendor landscape", "рыночн"]):
        return "market_overview"
    if any(token in lowered for token in ["динамик", "по дням", "по недел", "trend", "timeline", "за "]):
        return "trend"
    if any(token in lowered for token in ["сегмент", "аудитор", "географ", "по регионам", "по странам", "матриц"]):
        return "segmentation"
    if any(token in lowered for token in ["сравн", "топ", "рейтинг", "доли", "структур", "composition"]):
        return "comparison"
