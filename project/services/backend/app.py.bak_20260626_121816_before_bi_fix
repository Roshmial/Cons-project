    task_row = None
    request_preview = ""
    with db_connect() as conn:
        task_row = conn.execute(
            "SELECT id, user_id, thread_id, user_message_id, assistant_message_id, request_policy_json FROM chat_tasks WHERE id = ?",
            (task_id,),
        ).fetchone()
        if task_row is not None:
            user_message = conn.execute("SELECT content, meta_json FROM messages WHERE id = ?", (task_row["user_message_id"],)).fetchone()
            if user_message is not None:
                user_meta = json_loads(user_message["meta_json"], {})
