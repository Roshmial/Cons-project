def execute_web_collection_contract(contract: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    source_items, source_manifest = resolve_web_collection_sources(contract)
    if not source_items:
        raise ApiError('web_collection_sources_not_found', 409)
    documents: list[dict[str, Any]] = []
    skipped_sources: list[dict[str, str]] = []
    last_error: Exception | None = None
    for item in source_items[:WEB_COLLECTION_SOURCE_LIMIT]:
        try:
            documents.append(fetch_web_source_document(item))
        except Exception as exc:
            last_error = exc
            skipped_sources.append({'source_url': safe_text(item), 'error': safe_text(exc)})
    shortlist_rows = build_web_shortlist_rows(source_manifest, skipped_sources)
    if not documents:
        if shortlist_rows:
            attachment_contract = dict(contract)
            if safe_text(attachment_contract.get('output_format')).lower() == 'xlsx' and load_openpyxl_module() is None:
                attachment_contract['output_format'] = 'csv'
            if safe_text(attachment_contract.get('output_format')).lower() in {'csv', 'xlsx'}:
                attachment_contract['fields'] = [
                    'title', 'domain', 'source_url', 'query', 'source_rank', 'availability_level', 'snippet', 'error_reason'
                ]
            attachment = build_collection_artifact_attachment(attachment_contract, shortlist_rows)
            reply_text = (
                'Не удалось извлечь содержимое из найденных веб-источников, но собрала полезный shortlist источников в файл.\n\n'
                f"Найдено источников: {len(source_manifest.get('items') or []) if source_manifest else 0}.\n"
                f"Доступных документов: 0.\n"
                f"В файле есть URL, домены, поисковый запрос, порядок источника, краткие описания где доступны и причина недоступности.\n"
                f"Формат fallback-файла: {attachment_contract.get('output_format')}.\n"
                f"Файл: {attachment['original_name']}."
            )
            meta = {
                'message_kind': 'collection_execution_result',
                'downstream': 'chat:web_collection_result',
                'collection_contract': contract,
                'task_source_list': source_manifest,
                'attachments': [attachment],
                'collection_rows_preview': shortlist_rows[:5],
                'web_sources': shortlist_rows,
                'web_sources_skipped': skipped_sources,
                'partial_result': True,
                'status_note': 'sources_found_but_documents_unavailable',
                'fallback_result_kind': 'source_shortlist',
            }
            return reply_text, meta
        if isinstance(last_error, ApiError):
            raise last_error
        raise ApiError('web_collection_documents_unavailable', 409)
    documents = select_relevant_web_documents(contract, documents)
    if not documents:
        raise ApiError('web_collection_documents_irrelevant', 409)
    rows = structure_web_collection_rows(contract, documents)
    dashboard_reply = maybe_build_collection_dashboard_reply(contract, documents, rows, downstream='dashboard:web_collection_result')
    attachment_contract = dict(contract)
    hybrid_rows: list[dict[str, Any]] = []
    if skipped_sources and shortlist_rows and safe_text(attachment_contract.get('output_format')).lower() in {'csv', 'xlsx', 'json'}:
        hybrid_rows, hybrid_fields = build_hybrid_collection_rows(contract, rows, shortlist_rows)
        attachment_contract['fields'] = hybrid_fields
    artifact_rows = hybrid_rows or rows
    raw_attachment = build_collection_artifact_attachment(attachment_contract, artifact_rows) if safe_text(contract.get('output_format')) in COLLECTION_STRUCTURED_FORMATS else None
    if dashboard_reply is not None:
        reply_text, meta = dashboard_reply
        meta['task_source_list'] = source_manifest
        if skipped_sources:
            meta['web_sources_skipped'] = skipped_sources
            meta['partial_result'] = True
            meta['status_note'] = 'sources_partially_unavailable'
            meta['fallback_result_kind'] = 'hybrid_content_plus_shortlist'
            meta['web_source_shortlist'] = shortlist_rows
        return reply_text, meta
    proposal_reply = maybe_attach_proposal_artifact(
        contract,
        documents,
        rows,
        [raw_attachment] if raw_attachment else [],
        'chat:web_collection_result',
    )
    if proposal_reply is not None:
        reply_text, meta = proposal_reply
        meta['task_source_list'] = source_manifest
        meta['collection_rows_preview'] = rows[:5]
        meta['web_sources'] = [
            {'requested_url': doc.get('requested_url'), 'final_url': doc.get('final_url'), 'title': doc.get('title')}
            for doc in documents
        ]
        if skipped_sources:
            meta['web_sources_skipped'] = skipped_sources
            meta['partial_result'] = True
            meta['status_note'] = 'sources_partially_unavailable'
            meta['fallback_result_kind'] = 'hybrid_content_plus_shortlist'
            meta['web_source_shortlist'] = shortlist_rows
        return reply_text, meta
    if raw_attachment is None:
        raise ApiError('collection_output_format_unsupported', 409)
    attachment = raw_attachment
    reply_text = (
        'Готово. Собрала данные из веб-источников и подготовила реальный файл.\n\n'
        f"Источников обработано: {len(documents)}.\n"
        f"Строк в результате: {len(rows)}.\n"
        f"Формат: {attachment_contract.get('output_format')}.\n"
        f"Файл: {attachment['original_name']}."
    )
    if skipped_sources:
        reply_text += (
            f"\nПропущено источников: {len(skipped_sources)}."
            ' В файл добавлен shortlist по недоступным источникам с краткими описаниями, где они доступны.'
        )
    meta = {
        'message_kind': 'collection_execution_result',
        'downstream': 'chat:web_collection_result',
        'collection_contract': contract,
        'task_source_list': source_manifest,
        'attachments': [attachment],
        'collection_rows_preview': artifact_rows[:5],
        'web_sources': [
            {'requested_url': doc.get('requested_url'), 'final_url': doc.get('final_url'), 'title': doc.get('title')}
            for doc in documents
        ],
    }
    if skipped_sources:
        meta['web_sources_skipped'] = skipped_sources
        meta['partial_result'] = True
        meta['status_note'] = 'sources_partially_unavailable'
        meta['fallback_result_kind'] = 'hybrid_content_plus_shortlist'
        meta['web_source_shortlist'] = shortlist_rows
    return reply_text, meta


def maybe_execute_collection_request(
    conn: sqlite3.Connection,
    task: sqlite3.Row,
    user_row: sqlite3.Row,
    message_rows: list[sqlite3.Row],
    user_text: str,
    attachments: list[dict[str, Any]] | None = None,
) -> tuple[str, dict[str, Any]] | None:
    if not looks_like_collection_request(user_text, attachments):
        return None
    contract = build_collection_contract_meta(user_text, attachments)
    if contract.get('missing_fields'):
        return None
    source_kind = safe_text(contract.get('source_kind'))
    if source_kind == 'attachment' and attachments:
        return execute_attachment_collection_contract(contract, attachments)
    if source_kind == 'telegram':
        return execute_telegram_collection_contract(contract)
    if source_kind == 'tenders':
        return execute_tender_collection_contract(contract)
    if source_kind == 'api':
        return execute_api_collection_contract(contract)
    if source_kind == 'web':
        return execute_web_collection_contract(contract)
    if source_kind == 'media':
        return execute_web_collection_contract(contract)
    if source_kind == 'url':
        return None
    return None


def telegram_post_type(text: str) -> str:
    lowered = safe_text(text).lower()
    if not lowered:
        return "без текста"
    rules = [
        ("исследование", [r"\bисследован", r"\bопрос", r"benchmark", r"ключевые выводы"]),
        ("мероприятие", [r"\bвебинар", r"\bконференц", r"\bфорум", r"\bэфир", r"регистрац"]),
        ("кейс", [r"\bкейс", r"\bвнедр", r"\bреализ", r"\bавтоматизац", r"для клиента"]),
        ("реклама услуг", [r"мы можем помочь", r"обращайтесь", r"оставьте заявку", r"готовы помочь", r"экспертные консультации"]),
        ("интервью/комментарий", [r"\bинтервью", r"\bподкаст", r"эксперт", r"рассказал", r"прокомментир"]),
        ("корпоративная новость", [r"совет директор", r"дивиденд", r"награждени", r"поздравля", r"фотоотчет"]),
        ("обзор рынка", [r"обзор новостей", r"дайджест", r"рынок", r"тренд", r"ландшафт"]),
        ("аналитика", [r"разбор", r"почему", r"риски", r"подход", r"что происходит"]),
        ("продукт/решение", [r"платформ", r"решени", r"сервис", r"продукт", r"модуль"]),
    ]
    best_label = "прочее"
    best_score = 0
    for label, patterns in rules:
        score = 0
        for pattern in patterns:
            score += len(re.findall(pattern, lowered, flags=re.IGNORECASE))
        if score > best_score:
            best_score = score
            best_label = label
    return best_label


def compact_telegram_text(text: str, limit: int = 160) -> str:
    cleaned = re.sub(r"\s+", " ", safe_text(text)).strip()
    if len(cleaned) <= limit:
        return cleaned
    shortened = cleaned[: limit - 1].rsplit(" ", 1)[0].rstrip(" ,;:-")
    return f"{shortened}…"


def normalize_public_error_text(error_text: str) -> str:
    cleaned = safe_text(error_text).strip()
    if not cleaned:
        return "Ошибка runtime: источник не вернул пригодный ответ."
    lowered = cleaned.lower()
    normalized_html = html.unescape(lowered)
    if cleaned == "message_export_unfulfilled_by_model":
        return "Не удалось сформировать файл: модель вернула служебный или непригодный ответ вместо содержимого документа. Повторите запрос."
    if cleaned == "structured_generated_file_not_supported":
        return "Не удалось сформировать файл: для CSV/XLSX/JSON/XML нужен структурированный набор данных, а не просто текст ответа. Уточните источник и формат выгрузки."
    if cleaned == "llm_reply_language_guard_failed":
        return "Не удалось получить ответ в корректном русском формате. Повторите запрос."
    if cleaned.startswith("message_export_"):
        return "Не удалось сформировать файл по предыдущему ответу. Повторите запрос после того, как в чате появится содержательный ответ."
    if cleaned == 'telegram_collection_busy_timeout':
        return "Telegram-выгрузка ещё занята предыдущей задачей. Дождитесь завершения текущего сбора и повторите запрос."
    if "timed out" in lowered:
        return "Не удалось получить ответ: upstream-источник превысил лимит ожидания. Повторите запрос."
    html_markers = (
        "<html",
        "<!doctype html",
        "<body",
        "<head",
        '<meta name="viewport"',
        "<style",
        "</html>",
    )
    if any(marker in normalized_html for marker in html_markers):
        return "Ошибка runtime: вместо API-ответа вернулась HTML-страница."
    if len(cleaned) > 500:
        return "Ошибка runtime: источник вернул слишком длинную техническую ошибку."
    return cleaned


