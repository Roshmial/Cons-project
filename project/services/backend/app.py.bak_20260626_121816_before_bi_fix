def persist_connector_group_overrides(
    conn: sqlite3.Connection,
    overrides: dict[str, str],
    *,
    actor_user_id: int | None = None,
) -> None:
    normalized = normalize_connector_group_overrides(overrides)
    ts = now_iso()
    for item_key in ("internal_connector", "external_connector"):
        current = conn.execute(
            "SELECT id, payload_json, version FROM reference_items WHERE scope = ? AND dataset_key = ? AND item_key = ?",
            (REFERENCE_SCOPE_GLOBAL, REFERENCE_DATASET_DATA_SOURCES, item_key),
        ).fetchone()
        if not current:
            continue
        payload = json_loads(current["payload_json"], {})
        if payload.get("connector_group_overrides") == normalized:
            continue
        payload["connector_group_overrides"] = normalized
        next_version = int(current["version"] or 1) + 1
        conn.execute(
            "UPDATE reference_items SET payload_json = ?, version = ?, updated_at = ? WHERE id = ?",
            (json.dumps(payload, ensure_ascii=False), next_version, ts, current["id"]),
        )
        if actor_user_id is not None:
            write_reference_item_change_log(conn, REFERENCE_DATASET_DATA_SOURCES, item_key, actor_user_id, "connector_group_override")


def apply_policy_to_data_sources(data_sources: list[dict[str, Any]], policy: dict[str, Any]) -> list[dict[str, Any]]:
    connector_targets = policy.get("connector_targets") if isinstance(policy.get("connector_targets"), dict) else {}
    result: list[dict[str, Any]] = []
    for item in data_sources:
        next_item = dict(item)
        item_key = safe_text(item.get("item_key"))
        if item_key in {"internal_connector", "external_connector"}:
            enabled_children = set(connector_targets.get(item_key) or [])
            child_items = item.get("child_connectors") if isinstance(item.get("child_connectors"), list) else []
            next_item["child_connectors"] = [
                {
                    **child,
                    "enabled": safe_text(child.get("connector_key")) in enabled_children,
                }
                for child in child_items
            ]
        result.append(next_item)
    return result


def resolve_dashboard_policy_context(conn: sqlite3.Connection, payload: dict[str, Any] | None = None) -> dict[str, Any]:
    payload = payload if isinstance(payload, dict) else {}
    policy = get_dashboard_policy(conn)
    source_mode = safe_text(payload.get("source_mode") or policy.get("source_mode") or DASHBOARD_SOURCE_MODE_LOCAL_FIRST).lower()
    if source_mode not in DASHBOARD_SOURCE_MODES:
        source_mode = policy["source_mode"]
    explicit_raw = payload.get("explicit_source_ids") if isinstance(payload.get("explicit_source_ids"), list) else None
    legacy_raw = payload.get("allowed_source_ids") if isinstance(payload.get("allowed_source_ids"), list) else None
    connector_targets_override_raw = payload.get("connector_targets") if isinstance(payload.get("connector_targets"), dict) else None
    requested_allowed = explicit_raw if explicit_raw is not None else (legacy_raw if legacy_raw is not None else policy.get("allowed_sources") or [])
    requested_keys = []
    for item in requested_allowed:
        key = canonicalize_dashboard_source_key(item)
        if key and key not in requested_keys:
            requested_keys.append(key)
    active_sources = list_active_data_sources(conn)
    source_map = {item["item_key"]: item for item in active_sources}
    allowed_sources = [source_map[key] for key in requested_keys if key in source_map]
    if not allowed_sources:
        fallback_keys = policy.get("allowed_sources") or []
        allowed_sources = [source_map[key] for key in fallback_keys if key in source_map]
    if not allowed_sources:
        allowed_sources = active_sources

    normalized_connector_targets: dict[str, list[str]] = {}
    for group_key, keys in (policy.get("connector_targets") or {}).items():
        if isinstance(keys, list):
            normalized_connector_targets[group_key] = [safe_text(item) for item in keys if safe_text(item)]
    if connector_targets_override_raw:
        for group_key, keys in connector_targets_override_raw.items():
            if isinstance(keys, list):
                normalized_connector_targets[group_key] = [safe_text(item) for item in keys if safe_text(item)]

    allowed_sources_with_children = []
    for item in allowed_sources:
        item_copy = dict(item)
        child_connectors = item_copy.get("child_connectors") if isinstance(item_copy.get("child_connectors"), list) else []
        if child_connectors:
            enabled_keys = set(normalized_connector_targets.get(item_copy["item_key"], []))
            next_children = []
            for child in child_connectors:
                child_copy = dict(child)
                child_key = safe_text(child_copy.get("connector_key"))
                child_copy["enabled"] = child_key in enabled_keys if enabled_keys else bool(child_copy.get("enabled"))
                next_children.append(child_copy)
            item_copy["child_connectors"] = next_children
        allowed_sources_with_children.append(item_copy)

    default_global_source = safe_text(payload.get("default_global_source") or policy.get("default_global_source") or "web_research") or "web_research"
    if default_global_source not in {item["item_key"] for item in allowed_sources_with_children}:
        global_candidates = [item for item in allowed_sources_with_children if safe_text(item.get("scope")) == "global"]
        default_global_source = global_candidates[0]["item_key"] if global_candidates else (allowed_sources_with_children[0]["item_key"] if allowed_sources_with_children else "")
    return {
        "policy": {
            **policy,
            "source_mode": source_mode,
            "allowed_sources": [item["item_key"] for item in allowed_sources_with_children],
            "explicit_source_ids": [item["item_key"] for item in allowed_sources_with_children],
            "default_global_source": default_global_source,
            "connector_targets": normalized_connector_targets,
        },
        "allowed_sources": allowed_sources_with_children,
        "allowed_source_map": {item["item_key"]: item for item in allowed_sources_with_children},
    }


def extract_json_object(text: str) -> dict[str, Any]:
    cleaned = safe_text(text).strip()
    if not cleaned:
        raise ApiError("dashboard_json_missing", 502)
    try:
        payload = json.loads(cleaned)
        if isinstance(payload, dict):
            return payload
    except Exception:
        pass

    decoder = json.JSONDecoder()
    for match in re.finditer(r"\{", cleaned):
        start = match.start()
        try:
            payload, end_index = decoder.raw_decode(cleaned[start:])
        except Exception:
            continue
        if not isinstance(payload, dict):
            continue
        trailing = cleaned[start + end_index :].strip()
        if trailing and not trailing.startswith(("```",)):
            if not re.fullmatch(r"[,;\s]*", trailing):
                # Допускаем объясняющий хвост только если сам объект успешно распарсился
                # из более длинного LLM-ответа; продолжаем искать более точный блок.
                return payload
        return payload

    raise ApiError("dashboard_json_missing", 502)


