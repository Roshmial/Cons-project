def tokenize_collection_subject(value: str) -> list[str]:
    normalized = re.sub(r'[^\w\sа-яё-]+', ' ', safe_text(value).lower(), flags=re.IGNORECASE)
    result: list[str] = []
    for token in normalized.split():
        cleaned = token.strip('-_')
        if not cleaned or len(cleaned) < 3 or cleaned in WEB_COLLECTION_SUBJECT_STOPWORDS:
            continue
        if any(cleaned.startswith(prefix) for prefix in WEB_COLLECTION_GENERIC_TERM_PREFIXES):
            continue
        if cleaned not in result:
            result.append(cleaned)
    return result


def term_matches_normalized_haystack(term: str, haystack: str, tokens: set[str] | None = None) -> bool:
    normalized_term = safe_text(term).lower().strip()
    if not normalized_term:
        return False
    if ' ' in normalized_term:
        return normalized_term in haystack
    if tokens is None:
        tokens = set(re.findall(r'[\wа-яё]+', haystack, flags=re.IGNORECASE))
    return normalized_term in tokens


def build_collection_relevance_terms(value: str) -> list[str]:
    raw = safe_text(value)
    terms = list(tokenize_collection_subject(raw))
    expanded_terms: list[str] = []
    for term in terms:
        if term not in expanded_terms:
            expanded_terms.append(term)
        for piece in re.split(r'[-_/]+', term):
            piece = safe_text(piece).lower().strip()
            if not piece or piece in WEB_COLLECTION_SUBJECT_STOPWORDS:
                continue
            if len(piece) < 2:
                continue
            if piece not in expanded_terms:
                expanded_terms.append(piece)
    terms = expanded_terms
    lowered = raw.lower()
    acronym_candidates = re.findall(r'\b[a-zA-Z]{2,5}\b', raw)
    for item in acronym_candidates:
        normalized = safe_text(item).lower()
        if not normalized:
            continue
        if normalized not in terms:
            terms.append(normalized)
        for expanded in COLLECTION_SUBJECT_ACRONYM_EXPANSIONS.get(normalized, []):
            expanded = safe_text(expanded).lower()
            if expanded and expanded not in terms:
                terms.append(expanded)
    for normalized, expansions in COLLECTION_SUBJECT_ACRONYM_EXPANSIONS.items():
        if re.search(rf'\b{re.escape(normalized)}\b', lowered) or any(expanded in lowered for expanded in expansions):
            if normalized not in terms:
                terms.append(normalized)
            for expanded in expansions:
                expanded = safe_text(expanded).lower()
                if expanded and expanded not in terms:
                    terms.append(expanded)
    return terms


def expand_collection_subject_for_search(value: str) -> str:
    expanded = safe_text(value)
    if not expanded:
        return ''
    for normalized, expansions in COLLECTION_SUBJECT_ACRONYM_EXPANSIONS.items():
        replacement = safe_text(expansions[0] if expansions else '').strip()
        if not replacement:
            continue
        expanded = re.sub(rf'\b{re.escape(normalized)}(?=[\s\-_/]|$)', replacement, expanded, flags=re.IGNORECASE)
    expanded = re.sub(r'\s+', ' ', expanded).strip()
    return expanded


def build_broad_collection_search_phrase(subject_terms: list[str]) -> str:
    broad_terms: list[str] = []
    lowered_terms = [safe_text(term).strip().lower() for term in subject_terms if safe_text(term).strip()]
    expanded_values = {
        safe_text(expanded).strip().lower()
        for expansions in COLLECTION_SUBJECT_ACRONYM_EXPANSIONS.values()
        for expanded in expansions
        if safe_text(expanded).strip()
    }
    expanded_acronyms = {
        acronym
        for acronym, expansions in COLLECTION_SUBJECT_ACRONYM_EXPANSIONS.items()
        if any(safe_text(expanded).strip().lower() in lowered_terms for expanded in expansions)
    }
    for term in subject_terms:
        normalized = safe_text(term).strip().lower()
        if not normalized or normalized in WEB_COLLECTION_SUBJECT_STOPWORDS:
            continue
        if normalized in expanded_acronyms and any(normalized in safe_text(exp).lower() for exp in expanded_values):
            continue
        if '-' in normalized or '_' in normalized or '/' in normalized:
            continue
        if re.search(r'[a-z]', normalized) or ' ' in normalized:
            if normalized not in broad_terms:
                broad_terms.append(normalized)
    return ' '.join(broad_terms[:4]).strip()


def build_collection_search_profile(contract: dict[str, Any]) -> dict[str, Any]:
    subject = safe_text(contract.get('subject')).strip()
    request_text = safe_text(contract.get('request_text')).strip()
    combined = ' '.join(part for part in [subject, request_text] if part).lower()
    subject_terms = build_collection_relevance_terms(subject)
    subject_phrases: list[str] = []
    seen_phrases: set[str] = set()

    def add_phrase(value: str, *, front: bool = False) -> None:
        normalized = safe_text(value).strip()
        key = normalized.lower()
        if not normalized or key in seen_phrases:
            return
        seen_phrases.add(key)
        if front:
            subject_phrases.insert(0, normalized)
        else:
            subject_phrases.append(normalized)

    split_subject = re.sub(r'(?<=[a-z])(?=[A-Z])', ' ', subject).strip()
    if split_subject and split_subject != subject:
        add_phrase(split_subject)
    expanded_subject = expand_collection_subject_for_search(subject)
    if expanded_subject and expanded_subject != subject:
        add_phrase(expanded_subject, front=True)
    explicit_multiword_terms = [
        term for term in subject_terms
        if ' ' in safe_text(term).strip() and '-' not in safe_text(term).strip() and '_' not in safe_text(term).strip()
    ]
    for term in reversed(explicit_multiword_terms[:2]):
        add_phrase(term, front=True)
    broad_phrase = build_broad_collection_search_phrase(subject_terms)
    if broad_phrase:
        add_phrase(broad_phrase, front=True)
    if subject:
        add_phrase(subject)
    condensed_terms = [
        term for term in subject_terms
        if len(term) >= 3 and '-' not in term and '_' not in term and '/' not in term
    ]
    if condensed_terms:
        condensed_phrase = ' '.join(condensed_terms[:4]).strip()
        add_phrase(condensed_phrase, front=True)

    intent = 'default'
    for candidate, markers in COLLECTION_SEARCH_INTENT_MARKERS.items():
        if any(marker in combined for marker in markers):
            intent = candidate
            break
    if intent == 'default':
        fields = [safe_text(item).lower() for item in (contract.get('fields') or []) if safe_text(item)]
        if any(field in {'компания', 'company', 'vendor', 'игрок', 'продукт', 'product'} for field in fields):
            intent = 'market_overview'
    return {
        'subject': subject,
        'request_text': request_text,
        'intent': intent,
        'subject_terms': subject_terms,
        'subject_phrases': subject_phrases,
    }


def score_web_candidate_url_relevance(contract: dict[str, Any], url: str) -> int:
    normalized_url = normalize_web_source_url(url).lower()
    if not normalized_url:
        return -100
    haystack = re.sub(r'[-_/]+', ' ', normalized_url)
    haystack_tokens = set(re.findall(r'[\wа-яё]+', haystack, flags=re.IGNORECASE))
    score = 0
    for term in build_collection_relevance_terms(safe_text(contract.get('subject'))):
        if term_matches_normalized_haystack(term, haystack, haystack_tokens):
            score += 4 if len(term) >= 4 else 2
    if is_low_value_search_candidate(normalized_url):
        score -= 10
    return score


def score_web_candidate_preview_relevance(contract: dict[str, Any], item: dict[str, Any]) -> int:
    title = safe_text(item.get('title'))
    snippet = safe_text(item.get('snippet'))
    url = safe_text(item.get('url') or item.get('requested_url'))
    haystack = ' '.join([title, snippet, url]).lower()
    haystack = re.sub(r'[-_/]+', ' ', haystack)
    haystack_tokens = set(re.findall(r'[\wа-яё]+', haystack, flags=re.IGNORECASE))
    score = score_web_candidate_url_relevance(contract, url)
    for term in build_collection_relevance_terms(safe_text(contract.get('subject'))):
        if term_matches_normalized_haystack(term, haystack, haystack_tokens):
            score += 5 if len(term) >= 4 else 3
    if title:
        score += 1
    if snippet:
        score += 2
    score -= score_web_url_quality_penalty(url, title=title)
    return score


def score_web_candidate_set(contract: dict[str, Any], urls: list[str | dict[str, Any]]) -> int:
    normalized_urls: list[str] = []
    preview_items: list[dict[str, Any]] = []
    for item in urls:
        if isinstance(item, dict):
            normalized = normalize_web_source_url(safe_text(item.get('url') or item.get('requested_url')))
            if not normalized:
                continue
            preview_payload = dict(item)
            preview_payload['url'] = normalized
            preview_payload['requested_url'] = normalized
            preview_items.append(preview_payload)
            normalized_urls.append(normalized)
            continue
        normalized = normalize_web_source_url(item)
        if normalized:
            normalized_urls.append(normalized)
    if not normalized_urls:
        return -10**9
    per_url_scores = [score_web_candidate_url_relevance(contract, item) - score_web_url_quality_penalty(item) for item in normalized_urls]
    preview_bonus = sum(max(0, score_web_candidate_preview_relevance(contract, item)) for item in preview_items)
    unique_hosts = {
        urllib.parse.urlparse(item).netloc.lower()
        for item in normalized_urls
        if urllib.parse.urlparse(item).netloc
    }
    homepage_penalty = 0
    for item in normalized_urls:
        parsed = urllib.parse.urlparse(item)
        if safe_text(parsed.path).strip() in {'', '/'}:
            homepage_penalty += 2
    low_value_count = sum(1 for item in normalized_urls if is_low_value_search_candidate(item))
    intent = safe_text((build_collection_search_profile(contract) or {}).get('intent'))
    intent_bonus = 0
    if intent:
        intent_terms = {
            'history': ('history', 'timeline', 'evolution', 'origins', 'chronology'),
            'comparison': ('compare', 'comparison', 'alternative', 'alternatives', 'vendor', 'vendors'),
            'market_overview': ('market', 'landscape', 'vendor', 'vendors', 'company', 'companies', 'player', 'players'),
            'reference': ('overview', 'guide', 'what is', 'explained', 'reference'),
        }.get(intent, ())
        for item in normalized_urls:
            haystack = re.sub(r'[-_/]+', ' ', item.lower())
            if any(term in haystack for term in intent_terms):
                intent_bonus += 3
    topical_match_count = sum(1 for score in per_url_scores if score > 0)
    strongest_url_score = max(per_url_scores) if per_url_scores else -10**9
    weak_set_penalty = 0
    if topical_match_count == 0:
        weak_set_penalty += 12
    if strongest_url_score <= 0:
        weak_set_penalty += 12
    return sum(per_url_scores) + preview_bonus + len(unique_hosts) * 2 + intent_bonus + topical_match_count * 2 - low_value_count * 5 - homepage_penalty - weak_set_penalty


def is_low_value_search_candidate(url: str) -> bool:
    parsed = urllib.parse.urlparse(normalize_web_source_url(url))
    host = parsed.netloc.lower()
    path = parsed.path.lower()
    if any(fragment in host for fragment in WEB_SEARCH_BLOCKED_HOST_FRAGMENTS):
        return True
    return any(fragment in path for fragment in WEB_SEARCH_BLOCKED_PATH_FRAGMENTS)


def score_web_url_quality_penalty(url: str, title: str = '') -> int:
    normalized_url = normalize_web_source_url(url)
    if not normalized_url:
        return 20
    parsed = urllib.parse.urlparse(normalized_url)
    path = safe_text(parsed.path).lower()
    title_lower = safe_text(title).lower()
    penalty = 0
    if path.strip() in {'', '/'}:
        penalty += 6
    if any(fragment in path for fragment in WEB_SEARCH_WEAK_PATH_FRAGMENTS):
        penalty += 5
    if any(marker in title_lower for marker in WEB_SEARCH_WEAK_TITLE_MARKERS):
        penalty += 4
    if len([segment for segment in path.split('/') if segment]) <= 1 and title_lower:
        penalty += 1
    return penalty


def score_web_document_quality_penalty(document: dict[str, Any]) -> int:
    final_url = safe_text(document.get('final_url') or document.get('requested_url'))
    requested_url = safe_text(document.get('requested_url'))
    title = safe_text(document.get('title'))
    text = safe_text(document.get('text'))
    penalty = score_web_url_quality_penalty(final_url, title=title)
    if requested_url and final_url and normalize_web_source_url(requested_url) != normalize_web_source_url(final_url):
        final_parsed = urllib.parse.urlparse(normalize_web_source_url(final_url))
        if safe_text(final_parsed.path).strip() in {'', '/'}:
            penalty += 4
    if len(text) < 180:
        penalty += 3
    elif len(text) < 400:
        penalty += 1
    return penalty


def filter_search_result_urls(urls: list[str], *, contract: dict[str, Any] | None = None, limit: int = WEB_COLLECTION_SOURCE_LIMIT) -> list[str]:
    preferred = [item for item in urls if not is_low_value_search_candidate(item)]
    filtered = preferred or urls
    if contract is not None:
        filtered = sorted(
            filtered,
            key=lambda item: (score_web_candidate_url_relevance(contract, item) - score_web_url_quality_penalty(item), score_web_candidate_url_relevance(contract, item)),
            reverse=True,
        )
    deduped: list[str] = []
    seen: set[str] = set()
    for item in filtered:
        normalized = normalize_web_source_url(item)
        if not normalized or normalized in seen:
            continue
        seen.add(normalized)
        deduped.append(normalized)
        if len(deduped) >= limit:
            break
    return deduped


def extract_json_array_from_text(raw: str) -> list[str]:
    text = safe_text(raw)
    if not text:
        return []
    match = re.search(r'(\[[\s\S]*\])\s*$', text)
    if not match:
        return []
    try:
        payload = json.loads(match.group(1))
    except Exception:
        return []
    if not isinstance(payload, list):
        return []
    return [normalize_web_source_url(item) for item in payload if normalize_web_source_url(item)]


def build_web_search_queries(contract: dict[str, Any]) -> list[str]:
    profile = build_collection_search_profile(contract)
    subject = safe_text(profile.get('subject'))
    if not subject:
        return []
    queries: list[str] = []

    def add(query: str) -> None:
        normalized = safe_text(query)
        if normalized and normalized not in queries:
            queries.append(normalized)

    intent = safe_text(profile.get('intent')) or 'default'
    phrases = [safe_text(item) for item in (profile.get('subject_phrases') or []) if safe_text(item)] or [subject]
    preferred_phrase = next(
        (
            phrase for phrase in phrases
            if ' ' in phrase
            and re.fullmatch(r'[A-Za-z0-9\s]+', phrase.strip())
            and '-' not in phrase and '_' not in phrase and '/' not in phrase
            and all(len(token) >= 3 for token in phrase.strip().split())
        ),
        next(
            (
                phrase for phrase in phrases
                if ' ' in phrase and re.fullmatch(r'[A-Za-z0-9\s]+', phrase.strip()) and '-' not in phrase and '_' not in phrase and '/' not in phrase
            ),
            phrases[0],
        ),
    )
    add(preferred_phrase)
    if subject != preferred_phrase:
        add(subject)
    for phrase in phrases:
        for template in COLLECTION_SEARCH_QUERY_TEMPLATES.get(intent, COLLECTION_SEARCH_QUERY_TEMPLATES['default']):
            add(template.format(phrase=phrase))
    for phrase in phrases:
        if ' ' not in phrase:
            continue
        quoted = f'"{phrase}"'
        for template in COLLECTION_SEARCH_QUERY_TEMPLATES.get(intent, COLLECTION_SEARCH_QUERY_TEMPLATES['default']):
            add(template.format(phrase=quoted))
    if intent != 'reference':
        add(COLLECTION_SEARCH_QUERY_TEMPLATES['reference'][0].format(phrase=preferred_phrase))
    return queries


def search_web_source_candidates_via_hermes_cli(query: str, limit: int = WEB_COLLECTION_SOURCE_LIMIT, contract: dict[str, Any] | None = None) -> list[str]:
    hermes_bin = shutil.which('hermes')
    if not hermes_bin:
        for candidate in (
            os.path.expanduser('~/.local/bin/hermes'),
            '/home/hermes/.local/bin/hermes',
        ):
            if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
                hermes_bin = candidate
                break
    if not hermes_bin:
        return []
    prompt = (
        f'Используй web_search. Для запроса {query} верни только JSON-массив из не более чем {limit} URL. '
        'Нужны максимально релевантные предметные страницы, а не login/privacy/help/terms и не сервисные redirect-страницы. '
        'Без пояснений и без markdown.'
    )
    try:
        completed = subprocess.run(
            [
                hermes_bin,
                'chat',
                '-q',
                prompt,
                '-t',
                'web',
                '-Q',
                '--max-turns',
                '6',
                '--source',
                'tool',
            ],
            capture_output=True,
            text=True,
            timeout=HERMES_CLI_SEARCH_TIMEOUT_SECONDS,
            check=False,
        )
    except Exception:
        return []
    if completed.returncode != 0:
        return []
    urls = extract_json_array_from_text(completed.stdout)
    return filter_search_result_urls(urls, contract=contract, limit=limit)


def score_web_document_relevance(contract: dict[str, Any], document: dict[str, Any]) -> int:
    relevance_terms = build_collection_relevance_terms(safe_text(contract.get('subject')))
    haystack = ' '.join([
        safe_text(document.get('title')),
        safe_text(document.get('text'))[:4000],
        safe_text(document.get('final_url') or document.get('requested_url')),
    ]).lower()
    haystack = re.sub(r'[-_/]+', ' ', haystack)
    score = 0
    for term in relevance_terms:
        if term in haystack:
            score += 4 if len(term) >= 4 else 2
    title = safe_text(document.get('title'))
    text = safe_text(document.get('text'))
    if title:
        score += 1
    if len(text) >= 200:
        score += 1
    if not is_low_value_search_candidate(safe_text(document.get('final_url') or document.get('requested_url'))):
        score += 1
    score -= score_web_document_quality_penalty(document)
    return score


def count_web_document_subject_hits(contract: dict[str, Any], document: dict[str, Any]) -> int:
    relevance_terms = build_collection_relevance_terms(safe_text(contract.get('subject')))
    haystack = ' '.join([
        safe_text(document.get('title')),
        safe_text(document.get('text'))[:4000],
        safe_text(document.get('final_url') or document.get('requested_url')),
    ]).lower()
    haystack = re.sub(r'[-_/]+', ' ', haystack)
    hits = 0
    for term in relevance_terms:
        if term and term in haystack:
            hits += 1
    return hits


def select_relevant_web_documents(contract: dict[str, Any], documents: list[dict[str, Any]]) -> list[dict[str, Any]]:
    if not documents:
        return []
    scored = [(score_web_document_relevance(contract, doc), count_web_document_subject_hits(contract, doc), doc) for doc in documents]
    subject_terms = build_collection_relevance_terms(safe_text(contract.get('subject')))
    intent = safe_text((build_collection_search_profile(contract) or {}).get('intent'))
    if subject_terms:
        preferred = [doc for score, hits, doc in scored if hits > 0 and score >= 2]
        if not preferred and intent == 'market_overview':
            preferred = [
                doc for score, _hits, doc in scored
                if score >= 2 and not is_low_value_search_candidate(safe_text(doc.get('final_url') or doc.get('requested_url')))
            ]
    else:
        preferred = [doc for score, _, doc in scored if score >= 2]
    if preferred:
        return preferred
    if subject_terms:
        return []
    non_empty = [doc for _, _, doc in scored if safe_text(doc.get('title')) or len(safe_text(doc.get('text'))) >= 120]
    return non_empty[:5]


def _decode_bing_result_url(candidate: str) -> str:
    parsed = urllib.parse.urlparse(safe_text(candidate))
    if not parsed.netloc.lower().endswith('bing.com'):
        return safe_text(candidate)
    params = urllib.parse.parse_qs(parsed.query)
    encoded = safe_text((params.get('u') or [''])[0])
    if not encoded.startswith('a1'):
        return safe_text(candidate)
    raw = encoded[2:]
    try:
        padding = '=' * (-len(raw) % 4)
        decoded = base64.b64decode(raw + padding).decode('utf-8', errors='replace')
    except Exception:
        return safe_text(candidate)
    return safe_text(decoded or candidate)


def _extract_search_result_urls(body: str, *, limit: int = 5) -> list[str]:
    urls: list[str] = []
    patterns = [
        r'href="//duckduckgo\\.com/l/\\?uddg=([^"#]+)',
        r"href='//duckduckgo\\.com/l/\\?uddg=([^'#]+)",
        r'href="(https?://[^"#]+)"',
        r"href='(https?://[^'#]+)'",
    ]
    skip_hosts = {'duckduckgo.com', 'duck.com'}
    for pattern in patterns:
        for match in re.finditer(pattern, body, flags=re.IGNORECASE):
            candidate = safe_text(match.group(1))
            if not candidate:
                continue
            candidate = urllib.parse.unquote(candidate)
            candidate = html.unescape(candidate)
            if candidate.startswith('//'):
                candidate = 'https:' + candidate
            if not candidate.startswith(('http://', 'https://')):
                continue
            candidate = _decode_bing_result_url(candidate).rstrip(').,;')
            parsed = urllib.parse.urlparse(candidate)
            host = parsed.netloc.lower()
            if not host or host in skip_hosts or host.endswith('.bing.com'):
                continue
            if candidate not in urls:
                urls.append(candidate)
            if len(urls) >= limit:
                return urls
    return urls


def extract_search_result_previews(body: str, *, limit: int = 8) -> list[dict[str, Any]]:
    previews: list[dict[str, Any]] = []
    seen: set[str] = set()
    beautifulsoup_class = load_beautifulsoup_class()
    if beautifulsoup_class is not None:
        soup = beautifulsoup_class(body, 'lxml')
        selectors = [
            ('div.result', 'a.result__a', 'a.result__snippet, div.result__snippet'),
            ('li.b_algo', 'h2 a', 'div.b_caption p, p'),
        ]
        for container_selector, link_selector, snippet_selector in selectors:
            for node in soup.select(container_selector):
                link = node.select_one(link_selector)
                if not link:
                    continue
                href = safe_text(link.get('href'))
                if not href:
                    continue
                href = urllib.parse.unquote(html.unescape(href))
                if href.startswith('//'):
                    href = 'https:' + href
                if 'duckduckgo.com/l/?uddg=' in href:
                    parsed = urllib.parse.urlparse(href)
                    href = urllib.parse.unquote(safe_text((urllib.parse.parse_qs(parsed.query).get('uddg') or [''])[0]))
                href = _decode_bing_result_url(href).rstrip(').,;')
                normalized_url = normalize_web_source_url(href)
                parsed = urllib.parse.urlparse(normalized_url)
                host = parsed.netloc.lower()
                if not host or host in {'duckduckgo.com', 'duck.com'} or host.endswith('.bing.com'):
                    continue
                if normalized_url in seen:
                    continue
                snippet_node = node.select_one(snippet_selector)
                snippet = safe_text(snippet_node.get_text(' ', strip=True) if snippet_node else '')
                title = safe_text(link.get_text(' ', strip=True))
                previews.append({
                    'requested_url': normalized_url,
                    'url': normalized_url,
                    'title': title[:300],
                    'snippet': snippet[:1000],
                    'domain': host,
                })
                seen.add(normalized_url)
                if len(previews) >= limit:
                    return previews
    urls = _extract_search_result_urls(body, limit=max(limit * 2, 10))
    for url in urls:
        normalized_url = normalize_web_source_url(url)
        if not normalized_url or normalized_url in seen:
            continue
        parsed = urllib.parse.urlparse(normalized_url)
        host = parsed.netloc.lower()
        previews.append({
            'requested_url': normalized_url,
            'url': normalized_url,
            'title': '',
            'snippet': '',
            'domain': host,
        })
        seen.add(normalized_url)
        if len(previews) >= limit:
            break
    return previews


def search_web_source_candidates(query: str, limit: int = WEB_COLLECTION_SOURCE_LIMIT, contract: dict[str, Any] | None = None) -> list[str]:
    normalized_query = safe_text(query).strip()
    if not normalized_query:
        return []
    cli_urls = search_web_source_candidates_via_hermes_cli(normalized_query, limit=limit, contract=contract)
    if cli_urls:
        return cli_urls
    headers = {
        'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) HermesWebSearch/1.0',
        'Accept': 'text/html,application/xhtml+xml',
    }
    errors: list[str] = []
    search_urls = [
        f"https://duckduckgo.com/html/?{urllib.parse.urlencode({'q': normalized_query})}",
        f"https://www.bing.com/search?{urllib.parse.urlencode({'q': normalized_query})}",
    ]
    raw_limit = max(limit * 3, 10)
    for search_url in search_urls:
        request = urllib.request.Request(search_url, headers=headers, method='GET')
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                body = response.read().decode('utf-8', errors='replace')
        except Exception as exc:
            errors.append(f'{search_url}: {safe_text(exc)}')
            continue
        if 'anomaly-modal__title' in body or 'bots use DuckDuckGo too' in body:
            errors.append(f'{search_url}: bot_challenge')
            continue
        urls = filter_search_result_urls(_extract_search_result_urls(body, limit=raw_limit), contract=contract, limit=limit)
        if urls:
            return urls
        errors.append(f'{search_url}: empty_results')
    raise ApiError('web_search_stage_failed:' + ' | '.join(errors), 502)


def search_web_source_candidates_with_previews(query: str, limit: int = WEB_COLLECTION_SOURCE_LIMIT, contract: dict[str, Any] | None = None) -> list[dict[str, Any]]:
    normalized_query = safe_text(query).strip()
    if not normalized_query:
        return []
    cli_urls = search_web_source_candidates_via_hermes_cli(normalized_query, limit=limit, contract=contract)
    if cli_urls:
        return build_web_source_manifest_items(cli_urls, query=normalized_query)
    headers = {
        'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) HermesWebSearch/1.0',
        'Accept': 'text/html,application/xhtml+xml',
    }
    errors: list[str] = []
    search_urls = [
        f"https://duckduckgo.com/html/?{urllib.parse.urlencode({'q': normalized_query})}",
        f"https://www.bing.com/search?{urllib.parse.urlencode({'q': normalized_query})}",
    ]
    raw_limit = max(limit * 3, 10)
    for search_url in search_urls:
        request = urllib.request.Request(search_url, headers=headers, method='GET')
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                body = response.read().decode('utf-8', errors='replace')
        except Exception as exc:
            errors.append(f'{search_url}: {safe_text(exc)}')
            continue
        if 'anomaly-modal__title' in body or 'bots use DuckDuckGo too' in body:
            errors.append(f'{search_url}: bot_challenge')
            continue
        previews = extract_search_result_previews(body, limit=raw_limit)
        if contract is not None:
            previews = sorted(
                previews,
                key=lambda item: (
                    score_web_candidate_preview_relevance(contract, item),
                    score_web_candidate_url_relevance(contract, safe_text(item.get('url'))),
                ),
                reverse=True,
            )
        urls = filter_search_result_urls([safe_text(item.get('url')) for item in previews], contract=contract, limit=limit)
        if urls:
            preview_by_url = {safe_text(item.get('url')): item for item in previews if safe_text(item.get('url'))}
            result: list[dict[str, Any]] = []
            for index, url in enumerate(urls, start=1):
                item = dict(preview_by_url.get(url) or {})
                parsed = urllib.parse.urlparse(url)
                item['requested_url'] = url
                item['url'] = url
                item['domain'] = safe_text(item.get('domain') or parsed.netloc).lower()
                item['path'] = safe_text(item.get('path') or parsed.path) or '/'
                item['query'] = normalized_query
                item['source_rank'] = index
                item['availability_level'] = 'snippet_only' if safe_text(item.get('snippet')) else 'discovered_only'
                result.append(item)
            return result
        errors.append(f'{search_url}: empty_results')
    raise ApiError('web_search_stage_failed:' + ' | '.join(errors), 502)


def resolve_web_collection_sources(contract: dict[str, Any]) -> tuple[list[str], dict[str, Any] | None]:
    explicit = [normalize_web_source_url(item) for item in (contract.get('source_items') or []) if normalize_web_source_url(item)]
    if explicit:
        manifest = materialize_web_search_task_sources(contract, explicit, query='explicit_sources')
        return explicit, manifest
    queries = build_web_search_queries(contract)
    since_date = safe_text(contract.get('since_date'))
    if since_date:
        queries = [f'{item} после {since_date}' if item else item for item in queries]
    errors: list[str] = []
    best_candidates: list[dict[str, Any]] = []
    best_score = -10**9
    best_query = ''
    for query in queries:
        try:
            candidates = search_web_source_candidates_with_previews(query, limit=WEB_COLLECTION_SOURCE_LIMIT, contract=contract)
        except ApiError as exc:
            errors.append(safe_text(exc))
            continue
        if not candidates:
            continue
        candidate_urls = [normalize_web_source_url(safe_text(item.get('url') or item.get('requested_url'))) for item in candidates if normalize_web_source_url(safe_text(item.get('url') or item.get('requested_url')))]
        if not candidate_urls:
            continue
        candidate_score = score_web_candidate_set(contract, candidates)
        if candidate_score > best_score:
            best_candidates = candidates
            best_score = candidate_score
            best_query = query
        if candidate_score >= 14:
            manifest = materialize_web_search_task_sources(contract, candidates, query=query)
            return candidate_urls, manifest
    if best_candidates:
        manifest = materialize_web_search_task_sources(contract, best_candidates, query=best_query)
        best_urls = [normalize_web_source_url(safe_text(item.get('url') or item.get('requested_url'))) for item in best_candidates if normalize_web_source_url(safe_text(item.get('url') or item.get('requested_url')))]
        return best_urls, manifest
    if errors:
        raise ApiError('web_search_stage_failed:' + ' | '.join(errors), 502)
    raise ApiError('web_collection_sources_not_found', 409)


def infer_collection_since_date(text: str) -> str:
    raw = safe_text(text)
    match = re.search(r'с\s+(\d{2}\.\d{2}\.\d{4})', raw)
    if match:
        day, month, year = match.group(1).split('.')
        return f'{year}-{month}-{day}'
    match = re.search(r'from\s+(\d{4}-\d{2}-\d{2})', raw, flags=re.IGNORECASE)
    return safe_text(match.group(1)) if match else ''


def summarize_collection_source_label(source_kind: str, source_items: list[str], fallback: str) -> str:
    if not source_items:
        if source_kind in {'web', 'media'}:
            return fallback or 'Веб-поиск / открытые источники'
        return fallback
    if source_kind == 'telegram':
        preview = ', '.join('@' + item for item in source_items[:4])
        suffix = '' if len(source_items) <= 4 else f' и ещё {len(source_items) - 4}'
        return f'Telegram-каналы: {preview}{suffix}'
    preview = ', '.join(source_items[:4])
    suffix = '' if len(source_items) <= 4 else f' и ещё {len(source_items) - 4}'
    return f'{preview}{suffix}'


def build_collection_task_layers(contract: dict[str, Any]) -> dict[str, Any]:
    analysis_modes = [safe_text(item) for item in (contract.get('analysis_modes') or []) if safe_text(item)]
    stages = ['acquisition']
    if analysis_modes or safe_text(contract.get('composition_mode')):
        stages.append('analysis')
    if safe_text(contract.get('output_format')).lower() == 'dashboard':
        intent = infer_external_dashboard_intent(safe_text(contract.get('request_text') or contract.get('subject')))
        if intent in {'history_evolution', 'trend', 'segmentation', 'comparison', 'market_overview', 'evidence_board'}:
            stages.append('synthesis')
    stages.append('delivery')
    return {
        'root_class': 'data_pipeline',
        'stages': stages,
        'source_kind': safe_text(contract.get('source_kind')),
        'deliverable_kind': 'document' if safe_text(contract.get('composition_mode')) else ('dashboard' if safe_text(contract.get('output_format')).lower() == 'dashboard' else 'dataset'),
        'analysis_modes': analysis_modes,
        'cadence': 'once',
    }


def collection_dashboard_intent(contract: dict[str, Any]) -> str:
    return infer_external_dashboard_intent(safe_text(contract.get('request_text') or contract.get('subject')))


def collection_dashboard_requires_synthesis(contract: dict[str, Any]) -> bool:
    if safe_text(contract.get('output_format')).lower() != 'dashboard':
        return False
    layers = contract.get('task_layers') or {}
    stages = [safe_text(item) for item in (layers.get('stages') or []) if safe_text(item)]
    if 'synthesis' in stages:
        return True
    intent = collection_dashboard_intent(contract)
    return intent in {'history_evolution', 'trend', 'segmentation', 'comparison', 'market_overview', 'evidence_board'}


def build_collection_documents_from_rows(contract: dict[str, Any], rows: list[dict[str, Any]]) -> list[dict[str, Any]]:
    documents: list[dict[str, Any]] = []
    source_label = safe_text(contract.get('source_label') or contract.get('source_kind') or 'source')
    for index, row in enumerate(rows[:12], start=1):
        if not isinstance(row, dict):
            continue
        parts = []
        for key, value in list(row.items())[:8]:
            text_value = safe_text(value).strip()
            if not text_value:
                continue
            parts.append(f"{safe_text(key)}: {text_value[:220]}")
        text = '\n'.join(parts).strip()
        if not text:
            continue
        documents.append({
            'requested_url': safe_text(row.get('source_url') or source_label or f'row_{index}'),
            'final_url': safe_text(row.get('source_url') or ''),
            'title': safe_text(row.get('title') or row.get('name') or f'{source_label} #{index}'),
            'text': text,
        })
    return documents


def build_collection_synthesis_fallback_text(contract: dict[str, Any], documents: list[dict[str, Any]], rows: list[dict[str, Any]]) -> str:
    request_text = safe_text(contract.get('request_text') or contract.get('subject') or 'тема')
    intent = collection_dashboard_intent(contract)
    sections: list[str] = []
    intro = f"Собрала опорный материал по теме: {request_text}."
    if intent == 'history_evolution':
        intro += ' Ниже — не формальный каркас, а краткая синтетическая история по доступным источникам.'
    elif intent == 'market_overview':
        intro += ' Ниже — краткий обзор рынка по доступным источникам: игроки, сигналы, ограничения и заметные сдвиги.'
    sections.append(intro)
    source_titles = [safe_text(item.get('title') or item.get('final_url') or item.get('requested_url')) for item in documents[:5] if safe_text(item.get('title') or item.get('final_url') or item.get('requested_url'))]
    if source_titles:
        sections.append('Опорные материалы: ' + '; '.join(source_titles[:5]) + '.')
    evidence_points: list[str] = []
    for item in documents[:5]:
        excerpt = re.sub(r'\s+', ' ', safe_text(item.get('text'))).strip()
        if excerpt:
            evidence_points.append(excerpt[:320])
    if not evidence_points:
        for row in rows[:6]:
            if not isinstance(row, dict):
                continue
            row_text = '; '.join(f"{safe_text(key)}={safe_text(value)[:80]}" for key, value in list(row.items())[:6] if safe_text(value))
            if row_text:
                evidence_points.append(row_text[:320])
    if evidence_points:
        for idx, point in enumerate(evidence_points[:4], start=1):
            if intent == 'history_evolution':
                sections.append(f"Этап {idx}. {point}")
            elif intent == 'market_overview':
                sections.append(f"Рыночный сигнал {idx}. {point}")
            else:
                sections.append(f"Наблюдение {idx}. {point}")
    else:
        sections.append('Подтверждённых фрагментов пока мало: нужен дополнительный сбор данных перед финальной визуализацией.')
    return '\n\n'.join(section for section in sections if section).strip()


def build_collection_synthesis_text(contract: dict[str, Any], documents: list[dict[str, Any]], rows: list[dict[str, Any]]) -> str:
    prompt_documents = documents[:8] or build_collection_documents_from_rows(contract, rows)
    intent = collection_dashboard_intent(contract)
    if intent == 'history_evolution':
        intent_instruction = 'Верни обычный русский текст: 4-8 абзацев по существу темы, с фактами, этапами, сдвигами практик, ограничениями и оговорками. '
    elif intent == 'market_overview':
        intent_instruction = 'Верни обычный русский текст: 4-8 абзацев по существу темы, с фактами о рынке, игроках, позиционировании, продуктовых сигналах, ограничениях и оговорках. Не уходи в общие практики и методологию, если запрос про рынок или компанию. '
    else:
        intent_instruction = 'Верни обычный русский текст: 4-8 абзацев по существу темы, с фактами, ключевыми наблюдениями, ограничениями и оговорками. '
    prompt_messages = [
        {
            'role': 'system',
            'content': (
                'Ты выполняешь synthesis-stage для Hermes data pipeline. '
                'Нужно собрать содержательный промежуточный материал перед построением dashboard. '
                'Не описывай, что сделал агент. Не пиши про route, pipeline, backend, JSON, секции или визуализацию. '
                + intent_instruction +
                'Если данных мало, честно обозначь ограничение, но всё равно извлеки максимум содержания из материалов.'
            ),
        },
        {
            'role': 'user',
            'content': json.dumps({
                'request_text': contract.get('request_text'),
                'subject': contract.get('subject'),
                'intent': collection_dashboard_intent(contract),
                'analysis_modes': contract.get('analysis_modes') or [],
                'documents': [
                    {
                        'title': item.get('title') or item.get('final_url') or item.get('requested_url'),
                        'source_url': item.get('final_url') or item.get('requested_url'),
                        'text_excerpt': safe_text(item.get('text'))[:2500],
                    }
                    for item in prompt_documents[:8]
                ],
                'rows_preview': rows[:20],
            }, ensure_ascii=False),
        },
    ]
    try:
        synthesis_text, _ = call_hermes_messages(prompt_messages, model_name=HERMES_API_MODEL)
        cleaned = safe_text(synthesis_text).strip()
        if cleaned and len(cleaned) >= 180 and not response_looks_like_tool_transcript(cleaned):
            return cleaned
    except Exception:
        pass
    return build_collection_synthesis_fallback_text(contract, documents, rows)


def build_dashboard_from_synthesis_fallback_payload(contract: dict[str, Any], synthesis_text: str, source_meta: dict[str, Any]) -> dict[str, Any]:
    request_text = safe_text(contract.get('request_text') or contract.get('subject') or 'тема')
    intent = collection_dashboard_intent(contract)
    paragraphs = [re.sub(r'\s+', ' ', part).strip() for part in re.split(r'\n{2,}', safe_text(synthesis_text)) if re.sub(r'\s+', ' ', part).strip()]
    if not paragraphs:
        paragraphs = [re.sub(r'\s+', ' ', safe_text(synthesis_text)).strip()]
    sentences = [re.sub(r'\s+', ' ', part).strip() for part in re.split(r'(?<=[.!?])\s+', safe_text(synthesis_text)) if re.sub(r'\s+', ' ', part).strip()]
    dashboard_sentences = [
        part for part in sentences
        if not re.match(r'^(Собрала опорный материал по теме:|Ниже —|Опорные материалы:|Рыночный сигнал\s+\d+[\.:]?)', part, flags=re.IGNORECASE)
    ] or sentences
    timeline_items = []
    for idx, part in enumerate((paragraphs or dashboard_sentences)[:4], start=1):
        timeline_items.append({'label': f'Этап {idx}', 'value': part[:280]})
    timeline_values = {safe_text(item.get('value')).strip() for item in timeline_items if safe_text(item.get('value')).strip()}
    history_focus_candidates: list[str] = []
    seen_history_focuses: set[str] = set()
    for part in dashboard_sentences:
        normalized = safe_text(part).strip()
        if not normalized:
            continue
        if normalized in timeline_values:
            continue
        key = normalized.lower()
        if key in seen_history_focuses:
            continue
        seen_history_focuses.add(key)
        history_focus_candidates.append(normalized)
    if not history_focus_candidates and intent == 'history_evolution':
        for item in timeline_items:
            raw_value = safe_text(item.get('value')).strip()
            distilled = re.sub(r'^(ранний этап|затем|позже|отдельный сдвиг заключался в|на этом этапе|далее)\s+', '', raw_value, flags=re.IGNORECASE).strip(' .,:;-')
            if not distilled:
                continue
            if distilled.lower() in seen_history_focuses:
                continue
            seen_history_focuses.add(distilled.lower())
            history_focus_candidates.append(distilled)
    matrix_items = []
    for idx, part in enumerate(history_focus_candidates[:4], start=1):
        matrix_items.append({'label': f'Сдвиг {idx}', 'value': part[:220]})
    market_items = []
    for idx, part in enumerate(dashboard_sentences[:5], start=1):
        market_items.append({'label': f'Сигнал {idx}', 'value': part[:220]})
    text_items = [part[:260] for part in dashboard_sentences[:5] if part][:5]
    sections = []
    if intent == 'history_evolution' and timeline_items:
        sections.append({'kind': 'timeline_list', 'title': 'Ключевые этапы и поворотные точки', 'items': timeline_items})
    if intent == 'market_overview' and market_items:
        sections.append({'kind': 'bar_list', 'title': 'Игроки, сигналы и рыночные акценты', 'items': market_items})
    elif matrix_items:
        sections.append({'kind': 'matrix_list', 'title': 'Смена практик и подходов', 'items': matrix_items})
    if text_items:
        sections.append({'kind': 'text_list', 'title': 'Краткие выводы', 'items': text_items})
    summary_cards = [
        {'label': 'Режим', 'value': 'synthesis-first', 'note': 'Сначала собран содержательный материал'},
        {'label': 'Источник', 'value': safe_text(source_meta.get('label') or contract.get('source_label') or contract.get('source_kind') or 'Собранные данные')},
        {'label': 'Тип задачи', 'value': intent or 'evidence_board', 'note': 'Dashboard построен по уже собранному содержанию'},
    ]
    return {
        'reply_text': f"Собрала содержательный материал и на его основе подготовила дашборд по теме: {request_text[:120] or 'исследование'}.",
        'dashboard': {
            'kind': 'external_research_dashboard',
            'title': f"Дашборд по теме: {request_text[:80] or 'исследование'}",
            'subtitle': 'Сначала synthesis, затем dashboard',
            'summary_cards': summary_cards,
            'sections': sections,
            'sources': [{'label': safe_text(source_meta.get('label') or contract.get('source_label') or contract.get('source_kind') or 'Источник')}],
            'notes': 'Построено из уже собранного содержательного материала без synthetic-чисел.',
        },
    }


def dashboard_result_is_substantive(dashboard: dict[str, Any], reply_text: str, user_text: str) -> bool:
    sections = dashboard.get('sections') or []
    if not isinstance(sections, list) or not sections:
        return False
    blocked_markers = (
        'собрано из текущего ответа backend-маршрута',
        'fallback-секция',
        'нужен дополнительный сбор',
        'dashboard построен после execution-path',
    )
    good_sections = 0
    has_history_visual = False
    for section in sections:
        if not isinstance(section, dict):
            continue
        probe = ' '.join([
            safe_text(section.get('title')),
            safe_text(section.get('note')),
            json.dumps(section.get('items') or [], ensure_ascii=False)[:1200],
        ]).lower()
        if any(marker in probe for marker in blocked_markers):
            continue
        items = section.get('items') or []
        if isinstance(items, list) and len(items) >= 1 and len(probe) >= 80:
            good_sections += 1
        if safe_text(section.get('kind')) in {'timeline_list', 'matrix_list'} and isinstance(items, list) and len(items) >= 2:
            has_history_visual = True
    if good_sections < 2:
        return False
    if collection_dashboard_intent({'request_text': user_text}) == 'history_evolution' and not has_history_visual:
        return False
    lowered_reply = safe_text(reply_text).lower()
    if any(marker in lowered_reply for marker in blocked_markers):
        return False
    return len(safe_text(reply_text).strip()) >= 40


def is_transform_to_dashboard_followup(text: str) -> bool:
    normalized = re.sub(r'\s+', ' ', safe_text(text).strip().lower())
    if not normalized or len(normalized) > 180 or 'дашборд' not in normalized:
        return False
    markers = (
        'по этой теме',
        'по этой информации',
        'по этому',
        'по этому ответу',
        'на основе этого',
        'из этого',
        'из собранного',
        'из материала выше',
        'из предыдущего ответа',
    )
    return any(marker in normalized for marker in markers)


def previous_answer_supports_dashboard_transform(message_rows: list[sqlite3.Row]) -> tuple[str, sqlite3.Row | None]:
    previous_rows = list(message_rows[:-1]) if message_rows else []
    previous_assistant = latest_substantive_assistant_row(previous_rows)
    if previous_assistant is None:
        return '', None
    content = safe_text(previous_assistant['content']).strip()
    if len(content) < 220:
        return '', None
    lowered = content.lower()
    blocked_prefixes = ('не удалось получить ответ', 'не удалось сформировать файл', 'собрала дашборд')
    if lowered.startswith(blocked_prefixes):
        return '', None
    return content, previous_assistant


def maybe_build_dashboard_from_previous_answer(message_rows: list[sqlite3.Row], user_text: str) -> tuple[str, dict[str, Any]] | None:
    if not is_transform_to_dashboard_followup(user_text):
        return None
    previous_text, previous_assistant = previous_answer_supports_dashboard_transform(message_rows)
    if previous_assistant is None or not previous_text:
        return None
    previous_user_text = ''
    for row in reversed(message_rows[:-1]):
        if row['role'] == 'user':
            candidate = safe_text((json_loads(row['meta_json'], {}) if 'meta_json' in row.keys() else {}).get('user_text') or row['content']).strip()
            if candidate and candidate != safe_text(user_text).strip():
                previous_user_text = candidate
                break
    contract = {
        'source_kind': 'conversation',
        'source_label': 'Ранее собранный материал',
        'output_format': 'dashboard',
        'subject': infer_collection_subject(previous_user_text) or previous_user_text or 'предыдущий ответ',
        'request_text': previous_user_text or safe_text(user_text),
        'analysis_modes': infer_collection_analysis_modes(previous_user_text or previous_text),
        'task_layers': {
            'root_class': 'skill_transform',
            'stages': ['analysis', 'synthesis', 'delivery'],
            'source_kind': 'conversation',
            'deliverable_kind': 'dashboard',
        },
    }
    source_meta = {
        'label': 'Ранее собранный материал',
        'item_key': 'conversation_followup',
        'route': 'previous_answer_transform',
    }
    policy = {
        'source_mode': 'conversation_only',
        'notes': 'Dashboard построен как transform от предыдущего содержательного ответа.',
    }
    payload = None
    try:
        prompt_messages = [
            {
                'role': 'system',
                'content': (
                    'Ты строишь dashboard_result из уже собранного содержательного ответа Hermes. '
                    'Нельзя рассказывать, что сделал агент; нужно превратить содержание в визуально пригодный дашборд. '
                    'Верни строго JSON-объект вида {"reply_text":"...","dashboard":{...}} без markdown.'
                ),
            },
            {
                'role': 'user',
                'content': json.dumps({
                    'request_text': previous_user_text or user_text,
                    'followup_text': user_text,
                    'previous_answer': previous_text,
                }, ensure_ascii=False),
            },
        ]
        payload = extract_json_object(call_hermes_messages(prompt_messages, model_name=HERMES_API_MODEL)[0])
    except Exception:
        payload = None
    if not isinstance(payload, dict):
        payload = build_dashboard_from_synthesis_fallback_payload(contract, previous_text, source_meta)
    reply_text = safe_text(payload.get('reply_text') or f'Собрала дашборд по ранее собранному материалу: {safe_text(previous_user_text or user_text)[:120]}.')
    dashboard = normalize_external_dashboard_payload(
        payload.get('dashboard') if isinstance(payload.get('dashboard'), dict) else {},
        reply_text,
        source_meta,
        policy,
        safe_text(previous_user_text or user_text),
    )
    if not dashboard_result_is_substantive(dashboard, reply_text, safe_text(previous_user_text or user_text)):
        payload = build_dashboard_from_synthesis_fallback_payload(contract, previous_text, source_meta)
        reply_text = safe_text(payload.get('reply_text'))
        dashboard = normalize_external_dashboard_payload(payload.get('dashboard') or {}, reply_text, source_meta, policy, safe_text(previous_user_text or user_text))
    return reply_text, {
        'message_kind': 'dashboard_result',
        'downstream': 'dashboard:previous_answer_transform',
        'dashboard_builder': 'previous_answer_transform_dashboard',
        'dashboard_label': source_meta['label'],
        'dashboard_grammar': EXTERNAL_DASHBOARD_GRAMMAR_VERSION,
        'analytics_source': source_meta,
        'dashboard_policy': policy,
        'dashboard': dashboard,
        'focused_followup_context': {
            'followup_text': safe_text(user_text),
            'previous_user_text': safe_text(previous_user_text),
            'previous_assistant_message_id': int(previous_assistant['id']),
        },
    }


