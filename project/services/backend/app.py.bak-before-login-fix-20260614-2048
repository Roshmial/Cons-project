def reference_items_for_dataset(conn: sqlite3.Connection, dataset_key: str, include_inactive: bool = False) -> list[sqlite3.Row]:
    sql = """
        SELECT id, dataset_key, item_key, label, payload_json, sort_order, is_active, deleted_at, version, created_at, updated_at
        FROM reference_items
        WHERE scope = ? AND dataset_key = ?
    """
    params: list[Any] = [REFERENCE_SCOPE_GLOBAL, dataset_key]
    if not include_inactive:
        sql += " AND is_active = 1 AND deleted_at IS NULL"
    sql += " ORDER BY sort_order ASC, id ASC"
    return conn.execute(sql, params).fetchall()


def serialize_reference_item(row: sqlite3.Row) -> dict[str, Any]:
    payload = json_loads(row["payload_json"], {})
    keys = set(row.keys()) if hasattr(row, "keys") else set()
    deleted_at = row["deleted_at"] if "deleted_at" in keys else None
    is_active = bool(row["is_active"])
    status = "deleted" if deleted_at else ("inactive" if not is_active else "active")
    data = {
        "id": row["id"],
        "dataset_key": row["dataset_key"],
        "item_key": row["item_key"],
        "label": row["label"],
        "sort_order": row["sort_order"],
        "is_active": is_active,
        "deleted_at": deleted_at,
        "status": status,
        "version": row["version"] if "version" in row.keys() else 1,
        "created_at": row["created_at"],
        "updated_at": row["updated_at"],
    }
    if isinstance(payload, dict):
        data.update(payload)
    return data


def resolve_reference_item_status(payload: dict[str, Any], *, default_status: str = "active") -> tuple[int, str | None, str]:
    requested_status = safe_text(payload.get("status") or default_status).lower() or default_status
    if requested_status not in {"active", "inactive", "deleted"}:
        requested_status = default_status
    if "deleted_at" in payload:
        deleted_at_raw = safe_text(payload.get("deleted_at") or "")
        if deleted_at_raw:
            requested_status = "deleted"
    if "is_active" in payload and requested_status != "deleted":
        requested_status = "active" if bool(payload.get("is_active")) else "inactive"
    is_active = 1 if requested_status == "active" else 0
    deleted_at = now_iso() if requested_status == "deleted" else None
    return is_active, deleted_at, requested_status


