@app.get(f"{API_PREFIX}/threads")
def get_threads() -> Response:
    auth = require_auth()
    include_archived = request.args.get("include_archived") == "1"
    query = """
        SELECT t.id, t.title, t.preview, t.archived, t.thread_kind, t.job_id, t.version, t.created_at, t.updated_at,
               COUNT(m.id) AS message_count,
               MAX(m.created_at) AS last_message_at,
               MAX(
                   CASE
                       WHEN t.thread_kind = 'job'
                            AND m.role = 'assistant'
                            AND TRIM(COALESCE(m.content, '')) <> ''
                            AND COALESCE(m.meta_json, '') NOT LIKE '%%\"message_kind\": \"file_response\"%%'
                            AND COALESCE(m.meta_json, '') NOT LIKE '%%\"message_kind\":\"file_response\"%%'
                            AND COALESCE(m.meta_json, '') NOT LIKE '%%\"message_kind\": \"processing_status\"%%'
                            AND COALESCE(m.meta_json, '') NOT LIKE '%%\"message_kind\":\"processing_status\"%%'
                            AND (
                                COALESCE(m.meta_json, '') LIKE '%%\"source\": \"job_run\"%%'
                                OR COALESCE(m.meta_json, '') LIKE '%%\"source\":\"job_run\"%%'
                                OR COALESCE(m.meta_json, '') LIKE '%%\"source\": \"hermes_cron\"%%'
                                OR COALESCE(m.meta_json, '') LIKE '%%\"source\":\"hermes_cron\"%%'
                            )
                       THEN m.created_at
                       ELSE NULL
                   END
               ) AS last_delivery_at,
               MAX(
                   CASE
                       WHEN t.thread_kind = 'job'
                            AND m.role = 'user'
                            AND TRIM(COALESCE(m.content, '')) <> ''
                       THEN m.created_at
                       ELSE NULL
                   END
               ) AS last_user_interaction_at,
               CASE
                   WHEN t.thread_kind = 'job' THEN GREATEST(
                       COALESCE(
                           MAX(
                               CASE
                                   WHEN m.role = 'assistant'
                                        AND TRIM(COALESCE(m.content, '')) <> ''
                                        AND COALESCE(m.meta_json, '') NOT LIKE '%%\"message_kind\": \"file_response\"%%'
                                        AND COALESCE(m.meta_json, '') NOT LIKE '%%\"message_kind\":\"file_response\"%%'
                                        AND COALESCE(m.meta_json, '') NOT LIKE '%%\"message_kind\": \"processing_status\"%%'
                                        AND COALESCE(m.meta_json, '') NOT LIKE '%%\"message_kind\":\"processing_status\"%%'
                                        AND (
                                            COALESCE(m.meta_json, '') LIKE '%%\"source\": \"job_run\"%%'
                                            OR COALESCE(m.meta_json, '') LIKE '%%\"source\":\"job_run\"%%'
                                            OR COALESCE(m.meta_json, '') LIKE '%%\"source\": \"hermes_cron\"%%'
                                            OR COALESCE(m.meta_json, '') LIKE '%%\"source\":\"hermes_cron\"%%'
                                        )
                                   THEN m.created_at
                                   ELSE NULL
                               END
                           ),
                           t.created_at
                       ),
                       COALESCE(
                           MAX(
                               CASE
                                   WHEN m.role = 'user'
                                        AND TRIM(COALESCE(m.content, '')) <> ''
                                   THEN m.created_at
                                   ELSE NULL
                               END
                           ),
                           t.created_at
                       )
                   )
                   ELSE t.updated_at
               END AS freshness_at
        FROM threads t
        LEFT JOIN messages m ON m.thread_id = t.id
        WHERE t.user_id = ?
    """
    params: list[Any] = [auth.id]
    if not include_archived:
        query += " AND t.archived = 0"
    query += " GROUP BY t.id, t.title, t.preview, t.archived, t.thread_kind, t.job_id, t.version, t.created_at, t.updated_at ORDER BY freshness_at DESC, t.id DESC"
    with db_connect() as conn:
        rows = conn.execute(query, params).fetchall()
    return jsonify({"threads": [{**dict(row), "version": int(row["version"] or 1)} for row in rows]})


