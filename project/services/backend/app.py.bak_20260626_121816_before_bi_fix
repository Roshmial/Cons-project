def build_message_export_xlsx(message_row: sqlite3.Row, thread_title: str) -> io.BytesIO:
    rows = [
        ["Чат", thread_title or "Без названия"],
        ["Сообщение", int(message_row["id"])],
        ["Дата", safe_text(message_row["created_at"]) or "—"],
        [],
        ["Текст"],
    ]
    for line in build_message_export_text(message_row, thread_title).splitlines():
        rows.append([line])
    if True:
        openpyxl_module = load_openpyxl_module()
        if openpyxl_module is None:
            return build_message_export_xlsx_fallback(rows)
        workbook = openpyxl_module.Workbook()
    sheet = workbook.active
    sheet.title = "Сообщение"
    for row in rows:
        sheet.append(row)
    sheet.column_dimensions["A"].width = 120
    buffer = io.BytesIO()
    workbook.save(buffer)
    buffer.seek(0)
    return buffer


_EXPORT_PDF_FONT_REGISTERED = False


def ensure_pdf_export_font() -> str:
    global _EXPORT_PDF_FONT_REGISTERED
    A4_module, TTFont_module, pdfmetrics_module, canvas_module = load_reportlab_modules()
    if canvas_module is None or pdfmetrics_module is None or TTFont_module is None:
        raise ApiError("export_dependency_missing_pdf", 503)
    font_name = "Helvetica"
    candidate_paths = [
        Path("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"),
        Path("/usr/share/fonts/dejavu/DejaVuSans.ttf"),
    ]
    for candidate in candidate_paths:
        if candidate.exists() and candidate.is_file():
            font_name = "DejaVuSans"
            if not _EXPORT_PDF_FONT_REGISTERED:
                pdfmetrics_module.registerFont(TTFont_module(font_name, str(candidate)))
                _EXPORT_PDF_FONT_REGISTERED = True
            break
    return font_name


def build_message_export_pdf(message_row: sqlite3.Row, thread_title: str) -> io.BytesIO:
    A4_module, _TTFont_module, _pdfmetrics_module, canvas_module = load_reportlab_modules()
    if canvas_module is None or A4_module is None:
        fitz_module = load_fitz_module()
        if fitz_module is None:
            raise ApiError("export_dependency_missing_pdf", 503)
        document = fitz_module.open()
        page = document.new_page(width=595, height=842)
        text = build_message_export_text(message_row, thread_title)
        page.insert_textbox(fitz_module.Rect(40, 40, 555, 802), text, fontsize=11, fontname="helv")
        pdf_bytes = document.tobytes()
        document.close()
        return io.BytesIO(pdf_bytes)
    buffer = io.BytesIO()
    pdf = canvas_module.Canvas(buffer, pagesize=A4_module)
    width, height = A4_module
    font_name = ensure_pdf_export_font()
    font_size = 11
    left_margin = 40
    top_margin = height - 48
    line_height = 16
    y = top_margin
    pdf.setTitle(thread_title or "Hermes export")
    pdf.setFont(font_name, font_size)
    for raw_line in build_message_export_text(message_row, thread_title).splitlines():
        line = raw_line or " "
        chunks = [line[i:i + 110] for i in range(0, len(line), 110)] or [" "]
        for chunk in chunks:
            if y <= 40:
                pdf.showPage()
                pdf.setFont(font_name, font_size)
                y = top_margin
            pdf.drawString(left_margin, y, chunk)
            y -= line_height
    pdf.save()
    buffer.seek(0)
    return buffer


def build_message_export_image(message_row: sqlite3.Row, thread_title: str, image_format: str) -> io.BytesIO:
    image_module, image_draw_module, image_font_module = load_pil_modules()
    if image_module is None or image_draw_module is None or image_font_module is None:
        raise ApiError(f"export_dependency_missing_{image_format}", 503)
    payload = build_message_export_payload(message_row, thread_title)
    lines = [
        safe_text(payload['thread_title']) or 'Без названия',
        f"Сообщение #{payload['message_id']} · {safe_text(payload['created_at']) or '—'}",
        '',
    ] + [safe_text(line) for line in payload['text_lines'][4:]]
    font = image_font_module.load_default()
    max_width = 1200
    margin = 48
    line_gap = 10
    wrapped = []
    dummy = image_module.new('RGB', (10, 10), 'white')
    draw = image_draw_module.Draw(dummy)
    for raw in lines:
        text_line = raw or ''
        if not text_line:
            wrapped.append('')
            continue
        current = ''
        for word in text_line.split():
            candidate = word if not current else f"{current} {word}"
            bbox = draw.textbbox((0, 0), candidate, font=font)
            if bbox[2] - bbox[0] <= max_width - margin * 2:
                current = candidate
            else:
                if current:
                    wrapped.append(current)
                current = word
        wrapped.append(current or text_line)
    line_height = draw.textbbox((0, 0), 'Ag', font=font)[3] + line_gap
    image_height = max(400, margin * 2 + line_height * max(1, len(wrapped)))
    image = image_module.new('RGB', (max_width, image_height), 'white')
    canvas_draw = image_draw_module.Draw(image)
    y = margin
    for idx, line in enumerate(wrapped):
        fill = '#111827' if idx != 1 else '#6b7280'
        if not line:
            y += line_height
            continue
        canvas_draw.text((margin, y), line, fill=fill, font=font)
        y += line_height
    buffer = io.BytesIO()
    save_format = 'JPEG' if image_format == 'jpeg' else 'PNG'
    image.save(buffer, format=save_format, quality=92)
    buffer.seek(0)
    return buffer


