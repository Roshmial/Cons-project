    row = conn.execute(
        """
        SELECT u.*, 
               COUNT(DISTINCT t.id) AS thread_count,
               COUNT(DISTINCT j.id) AS job_count
        FROM users u
        LEFT JOIN threads t ON t.user_id = u.id
        LEFT JOIN jobs j ON j.user_id = u.id
        WHERE u.id = ?
        GROUP BY u.id, u.email, u.password_hash, u.role, u.name, u.timezone, u.language, u.team, u.title, u.goals, u.style, u.constraints_text, u.pinned_json, u.assistant_profile_json, u.interaction_memory_json, u.memory_last_processed_message_id, u.version, u.onboarding_completed, u.is_active, u.deleted_at, u.created_at, u.updated_at
        """,
        (user_id,),
    ).fetchone()
    if not row:
        raise ApiError("user_not_found", 404)
    payload = user_to_dict(row, conn)
    payload.update(
        {
            "thread_count": row["thread_count"],
            "job_count": row["job_count"],
            "created_at": row["created_at"],
            "updated_at": row["updated_at"],
        }
    )
    return payload


def save_admin_user(conn: sqlite3.Connection, payload: dict[str, Any], existing_user_id: int | None = None, actor_user_id: int | None = None) -> dict[str, Any]:
    normalized = normalize_import_user(payload)
    normalized["assistant_profile"] = validate_assistant_profile(conn, normalized["assistant_profile"], normalized["style"])
    password_value = safe_text(payload.get("password") or "")
    expected_version = payload.get("version")
    current = None
    if existing_user_id is not None:
        current = conn.execute("SELECT * FROM users WHERE id = ?", (existing_user_id,)).fetchone()
        if not current:
            raise ApiError("user_not_found", 404)
        if expected_version is not None and int(current["version"] or 1) != int(expected_version):
            raise ApiError("version_conflict", 409)
    duplicate = conn.execute("SELECT id FROM users WHERE lower(email) = ?", (normalized["email"],)).fetchone()
    if duplicate and (existing_user_id is None or duplicate["id"] != existing_user_id):
        raise ApiError("email_already_exists", 409)
    assistant_profile_json = json.dumps(normalized["assistant_profile"], ensure_ascii=False)
    pinned_json = json.dumps(normalized["pinned"], ensure_ascii=False)
    ts = now_iso()
    if current is None:
        if len(password_value) < MIN_PASSWORD_LENGTH:
            raise ApiError("password_too_short", 400)
        requested_status = safe_text(payload.get("status") or "active").lower() or "active"
        is_active = 1 if requested_status == "active" else 0
        deleted_at = ts if requested_status == "deleted" else None
        new_id = conn.execute(
            """
            INSERT INTO users (
                email, password_hash, role, name, timezone, language, team, title,
                goals, style, constraints_text, pinned_json, assistant_profile_json,
                version, onboarding_completed, is_active, deleted_at, created_at, updated_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, 0, ?, ?, ?, ?)
            RETURNING id
            """,
            (
                normalized["email"],
                generate_password_hash(password_value),
                normalized["role"],
                normalized["name"],
                normalized["timezone"],
                normalized["language"],
                normalized["team"],
                normalized["title"],
                normalized["goals"],
                normalized["style"],
                normalized["constraints"],
                pinned_json,
                assistant_profile_json,
                is_active,
                deleted_at,
                ts,
                ts,
            ),
        ).fetchone()[0]
        write_user_change_log(conn, int(new_id), actor_user_id, "create")
        return get_user_with_stats(conn, int(new_id))
    next_version = int(current["version"] or 1) + 1
    requested_status = safe_text(payload.get("status") or ("deleted" if current["deleted_at"] else ("inactive" if not bool(current["is_active"]) else "active"))).lower() or "active"
    is_active = 1 if requested_status == "active" else 0
    deleted_at = ts if requested_status == "deleted" else None
    updated = conn.execute(
        """
        UPDATE users
        SET email = ?, role = ?, name = ?, timezone = ?, language = ?, team = ?, title = ?,
            goals = ?, style = ?, constraints_text = ?, pinned_json = ?, assistant_profile_json = ?, version = ?, updated_at = ?, is_active = ?, deleted_at = ?
        WHERE id = ? AND version = ?
        RETURNING id
        """,
        (
            normalized["email"],
            normalized["role"],
            normalized["name"],
            normalized["timezone"],
            normalized["language"],
            normalized["team"],
            normalized["title"],
            normalized["goals"],
            normalized["style"],
            normalized["constraints"],
            pinned_json,
            assistant_profile_json,
            next_version,
            ts,
            is_active,
            deleted_at,
            existing_user_id,
            int(current["version"] or 1),
        ),
    ).fetchone()
    if not updated:
        raise ApiError("version_conflict", 409)
    if password_value:
        if len(password_value) < MIN_PASSWORD_LENGTH:
            raise ApiError("password_too_short", 400)
        conn.execute("UPDATE users SET password_hash = ?, updated_at = ? WHERE id = ?", (generate_password_hash(password_value), ts, existing_user_id))
        revoke_user_sessions(conn, int(existing_user_id))
    write_user_change_log(conn, int(existing_user_id), actor_user_id, "update")
    return get_user_with_stats(conn, int(existing_user_id))


def bulk_update_user_status(conn: sqlite3.Connection, *, user_ids: list[int], status: str, actor_user_id: int | None = None) -> list[dict[str, Any]]:
    normalized_ids: list[int] = []
    seen_ids: set[int] = set()
    for raw_id in user_ids:
        try:
            numeric_id = int(raw_id)
        except (TypeError, ValueError):
            continue
        if numeric_id <= 0 or numeric_id in seen_ids:
            continue
        seen_ids.add(numeric_id)
        normalized_ids.append(numeric_id)
    if not normalized_ids:
        raise ApiError("user_ids_required", 400)
    requested_status = safe_text(status).lower()
    if requested_status not in {"active", "inactive", "deleted"}:
        raise ApiError("user_status_invalid", 400)
    placeholders = ", ".join(["?"] * len(normalized_ids))
    rows = conn.execute(
        f"SELECT * FROM users WHERE id IN ({placeholders}) ORDER BY id ASC",
        tuple(normalized_ids),
    ).fetchall()
    found_ids = {int(row["id"]) for row in rows}
    if len(found_ids) != len(normalized_ids):
        raise ApiError("user_not_found", 404)
    if requested_status in {"inactive", "deleted"}:
        active_admin_total = conn.execute(
            "SELECT COUNT(*) FROM users WHERE role = 'admin' AND is_active = 1 AND deleted_at IS NULL"
        ).fetchone()[0]
        selected_active_admins = sum(1 for row in rows if row["role"] == "admin" and bool(row["is_active"]) and not row["deleted_at"])
        if active_admin_total and selected_active_admins >= active_admin_total:
            raise ApiError("last_active_admin_required", 400)
    ts = now_iso()
    is_active = 1 if requested_status == "active" else 0
    deleted_at = ts if requested_status == "deleted" else None
    change_type = {
        "active": "bulk_activate",
        "inactive": "bulk_inactivate",
        "deleted": "bulk_delete",
    }[requested_status]
    for row in rows:
        next_version = int(row["version"] or 1) + 1
        conn.execute(
            """
            UPDATE users
            SET is_active = ?, deleted_at = ?, version = ?, updated_at = ?
            WHERE id = ?
            """,
            (is_active, deleted_at, next_version, ts, int(row["id"])),
        )
        write_user_change_log(conn, int(row["id"]), actor_user_id, change_type)
    return [get_user_with_stats(conn, user_id) for user_id in normalized_ids]


def bulk_update_reference_item_status(
    conn: sqlite3.Connection,
    *,
    dataset_key: str,
    item_keys: list[str],
    status: str,
    actor_user_id: int | None = None,
) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    if dataset_key not in REFERENCE_DATASETS:
        raise ApiError("reference_dataset_not_found", 404)
    normalized_keys: list[str] = []
    seen_keys: set[str] = set()
    for raw_key in item_keys:
        item_key = safe_text(raw_key)
        if not item_key or item_key in seen_keys:
            continue
        seen_keys.add(item_key)
        normalized_keys.append(item_key)
    if not normalized_keys:
        raise ApiError("reference_item_keys_required", 400)
    requested_status = safe_text(status).lower()
    if requested_status not in {"active", "inactive", "deleted"}:
        raise ApiError("reference_item_status_invalid", 400)
    placeholders = ", ".join(["?"] * len(normalized_keys))
    rows = conn.execute(
        f"""
        SELECT *
        FROM reference_items
        WHERE scope = ? AND dataset_key = ? AND item_key IN ({placeholders})
        ORDER BY sort_order ASC, id ASC
        """,
        (REFERENCE_SCOPE_GLOBAL, dataset_key, *normalized_keys),
    ).fetchall()
    found_keys = {safe_text(row["item_key"]) for row in rows}
    if len(found_keys) != len(normalized_keys):
        raise ApiError("reference_item_not_found", 404)
    ts = now_iso()
    is_active = 1 if requested_status == "active" else 0
    deleted_at = ts if requested_status == "deleted" else None
    change_type = {
        "active": "bulk_activate",
        "inactive": "bulk_inactivate",
        "deleted": "bulk_delete",
    }[requested_status]
    for row in rows:
        next_version = int(row["version"] or 1) + 1
        conn.execute(
            """
            UPDATE reference_items
            SET is_active = ?, deleted_at = ?, version = ?, updated_at = ?
            WHERE scope = ? AND dataset_key = ? AND item_key = ?
            """,
            (is_active, deleted_at, next_version, ts, REFERENCE_SCOPE_GLOBAL, dataset_key, row["item_key"]),
        )
        write_reference_item_change_log(conn, dataset_key, row["item_key"], actor_user_id, change_type)
    dataset_payload = build_reference_payload(conn, include_inactive=True).get(dataset_key)
    updated_items_by_key = {item["item_key"]: item for item in (dataset_payload or {}).get("items", [])}
    ordered_items = [updated_items_by_key[item_key] for item_key in normalized_keys if item_key in updated_items_by_key]
    return ordered_items, dataset_payload


def build_recurring_summary_envelope(meta: dict[str, Any], content: str, *, created_at: str | None = None) -> dict[str, Any] | None:
    payload = meta if isinstance(meta, dict) else {}
    message_kind = safe_text(payload.get("message_kind")).lower()
    source = safe_text(payload.get("source")).lower()
    recurring_family = message_kind in {"job_delivery", "processing_status"} or source == "job_run"
    if not recurring_family:
        return None
    attachments = payload.get("attachments") if isinstance(payload.get("attachments"), list) else []
    recurring = payload.get("recurring_summary") if isinstance(payload.get("recurring_summary"), dict) else {}
    status = safe_text(recurring.get("status") or ("running" if payload.get("pending") else "failed" if payload.get("error") else "completed")).lower()
    if status not in {"running", "completed", "completed_with_limitations", "failed", "empty_result"}:
        status = "completed"
    created_at_value = safe_text(created_at or payload.get("created_at") or payload.get("started_at") or payload.get("queued_at"))
    is_stuck = status == "running" and is_timestamp_stale(created_at_value, threshold_seconds=CHAT_TASK_STUCK_SECONDS)
    if is_stuck:
        status = "failed"
    normalized_content = strip_internal_reasoning_prelude(content)
    summary_text = safe_text(normalized_content or recurring.get("summary") or payload.get("summary") or content)
    result_kind = safe_text(recurring.get("result_kind") or ("file" if attachments else "text" if summary_text else "empty")).lower()
    if result_kind not in {"in_progress", "text", "file", "empty", "error"}:
        result_kind = "text" if summary_text else "empty"
    if is_stuck:
        result_kind = "error"
    status_reason = safe_text(recurring.get("status_reason") or ("stuck" if is_stuck else "in_progress" if status == "running" else "error" if status == "failed" else "no_signal" if status == "empty_result" else "delivered" if attachments else "result_ready"))
    delivery_summary = safe_text(recurring.get("delivery_summary") or ("Задача зависла и будет перезапущена" if is_stuck else "Есть вложение" if attachments else "Доставка не зафиксирована" if status != "running" else "Выполнение продолжается"))
    status_detail = safe_text(normalized_content or recurring.get("status_detail") or payload.get("error_detail") or payload.get("error_text") or summary_text)
    if is_stuck and not status_detail:
        status_detail = "Выполнение превысило допустимое время и помечено как зависшее"
    delivered_count = recurring.get("delivered_count")
    if delivered_count is None:
        delivered_raw = payload.get("delivered_to_json")
        delivered = json_loads(delivered_raw, []) if delivered_raw is not None else []
        delivered_count = len(delivered) if isinstance(delivered, list) else 0
    has_result = bool(recurring.get("has_result") if "has_result" in recurring else (bool(attachments) or bool(summary_text)))
    has_limitations = bool(recurring.get("has_limitations") if "has_limitations" in recurring else status == "completed_with_limitations")
    return {
        "status": status,
        "summary": summary_text,
        "status_reason": status_reason,
        "status_detail": status_detail,
        "delivery_summary": delivery_summary,
        "result_kind": result_kind,
        "has_result": has_result,
        "has_limitations": has_limitations,
        "delivered_count": int(delivered_count or 0),
        "is_stuck": is_stuck,
    }


def build_assistant_result_contract(meta: dict[str, Any], content: str, *, created_at: str | None = None) -> dict[str, Any]:
    payload = meta if isinstance(meta, dict) else {}
    message_kind = safe_text(payload.get("message_kind")).lower()
    attachments = payload.get("attachments") if isinstance(payload.get("attachments"), list) else []
    has_dashboard = isinstance(payload.get("dashboard_artifact"), dict) or isinstance(payload.get("dashboard"), dict)
    recurring_summary = build_recurring_summary_envelope(payload, content, created_at=created_at)
    collection_contract = payload.get("collection_contract") if isinstance(payload.get("collection_contract"), dict) else {}
    research_payload = payload.get("research_result") if isinstance(payload.get("research_result"), dict) else {}
    structured_payload = payload.get("structured_result") if isinstance(payload.get("structured_result"), dict) else {}
    table_payload = payload.get("table_result") if isinstance(payload.get("table_result"), dict) else {}
    has_table_payload = bool(table_payload) or bool(structured_payload.get("rows") and structured_payload.get("columns")) or bool(structured_payload.get("table"))
    has_research_payload = bool(research_payload) or bool(structured_payload.get("evidence") or structured_payload.get("caveats") or structured_payload.get("findings"))
    collection_missing_fields = [safe_text(item) for item in (collection_contract.get("missing_fields") or []) if safe_text(item)]
    if message_kind in {"clarification_request", "approval_request"} or (message_kind == "collection_contract" and collection_missing_fields):
        result_kind = "clarification_needed"
        output_mode = "clarification"
        next_actions = ["clarify_request"]
    elif message_kind == "collection_contract":
        result_kind = "structured_result"
        output_mode = "structured"
        next_actions = ["export_result", "save_as_job"]
    elif message_kind == "job_delivery" or recurring_summary:
        result_kind = "job_result"
        output_mode = "job_delivery"
        next_actions = ["reply_in_chat"]
    elif message_kind == "processing_status":
        result_kind = "status_update"
        output_mode = "status"
        next_actions = ["reply_in_chat"]
    elif has_dashboard:
        result_kind = "artifact_result"
        output_mode = "artifact"
        next_actions = ["open_artifact", "export_result", "save_as_job"]
    elif attachments:
        result_kind = "file_result"
        output_mode = "file"
        next_actions = ["open_artifact", "export_result"]
    elif has_table_payload:
        result_kind = "table_result"
        output_mode = "structured"
        next_actions = ["export_result", "save_as_job"]
    elif has_research_payload:
        result_kind = "research_result"
        output_mode = "structured"
        next_actions = ["export_result", "save_as_job"]
    elif isinstance(payload.get("structured_result"), dict):
        result_kind = "structured_result"
        output_mode = "structured"
        next_actions = ["export_result", "save_as_job"]
    else:
        result_kind = "chat_answer"
        output_mode = "chat"
        next_actions = ["reply_in_chat", "export_result", "save_as_job"]
    return {
        "assistant_result_kind": result_kind,
        "output_mode": output_mode,
        "next_actions": next_actions,
    }


def derive_message_surface(meta: dict[str, Any], content: str, created_at: str | None = None) -> dict[str, Any]:
    payload = meta if isinstance(meta, dict) else {}
    message_kind = safe_text(payload.get("message_kind")).lower()
    attachments = payload.get("attachments") if isinstance(payload.get("attachments"), list) else []
    has_dashboard = isinstance(payload.get("dashboard_artifact"), dict) or isinstance(payload.get("dashboard"), dict)
    recurring_summary = build_recurring_summary_envelope(payload, content, created_at=created_at)
    assistant_contract = build_assistant_result_contract(payload, content, created_at=created_at)
    is_pending = bool(payload.get("pending"))
    is_error = bool(payload.get("error"))
    status = recurring_summary.get("status") if recurring_summary else "completed"
    if is_pending and not recurring_summary:
        status = "running"
    elif is_error:
        status = "failed"
    elif message_kind in {"clarification_request", "approval_request"}:
        status = "needs_clarification"
    elif not recurring_summary and not safe_text(content).strip() and not attachments:
        status = "empty_result"
    entity_kind = "chat_message"
    label = "Ответ"
    if has_dashboard:
        entity_kind = "artifact"
        label = "Артефакт"
    elif attachments:
        entity_kind = "file_result"
        label = "Файл"
    elif message_kind in {"clarification_request", "approval_request"}:
        entity_kind = "clarification"
        label = "Уточнение"
    elif message_kind == "job_delivery":
        entity_kind = "job_delivery"
        label = "Результат задачи"
    elif message_kind == "processing_status":
        entity_kind = "processing_status"
        label = "Статус обработки"
    return {
        "status": status,
        "entity_kind": entity_kind,
        "label": label,
        "message_kind": message_kind or "chat_response",
        "has_attachments": bool(attachments),
        "has_dashboard_artifact": bool(has_dashboard),
        "has_recurring_summary": bool(recurring_summary),
        "assistant_result_kind": assistant_contract["assistant_result_kind"],
        "output_mode": assistant_contract["output_mode"],
        "next_actions": assistant_contract["next_actions"],
    }


def serialize_message(row: sqlite3.Row) -> dict[str, Any]:
    meta = authorize_attachment_payload(json_loads(row["meta_json"], {})) if has_request_context() else json_loads(row["meta_json"], {})
    attachments = meta.get('attachments') if isinstance(meta.get('attachments'), list) else []
    if attachments:
        normalized_attachments = []
        request_token = try_get_auth_token() if has_request_context() else None
        for index, item in enumerate(attachments):
            if not isinstance(item, dict):
                normalized_attachments.append(item)
                continue
            download_url = safe_text(item.get('download_url')) or f"{API_PREFIX}/messages/{int(row['id'])}/attachments/{index}"
            normalized_attachments.append(normalize_attachment_payload({**item, 'download_url': append_access_token(download_url, request_token)}))
        meta = {**meta, 'attachments': normalized_attachments}
    used_files = meta.get('used_files') if isinstance(meta.get('used_files'), list) else []
    if used_files:
        meta = {**meta, 'used_files': [normalize_attachment_payload(item, used_in_response=True) if isinstance(item, dict) else item for item in used_files]}
    recurring_summary = build_recurring_summary_envelope(meta, row["content"], created_at=row["created_at"])
    if recurring_summary:
        meta = {**meta, 'recurring_summary': recurring_summary}
    display_text = safe_text(meta.get('display_text')) if isinstance(meta, dict) else ''
    if safe_text(row['role']).lower() == 'assistant':
        source_for_display = display_text or row['content']
        display_text = build_message_display_text(source_for_display)
        if recurring_summary:
            recurring_display = safe_text(
                recurring_summary.get('summary')
                or recurring_summary.get('status_detail')
                or display_text
                or row['content']
            )
            display_text = build_message_display_text(recurring_display)
        if isinstance(meta, dict) and display_text:
            meta = {**meta, 'display_text': display_text}
    elif isinstance(meta, dict) and attachments and meta.get('user_text') is not None:
        display_text = safe_text(meta.get('user_text'))
    elif not display_text:
        display_text = safe_text(row['content'])
    assistant_contract = build_assistant_result_contract(meta, row['content'], created_at=row['created_at']) if safe_text(row['role']).lower() == 'assistant' else {
        'assistant_result_kind': 'user_input',
        'output_mode': 'chat',
        'next_actions': ['reply_in_chat'],
    }
    if isinstance(meta, dict):
        meta = {**meta, **assistant_contract}
    return {
        "id": row["id"],
        "role": row["role"],
        "content": row["content"],
        "display_text": display_text,
        "assistant_result_kind": assistant_contract["assistant_result_kind"],
        "output_mode": assistant_contract["output_mode"],
        "next_actions": assistant_contract["next_actions"],
        "created_at": row["created_at"],
        "meta": meta,
        "surface": derive_message_surface(meta, row["content"], created_at=row["created_at"]),
    }


def normalize_message_export_format(value: Any) -> str:
    normalized = safe_text(value).lower()
    normalized = MESSAGE_EXPORT_FORMAT_ALIASES.get(normalized, normalized)
    if normalized not in MESSAGE_EXPORT_FORMATS:
        raise ApiError("unsupported_export_format", 400)
    return normalized


def format_message_export_filename(*, thread_title: str, created_at: str, export_format: str) -> str:
    date_part = safe_text(created_at).replace(":", "-").replace("T", "_")[:19] or "message"
    base = safe_filename(f"{thread_title}-{date_part}", "assistant-message")
    return f"{base}.{export_format}"


def build_message_export_body(message_row: sqlite3.Row) -> str:
    meta = json_loads(message_row["meta_json"], {})
    content = safe_text(message_row["content"])
    role = safe_text(message_row["role"]).lower()
    recurring_summary = build_recurring_summary_envelope(meta, content, created_at=message_row["created_at"]) if isinstance(meta, dict) else None
    if role == 'assistant':
        if recurring_summary:
            return safe_text(recurring_summary.get("summary") or recurring_summary.get("status_detail") or content).strip()
        preferred = safe_text(meta.get("display_text")) if isinstance(meta, dict) else ''
        return build_message_display_text(preferred or content).strip()
    if role == 'user' and isinstance(meta, dict) and meta.get("user_text") is not None:
        return safe_text(meta.get("user_text")).strip()
    return content.strip()


def normalize_document_export_body(body_text: str) -> str:
    raw = build_message_display_text(body_text or "")
    if not raw:
        return ""
    lines = raw.splitlines()
    if response_looks_like_file_limitation(raw) or response_looks_like_tool_transcript(raw) or response_looks_like_generic_llm_failure(raw):
        anchors = (
            r'^#{1,6}\s+',
            r'^\*\*[^*\n]{3,}\*\*\s*$',
            r'^\*\*[^*\n]{3,}\*\*\s*[:：].*$',
            r'^(?:слайд|slide)\s*\d+\b',
            r'^[-*•]\s+',
            r'^\d+[\.)]\s+',
            r'^\|.+\|$',
        )
        for index, line in enumerate(lines):
            stripped = safe_text(line).strip()
            if not stripped:
                continue
            if any(re.match(pattern, stripped, re.IGNORECASE) for pattern in anchors):
                lines = lines[index:]
                break
    normalized_lines: list[str] = []
    previous_blank = False
    for line in lines:
        stripped = safe_text(line).strip()
        if stripped in {'---', '***', '___'}:
            if not previous_blank:
                normalized_lines.append('')
            previous_blank = True
            continue
        if not stripped:
            if not previous_blank:
                normalized_lines.append('')
            previous_blank = True
            continue
        normalized_lines.append(stripped)
        previous_blank = False
    return '\n'.join(normalized_lines).strip()


def flatten_message_export_lines(message_row: sqlite3.Row, thread_title: str) -> list[str]:
    meta = json_loads(message_row["meta_json"], {})
    lines = [
        f"Чат: {thread_title or 'Без названия'}",
        f"Сообщение: #{message_row['id']}",
        f"Дата: {safe_text(message_row['created_at']) or '—'}",
        "",
        build_message_export_body(message_row) or "Пустой ответ",
    ]
    dashboard = meta.get("dashboard") if isinstance(meta, dict) else None
    if isinstance(dashboard, dict):
        dashboard_title = safe_text(dashboard.get("title") or dashboard.get("kind") or "")
        summary_cards = dashboard.get("summary_cards") if isinstance(dashboard.get("summary_cards"), list) else []
        sections = dashboard.get("sections") if isinstance(dashboard.get("sections"), list) else []
        if dashboard_title or summary_cards or sections:
            lines.extend(["", "---", "", f"Дашборд: {dashboard_title or 'Аналитика'}"])
        for card in summary_cards:
            if not isinstance(card, dict):
                continue
            label = safe_text(card.get("label") or "Показатель")
            value = safe_text(card.get("value") or "—")
            note = safe_text(card.get("note") or "")
            lines.append(f"- {label}: {value}" + (f" ({note})" if note else ""))
        for section in sections:
            if not isinstance(section, dict):
                continue
            section_title = safe_text(section.get("title") or section.get("kind") or "Раздел")
            lines.extend(["", section_title])
            items = section.get("items") if isinstance(section.get("items"), list) else []
            if not items:
                lines.append("- Нет данных")
                continue
            for item in items:
                if isinstance(item, dict):
                    label = safe_text(item.get("label") or item.get("title") or item.get("name") or item.get("value") or "Пункт")
                    value = safe_text(item.get("value") or item.get("note") or item.get("meta") or "")
                    lines.append(f"- {label}" + (f": {value}" if value else ""))
                else:
                    lines.append(f"- {safe_text(item) or 'Пункт'}")
    return lines


def build_message_export_text(message_row: sqlite3.Row, thread_title: str) -> str:
    return "\n".join(flatten_message_export_lines(message_row, thread_title)).strip() + "\n"


def build_message_export_python(message_row: sqlite3.Row, thread_title: str) -> str:
    payload = build_message_export_payload(message_row, thread_title)
    body = safe_text(payload.get("content")).strip()
    fence_match = re.search(r"```(?:python|py)?\s*\n([\s\S]*?)\n```", body, flags=re.IGNORECASE)
    if fence_match:
        code = fence_match.group(1).strip("\n")
        return code.rstrip() + "\n"
    header = [
        '# -*- coding: utf-8 -*-',
        '"""',
        f"Чат: {payload['thread_title']}",
        f"Сообщение: #{payload['message_id']}",
        f"Дата: {payload['created_at'] or '—'}",
        'Экспорт ответа Hermes Web в Python-файл.',
        '"""',
        '',
        'CONTENT = r"""',
        body,
        '"""',
        '',
        'if __name__ == "__main__":',
        '    print(CONTENT)',
        '',
    ]
    return "\n".join(header)


def build_message_export_markdown(message_row: sqlite3.Row, thread_title: str) -> str:
    lines = flatten_message_export_lines(message_row, thread_title)
    title = safe_text(thread_title) or "Без названия"
    parts = [
        f"# {title}",
        "",
        f"- Сообщение: #{message_row['id']}",
        f"- Дата: {safe_text(message_row['created_at']) or '—'}",
        "",
    ]
    body_started = False
    for line in lines[4:]:
        text = safe_text(line)
        if not text:
            parts.append("")
            continue
        if text == "---":
            parts.extend(["", "## Дашборд", ""])
            continue
        if not body_started:
            parts.append(text)
            body_started = True
            continue
        if text.startswith("- "):
            parts.append(text)
            continue
        parts.extend(["", f"### {text}"])
    return "\n".join(parts).strip() + "\n"


def build_message_export_html(message_row: sqlite3.Row, thread_title: str) -> str:
    title = safe_text(thread_title) or "Без названия"
    body_markdown = build_message_export_body(message_row)
    markdown_module = load_markdown_module()
    if markdown_module is not None:
        body_html = markdown_module.markdown(
            body_markdown,
            extensions=["extra", "tables", "sane_lists", "nl2br"],
            output_format="html5",
        )
    else:
        body_chunks: list[str] = []
        for line in body_markdown.splitlines():
            text = safe_text(line)
            if not text:
                continue
            body_chunks.append(f"<p>{html.escape(text)}</p>")
        body_html = "\n".join(body_chunks)
    return (
        "<!doctype html>\n"
        "<html lang=\"ru\">\n"
        "<head>\n"
        "  <meta charset=\"utf-8\" />\n"
        f"  <title>{html.escape(title)}</title>\n"
        "  <style>body{font-family:Arial,sans-serif;max-width:960px;margin:32px auto;padding:0 16px;line-height:1.6;color:#1f2937;background:#fff}"
        "h1{margin-bottom:8px} .meta{color:#6b7280;margin-bottom:20px} table{border-collapse:collapse;width:100%;margin:16px 0;font-size:14px} th,td{border:1px solid #d1d5db;padding:8px 10px;vertical-align:top;text-align:left} th{background:#f8fafc;font-weight:600} code{background:#f3f4f6;padding:1px 4px;border-radius:4px} pre{background:#111827;color:#f9fafb;padding:12px;border-radius:8px;overflow:auto} hr{margin:20px 0;border:none;border-top:1px solid #e5e7eb} a{color:#2563eb;text-decoration:none} a:hover{text-decoration:underline} ul,ol{padding-left:22px}</style>\n"
        "</head>\n"
        "<body>\n"
        f"  <h1>{html.escape(title)}</h1>\n"
        f"  <div class=\"meta\">Сообщение #{int(message_row['id'])} · {html.escape(safe_text(message_row['created_at']) or '—')}</div>\n"
        f"  {body_html}\n"
        "</body>\n"
        "</html>\n"
    )


def build_message_export_payload(message_row: sqlite3.Row, thread_title: str) -> dict[str, Any]:
    meta = json_loads(message_row["meta_json"], {})
    display_content = build_message_export_body(message_row)
    return {
        "thread_title": safe_text(thread_title) or "Без названия",
        "message_id": int(message_row["id"]),
        "created_at": safe_text(message_row["created_at"]) or "",
        "content": safe_text(message_row["content"]) or "",
        "display_content": display_content,
        "meta": meta if isinstance(meta, dict) else {},
        "text_lines": flatten_message_export_lines(message_row, thread_title),
    }


def build_message_export_json(message_row: sqlite3.Row, thread_title: str) -> str:
    return json.dumps(build_message_export_payload(message_row, thread_title), ensure_ascii=False, indent=2) + "\n"


def build_message_export_csv(message_row: sqlite3.Row, thread_title: str) -> str:
    payload = build_message_export_payload(message_row, thread_title)
    structured = payload["meta"].get("table_result") if isinstance(payload["meta"].get("table_result"), dict) else None
    if not structured and isinstance(payload["meta"].get("structured_result"), dict):
        candidate = payload["meta"].get("structured_result")
        if isinstance(candidate.get("rows"), list) and (isinstance(candidate.get("columns"), list) or isinstance(candidate.get("table"), list)):
            structured = candidate
    if structured:
        columns = structured.get("columns") if isinstance(structured.get("columns"), list) else []
        rows = structured.get("rows") if isinstance(structured.get("rows"), list) else []
        table = structured.get("table") if isinstance(structured.get("table"), list) else []
        buffer = io.StringIO()
        writer = csv.writer(buffer)
        if columns:
            writer.writerow([safe_text(item) for item in columns])
        if rows:
            for row in rows:
                if isinstance(row, dict):
                    ordered = columns or list(row.keys())
                    writer.writerow([safe_text(row.get(key)) for key in ordered])
                elif isinstance(row, list):
                    writer.writerow([safe_text(cell) for cell in row])
                else:
                    writer.writerow([safe_text(row)])
            return buffer.getvalue()
        if table:
            for row in table:
                if isinstance(row, list):
                    writer.writerow([safe_text(cell) for cell in row])
            return buffer.getvalue()
    buffer = io.StringIO()
    writer = csv.writer(buffer)
    writer.writerow(["thread_title", "message_id", "created_at", "line_no", "line"])
    for index, line in enumerate(payload["text_lines"], start=1):
        writer.writerow([payload["thread_title"], payload["message_id"], payload["created_at"], index, line])
    return buffer.getvalue()


def build_message_export_xml(message_row: sqlite3.Row, thread_title: str) -> str:
    payload = build_message_export_payload(message_row, thread_title)
    lines_xml = "\n".join(
        f"    <line number=\"{index}\">{html.escape(safe_text(line))}</line>"
        for index, line in enumerate(payload["text_lines"], start=1)
    )
    return (
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
        f"<assistant_message id=\"{payload['message_id']}\">\n"
        f"  <thread_title>{html.escape(payload['thread_title'])}</thread_title>\n"
        f"  <created_at>{html.escape(payload['created_at'])}</created_at>\n"
        f"  <content>{html.escape(payload['content'])}</content>\n"
        "  <text_lines>\n"
        f"{lines_xml}\n"
        "  </text_lines>\n"
        "</assistant_message>\n"
    )


def build_message_export_rtf(message_row: sqlite3.Row, thread_title: str) -> str:
    def rtf_escape(value: Any) -> str:
        text = safe_text(value)
        escaped = text.replace('\\', r'\\').replace('{', r'\{').replace('}', r'\}')
        result: list[str] = []
        for ch in escaped:
            code = ord(ch)
            if code > 127:
                if code > 32767:
                    code -= 65536
                result.append(f"\\u{code}?")
            elif ch == '\n':
                result.append(r'\par ')
            else:
                result.append(ch)
        return ''.join(result)

    payload = build_message_export_payload(message_row, thread_title)
    paragraphs = [
        r"{\rtf1\ansi\deff0",
        r"{\fonttbl{\f0 Arial;}}",
        r"\fs24",
        rtf_escape(payload["thread_title"]) + r"\par",
        rtf_escape(f"Сообщение #{payload['message_id']}") + r"\par",
        rtf_escape(f"Дата: {payload['created_at'] or '—'}") + r"\par\par",
    ]
    for line in payload["text_lines"][4:]:
        paragraphs.append(rtf_escape(line) + r"\par")
    paragraphs.append("}")
    return "\n".join(paragraphs)


def build_document_export_body(message_row: sqlite3.Row) -> str:
    return normalize_document_export_body(build_message_export_body(message_row))


def parse_inline_format_runs(text: str) -> list[dict[str, Any]]:
    source = safe_text(text)
    if not source:
        return []
    runs: list[dict[str, Any]] = []
    buffer: list[str] = []
    bold = False
    italic = False
    index = 0

    def flush() -> None:
        nonlocal buffer
        if not buffer:
            return
        chunk = ''.join(buffer)
        if chunk:
            if runs and runs[-1].get('bold') == bold and runs[-1].get('italic') == italic:
                runs[-1]['text'] = safe_text(runs[-1].get('text')) + chunk
            else:
                runs.append({'text': chunk, 'bold': bold, 'italic': italic})
        buffer = []

    while index < len(source):
        if source.startswith('**', index):
            flush()
            bold = not bold
            index += 2
            continue
        if source.startswith('__', index):
            flush()
            bold = not bold
            index += 2
            continue
        if source[index] == '*':
            flush()
            italic = not italic
            index += 1
            continue
        if source[index] == '_':
            flush()
            italic = not italic
            index += 1
            continue
        buffer.append(source[index])
        index += 1
    flush()
    return [run for run in runs if safe_text(run.get('text'))]


def plain_text_from_runs(runs: list[dict[str, Any]]) -> str:
    return ''.join(safe_text(run.get('text')) for run in runs).strip()


def make_runs(text: str, *, bold: bool = False, italic: bool = False) -> list[dict[str, Any]]:
    cleaned = safe_text(text)
    if not cleaned:
        return []
    return [{'text': cleaned, 'bold': bold, 'italic': italic}]


def parse_document_export_blocks(body_text: str) -> list[dict[str, Any]]:
    lines = body_text.splitlines()
    blocks: list[dict[str, Any]] = []
    paragraph_buffer: list[str] = []
    index = 0

    def flush_paragraph() -> None:
        nonlocal paragraph_buffer
        if paragraph_buffer:
            combined = ' '.join(item.strip() for item in paragraph_buffer if item.strip()).strip()
            runs = parse_inline_format_runs(combined)
            text_value = plain_text_from_runs(runs)
            if text_value:
                blocks.append({'kind': 'paragraph', 'text': text_value, 'runs': runs})
            paragraph_buffer = []

    while index < len(lines):
        raw_line = lines[index]
        text = safe_text(raw_line).rstrip()
        stripped = text.strip()
        if not stripped:
            flush_paragraph()
            index += 1
            continue

        slide_heading_match = re.match(r'^\*\*(слайд\s*\d+[^*]*)\*\*\s*$', stripped, re.IGNORECASE)
        if slide_heading_match:
            flush_paragraph()
            heading_text = safe_text(slide_heading_match.group(1)).strip(' :：-—')
            heading_runs = make_runs(heading_text, bold=True)
            if heading_text:
                blocks.append({'kind': 'heading', 'level': 1, 'text': heading_text, 'runs': heading_runs})
            index += 1
            continue

        bold_heading_match = re.match(r'^\*\*([^*\n]+)\*\*\s*$', stripped)
        if bold_heading_match:
            flush_paragraph()
            heading_text = safe_text(bold_heading_match.group(1)).strip(' :：-—')
            heading_runs = make_runs(heading_text, bold=True)
            if heading_text:
                blocks.append({'kind': 'heading', 'level': 2, 'text': heading_text, 'runs': heading_runs})
            index += 1
            continue

        labeled_bold_match = re.match(r'^\*\*([^*\n]+?)[:：]\*\*\s*(.+)$', stripped)
        if labeled_bold_match:
            flush_paragraph()
            label = safe_text(labeled_bold_match.group(1)).strip()
            value_runs = parse_inline_format_runs(safe_text(labeled_bold_match.group(2)).strip())
            text_value = f"{label}:\t{plain_text_from_runs(value_runs).strip()}" if label else plain_text_from_runs(value_runs).strip()
            if label and text_value:
                blocks.append({'kind': 'label', 'text': text_value, 'label': label, 'value_runs': value_runs})
            index += 1
            continue

        labeled_bold_match = re.match(r'^\*\*([^*\n:：]+)\*\*\s*[:：]\s*(.+)$', stripped)
        if labeled_bold_match:
            flush_paragraph()
            label = safe_text(labeled_bold_match.group(1)).strip()
            value_runs = parse_inline_format_runs(safe_text(labeled_bold_match.group(2)).strip())
            text_value = f"{label}:\t{plain_text_from_runs(value_runs).strip()}" if label else plain_text_from_runs(value_runs).strip()
            if label and text_value:
                blocks.append({'kind': 'label', 'text': text_value, 'label': label, 'value_runs': value_runs})
            index += 1
            continue

        heading_match = re.match(r"^(#{1,6})\s+(.*)$", stripped)
        if heading_match:
            flush_paragraph()
            level = min(4, len(heading_match.group(1)))
            heading_runs = parse_inline_format_runs(safe_text(heading_match.group(2)).strip())
            heading_text = plain_text_from_runs(heading_runs)
            if heading_text:
                blocks.append({'kind': 'heading', 'level': level, 'text': heading_text, 'runs': heading_runs})
            index += 1
            continue

        if '|' in stripped:
            table_lines: list[str] = []
            cursor = index
            while cursor < len(lines):
                candidate = safe_text(lines[cursor]).strip()
                if candidate and '|' in candidate:
                    table_lines.append(candidate)
                    cursor += 1
                    continue
                break
            normalized_rows: list[list[str]] = []
            normalized_run_rows: list[list[list[dict[str, Any]]]] = []
            for line in table_lines:
                parts = [cell.strip() for cell in line.strip('|').split('|')]
                if not parts:
                    continue
                if all(re.fullmatch(r':?-{3,}:?', cell.replace(' ', '')) for cell in parts if cell):
                    continue
                normalized_rows.append([plain_text_from_runs(parse_inline_format_runs(cell)) or safe_text(cell) for cell in parts])
                normalized_run_rows.append([parse_inline_format_runs(cell) for cell in parts])
            if len(normalized_rows) >= 2 and any(len(row) >= 2 for row in normalized_rows):
                flush_paragraph()
                blocks.append({'kind': 'table', 'rows': normalized_rows, 'run_rows': normalized_run_rows})
                index = cursor
                continue

        bullet_match = re.match(r'^(\s*)([-*•])\s+(.*)$', text)
        if bullet_match:
            flush_paragraph()
            runs = parse_inline_format_runs(safe_text(bullet_match.group(3)).strip())
            item_text = plain_text_from_runs(runs)
            if item_text:
                blocks.append({'kind': 'bullet', 'text': item_text, 'runs': runs})
            index += 1
            continue

        numbered_match = re.match(r'^(\s*)(\d+)[\.)]\s+(.*)$', text)
        if numbered_match:
            flush_paragraph()
            runs = parse_inline_format_runs(safe_text(numbered_match.group(3)).strip())
            item_text = plain_text_from_runs(runs)
            if item_text:
                blocks.append({'kind': 'numbered', 'text': item_text, 'runs': runs})
            index += 1
            continue

        paragraph_buffer.append(stripped)
        index += 1

    flush_paragraph()
    return blocks


def build_message_export_docx(message_row: sqlite3.Row, thread_title: str) -> io.BytesIO:
    docx_module = load_docx_module()
    if docx_module is None:
        raise ApiError("export_dependency_missing_docx", 503)
    document = docx_module.Document()

    def apply_docx_runs(paragraph: Any, runs: list[dict[str, Any]], *, default_bold: bool = False, default_italic: bool = False, font_size_pt: int | None = None) -> None:
        if not runs:
            paragraph.add_run('')
            return
        try:
            from docx.oxml.shared import OxmlElement, qn  # type: ignore
        except Exception:
            OxmlElement = None
            qn = None
        for run_spec in runs:
            chunk = safe_text(run_spec.get('text'))
            if not chunk:
                continue
            run = paragraph.add_run()
            if OxmlElement is not None and qn is not None and (chunk[:1].isspace() or chunk[-1:].isspace()):
                for child in list(run._r):
                    run._r.remove(child)
                text_node = OxmlElement('w:t')
                text_node.set(qn('xml:space'), 'preserve')
                text_node.text = chunk
                run._r.append(text_node)
            else:
                run.text = chunk
            run.bold = bool(run_spec.get('bold', default_bold)) or default_bold
            run.italic = bool(run_spec.get('italic', default_italic)) or default_italic
            if font_size_pt:
                run.font.size = docx_module.shared.Pt(font_size_pt)

    try:
        section = document.sections[0]
        section.top_margin = docx_module.shared.Cm(1.8)
        section.bottom_margin = docx_module.shared.Cm(1.8)
        section.left_margin = docx_module.shared.Cm(2.0)
        section.right_margin = docx_module.shared.Cm(2.0)
        normal_style = document.styles['Normal']
        normal_style.font.name = 'Calibri'
        normal_style.font.size = docx_module.shared.Pt(11)
    except Exception:
        pass
    body_text = build_document_export_body(message_row)
    blocks = parse_document_export_blocks(body_text)
    if not blocks:
        document.add_paragraph(body_text or 'Пустой ответ')
    for block in blocks:
        kind = safe_text(block.get('kind'))
        runs = block.get('runs') if isinstance(block.get('runs'), list) else make_runs(safe_text(block.get('text')))
        if kind == 'heading':
            level = max(1, min(4, int(block.get('level') or 1)))
            paragraph = document.add_paragraph(style=f'Heading {level}')
            paragraph.paragraph_format.space_before = docx_module.shared.Pt(10 if level == 1 else 6)
            paragraph.paragraph_format.space_after = docx_module.shared.Pt(6)
            apply_docx_runs(paragraph, runs, default_bold=True, font_size_pt=16 if level == 1 else 13)
            continue
        if kind == 'paragraph':
            paragraph = document.add_paragraph()
            paragraph.paragraph_format.space_after = docx_module.shared.Pt(6)
            apply_docx_runs(paragraph, runs)
            continue
        if kind == 'label':
            label = safe_text(block.get('label'))
            value_runs = block.get('value_runs') if isinstance(block.get('value_runs'), list) else []
            value_text = plain_text_from_runs(value_runs)
            table = document.add_table(rows=1, cols=2)
            left = table.cell(0, 0).paragraphs[0]
            right = table.cell(0, 1).paragraphs[0]
            apply_docx_runs(left, make_runs(f'{label}:', bold=True), default_bold=True)
            apply_docx_runs(right, value_runs or make_runs(value_text))
            continue
        if kind == 'bullet':
            paragraph = document.add_paragraph(style='List Bullet')
            paragraph.paragraph_format.space_after = docx_module.shared.Pt(2)
            apply_docx_runs(paragraph, runs)
            continue
        if kind == 'numbered':
            paragraph = document.add_paragraph(style='List Number')
            paragraph.paragraph_format.space_after = docx_module.shared.Pt(2)
            apply_docx_runs(paragraph, runs)
            continue
        if kind == 'table':
            rows = block.get('rows') if isinstance(block.get('rows'), list) else []
            run_rows = block.get('run_rows') if isinstance(block.get('run_rows'), list) else []
            if not rows:
                continue
            max_cols = max(len(row) for row in rows)
            table = document.add_table(rows=len(rows), cols=max_cols)
            table.style = 'Table Grid'
            for row_index, row in enumerate(rows):
                for col_index in range(max_cols):
                    cell = table.cell(row_index, col_index)
                    cell.text = ''
                    paragraph = cell.paragraphs[0]
                    cell_runs = []
                    if row_index < len(run_rows) and col_index < len(run_rows[row_index]):
                        candidate = run_rows[row_index][col_index]
                        if isinstance(candidate, list):
                            cell_runs = candidate
                    if not cell_runs:
                        value = safe_text(row[col_index]) if col_index < len(row) else ''
                        cell_runs = make_runs(value, bold=row_index == 0)
                    apply_docx_runs(paragraph, cell_runs, default_bold=(row_index == 0))
    buffer = io.BytesIO()
    document.save(buffer)
    buffer.seek(0)
    return buffer

def build_message_export_pptx(message_row: sqlite3.Row, thread_title: str) -> io.BytesIO:
    pptx_module = load_pptx_module()
    if pptx_module is None:
        raise ApiError("export_dependency_missing_pptx", 503)
    presentation = pptx_module.Presentation()
    inches = getattr(getattr(pptx_module, 'util', None), 'Inches', None)
    pt = getattr(getattr(pptx_module, 'util', None), 'Pt', None)
    rgb = getattr(getattr(pptx_module, 'dml', None), 'color', None)
    rgb_color = getattr(rgb, 'RGBColor', None)
    shape_enum = getattr(getattr(pptx_module, 'enum', None), 'shapes', None)
    mso_shape = getattr(shape_enum, 'MSO_SHAPE', None)
    align_enum = getattr(getattr(pptx_module, 'enum', None), 'text', None)
    pp_align = getattr(align_enum, 'PP_ALIGN', None)
    vertical_anchor = getattr(align_enum, 'MSO_VERTICAL_ANCHOR', None)

    def color(hex_value: str):
        hex_value = hex_value.lstrip('#')
        if rgb_color is None:
            return None
        return rgb_color(int(hex_value[0:2], 16), int(hex_value[2:4], 16), int(hex_value[4:6], 16))

    NAVY = color('17324D')
    BLUE = color('2F6BFF')
    TEXT = color('142033')
    MUTED = color('667085')
    LIGHT_BG = color('F7F9FC')
    CARD_BG = color('FFFFFF')
    TABLE_HEADER = color('EAF1FF')
    TABLE_ALT = color('F8FAFC')

    if inches is not None:
        presentation.slide_width = inches(13.333)
        presentation.slide_height = inches(7.5)
    body_text = build_document_export_body(message_row)
    payload = build_message_export_payload(message_row, thread_title)
    blocks = parse_document_export_blocks(body_text)

    def set_shape_fill(shape: Any, fill_color: Any) -> None:
        try:
            shape.fill.solid()
            if fill_color is not None:
                shape.fill.fore_color.rgb = fill_color
            shape.line.fill.background()
        except Exception:
            pass

    def add_box(slide: Any, left: float, top: float, width: float, height: float, fill_color: Any = None, rounded: bool = False) -> Any:
        if inches is None or mso_shape is None:
            return None
        kind = getattr(mso_shape, 'ROUNDED_RECTANGLE' if rounded else 'RECTANGLE')
        shape = slide.shapes.add_shape(kind, inches(left), inches(top), inches(width), inches(height))
        set_shape_fill(shape, fill_color)
        return shape

    def add_textbox(slide: Any, left: float, top: float, width: float, height: float) -> Any:
        if inches is None:
            return None
        return slide.shapes.add_textbox(inches(left), inches(top), inches(width), inches(height))

    def apply_pptx_runs(paragraph: Any, runs: list[dict[str, Any]], *, size: int, color_value: Any, bold_default: bool = False, italic_default: bool = False, bullet_prefix: str = '', align: Any = None) -> None:
        paragraph.text = ''
        if align is not None:
            try:
                paragraph.alignment = align
            except Exception:
                pass
        if bullet_prefix:
            run = paragraph.add_run()
            run.text = bullet_prefix
            if pt is not None:
                run.font.size = pt(size)
            run.font.bold = bold_default
            run.font.italic = italic_default
            if color_value is not None:
                run.font.color.rgb = color_value
        payload_runs = runs or make_runs('')
        for run_spec in payload_runs:
            chunk = safe_text(run_spec.get('text'))
            if not chunk:
                continue
            run = paragraph.add_run()
            run.text = chunk
            if pt is not None:
                run.font.size = pt(size)
            run.font.name = 'Aptos'
            run.font.bold = bool(run_spec.get('bold', False)) or bold_default
            run.font.italic = bool(run_spec.get('italic', False)) or italic_default
            if color_value is not None:
                run.font.color.rgb = color_value

    title_slide = presentation.slides.add_slide(presentation.slide_layouts[6])
    add_box(title_slide, 0, 0, 13.333, 7.5, NAVY, rounded=False)
    kicker = add_textbox(title_slide, 0.8, 0.7, 2.8, 0.35)
    if kicker is not None:
        p = kicker.text_frame.paragraphs[0]
        apply_pptx_runs(p, make_runs('Hermes Web export', bold=True), size=12, color_value=LIGHT_BG)
    title_box = add_textbox(title_slide, 0.8, 1.35, 8.8, 1.4)
    if title_box is not None:
        p = title_box.text_frame.paragraphs[0]
        apply_pptx_runs(p, make_runs(safe_text(thread_title) or 'Презентация', bold=True), size=26, color_value=CARD_BG)
    intro_lines: list[str] = []
    first_heading = ''
    for block in blocks:
        if safe_text(block.get('kind')) == 'heading' and not first_heading:
            first_heading = safe_text(block.get('text'))
            continue
        if len(intro_lines) >= 3:
            break
        if safe_text(block.get('kind')) in {'paragraph', 'bullet'}:
            value = safe_text(block.get('text'))
            if value:
                intro_lines.append(value)
    subtitle_box = add_textbox(title_slide, 0.8, 3.1, 7.2, 1.3)
    if subtitle_box is not None:
        tf = subtitle_box.text_frame
        tf.word_wrap = True
        subtitle_text = first_heading or 'Материал подготовлен по содержанию обсуждения'
        p0 = tf.paragraphs[0]
        apply_pptx_runs(p0, make_runs(subtitle_text, bold=True), size=17, color_value=LIGHT_BG)
        for line in intro_lines[:2]:
            p = tf.add_paragraph()
            apply_pptx_runs(p, make_runs(line), size=13, color_value=LIGHT_BG)
    side_card = add_box(title_slide, 9.2, 1.2, 3.0, 4.8, fill_color=color('21496E'), rounded=True)
    if side_card is not None:
        side_text = add_textbox(title_slide, 9.55, 1.55, 2.3, 3.8)
        if side_text is not None:
            tf = side_text.text_frame
            lines = [('Тема', 'ITFM'), ('Формат', 'DOCX / PPTX'), ('Источник', 'generated export')]
            first = True
            for label, value in lines:
                p = tf.paragraphs[0] if first else tf.add_paragraph()
                first = False
                apply_pptx_runs(p, make_runs(label + '\n', bold=True) + make_runs(value), size=14, color_value=CARD_BG)

    sections: list[dict[str, Any]] = []
    current_section: dict[str, Any] | None = None
    for block in blocks:
        kind = safe_text(block.get('kind'))
        if kind == 'heading':
            current_section = {'title': safe_text(block.get('text')) or 'Раздел', 'items': [], 'tables': []}
            sections.append(current_section)
            continue
        if current_section is None:
            continue
        if kind == 'table':
            rows = block.get('rows') if isinstance(block.get('rows'), list) else []
            run_rows = block.get('run_rows') if isinstance(block.get('run_rows'), list) else []
            normalized = [[safe_text(cell) for cell in row] for row in rows if isinstance(row, list) and row]
            if normalized:
                current_section['tables'].append({'rows': normalized, 'run_rows': run_rows})
            continue
        current_section['items'].append({'kind': kind, 'text': safe_text(block.get('text')), 'runs': block.get('runs') if isinstance(block.get('runs'), list) else make_runs(safe_text(block.get('text'))), 'label': block.get('label'), 'value_runs': block.get('value_runs')})

    def add_content_slide(title_text: str, items: list[dict[str, Any]], note: str | None = None) -> None:
        slide = presentation.slides.add_slide(presentation.slide_layouts[6])
        add_box(slide, 0, 0, 13.333, 7.5, LIGHT_BG, rounded=False)
        note_box = add_textbox(slide, 0.8, 0.45, 3.2, 0.3)
        if note_box is not None:
            p = note_box.text_frame.paragraphs[0]
            apply_pptx_runs(p, make_runs(note or 'Hermes Web generated export'), size=10, color_value=MUTED)
        title_box = add_textbox(slide, 0.8, 0.75, 9.8, 0.65)
        if title_box is not None:
            p = title_box.text_frame.paragraphs[0]
            apply_pptx_runs(p, make_runs(title_text, bold=True), size=24, color_value=TEXT)
        add_box(slide, 0.75, 1.45, 11.9, 5.35, CARD_BG, rounded=True)
        body_box = add_textbox(slide, 1.1, 1.85, 10.9, 4.6)
        if body_box is not None:
            tf = body_box.text_frame
            tf.word_wrap = True
            try:
                tf.margin_left = 0
                tf.margin_right = 0
                tf.margin_top = 0
                tf.margin_bottom = 0
                if vertical_anchor is not None:
                    tf.vertical_anchor = vertical_anchor.TOP
            except Exception:
                pass
            first = True
            for item in items[:5]:
                p = tf.paragraphs[0] if first else tf.add_paragraph()
                first = False
                kind = safe_text(item.get('kind'))
                bullet_prefix = '• ' if kind == 'bullet' else ''
                runs = item.get('runs') if isinstance(item.get('runs'), list) else make_runs(safe_text(item.get('text')))
                if kind == 'label':
                    runs = make_runs(f"{safe_text(item.get('label'))}: ", bold=True) + (item.get('value_runs') if isinstance(item.get('value_runs'), list) else [])
                apply_pptx_runs(p, runs, size=18 if kind != 'paragraph' else 17, color_value=TEXT, bullet_prefix=bullet_prefix)
                try:
                    p.space_after = pt(10) if pt is not None else None
                except Exception:
                    pass
        accent = add_box(slide, 11.25, 0.95, 1.0, 0.34, BLUE, rounded=True)
        if accent is not None:
            accent_text = add_textbox(slide, 11.42, 0.98, 0.65, 0.2)
            if accent_text is not None:
                p = accent_text.text_frame.paragraphs[0]
                apply_pptx_runs(p, make_runs('slide', bold=True), size=9, color_value=CARD_BG)

    if sections:
        for section in sections:
            title_text = safe_text(section.get('title')) or 'Раздел'
            items = section.get('items') if isinstance(section.get('items'), list) else []
            if items:
                for chunk_start in range(0, len(items), 4):
                    chunk = items[chunk_start:chunk_start + 4]
                    add_content_slide(title_text, chunk, note=safe_text(thread_title))
            elif not section.get('tables'):
                add_content_slide(title_text, [{'kind': 'bullet', 'text': 'Материал подготовлен без дополнительных пунктов.', 'runs': make_runs('Материал подготовлен без дополнительных пунктов.')}], note=safe_text(thread_title))
    else:
        fallback_lines = [line.strip() for line in body_text.splitlines() if line.strip()]
        for chunk_start in range(0, len(fallback_lines), 4):
            chunk = fallback_lines[chunk_start:chunk_start + 4]
            add_content_slide(f'Слайд {chunk_start // 4 + 1}', [{'kind': 'bullet', 'text': line, 'runs': make_runs(line)} for line in chunk], note=safe_text(thread_title))

    normalized_tables: list[tuple[str, list[list[str]], list[list[list[dict[str, Any]]]]]] = []
    tabular = payload['meta'].get('table_result') if isinstance(payload['meta'].get('table_result'), dict) else None
    if not tabular and isinstance(payload['meta'].get('structured_result'), dict):
        candidate = payload['meta'].get('structured_result')
        if isinstance(candidate.get('rows'), list) and (isinstance(candidate.get('columns'), list) or isinstance(candidate.get('table'), list)):
            tabular = candidate
    if tabular:
        columns = tabular.get('columns') if isinstance(tabular.get('columns'), list) else []
        rows = tabular.get('rows') if isinstance(tabular.get('rows'), list) else []
        table_rows = tabular.get('table') if isinstance(tabular.get('table'), list) else []
        normalized_rows: list[list[str]] = []
        if columns:
            normalized_rows.append([safe_text(cell) for cell in columns])
        if rows:
            for row in rows:
                if isinstance(row, dict):
                    ordered = columns or list(row.keys())
                    normalized_rows.append([safe_text(row.get(key)) for key in ordered])
                elif isinstance(row, list):
                    normalized_rows.append([safe_text(cell) for cell in row])
        elif table_rows:
            for row in table_rows:
                if isinstance(row, list):
                    normalized_rows.append([safe_text(cell) for cell in row])
        if normalized_rows:
            normalized_tables.append((safe_text(tabular.get('summary')) or 'Таблица', normalized_rows, []))

    for section in sections:
        title_text = safe_text(section.get('title')) or 'Таблица'
        for index, table_payload in enumerate(section.get('tables') or [], start=1):
            rows = table_payload.get('rows') if isinstance(table_payload, dict) else []
            run_rows = table_payload.get('run_rows') if isinstance(table_payload, dict) else []
            if rows:
                normalized_tables.append((title_text if index == 1 else f'{title_text} — таблица {index}', rows, run_rows))

    for table_title, normalized_rows, _run_rows in normalized_tables:
        slide = presentation.slides.add_slide(presentation.slide_layouts[6])
        add_box(slide, 0, 0, 13.333, 7.5, LIGHT_BG, rounded=False)
        title_box = add_textbox(slide, 0.8, 0.55, 10.5, 0.7)
        if title_box is not None:
            p = title_box.text_frame.paragraphs[0]
            apply_pptx_runs(p, make_runs(table_title, bold=True), size=24, color_value=TEXT)
        subtitle_box = add_textbox(slide, 0.8, 1.0, 4.5, 0.3)
        if subtitle_box is not None:
            p = subtitle_box.text_frame.paragraphs[0]
            apply_pptx_runs(p, make_runs('Структурированная таблица', bold=False), size=10, color_value=MUTED)
        if inches is None:
            continue
        row_count = len(normalized_rows)
        col_count = max(len(row) for row in normalized_rows)
        table_shape = slide.shapes.add_table(row_count, col_count, inches(0.8), inches(1.5), inches(11.8), inches(min(4.9, max(1.5, 0.44 * row_count))))
        table = table_shape.table
        for row_index, row in enumerate(normalized_rows):
            for col_index in range(col_count):
                cell = table.cell(row_index, col_index)
                cell.text = row[col_index] if col_index < len(row) else ''
                try:
                    cell.fill.solid()
                    cell.fill.fore_color.rgb = TABLE_HEADER if row_index == 0 else (TABLE_ALT if row_index % 2 == 0 else CARD_BG)
                except Exception:
                    pass
                paragraphs = cell.text_frame.paragraphs
                if paragraphs:
                    p = paragraphs[0]
                    try:
                        if pp_align is not None:
                            p.alignment = pp_align.LEFT
                    except Exception:
                        pass
                    for run in p.runs:
                        if pt is not None:
                            run.font.size = pt(14 if row_index == 0 else 12)
                        run.font.name = 'Aptos'
                        run.font.bold = row_index == 0
                        if TEXT is not None:
                            run.font.color.rgb = TEXT
        badge = add_box(slide, 11.3, 0.62, 1.2, 0.34, BLUE, rounded=True)
        if badge is not None:
            badge_text = add_textbox(slide, 11.48, 0.65, 0.8, 0.2)
            if badge_text is not None:
                p = badge_text.text_frame.paragraphs[0]
                apply_pptx_runs(p, make_runs('table', bold=True), size=9, color_value=CARD_BG)

    buffer = io.BytesIO()
    presentation.save(buffer)
    buffer.seek(0)
    return buffer

def xlsx_column_name(index: int) -> str:
    value = max(1, int(index))
    parts: list[str] = []
    while value > 0:
        value, remainder = divmod(value - 1, 26)
        parts.append(chr(65 + remainder))
    return "".join(reversed(parts))


def build_message_export_xlsx_fallback(rows: list[list[Any]]) -> io.BytesIO:
    def cell_xml(cell_ref: str, value: Any) -> str:
        if value is None or value == "":
            return f'<c r="{cell_ref}" t="inlineStr"><is><t></t></is></c>'
        if isinstance(value, (int, float)) and not isinstance(value, bool):
            return f'<c r="{cell_ref}"><v>{value}</v></c>'
        text = html.escape(str(value))
        return f'<c r="{cell_ref}" t="inlineStr"><is><t xml:space="preserve">{text}</t></is></c>'

    sheet_rows: list[str] = []
    for row_index, row in enumerate(rows, start=1):
        cells = [cell_xml(f"{xlsx_column_name(col_index)}{row_index}", value) for col_index, value in enumerate(row, start=1)]
        sheet_rows.append(f'<row r="{row_index}">' + "".join(cells) + '</row>')

    worksheet_xml = (
        '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">'
        '<sheetData>' + ''.join(sheet_rows) + '</sheetData>'
