        raise ApiError("password_too_short", 400)
    with db_connect() as conn:
        row = conn.execute("SELECT * FROM users WHERE id = ?", (auth.id,)).fetchone()
        if not row:
            raise ApiError("user_not_found", 404)
        if not check_password_hash(row["password_hash"], current_password):
            raise ApiError("invalid_credentials", 401)
        conn.execute(
            "UPDATE users SET password_hash = ?, version = COALESCE(version, 1) + 1, updated_at = ? WHERE id = ?",
            (generate_password_hash(new_password), now_iso(), auth.id),
        )
        with _session_write_lock:
            revoke_user_sessions(conn, auth.id, except_token=token)
        write_user_change_log(conn, auth.id, auth.id, "password_change")
    return jsonify({"status": "password_changed"})


@app.get(f"{API_PREFIX}/threads")
