[Unit]
Description=Memory Archive MVP Light backend
After=network.target

[Service]
WorkingDirectory=/home/hermes/workspace/memory-archive-mvp-light
Environment=MEMORY_ARCHIVE_DATA_DIR=/home/hermes/workspace/memory-archive-mvp-light/data
ExecStart=/home/hermes/workspace/memory-archive-mvp-light/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8810
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
