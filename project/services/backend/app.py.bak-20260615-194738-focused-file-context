def reasoning_usage_stats(conn: sqlite3.Connection, user_id: int, usage_date: str | None = None) -> dict[str, Any]:
    current_date = usage_date or utc_today_iso()
    global_row = conn.execute(
        "SELECT COUNT(*) AS request_count, COALESCE(SUM(COALESCE(actual_cost_usd, estimated_cost_usd)), 0) AS total_cost "
        "FROM llm_usage_events WHERE usage_date = ? AND model_key = ?",
        (current_date, LLM_USAGE_REASONING_MODEL),
    ).fetchone()
    user_row = conn.execute(
        "SELECT COUNT(*) AS request_count, COALESCE(SUM(COALESCE(actual_cost_usd, estimated_cost_usd)), 0) AS total_cost "
        "FROM llm_usage_events WHERE usage_date = ? AND model_key = ? AND user_id = ?",
        (current_date, LLM_USAGE_REASONING_MODEL, user_id),
    ).fetchone()
    global_requests = int(global_row["request_count"] or 0)
    global_cost = float(global_row["total_cost"] or 0.0)
    user_requests = int(user_row["request_count"] or 0)
    user_cost = float(user_row["total_cost"] or 0.0)
    return {
        "date": current_date,
        "global_requests": global_requests,
        "global_cost_usd": global_cost,
        "user_requests": user_requests,
        "user_cost_usd": user_cost,
        "global_requests_remaining": max(HERMES_REASONING_DAILY_MAX_REQUESTS - global_requests, 0),
        "user_requests_remaining": max(HERMES_REASONING_DAILY_MAX_PER_USER - user_requests, 0),
        "global_cost_remaining_usd": max(HERMES_REASONING_DAILY_MAX_COST_USD - global_cost, 0.0),
    }


def reasoning_limit_block_reason(stats: dict[str, Any]) -> str | None:
    if not HERMES_REASONING_ENABLED:
        return "reasoning_disabled"
    if stats["global_requests"] >= HERMES_REASONING_DAILY_MAX_REQUESTS:
        return "global_request_limit"
    if stats["user_requests"] >= HERMES_REASONING_DAILY_MAX_PER_USER:
        return "user_request_limit"
    if stats["global_cost_usd"] >= HERMES_REASONING_DAILY_MAX_COST_USD:
        return "global_cost_limit"
    return None


def normalize_chat_model_preference(value: Any) -> str:
    normalized = safe_text(value).strip().lower().replace("-", "_")
    alias_map = {
        "": CHAT_MODEL_AUTO,
        "automatic": CHAT_MODEL_AUTO,
        "auto": CHAT_MODEL_AUTO,
        "owl": CHAT_MODEL_OWL_ALPHA,
        "owl_alpha": CHAT_MODEL_OWL_ALPHA,
        "openrouter/owl_alpha": CHAT_MODEL_OWL_ALPHA,
        "openrouter/owl-alpha": CHAT_MODEL_OWL_ALPHA,
        "deepseek": CHAT_MODEL_DEEPSEEK_R1,
        "deepseek_r1": CHAT_MODEL_DEEPSEEK_R1,
        "deepseek/deepseek_r1_0528": CHAT_MODEL_DEEPSEEK_R1,
        "deepseek/deepseek_r1-0528": CHAT_MODEL_DEEPSEEK_R1,
        "deepseek/deepseek-r1-0528": CHAT_MODEL_DEEPSEEK_R1,
        "r1": CHAT_MODEL_DEEPSEEK_R1,
    }
    resolved = alias_map.get(normalized, normalized)
    if resolved not in CHAT_MODEL_SELECTOR_VALUES:
        return CHAT_MODEL_AUTO
    return resolved


def build_llm_routing_state(user_id: int | None = None, *, conn: sqlite3.Connection | None = None) -> dict[str, Any]:
    owns_conn = conn is None
    active_conn = conn or db_connect()
    try:
        global_stats = reasoning_usage_stats(active_conn, 0)
        user_stats = reasoning_usage_stats(active_conn, int(user_id or 0))
        deepseek_blocked_reason = reasoning_limit_block_reason(user_stats)
        deepseek_available = deepseek_blocked_reason is None
        return {
            "default_model": HERMES_API_MODEL,
            "reasoning_model": HERMES_REASONING_MODEL,
            "routing_enabled": HERMES_REASONING_ROUTING_ENABLED,
            "manual_only": HERMES_REASONING_MANUAL_ONLY,
            "reasoning_enabled": HERMES_REASONING_ENABLED,
            "selector": {
                "default": CHAT_MODEL_AUTO,
                "options": [
                    {"value": CHAT_MODEL_AUTO, "label": "Автоматически", "model": None, "enabled": True},
                    {"value": CHAT_MODEL_OWL_ALPHA, "label": "owl alpha", "model": HERMES_API_MODEL, "enabled": True},
                    {"value": CHAT_MODEL_DEEPSEEK_R1, "label": "DeepSeek R1", "model": HERMES_REASONING_MODEL, "enabled": deepseek_available, "blocked_reason": deepseek_blocked_reason},
                ],
            },
            "limits": {
                "global_requests_per_day": HERMES_REASONING_DAILY_MAX_REQUESTS,
                "per_user_requests_per_day": HERMES_REASONING_DAILY_MAX_PER_USER,
                "global_cost_usd_per_day": HERMES_REASONING_DAILY_MAX_COST_USD,
            },
            "usage_today": {
