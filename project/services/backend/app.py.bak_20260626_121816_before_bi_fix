def section_items_contain_synthetic_markers(section: dict[str, Any]) -> bool:
    items = section.get("items") or []
    if not isinstance(items, list):
        return False
    for item in items:
        if isinstance(item, dict):
            for value in item.values():
                if text_contains_synthetic_marker(value):
                    return True
        elif text_contains_synthetic_marker(item):
            return True
    return False


def section_is_clearly_english(section: dict[str, Any]) -> bool:
    if any(text_looks_cyrillic(section.get(field)) for field in ("title", "note")):
        return False
    title = safe_text(section.get("title"))
    note = safe_text(section.get("note"))
    if title and re.search(r"[A-Za-z]", title):
        return True
    if note and re.search(r"[A-Za-z]", note):
        return True
    items = section.get("items") or []
    if not isinstance(items, list):
        return False
    latin_hits = 0
    for item in items:
        probe = ""
        if isinstance(item, dict):
            probe = " ".join(safe_text(v) for v in item.values())
        else:
            probe = safe_text(item)
        if text_looks_cyrillic(probe):
            return False
        if re.search(r"[A-Za-z]{4,}", probe):
            latin_hits += 1
    return latin_hits > 0


