def get_columns(conn: DBConnection, table: str) -> set[str]:
    rows = conn.execute(
        """
        SELECT column_name AS name
        FROM information_schema.columns
        WHERE table_schema = current_schema() AND table_name = ?
        """,
        (table,),
    ).fetchall()
    return {row["name"] for row in rows}


def ensure_column(conn: DBConnection, table: str, name: str, definition: str) -> None:
    if name not in get_columns(conn, table):
        try:
            conn.execute(f"ALTER TABLE {table} ADD COLUMN {name} {definition}")
        except Exception as error:
            message = str(error)
            if "Adding columns with constraints not yet supported" not in message:
                raise
            relaxed = definition.replace(" NOT NULL", "")
            conn.execute(f"ALTER TABLE {table} ADD COLUMN {name} {relaxed}")
            if "DEFAULT 1" in definition:
                conn.execute(f"UPDATE {table} SET {name} = 1 WHERE {name} IS NULL")
            if "DEFAULT 0" in definition:
                conn.execute(f"UPDATE {table} SET {name} = 0 WHERE {name} IS NULL")


def _legacy_sqlite_sequence_start(table: str) -> int:
    if not LEGACY_SQLITE_PATH.exists():
        return 1
    src = sqlite3.connect(LEGACY_SQLITE_PATH)
    try:
        row = src.execute(
            "SELECT name FROM sqlite_master WHERE type='table' AND name = ?",
            (table,),
        ).fetchone()
        if not row:
            return 1
        max_id = src.execute(f"SELECT COALESCE(MAX(id), 0) FROM {table}").fetchone()[0] or 0
        return int(max_id) + 1
    finally:
        src.close()


def migrate_legacy_sqlite_if_needed(conn: DBConnection) -> None:
    if conn.execute("SELECT COUNT(*) AS c FROM users").fetchone()["c"]:
        return
    if not LEGACY_SQLITE_PATH.exists():
        return

    src = sqlite3.connect(LEGACY_SQLITE_PATH)
    src.row_factory = sqlite3.Row
    try:
        for table, columns in APP_TABLE_COLUMNS.items():
            exists = src.execute(
                "SELECT name FROM sqlite_master WHERE type='table' AND name = ?",
                (table,),
            ).fetchone()
            if not exists:
                continue
            legacy_columns = {
                row[1]
                for row in src.execute(f"PRAGMA table_info({table})").fetchall()
            }
            selected_columns = [column for column in columns if column in legacy_columns]
            if not selected_columns:
                continue
            rows = src.execute(f"SELECT {', '.join(selected_columns)} FROM {table}").fetchall()
            if not rows:
                continue
            placeholders = ', '.join(['?'] * len(columns))
            insert_sql = f"INSERT INTO {table} ({', '.join(columns)}) VALUES ({placeholders})"
            prepared_rows = []
            for row in rows:
                payload: list[Any] = []
                for column in columns:
                    if column in selected_columns:
                        payload.append(row[column])
                    elif column == "version":
                        payload.append(1)
                    elif column == "assistant_profile_json":
                        payload.append(json.dumps(default_assistant_profile(""), ensure_ascii=False))
                    elif column == "display_name":
                        payload.append("")
                    elif column == "self_subscribe_enabled":
                        payload.append(0)
                    elif column == "self_subscribe_scope":
                        payload.append("disabled")
                    elif column == "onboarding_completed":
                        payload.append(0)
                    else:
                        payload.append(None)
                prepared_rows.append(tuple(payload))
            conn.executemany(insert_sql, prepared_rows)
    finally:
        src.close()


def _sync_postgres_sequences(conn: DBConnection) -> None:
    if getattr(conn, 'driver', 'duckdb') != 'postgres':
