def build_message_export_xlsx(message_row: sqlite3.Row, thread_title: str) -> io.BytesIO:
    rows = [
        ["Чат", thread_title or "Без названия"],
        ["Сообщение", int(message_row["id"])],
        ["Дата", safe_text(message_row["created_at"]) or "—"],
        [],
        ["Текст"],
    ]
    for line in build_message_export_text(message_row, thread_title).splitlines():
        rows.append([line])
    if openpyxl is None:
        return build_message_export_xlsx_fallback(rows)
    workbook = openpyxl.Workbook()
    sheet = workbook.active
    sheet.title = "Сообщение"
    for row in rows:
        sheet.append(row)
    sheet.column_dimensions["A"].width = 120
    buffer = io.BytesIO()
    workbook.save(buffer)
    buffer.seek(0)
    return buffer


_EXPORT_PDF_FONT_REGISTERED = False


def ensure_pdf_export_font() -> str:
    global _EXPORT_PDF_FONT_REGISTERED
    if canvas is None or pdfmetrics is None or TTFont is None:
        raise ApiError("export_dependency_missing_pdf", 503)
    font_name = "Helvetica"
    candidate_paths = [
        Path("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"),
        Path("/usr/share/fonts/dejavu/DejaVuSans.ttf"),
    ]
    for candidate in candidate_paths:
        if candidate.exists() and candidate.is_file():
            font_name = "DejaVuSans"
            if not _EXPORT_PDF_FONT_REGISTERED:
                pdfmetrics.registerFont(TTFont(font_name, str(candidate)))
                _EXPORT_PDF_FONT_REGISTERED = True
            break
    return font_name


def build_message_export_pdf(message_row: sqlite3.Row, thread_title: str) -> io.BytesIO:
    if canvas is None or A4 is None:
        if fitz is None:
            raise ApiError("export_dependency_missing_pdf", 503)
        document = fitz.open()
        page = document.new_page(width=595, height=842)
        text = build_message_export_text(message_row, thread_title)
        page.insert_textbox(fitz.Rect(40, 40, 555, 802), text, fontsize=11, fontname="helv")
        pdf_bytes = document.tobytes()
        document.close()
        return io.BytesIO(pdf_bytes)
    buffer = io.BytesIO()
    pdf = canvas.Canvas(buffer, pagesize=A4)
    width, height = A4
    font_name = ensure_pdf_export_font()
    font_size = 11
    left_margin = 40
    top_margin = height - 48
    line_height = 16
    y = top_margin
    pdf.setTitle(thread_title or "Hermes export")
    pdf.setFont(font_name, font_size)
    for raw_line in build_message_export_text(message_row, thread_title).splitlines():
        line = raw_line or " "
        chunks = [line[i:i + 110] for i in range(0, len(line), 110)] or [" "]
        for chunk in chunks:
            if y <= 40:
                pdf.showPage()
                pdf.setFont(font_name, font_size)
                y = top_margin
            pdf.drawString(left_margin, y, chunk)
            y -= line_height
    pdf.save()
    buffer.seek(0)
    return buffer


def build_message_export_stream(message_row: sqlite3.Row, thread_title: str, export_format: str) -> io.BytesIO:
    if export_format == "txt":
        return io.BytesIO(build_message_export_text(message_row, thread_title).encode("utf-8"))
    if export_format == "md":
        return io.BytesIO(build_message_export_markdown(message_row, thread_title).encode("utf-8"))
    if export_format == "html":
        return io.BytesIO(build_message_export_html(message_row, thread_title).encode("utf-8"))
    if export_format == "json":
        return io.BytesIO(build_message_export_json(message_row, thread_title).encode("utf-8"))
    if export_format == "csv":
        return io.BytesIO(build_message_export_csv(message_row, thread_title).encode("utf-8"))
    if export_format == "xml":
        return io.BytesIO(build_message_export_xml(message_row, thread_title).encode("utf-8"))
    if export_format == "rtf":
        return io.BytesIO(build_message_export_rtf(message_row, thread_title).encode("utf-8"))
    if export_format == "docx":
        return build_message_export_docx(message_row, thread_title)
    if export_format == "xlsx":
        return build_message_export_xlsx(message_row, thread_title)
    if export_format == "pdf":
        return build_message_export_pdf(message_row, thread_title)
    raise ApiError("unsupported_export_format", 400)


def detect_message_export_format(text: str) -> str | None:
    lowered = safe_text(text).lower()
    if not lowered:
        return None
    if 'media:' in lowered:
        return None
    explicit_format: str | None = None
    for export_format, keywords in MESSAGE_EXPORT_FORMAT_KEYWORDS.items():
        if any(keyword in lowered for keyword in keywords):
            explicit_format = export_format
            break
    if explicit_format:
        return explicit_format
    if any(marker in lowered for marker in MESSAGE_EXPORT_GENERIC_DOCX_MARKERS):
        return "docx"
    if any(action in lowered for action in MESSAGE_EXPORT_ACTION_MARKERS) and any(target in lowered for target in MESSAGE_EXPORT_TARGET_MARKERS):
        return "docx"
    return None


def is_generate_and_attach_file_request(text: str) -> bool:
    lowered = safe_text(text).lower()
    if not detect_message_export_format(lowered):
        return False
    normalized = re.sub(r"[^\w\sа-яё-]+", " ", lowered, flags=re.IGNORECASE)
    tokens = [token.strip("-_") for token in normalized.split()]
    substantive_tokens = [
        token for token in tokens
        if token and token not in MESSAGE_EXPORT_REQUEST_STOPWORDS and len(token) > 2
    ]
    if len(substantive_tokens) >= 3:
        return True
    return len(" ".join(substantive_tokens)) >= 18


def build_message_export_attachment(message_row: sqlite3.Row, thread_title: str, export_format: str) -> dict[str, Any]:
    export_dir = DATA_DIR / "message_exports"
    export_dir.mkdir(parents=True, exist_ok=True)
    filename = format_message_export_filename(
        thread_title=thread_title,
        created_at=safe_text(message_row["created_at"]),
        export_format=export_format,
    )
    stored_name = f"{uuid.uuid4().hex}-{filename}"
    target_path = export_dir / stored_name
    stream = build_message_export_stream(message_row, thread_title, export_format)
    target_path.write_bytes(stream.getvalue())
    return {
        "kind": "assistant_generated",
        "assistant_generated": True,
        "source": "message_export",
        "original_name": filename,
        "stored_name": stored_name,
        "relative_path": str(target_path.relative_to(DATA_DIR)),
        "local_path": str(target_path),
        "mime_type": MESSAGE_EXPORT_MIME_TYPES[export_format],
        "size_bytes": target_path.stat().st_size,
        "download_url": None,
        "preview_excerpt": safe_text(message_row["content"])[:240],
        "message_id": int(message_row["id"]),
        "export_format": export_format,
    }


def is_exportable_assistant_message(row: sqlite3.Row) -> bool:
    if safe_text(row["role"]).lower() != "assistant":
        return False
    meta = json_loads(row["meta_json"], {})
    if isinstance(meta, dict):
        message_kind = safe_text(meta.get("message_kind")).lower()
        if message_kind in {"file_response", "processing_status"}:
            return False
        if bool(meta.get("error")):
            return False
    content = safe_text(row["content"]).strip()
    if not content:
        return False
    lowered = content.lower()
    if lowered == "готовлю ответ…" or lowered == "готовлю ответ...":
        return False
    if lowered.startswith("не удалось получить ответ"):
        return False
    if any(marker in lowered for marker in MESSAGE_EXPORT_NON_CONTENT_MARKERS):
        return False
    return True


def select_export_target_message(message_rows: list[sqlite3.Row]) -> sqlite3.Row | None:
    for row in reversed(message_rows):
        if is_exportable_assistant_message(row):
            return row
    return None


def maybe_build_export_reply(message_rows: list[sqlite3.Row], user_text: str, thread_title: str) -> tuple[str, dict[str, Any]] | None:
    export_format = detect_message_export_format(user_text)
    if not export_format:
        return None
    if is_generate_and_attach_file_request(user_text):
        return None
    previous_assistant = select_export_target_message(message_rows)
    if previous_assistant is None:
        raise ApiError("message_export_target_missing", 409)
    attachment = build_message_export_attachment(previous_assistant, thread_title, export_format)
    reply_text = f"Собрала предыдущий ответ в файл {attachment['original_name']}."
    meta = {
        "message_kind": "file_response",
        "source": "message_export",
        "exported_message_id": int(previous_assistant["id"]),
        "export_format": export_format,
        "attachments": [attachment],
    }
    return reply_text, meta


def build_generated_file_reply(*, assistant_message_id: int, reply_text: str, reply_meta: dict[str, Any], thread_title: str, export_format: str, created_at: str) -> tuple[str, dict[str, Any]]:
    export_message_row = {
        "id": int(assistant_message_id),
        "created_at": created_at,
        "content": reply_text,
        "meta_json": json.dumps(reply_meta or {}, ensure_ascii=False),
    }
    attachment = build_message_export_attachment(export_message_row, thread_title, export_format)
    public_text = f"Собрала новый ответ в файл {attachment['original_name']}."
    meta = dict(reply_meta or {})
    meta.update({
        "message_kind": "file_response",
        "source": "generated_file_response",
        "generated_from_request": True,
        "export_format": export_format,
        "attachments": [attachment],
    })
    meta.pop("error", None)
    return public_text, meta


def build_pending_assistant_meta(task_id: int, *, status_label: str = "В очереди") -> dict[str, Any]:
    return {
        "pending": True,
        "processing_status": "pending",
        "message_kind": "processing_status",
        "task_id": task_id,
