    auth = require_admin()
    if dataset_key not in REFERENCE_DATASETS:
        raise ApiError("reference_dataset_not_found", 404)
    payload = request.get_json(force=True, silent=True) or {}
    item_key = safe_text(payload.get("item_key"))
    label = safe_text(payload.get("label"))
    if not item_key or not label:
        raise ApiError("reference_item_required", 400)
    sort_order = int(payload.get("sort_order") or 0)
    is_active, deleted_at, _ = resolve_reference_item_status(payload, default_status="active")
    extra_payload = {key: value for key, value in payload.items() if key not in {"item_key", "label", "sort_order", "is_active", "status", "deleted_at"}}
    ts = now_iso()
    with db_connect() as conn:
        exists = conn.execute(
            "SELECT id FROM reference_items WHERE scope = ? AND dataset_key = ? AND item_key = ?",
            (REFERENCE_SCOPE_GLOBAL, dataset_key, item_key),
        ).fetchone()
        if exists:
            raise ApiError("reference_item_exists", 409)
        conn.execute(
            """
            INSERT INTO reference_items (scope, dataset_key, item_key, label, payload_json, sort_order, is_active, deleted_at, version, created_at, updated_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, 1, ?, ?)
            """,
            (REFERENCE_SCOPE_GLOBAL, dataset_key, item_key, label, json.dumps(extra_payload, ensure_ascii=False), sort_order, is_active, deleted_at, ts, ts),
        )
        write_reference_item_change_log(conn, dataset_key, item_key, auth.id, "create")
        references = build_reference_payload(conn, include_inactive=True)
    return jsonify({"status": "created", "dataset": references.get(dataset_key)})


@app.patch(f"{API_PREFIX}/admin/reference-data/<dataset_key>/items/<item_key>")
def admin_reference_item_update(dataset_key: str, item_key: str) -> Response:
    auth = require_admin()
    if dataset_key not in REFERENCE_DATASETS:
        raise ApiError("reference_dataset_not_found", 404)
    payload = request.get_json(force=True, silent=True) or {}
    label = safe_text(payload.get("label"))
    if not label:
        raise ApiError("reference_item_required", 400)
    sort_order = int(payload.get("sort_order") or 0)
    extra_payload = {key: value for key, value in payload.items() if key not in {"label", "sort_order", "is_active", "status", "deleted_at"}}
    ts = now_iso()
    with db_connect() as conn:
        current = conn.execute(
            "SELECT id, version, is_active, deleted_at FROM reference_items WHERE scope = ? AND dataset_key = ? AND item_key = ?",
            (REFERENCE_SCOPE_GLOBAL, dataset_key, item_key),
        ).fetchone()
        if not current:
            raise ApiError("reference_item_not_found", 404)
        default_status = "deleted" if current["deleted_at"] else ("inactive" if not bool(current["is_active"]) else "active")
        is_active, deleted_at, _ = resolve_reference_item_status(payload, default_status=default_status)
        next_version = int(current["version"] or 1) + 1
        conn.execute(
            """
            UPDATE reference_items
            SET label = ?, payload_json = ?, sort_order = ?, is_active = ?, deleted_at = ?, version = ?, updated_at = ?
            WHERE scope = ? AND dataset_key = ? AND item_key = ?
            """,
            (label, json.dumps(extra_payload, ensure_ascii=False), sort_order, is_active, deleted_at, next_version, ts, REFERENCE_SCOPE_GLOBAL, dataset_key, item_key),
        )
        write_reference_item_change_log(conn, dataset_key, item_key, auth.id, "update")
        references = build_reference_payload(conn, include_inactive=True)
    return jsonify({"status": "updated", "dataset": references.get(dataset_key)})


