    return f"Примечание: {reason_text}, поэтому отвечаю в обычном режиме через {HERMES_API_MODEL}."


def reasoning_engaged_notice(route_reason: str) -> str:
    reason_map = {
        "explicit_reasoning": "включён глубокий reasoning-режим по вашему запросу",
        "architecture_or_tradeoff": "включён глубокий reasoning-режим для архитектурной/стратегической задачи",
        "multi_document_analysis": "включён глубокий reasoning-режим для анализа нескольких источников",
        "high_stakes_decision": "включён глубокий reasoning-режим из-за высокой цены ошибки",
