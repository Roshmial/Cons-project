def top_category_items(rows: list[dict[str, Any]], column: str, *, limit: int = 8) -> list[dict[str, Any]]:
    counts = Counter(str(row.get(column) or '∅') for row in rows if isinstance(row, dict))
    total = max(sum(counts.values()), 1)
    return [
        {'label': label[:60], 'value': value, 'ratio': round(value / total, 3), 'meta': f'{round(value / total * 100)}% строк'}
        for label, value in counts.most_common(limit)
    ]


def month_bucket_from_value(value: Any) -> str:
    raw = safe_text(value).strip()
    if not raw:
        return '∅'
    for fmt in ('%Y-%m-%d', '%d.%m.%Y', '%Y/%m/%d', '%d/%m/%Y', '%Y-%m-%d %H:%M:%S', '%Y-%m'):
        try:
            parsed = datetime.strptime(raw[:19], fmt)
            return parsed.strftime('%Y-%m')
        except ValueError:
            continue
    match = re.search(r'(20\d{2})[-/.](\d{1,2})', raw)
    if match:
        return f"{match.group(1)}-{int(match.group(2)):02d}"
    return raw[:20]


def aggregate_numeric_by_category(rows: list[dict[str, Any]], category_col: str, amount_col: str, *, limit: int = 8) -> list[dict[str, Any]]:
    totals: dict[str, float] = defaultdict(float)
    for row in rows:
        if not isinstance(row, dict):
            continue
        amount = parse_numeric_like(row.get(amount_col))
        if amount is None:
            continue
        label = safe_text(row.get(category_col)) or '∅'
        totals[label] += amount
    grand_total = sum(totals.values()) or 1.0
    return [
        {'label': label[:60], 'value': round(value, 2), 'ratio': round(value / grand_total, 3), 'meta': amount_col}
        for label, value in sorted(totals.items(), key=lambda item: item[1], reverse=True)[:limit]
    ]


