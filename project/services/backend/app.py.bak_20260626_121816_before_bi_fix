    }
    task_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding='utf-8')
    return {'kind': 'api_task', 'path': str(task_path), 'items': payload['source_items']}


def execute_api_collection_contract(contract: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    task_config = materialize_api_task_config(contract)
    rows: list[dict[str, Any]] = []
    documents: list[dict[str, Any]] = []
    fields = list(contract.get('fields') or [])
    for source in (contract.get('source_items') or [])[:5]:
        final_url, payload = fetch_api_source_payload(source)
        payload_rows = normalize_api_payload_rows(payload)
        documents.append({
            'requested_url': source,
            'final_url': final_url,
            'title': final_url,
            'text': json.dumps(payload, ensure_ascii=False)[:12000],
        })
        for item in payload_rows:
            row = {field: safe_text(item.get(field)) for field in fields}
            row['source_url'] = final_url
            rows.append(row)
    dashboard_reply = maybe_build_collection_dashboard_reply(contract, documents, rows, downstream='dashboard:api_collection_result')
    if dashboard_reply is not None:
        reply_text, meta = dashboard_reply
        meta['task_source_list'] = task_config
        meta['collection_rows_preview'] = rows[:5]
        return reply_text, meta
    raw_attachment = build_collection_artifact_attachment(contract, rows) if safe_text(contract.get('output_format')) in COLLECTION_STRUCTURED_FORMATS else None
    proposal_reply = maybe_attach_proposal_artifact(
        contract,
        documents,
        rows,
        [raw_attachment] if raw_attachment else [],
        'chat:api_collection_result',
    )
    if proposal_reply is not None:
        reply_text, meta = proposal_reply
        meta['task_source_list'] = task_config
        meta['collection_rows_preview'] = rows[:5]
        return reply_text, meta
    attachment = raw_attachment
    reply_text = (
        'Готово. Собрала данные из API и подготовила реальный файл.\n\n'
        f"API-источников обработано: {len(task_config['items'])}.\n"
        f"Строк в результате: {len(rows)}.\n"
        f"Файл: {attachment['original_name']}."
    )
    meta = {
        'message_kind': 'collection_execution_result',
        'downstream': 'chat:api_collection_result',
        'collection_contract': contract,
        'task_source_list': task_config,
        'attachments': [attachment],
        'collection_rows_preview': rows[:5],
    }
    return reply_text, meta


def build_collection_dashboard_fallback_payload(contract: dict[str, Any], documents: list[dict[str, Any]], rows: list[dict[str, Any]]) -> dict[str, Any]:
    subject = safe_text(contract.get('subject') or contract.get('request_text') or 'Собранные данные')
    source_label = {
        'web': 'Веб-источники',
        'telegram': 'Telegram',
        'api': 'API',
        'attachment': 'Файлы',
    }.get(safe_text(contract.get('source_kind')), 'Источник')
    top_titles = [safe_text(item.get('title') or item.get('final_url') or item.get('requested_url')) for item in documents[:5]]
    summary_cards = [
        {'label': 'Источник', 'value': source_label, 'note': safe_text(contract.get('source_kind') or 'mixed')},
        {'label': 'Документов', 'value': str(len(documents)), 'note': 'Реально обработано'},
        {'label': 'Строк', 'value': str(len(rows)), 'note': 'После нормализации'},
    ]
    sections: list[dict[str, Any]] = [
        {
            'kind': 'text_list',
            'title': 'Что вошло в анализ',
            'items': top_titles or ['Собранные документы без явных заголовков'],
        }
    ]
    category_field = next((field for field in contract.get('fields') or [] if field in {'type', 'category', 'segment', 'product_type', 'class'}), '')
    if category_field:
        counts: dict[str, int] = {}
        for row in rows:
            label = safe_text(row.get(category_field)) or 'Не указано'
            counts[label] = counts.get(label, 0) + 1
        if counts:
            total = sum(counts.values()) or 1
            sections.append({
                'kind': 'bar_list',
                'title': 'Распределение по категориям',
                'items': [
                    {'label': label, 'value': str(value), 'ratio': round(value / total, 4)}
                    for label, value in sorted(counts.items(), key=lambda item: (-item[1], item[0]))[:8]
                ],
            })
    sections.append({
        'kind': 'text_list',
        'title': 'Ограничения',
        'items': [
            {'text': 'Часть выводов может быть ориентировочной, если в источниках мало структурированных данных.', 'meta': 'Fallback dashboard payload'},
        ],
    })
    return {
        'reply_text': f'Собрала данные по теме {subject} и подготовила dashboard по собранным источникам.',
        'dashboard': {
            'kind': 'external_research_dashboard',
            'grammar_version': EXTERNAL_DASHBOARD_GRAMMAR_VERSION,
            'intent': infer_external_dashboard_intent(subject),
            'title': f'Дашборд: {subject[:80]}',
            'subtitle': f'Собранные документы: {len(documents)} · строки: {len(rows)}',
            'summary_cards': summary_cards,
            'sections': sections,
            'sources': [
                {'label': safe_text(item.get('title') or item.get('final_url') or item.get('requested_url')), 'url': safe_text(item.get('final_url') or item.get('requested_url'))}
                for item in documents[:8]
            ],
            'notes': 'Dashboard построен на собранном dataset-path без отдельного file artifact.',
        },
    }


def maybe_build_collection_dashboard_reply(
    contract: dict[str, Any],
    documents: list[dict[str, Any]],
    rows: list[dict[str, Any]],
    *,
    downstream: str,
) -> tuple[str, dict[str, Any]] | None:
    if safe_text(contract.get('output_format')).lower() != 'dashboard':
        return None
    materialized_documents = documents or build_collection_documents_from_rows(contract, rows)
    source_label = {
        'web': 'Интернет-исследование',
        'telegram': 'Telegram-выгрузка',
        'api': 'API-источник',
        'attachment': 'Файлы пользователя',
        'conversation': 'Ранее собранный материал',
    }.get(safe_text(contract.get('source_kind')), 'Собранные данные')
    source_meta = {
        'label': source_label,
        'item_key': safe_text(contract.get('source_kind') or 'collection_dashboard'),
        'route': downstream.split(':', 1)[-1] if ':' in downstream else downstream,
    }
    policy = {
        'source_mode': 'global_only' if safe_text(contract.get('source_kind')) in {'web', 'api', 'telegram'} else 'local_only',
        'notes': 'Dashboard построен после execution-path сбора данных.',
    }
    synthesis_text = build_collection_synthesis_text(contract, materialized_documents, rows) if collection_dashboard_requires_synthesis(contract) else ''
    try:
        prompt_messages = build_web_collection_rows_prompt(contract, materialized_documents)
        prompt_messages[0] = {
            'role': 'system',
            'content': (
                'Ты строишь dashboard_result для уже собранных данных Hermes Web. '
                'Используй только synthesis_text, rows_preview и documents. '
                'Верни строго JSON-объект вида {"reply_text":"...","dashboard":{...}} без markdown. '
                'В dashboard нужны summary_cards, sections, sources и честные оговорки, если данных мало. '
                'Не описывай действия агента и не подменяй содержание служебным текстом.'
            ),
        }
        prompt_messages[1] = {
            'role': 'user',
            'content': json.dumps({
                'request_text': contract.get('request_text'),
                'subject': contract.get('subject'),
                'intent': collection_dashboard_intent(contract),
                'synthesis_text': synthesis_text,
                'analysis_modes': contract.get('analysis_modes') or [],
                'rows_preview': rows[:30],
                'documents': [
                    {
                        'source_url': item.get('final_url') or item.get('requested_url'),
                        'title': item.get('title'),
                        'text_excerpt': safe_text(item.get('text'))[:3000],
                    }
                    for item in materialized_documents[:8]
                ],
            }, ensure_ascii=False),
        }
        payload = extract_json_object(call_hermes_messages(prompt_messages, model_name=HERMES_API_MODEL)[0])
        if not isinstance(payload, dict):
            payload = build_dashboard_from_synthesis_fallback_payload(contract, synthesis_text or build_collection_synthesis_fallback_text(contract, materialized_documents, rows), source_meta)
    except Exception:
        payload = build_dashboard_from_synthesis_fallback_payload(contract, synthesis_text or build_collection_synthesis_fallback_text(contract, materialized_documents, rows), source_meta)
    reply_text = safe_text(payload.get('reply_text') or f'Собрала данные и подготовила dashboard по теме {safe_text(contract.get("subject") or "запрос")}.' )
    request_text = safe_text(contract.get('request_text') or contract.get('subject'))
    dashboard = normalize_external_dashboard_payload(
        payload.get('dashboard') if isinstance(payload.get('dashboard'), dict) else {},
        reply_text,
        source_meta,
        policy,
        request_text,
    )
    if user_prefers_russian_dashboard(request_text) and not text_looks_cyrillic(reply_text):
        reply_text = f"Собрала структурированный дашборд по теме: {request_text[:120] or 'внешнее исследование'}. Числовые блоки без подтверждённых источников исключены; сохранены только содержательные и честно ограниченные секции."
    if not dashboard_result_is_substantive(dashboard, reply_text, request_text):
        payload = build_dashboard_from_synthesis_fallback_payload(contract, synthesis_text or build_collection_synthesis_fallback_text(contract, materialized_documents, rows), source_meta)
        reply_text = safe_text(payload.get('reply_text') or reply_text)
        dashboard = normalize_external_dashboard_payload(
            payload.get('dashboard') if isinstance(payload.get('dashboard'), dict) else {},
            reply_text,
            source_meta,
            policy,
            request_text,
        )
    return reply_text, {
        'message_kind': 'dashboard_result',
        'downstream': downstream,
