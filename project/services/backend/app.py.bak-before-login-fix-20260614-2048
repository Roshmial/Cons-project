def user_to_dict(row: sqlite3.Row, conn: sqlite3.Connection | None = None) -> dict[str, Any]:
    assistant_profile = assistant_profile_from_row(row, conn)
    tone_labels = reference_label_map(conn, REFERENCE_DATASET_ASSISTANT_TONES) if conn is not None else None
    depth_labels = reference_label_map(conn, REFERENCE_DATASET_ASSISTANT_ANSWER_DEPTHS) if conn is not None else None
    mode_labels = reference_label_map(conn, REFERENCE_DATASET_ASSISTANT_INTERACTION_MODES) if conn is not None else None
    keys = set(row.keys()) if hasattr(row, "keys") else set()
    return {
        "id": row["id"],
        "email": row["email"],
        "role": row["role"],
        "name": row["name"],
        "timezone": row["timezone"],
        "language": row["language"],
        "team": row["team"],
        "title": row["title"],
        "goals": row["goals"],
        "style": row["style"],
        "constraints": row["constraints_text"],
        "pinned": json_loads(row["pinned_json"], []),
        "assistant_profile": assistant_profile,
        "version": row["version"] if "version" in keys else 1,
        "style_summary": {
            "tone": humanize_tone(assistant_profile["tone"], tone_labels),
            "answer_depth": humanize_depth(assistant_profile["answer_depth"], depth_labels),
            "interaction_mode": humanize_mode(assistant_profile["interaction_mode"], mode_labels),
        },
        "onboarding_completed": bool(row["onboarding_completed"]),
        "is_active": bool(row["is_active"]) if "is_active" in keys else True,
        "deleted_at": row["deleted_at"] if "deleted_at" in keys else None,
        "status": "deleted" if ("deleted_at" in keys and row["deleted_at"]) else ("inactive" if ("is_active" in keys and not bool(row["is_active"])) else "active"),
        "created_at": row["created_at"] if "created_at" in keys else None,
        "updated_at": row["updated_at"] if "updated_at" in keys else None,
    }


