    query = """
        SELECT t.id, t.title, t.preview, t.archived, t.thread_kind, t.job_id, t.version, t.created_at, t.updated_at,
               COUNT(m.id) AS message_count,
               MAX(m.created_at) AS last_message_at
        FROM threads t
        LEFT JOIN messages m ON m.thread_id = t.id
        WHERE t.user_id = ?
    """
    params: list[Any] = [auth.id]
    if not include_archived:
        query += " AND t.archived = 0"
    query += " GROUP BY t.id, t.title, t.preview, t.archived, t.thread_kind, t.job_id, t.version, t.created_at, t.updated_at ORDER BY t.updated_at DESC, t.id DESC"
    with db_connect() as conn:
