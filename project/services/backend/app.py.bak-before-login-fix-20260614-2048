def resolve_job_recipient_user_ids(conn: sqlite3.Connection, job_id: int, owner_user_id: int) -> list[int]:
    recipients = fetch_job_recipients(conn, job_id)
    user_ids: set[int] = set()
    for item in recipients:
        recipient_type = item["recipient_type"]
        if recipient_type == "owner":
            user_ids.add(int(owner_user_id))
        elif recipient_type == "fixed_user":
            try:
                user_ids.add(int(item["target_value"]))
            except (TypeError, ValueError):
                continue
        elif recipient_type == "fixed_thread":
            try:
                thread_id = int(item["target_value"])
            except (TypeError, ValueError):
                continue
            thread_row = conn.execute("SELECT user_id FROM threads WHERE id = ?", (thread_id,)).fetchone()
            if thread_row and thread_row["user_id"] is not None:
                user_ids.add(int(thread_row["user_id"]))
        elif recipient_type == "subscribers":
            rows = conn.execute("SELECT user_id FROM job_subscriptions WHERE job_id = ?", (job_id,)).fetchall()
            user_ids.update(int(row["user_id"]) for row in rows)
        elif recipient_type == "workspace":
            rows = conn.execute("SELECT id FROM users ORDER BY id ASC").fetchall()
            user_ids.update(int(row["id"]) for row in rows)
    subscription_rows = conn.execute("SELECT user_id FROM job_subscriptions WHERE job_id = ?", (job_id,)).fetchall()
    user_ids.update(int(row["user_id"]) for row in subscription_rows)
    return sorted(user_ids)


def ensure_job_thread_for_user(conn: sqlite3.Connection, job_row: sqlite3.Row, user_id: int, preview_override: str | None = None) -> int:
    existing = conn.execute("SELECT id FROM threads WHERE user_id = ? AND job_id = ? ORDER BY id ASC LIMIT 1", (user_id, job_row["id"])).fetchone()
    ts = now_iso()
    title = safe_text(job_row["display_name"] if "display_name" in job_row.keys() else "") or safe_text(job_row["name"]) or f"Задача {job_row['id']}"
    preview = preview_override or safe_text(job_row["description"]) or f"Рассылка по задаче: {title}"
    if existing:
        conn.execute("UPDATE threads SET title = ?, preview = ?, archived = 0, thread_kind = 'job', updated_at = ? WHERE id = ?", (title, preview[:140], ts, existing["id"]))
        return int(existing["id"])
    cur = conn.execute("INSERT INTO threads (user_id, title, preview, archived, thread_kind, job_id, created_at, updated_at) VALUES (?, ?, ?, 0, 'job', ?, ?, ?) RETURNING id", (user_id, title, preview[:140], job_row["id"], ts, ts))
    return int(cur.fetchone()[0])


def sync_job_threads(conn: sqlite3.Connection, job_id: int) -> None:
    job_row = get_job_by_id(conn, job_id)
    target_user_ids = set(resolve_job_recipient_user_ids(conn, job_id, int(job_row["user_id"])))
    existing_rows = conn.execute("SELECT id, user_id FROM threads WHERE job_id = ?", (job_id,)).fetchall()
    existing_by_user = {int(row["user_id"]): int(row["id"]) for row in existing_rows}
    for user_id in sorted(target_user_ids):
        ensure_job_thread_for_user(conn, job_row, user_id)
    remove_thread_ids = [thread_id for user_id, thread_id in existing_by_user.items() if user_id not in target_user_ids]
    for thread_id in remove_thread_ids:
        conn.execute("DELETE FROM user_files WHERE thread_id = ?", (thread_id,))
        conn.execute("DELETE FROM feedback WHERE message_id IN (SELECT id FROM messages WHERE thread_id = ?)", (thread_id,))
        conn.execute("DELETE FROM messages WHERE thread_id = ?", (thread_id,))
        conn.execute("DELETE FROM threads WHERE id = ?", (thread_id,))


def append_job_delivery_messages(conn: sqlite3.Connection, job_row: sqlite3.Row, result_text: str, meta: dict[str, Any] | None = None) -> list[dict[str, Any]]:
    delivered = []
    ts = now_iso()
    preview = safe_text(result_text).replace("\n", " ")[:140] or safe_text(job_row["name"]) or f"Задача {job_row['id']}"
    for user_id in resolve_job_recipient_user_ids(conn, int(job_row["id"]), int(job_row["user_id"])):
        thread_id = ensure_job_thread_for_user(conn, job_row, user_id, preview_override=preview)
        cur = conn.execute("INSERT INTO messages (thread_id, role, content, created_at, meta_json) VALUES (?, 'assistant', ?, ?, ?) RETURNING id", (thread_id, result_text, ts, json.dumps(meta or {"source": "job_run", "job_id": job_row["id"]}, ensure_ascii=False)))
        message_id = cur.fetchone()[0]
        final_text, final_meta = enrich_assistant_meta(meta or {"source": "job_run", "job_id": job_row["id"]}, result_text, message_id=message_id)
        conn.execute("UPDATE messages SET content = ?, meta_json = ? WHERE id = ?", (final_text, json.dumps(final_meta, ensure_ascii=False), message_id))
        delivered.append({"user_id": user_id, "thread_id": thread_id})
    return delivered


def finalize_job_success(job_id: int, run_id: int, job_row: sqlite3.Row, job: dict[str, Any], result_text: str, meta: dict[str, Any] | None, finished: datetime, started: datetime) -> dict[str, Any]:
    summary = safe_text(result_text).replace("\n", " ")[:220]
    duration_ms = int((finished - started).total_seconds() * 1000)
    last_error: duckdb.TransactionException | None = None
    for attempt in range(JOB_WRITE_RETRY_ATTEMPTS):
        try:
            with db_connect() as conn:
                delivered = append_job_delivery_messages(conn, job_row, result_text, meta if isinstance(meta, dict) else None)
                next_run = compute_next_run(
                    {
                        "schedule_kind": job["schedule_kind"],
                        "days_of_week": job["days_of_week"],
                        "time_of_day": job["time_of_day"],
                        "start_date": job["start_date"],
                        "timezone": job["timezone"],
                        "status": job["status"],
                    },
                    finished + timedelta(seconds=1),
                )
                conn.execute(
                    """
                    UPDATE job_runs
                    SET status = 'success', finished_at = ?, duration_ms = ?, summary = ?, result_text = ?, error_text = '', delivered_to_json = ?
                    WHERE id = ?
                    """,
                    (
                        now_iso(finished),
                        duration_ms,
                        summary,
                        result_text,
                        json.dumps(delivered, ensure_ascii=False),
                        run_id,
                    ),
                )
                conn.execute(
                    """
                    UPDATE jobs
                    SET last_run_at = ?, last_run_status = 'success', last_run_summary = ?, last_error = '', next_run_at = ?, updated_at = ?
                    WHERE id = ?
                    """,
                    (now_iso(finished), summary, next_run, now_iso(finished), job_id),
                )
                updated = row_to_job_dict(conn, get_job_by_id(conn, job_id), include_details=True)
            updated["last_run_result"] = result_text
            updated["last_run_meta"] = meta
            return updated
        except duckdb.TransactionException as exc:
            last_error = exc
            if attempt >= JOB_WRITE_RETRY_ATTEMPTS - 1:
                break
            time.sleep(JOB_WRITE_RETRY_DELAY_SECONDS * (attempt + 1))
    raise ApiError(f"job_delivery_write_conflict: {last_error}", 409)


def execute_job(job_id: int, triggered_by_user_id: int | None, trigger_type: str) -> dict[str, Any]:
    with _running_jobs_lock:
        if job_id in _running_jobs:
            raise ApiError("job_already_running", 409)
        _running_jobs.add(job_id)
    started = now_utc()
    run_id = None
    try:
        with db_connect() as conn:
            job_row = get_job_by_id(conn, job_id)
            owner_row = conn.execute("SELECT * FROM users WHERE id = ?", (job_row["user_id"],)).fetchone()
            owner_profile = user_to_dict(owner_row, conn)
            run_cur = conn.execute(
                "INSERT INTO job_runs (job_id, triggered_by_user_id, trigger_type, status, started_at) VALUES (?, ?, ?, 'running', ?) RETURNING id",
                (job_id, triggered_by_user_id, trigger_type, now_iso(started)),
            )
            run_id = run_cur.fetchone()[0]
        with db_connect() as conn:
            job_row = get_job_by_id(conn, job_id)
            job = row_to_job_dict(conn, job_row, include_details=True)
        messages = [
            {"role": "system", "content": build_job_system_prompt(owner_profile)},
            {"role": "user", "content": build_job_user_prompt(job, owner_profile)},
        ]
        result_text, meta = call_hermes_messages(messages)
        finished = now_utc()
        updated = finalize_job_success(job_id, run_id, job_row, job, result_text, meta, finished, started)
        return updated
    except ApiError as exc:
        finished = now_utc()
        duration_ms = int((finished - started).total_seconds() * 1000)
        if run_id is not None:
            with db_connect() as conn:
                conn.execute(
                    "UPDATE job_runs SET status = 'error', finished_at = ?, duration_ms = ?, error_text = ?, summary = '' WHERE id = ?",
                    (now_iso(finished), duration_ms, exc.message, run_id),
                )
                conn.execute(
                    "UPDATE jobs SET last_run_at = ?, last_run_status = 'error', last_error = ?, updated_at = ? WHERE id = ?",
                    (now_iso(finished), exc.message, now_iso(finished), job_id),
                )
        raise
    finally:
        with _running_jobs_lock:
            _running_jobs.discard(job_id)


def scheduler_worker() -> None:
    while not _scheduler_stop.is_set():
        try:
            with db_connect() as conn:
                due_rows = conn.execute(
                    "SELECT id FROM jobs WHERE status = 'active' AND next_run_at IS NOT NULL AND next_run_at <= ? ORDER BY next_run_at ASC LIMIT 5",
                    (now_iso(),),
                ).fetchall()
            for row in due_rows:
                try:
                    execute_job(int(row["id"]), None, "schedule")
                except Exception:
                    pass
        except Exception:
            pass
        _scheduler_stop.wait(SCHEDULER_POLL_SECONDS)


def start_scheduler() -> None:
    global _scheduler_started
    if not SCHEDULER_ENABLED:
        return
    with _scheduler_lock:
        if _scheduler_started:
            return
        thread = threading.Thread(target=scheduler_worker, name="hermes-web-jobs", daemon=True)
        thread.start()
        _scheduler_started = True


@app.before_request
def handle_preflight() -> Response | None:
    if request.method == "OPTIONS":
        return Response(status=204)
    return None


@app.after_request
def add_cors_headers(response: Response) -> Response:
    request_origin = request.headers.get("Origin", "")
    if CORS_ALLOW_ORIGIN == "*":
        allow_origin = "*"
    elif request_origin and request_origin in CORS_ALLOW_ORIGINS:
        allow_origin = request_origin
    else:
        allow_origin = CORS_ALLOW_ORIGINS[0] if CORS_ALLOW_ORIGINS else "*"
    response.headers["Access-Control-Allow-Origin"] = allow_origin
    response.headers["Vary"] = "Origin"
    response.headers["Access-Control-Allow-Headers"] = "Authorization, Content-Type"
    response.headers["Access-Control-Allow-Methods"] = "GET, POST, PATCH, OPTIONS"
    response.headers["X-Content-Type-Options"] = "nosniff"
    response.headers["X-Frame-Options"] = "DENY"
    response.headers["Referrer-Policy"] = "same-origin"
    if request.headers.get("Authorization") or request.path.startswith(f"{API_PREFIX}/auth") or request.path in {f"{API_PREFIX}/me", f"{API_PREFIX}/bootstrap"}:
        response.headers["Cache-Control"] = "no-store"
    return response


