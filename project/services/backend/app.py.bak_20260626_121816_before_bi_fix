    return {
        'kind': kind,
        'assistant_generated': True,
        'source': source,
        'original_name': resolved.name,
        'stored_name': resolved.name,
        'relative_path': relative_path,
        'local_path': str(resolved),
        'mime_type': guess_mime_type(resolved.name),
        'size_bytes': resolved.stat().st_size,
        'download_url': None,
    }


def run_tender_pipeline_snapshot(contract: dict[str, Any]) -> dict[str, Any]:
    script_path = Path('/home/hermes/workspace/eva-github-backup/hermes-runtime/scripts/it_tender_pipeline.py')
    if not script_path.exists():
        raise ApiError('tender_pipeline_script_missing', 409)
    since_date = safe_text(contract.get('since_date')) or datetime.now().strftime('%Y-%m-%d')
    until_date = datetime.now().strftime('%Y-%m-%d')
    try:
        target_date = datetime.strptime(since_date, '%Y-%m-%d').strftime('%d.%m.%Y')
        until_target_date = datetime.strptime(until_date, '%Y-%m-%d').strftime('%d.%m.%Y')
    except ValueError as exc:
        raise ApiError('tender_collection_since_date_invalid', 409) from exc
    run_dir = collection_task_artifacts_root('tenders') / 'pipeline_runs' / f"{build_collection_task_slug(contract)}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
    run_dir.mkdir(parents=True, exist_ok=True)
    command = [sys.executable, str(script_path), '--date', target_date, '--until-date', until_target_date, '--out-dir', str(run_dir)]
    env = os.environ.copy()
    env.setdefault('TENDER_PIPELINE_SKIP_REFRESH', '1')
    try:
        completed = subprocess.run(command, capture_output=True, text=True, timeout=300, check=False, env=env)
    except subprocess.TimeoutExpired as exc:
        raise ApiError('tender_collection_timeout', 504) from exc
    if completed.returncode != 0:
        raise ApiError(f"tender_collection_runtime_failed:{completed.returncode}", 502)
    summary_path = run_dir / 'last_run_summary.json'
    if not summary_path.exists():
        raise ApiError('tender_collection_summary_missing', 502)
    summary = json.loads(summary_path.read_text(encoding='utf-8'))
    csv_path = Path(safe_text(summary.get('csv_path')))
    status_csv_path = Path(safe_text(summary.get('status_csv_path')))
    if not csv_path.exists():
        raise ApiError('tender_collection_csv_missing', 502)
    if not status_csv_path.exists():
        raise ApiError('tender_collection_status_csv_missing', 502)
    return {
        'target_date': target_date,
        'until_target_date': until_target_date,
        'run_dir': str(run_dir),
        'summary_path': str(summary_path),
        'summary': summary,
        'stdout': safe_text(completed.stdout),
        'stderr': safe_text(completed.stderr),
        'csv_attachment': build_existing_file_attachment(str(csv_path), kind='collection_artifact', source='tender_pipeline'),
        'status_attachment': build_existing_file_attachment(str(status_csv_path), kind='collection_status_artifact', source='tender_pipeline'),
    }


