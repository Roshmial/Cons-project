    depth_labels = reference_label_map(conn, REFERENCE_DATASET_ASSISTANT_ANSWER_DEPTHS) if conn is not None else None
    mode_labels = reference_label_map(conn, REFERENCE_DATASET_ASSISTANT_INTERACTION_MODES) if conn is not None else None
    keys = set(row.keys()) if hasattr(row, "keys") else set()
    return {
        "id": row["id"],
        "email": row["email"],
        "role": row["role"],
        "name": row["name"],
        "timezone": row["timezone"],
        "language": row["language"],
        "team": row["team"],
        "title": row["title"],
        "goals": row["goals"],
        "style": row["style"],
        "constraints": row["constraints_text"],
