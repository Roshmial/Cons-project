@app.get(f"{API_PREFIX}/admin/events")
def admin_events() -> Response:
    require_admin()
    date_from = parse_iso(request.args.get("date_from"))
    date_to = parse_iso(request.args.get("date_to"))
    export_format = (request.args.get("export") or "").strip().lower()
    try:
        limit = max(1, min(500, int(request.args.get("limit") or 100)))
    except ValueError:
        limit = 100
    message_filters: list[str] = []
    job_filters: list[str] = []
    message_params: list[Any] = []
    job_params: list[Any] = []
    if date_from:
        message_filters.append("CAST(m.created_at AS TIMESTAMP) >= CAST(? AS TIMESTAMP)")
        job_filters.append("CAST(r.started_at AS TIMESTAMP) >= CAST(? AS TIMESTAMP)")
        message_params.append(now_iso(date_from))
        job_params.append(now_iso(date_from))
    if date_to:
        message_filters.append("CAST(m.created_at AS TIMESTAMP) <= CAST(? AS TIMESTAMP)")
        job_filters.append("CAST(r.started_at AS TIMESTAMP) <= CAST(? AS TIMESTAMP)")
        message_params.append(now_iso(date_to))
        job_params.append(now_iso(date_to))
    message_where = f"WHERE {' AND '.join(message_filters)}" if message_filters else ""
    job_where = f"WHERE {' AND '.join(job_filters)}" if job_filters else ""
    with db_connect() as conn:
        message_events = conn.execute(
            f"""
            SELECT m.created_at, u.email, t.title AS subject, m.role AS event_type, substr(m.content, 1, 160) AS content_short
            FROM messages m
            JOIN threads t ON t.id = m.thread_id
            JOIN users u ON u.id = t.user_id
            {message_where}
            ORDER BY m.id DESC
            LIMIT ?
            """,
            (*message_params, limit),
        ).fetchall()
        job_events = conn.execute(
            f"""
            SELECT r.started_at AS created_at, u.email, j.name AS subject, ('job:' || r.status) AS event_type, substr(r.summary, 1, 160) AS content_short
            FROM job_runs r
            JOIN jobs j ON j.id = r.job_id
            JOIN users u ON u.id = j.user_id
            {job_where}
            ORDER BY r.id DESC
            LIMIT ?
            """,
            (*job_params, limit),
        ).fetchall()
    events = [dict(row) for row in message_events] + [dict(row) for row in job_events]
    events.sort(key=lambda item: item["created_at"], reverse=True)
    events = events[:limit]
    if export_format == "csv":
        buffer = io.StringIO()
        writer = csv.DictWriter(buffer, fieldnames=["created_at", "email", "event_type", "subject", "content_short"])
        writer.writeheader()
        writer.writerows(events)
        return Response(buffer.getvalue(), mimetype="text/csv; charset=utf-8", headers={"Content-Disposition": 'attachment; filename="admin-events.csv"'})
    if export_format == "json":
        return Response(json.dumps({"events": events}, ensure_ascii=False, indent=2), mimetype="application/json", headers={"Content-Disposition": 'attachment; filename="admin-events.json"'})
    return jsonify({"events": events, "filters": {"date_from": now_iso(date_from) if date_from else None, "date_to": now_iso(date_to) if date_to else None, "limit": limit}})


@app.get(f"{API_PREFIX}/admin/jobs")
def admin_jobs() -> Response:
    require_admin()
    jobs = [
        {
            "id": item["id"],
            "name": item["name"],
            "status": item["status"],
            "visibility": item["visibility"],
            "updated_at": item["updated_at"],
            "last_run_status": item["last_run_status"],
            "next_run_at": item["next_run_at"],
            "email": "admin-only",
        }
        for item in (hermes_job_to_web(job, include_details=False) for job in list_cached_hermes_jobs())
    ]
    jobs.sort(key=lambda item: (item.get("updated_at") or "", item.get("id") or ""), reverse=True)
    return jsonify({"jobs": jobs[:30]})


