def fetch_hermes_job_recipients(conn: sqlite3.Connection, hermes_job_id: str, hermes_job: dict[str, Any] | None = None) -> list[dict[str, Any]]:
    rows = conn.execute(
        "SELECT recipient_type, target_value, label FROM hermes_job_recipients WHERE hermes_job_id = ? ORDER BY id ASC",
        (str(hermes_job_id),),
    ).fetchall()
    recipients = [dict(row) for row in rows]
    if recipients:
        return recipients
    if hermes_job is None:
        hermes_job = hermes_get_job(str(hermes_job_id)) or {}
    deliver_value = safe_text((hermes_job or {}).get("deliver") or "origin") or "origin"
    return [{"recipient_type": "delivery_target", "target_value": deliver_value, "label": "Цель доставки Hermes"}]


def replace_hermes_job_recipients(conn: sqlite3.Connection, hermes_job_id: str, recipients: list[dict[str, Any]]) -> None:
    job_id = str(hermes_job_id)
    conn.execute("DELETE FROM hermes_job_recipients WHERE hermes_job_id = ?", (job_id,))
    ts = now_iso()
    deduped: list[tuple[str, str, str]] = []
    seen: set[tuple[str, str]] = set()
    for item in recipients or []:
        if not isinstance(item, dict):
            continue
        recipient_type = safe_text(item.get("recipient_type"))
        target_value = safe_text(item.get("target_value"))
        label = safe_text(item.get("label"))
        if recipient_type not in {"fixed_user", "fixed_thread"} or not target_value:
            continue
        key = (recipient_type, target_value)
        if key in seen:
            continue
        seen.add(key)
        deduped.append((recipient_type, target_value, label))
    for recipient_type, target_value, label in deduped:
        conn.execute(
            "INSERT INTO hermes_job_recipients (hermes_job_id, recipient_type, target_value, label, created_at) VALUES (?, ?, ?, ?, ?)",
            (job_id, recipient_type, target_value, label, ts),
        )


def resolve_hermes_job_recipient_user_ids(conn: sqlite3.Connection, hermes_job_id: str, hermes_job: dict[str, Any] | None = None) -> list[int]:
    recipients = fetch_hermes_job_recipients(conn, hermes_job_id, hermes_job=hermes_job)
    user_ids: set[int] = set()
    for item in recipients:
        recipient_type = item.get("recipient_type")
        target_value = safe_text(item.get("target_value"))
        if recipient_type == "fixed_user":
            try:
                user_ids.add(int(target_value))
            except (TypeError, ValueError):
                continue
        elif recipient_type == "fixed_thread":
            try:
                thread_id = int(target_value)
            except (TypeError, ValueError):
                continue
            thread_row = conn.execute("SELECT user_id FROM threads WHERE id = ?", (thread_id,)).fetchone()
            if thread_row and thread_row["user_id"] is not None:
                user_ids.add(int(thread_row["user_id"]))
    return sorted(user_ids)


def ensure_hermes_job_thread_for_user(conn: sqlite3.Connection, hermes_job: dict[str, Any], user_id: int, preview_override: str | None = None) -> int:
    hermes_job_id = str(hermes_job.get("id") or "")
    existing = conn.execute(
        "SELECT id, title, preview, archived, thread_kind FROM threads WHERE user_id = ? AND external_job_id = ? ORDER BY id ASC LIMIT 1",
        (user_id, hermes_job_id),
    ).fetchone()
    ts = now_iso()
    title = safe_text(hermes_job.get("name") or hermes_job_id) or f"Hermes Cron {hermes_job_id}"
    preview = preview_override or safe_text(hermes_job.get("prompt") or "")[:140] or f"Рассылка Hermes Cron: {title}"
    preview = preview[:140]
    if existing:
        needs_update = (
            safe_text(existing["title"]) != title
            or safe_text(existing["preview"]) != preview
            or bool(existing["archived"])
            or safe_text(existing["thread_kind"]) != "job"
        )
        if needs_update:
            conn.execute(
                "UPDATE threads SET title = ?, preview = ?, archived = 0, thread_kind = 'job', updated_at = ? WHERE id = ?",
                (title, preview, ts, existing["id"]),
            )
        return int(existing["id"])
    cur = conn.execute(
        "INSERT INTO threads (user_id, title, preview, archived, thread_kind, external_job_id, created_at, updated_at) VALUES (?, ?, ?, 0, 'job', ?, ?, ?) RETURNING id",
        (user_id, title, preview, hermes_job_id, ts, ts),
    )
    return int(cur.fetchone()[0])


def sync_hermes_job_threads(conn: sqlite3.Connection, hermes_job: dict[str, Any]) -> None:
    hermes_job_id = str(hermes_job.get("id") or "")
    target_user_ids = set(resolve_hermes_job_recipient_user_ids(conn, hermes_job_id, hermes_job=hermes_job))
    existing_rows = conn.execute(
        "SELECT id, user_id FROM threads WHERE external_job_id = ?",
        (hermes_job_id,),
    ).fetchall()
    existing_by_user = {int(row["user_id"]): int(row["id"]) for row in existing_rows}
    for user_id in sorted(target_user_ids):
        ensure_hermes_job_thread_for_user(conn, hermes_job, user_id)
    remove_thread_ids = [thread_id for user_id, thread_id in existing_by_user.items() if user_id not in target_user_ids]
    for thread_id in remove_thread_ids:
        conn.execute("DELETE FROM user_files WHERE thread_id = ?", (thread_id,))
        conn.execute("DELETE FROM feedback WHERE message_id IN (SELECT id FROM messages WHERE thread_id = ?)", (thread_id,))
        conn.execute("DELETE FROM messages WHERE thread_id = ?", (thread_id,))
        conn.execute("DELETE FROM threads WHERE id = ?", (thread_id,))


def _looks_like_tg_digest_reasoning(text: str) -> bool:
    lowered = safe_text(text).lower()
    if not lowered:
        return False
    return (
        lowered.startswith('we have the payload')
        or lowered.startswith('- короткую тему:')
        or 'need to extract top_candidates' in lowered
        or 'instructions say "короткую тему"' in lowered
        or ('top_candidates' in lowered and 'selection_reasons' in lowered)
    )


def _find_tg_digest_payload_for_output(output_path: str | None) -> tuple[Path | None, Path | None]:
    candidate = Path(str(output_path or '').strip())
    if not candidate.name:
        return None, None
    match = re.search(r'(\d{4}-\d{2}-\d{2})_', candidate.name)
    if not match:
        return None, None
    day = match.group(1)
    cache_dir = Path('/home/hermes/.hermes/cache/documents/tg-it-consulting/178')
    if not cache_dir.exists():
        return None, None
    payload_matches = sorted(cache_dir.glob(f'telegram_it_consulting_digest_payload_{day}_*.json'))
    csv_matches = sorted(cache_dir.glob(f'telegram_it_consulting_processed_{day}_*.csv'))
    payload_path = payload_matches[-1] if payload_matches else None
    csv_path = csv_matches[-1] if csv_matches else None
    return payload_path, csv_path


def _compact_tg_digest_summary(text: str, limit: int = 420) -> str:
    cleaned = ' '.join(safe_text(text).replace('…', '. ').split())
    if not cleaned:
        return ''
    parts = [part.strip(' .;') for part in re.split(r'(?<=[.!?])\s+', cleaned) if part.strip(' .;')]
    if not parts:
        return cleaned[:limit].rstrip(' ,;:-')
    selected: list[str] = []
    total = 0
    for part in parts:
        candidate = (part.rstrip(' .;') + '.') if not re.search(r'[.!?…]$', part) else part
        projected = total + len(candidate) + (1 if selected else 0)
        if selected and projected > limit:
            break
        if not selected and len(candidate) > limit:
            return candidate[:limit].rsplit(' ', 1)[0].rstrip(' ,;:-') + '…'
        selected.append(candidate)
        total = projected
        if len(selected) >= 3:
            break
    return ' '.join(selected) if selected else cleaned[:limit].rstrip(' ,;:-')


def _build_tg_digest_from_payload(payload_path: Path, csv_path: Path | None = None) -> str:
    payload = json_loads(payload_path.read_text(encoding='utf-8'), {})
    if not isinstance(payload, dict):
        return ''
    top_candidates = payload.get('top_candidates') or []
    if not isinstance(top_candidates, list) or not top_candidates:
        return ''
    generated_at = safe_text(payload.get('generated_at'))
    date_match = re.search(r'(\d{4})-(\d{2})-(\d{2})', generated_at)
    date_label = f'{date_match.group(3)}.{date_match.group(2)}.{date_match.group(1)}' if date_match else ''
    non_empty_messages = payload.get('non_empty_messages')
    try:
        non_empty_value = int(non_empty_messages)
    except (TypeError, ValueError):
        non_empty_value = len(top_candidates)
    lines = [
        f'Дайджест ИТ-консалтинга за {date_label}' if date_label else 'Дайджест ИТ-консалтинга',
        f'Обработано непустых сообщений: {non_empty_value}; в дайджесте: {min(len(top_candidates), 10)}.',
        '',
    ]
    for item in top_candidates[:10]:
        if not isinstance(item, dict):
            continue
        title = safe_text(item.get('краткое содержание') or item.get('саммари') or item.get('тип поста') or 'Пост')
        channel = safe_text(item.get('канал'))
        dt_value = safe_text(item.get('дата-время'))
        link = safe_text(item.get('ссылка'))
        summary = _compact_tg_digest_summary(item.get('саммари') or item.get('краткое содержание'))
        links = []
        for ext in item.get('external_links') or []:
            if not isinstance(ext, dict):
                continue
            label = safe_text(ext.get('label') or ext.get('url'))
            url = safe_text(ext.get('url'))
            if label and url:
                links.append(f'[{label}]({url})')
        lines.append(f'**{title}**')
        if channel:
            lines.append(f'Канал: {channel}')
        if dt_value:
            lines.append(f'Время: {dt_value}')
        if link:
            lines.append(f'[пост]({link})')
        if summary:
            lines.append(f'Краткое содержание: {summary}')
        if links:
            lines.append(f'Ссылки: {", ".join(links)}')
        lines.append('')
    requires_review = payload.get('requires_review_count')
    try:
        requires_review_value = int(requires_review)
    except (TypeError, ValueError):
        requires_review_value = 0
    if requires_review_value > 0:
        lines.append('Есть сообщения, которым может понадобиться уточнение классификации.')
    if csv_path and csv_path.exists():
        lines.append(f'MEDIA:{csv_path}')
    return '\n'.join(line for line in lines if line is not None).strip()


def extract_hermes_output_for_delivery(raw: str, output_path: str | None = None) -> str:
    text = str(raw or "")
    if not text.strip():
        return ""
    payload_path, csv_path = _find_tg_digest_payload_for_output(output_path)
    if payload_path:
        rebuilt = _build_tg_digest_from_payload(payload_path, csv_path=csv_path)
        if rebuilt:
            return rebuilt
    marker = "## Response"
    if marker in text:
        response = text.split(marker, 1)[1].strip()
        if response:
            candidate = build_message_display_text(response)
            if not _looks_like_tg_digest_reasoning(candidate):
                return candidate
    fence = "---"
    if fence in text:
        tail = text.split(fence, 1)[1].strip()
        if tail:
            candidate = build_message_display_text(tail)
            if not _looks_like_tg_digest_reasoning(candidate):
                return candidate
    cleaned = build_message_display_text(text)
    if _looks_like_tg_digest_reasoning(cleaned):
        payload_path, csv_path = _find_tg_digest_payload_for_output(output_path)
        if payload_path:
            rebuilt = _build_tg_digest_from_payload(payload_path, csv_path=csv_path)
            if rebuilt:
                return rebuilt
    return cleaned


def reconcile_hermes_job_delivery(conn: sqlite3.Connection, hermes_job: dict[str, Any]) -> bool:
    hermes_job_id = str(hermes_job.get("id") or "")
    if not hermes_job_id or not HERMES_CRON_OUTPUT_DIR.exists():
        return False
    job_output_dir = HERMES_CRON_OUTPUT_DIR / hermes_job_id
    if not job_output_dir.exists() or not job_output_dir.is_dir():
        return False
    recipients = fetch_hermes_job_recipients(conn, hermes_job_id, hermes_job=hermes_job)
    if not any(item.get("recipient_type") in {"fixed_user", "fixed_thread"} for item in recipients):
        return False
    output_files = sorted(job_output_dir.glob("*.md"), key=lambda path: path.stat().st_mtime, reverse=True)
    if not output_files:
        return False
    latest_path = output_files[0]
    state_row = conn.execute(
        "SELECT last_output_path FROM hermes_job_delivery_state WHERE hermes_job_id = ?",
        (hermes_job_id,),
    ).fetchone()
    latest_key = str(latest_path)
    if state_row and safe_text(state_row["last_output_path"]) == latest_key:
        sync_hermes_job_threads(conn, hermes_job)
        return False
    result_text = extract_hermes_output_for_delivery(latest_path.read_text(encoding="utf-8"), output_path=str(latest_path))
    if not result_text:
        return False
    preview = safe_text(result_text).replace("\n", " ")[:140] or safe_text(hermes_job.get("name") or hermes_job_id)
    delivered = []
    for user_id in resolve_hermes_job_recipient_user_ids(conn, hermes_job_id, hermes_job=hermes_job):
        thread_id = ensure_hermes_job_thread_for_user(conn, hermes_job, user_id, preview_override=preview)
        message_meta = {
            "source": "hermes_cron",
            "job_id": hermes_job_id,
            "output_path": latest_key,
            "message_kind": "job_delivery",
        }
        cur = conn.execute(
            "INSERT INTO messages (thread_id, role, content, created_at, meta_json) VALUES (?, 'assistant', ?, ?, ?) RETURNING id",
            (thread_id, result_text, now_iso(), json.dumps(message_meta, ensure_ascii=False)),
        )
        message_id = cur.fetchone()[0]
        final_text, final_meta = enrich_assistant_meta(message_meta, result_text, message_id=message_id)
        conn.execute("UPDATE messages SET content = ?, meta_json = ? WHERE id = ?", (final_text, json.dumps(final_meta, ensure_ascii=False), message_id))
        delivered.append({"user_id": user_id, "thread_id": thread_id})
    ts = now_iso()
    conn.execute(
        """
        INSERT INTO hermes_job_delivery_state (hermes_job_id, last_output_path, last_delivered_at, updated_at)
        VALUES (?, ?, ?, ?)
        ON CONFLICT (hermes_job_id) DO UPDATE SET
            last_output_path = excluded.last_output_path,
            last_delivered_at = excluded.last_delivered_at,
            updated_at = excluded.updated_at
        """,
        (hermes_job_id, latest_key, ts, ts),
    )
    return bool(delivered)


def classify_job_run_surface(status: str | None, *, result_text: str = "", error_text: str = "", delivered_count: int = 0) -> tuple[str, str]:
    normalized = safe_text(status).lower()
    result_text = safe_text(result_text)
    error_text = safe_text(error_text)
    has_result = bool(result_text.strip())
    has_error = bool(error_text.strip())
    has_media = bool(parse_media_paths(result_text))
    if normalized == "running":
        return "running", "in_progress"
    if normalized in {"error", "failed"} or has_error:
        return "failed", "error"
    if normalized in {"ok", "success", "completed"}:
        if not has_result:
            return "empty_result", "empty"
        if delivered_count <= 0:
            return "completed_with_limitations", "file" if has_media else "text"
        if has_media:
            return "completed", "file"
        return "completed", "text"
    if not has_result and not has_error:
        return "empty_result", "empty"
    if has_error:
        return "failed", "error"
    return "completed_with_limitations" if delivered_count <= 0 else "completed", "file" if has_media else "text"


def build_job_run_status_reason(public_status: str, *, delivered_count: int = 0, has_error: bool = False, has_result: bool = False) -> str:
    if public_status == "failed" or has_error:
        return "error"
    if public_status == "running":
        return "in_progress"
    if public_status == "empty_result":
        return "no_signal"
    if public_status == "completed_with_limitations":
        if has_result and delivered_count <= 0:
            return "not_delivered"
        return "limitations"
    if public_status == "completed":
        if delivered_count > 0:
            return "delivered"
        if has_result:
            return "result_ready"
    return "unknown"


def build_job_run_status_detail(*, summary: str = "", result_text: str = "", error_text: str = "") -> str:
    if safe_text(error_text).strip():
        return safe_text(error_text).strip()
    if safe_text(summary).strip():
        return safe_text(summary).strip()
    if safe_text(result_text).strip():
        return safe_text(result_text).strip().splitlines()[0][:280]
    return ""


def build_job_run_delivery_summary(delivered_count: int, *, has_result: bool = False) -> str:
    if delivered_count > 0:
        return f"Доставлено: {delivered_count}"
    if has_result:
        return "Не доставлено"
    return "Есть результат последнего запуска" if has_result else "Нет результата для доставки"


def serialize_job_run_row(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    payload = dict(row)
    delivered_raw = json_loads(payload.get("delivered_to_json"), []) if payload.get("delivered_to_json") is not None else []
    delivered = delivered_raw if isinstance(delivered_raw, list) else []
    result_text = payload.get("result_text") or ""
    error_text = payload.get("error_text") or ""
    summary = payload.get("summary") or payload.get("last_run_summary") or ""
    stuck_running = safe_text(payload.get("status")).lower() == "running" and not safe_text(payload.get("finished_at")).strip() and is_timestamp_stale(payload.get("started_at") or payload.get("last_run_at"), threshold_seconds=JOB_RUN_STUCK_SECONDS)
    effective_status = "failed" if stuck_running else payload.get("status")
    effective_error_text = error_text or ("Запуск превысил допустимое время и помечен как зависший" if stuck_running else "")
    public_status, result_kind = classify_job_run_surface(
        effective_status,
        result_text=result_text,
        error_text=effective_error_text,
        delivered_count=len(delivered),
    )
    has_result = bool(safe_text(result_text).strip())
    has_error = bool(safe_text(effective_error_text).strip())
    payload["public_status"] = public_status
    payload["result_kind"] = result_kind
    payload["delivered_count"] = len(delivered)
    payload["has_result_text"] = has_result
    payload["has_error"] = has_error
    payload["is_stuck"] = stuck_running
    payload["status_reason"] = "stuck" if stuck_running else build_job_run_status_reason(
        public_status,
        delivered_count=len(delivered),
        has_error=has_error,
        has_result=has_result,
    )
    payload["status_detail"] = (
        "Запуск превысил допустимое время и будет требовать повторного выполнения"
        if stuck_running
        else build_job_run_status_detail(
            summary=summary,
            result_text=result_text,
            error_text=effective_error_text,
        )
    )
    payload["delivery_summary"] = "Выполнение зависло — доставка не завершена" if stuck_running else build_job_run_delivery_summary(len(delivered), has_result=has_result)
    payload["finished_at"] = payload.get("finished_at")
    payload["duration_ms"] = payload.get("duration_ms")
    return payload


def fetch_job_runs(conn: sqlite3.Connection, job_id: int, limit: int = 10) -> list[dict[str, Any]]:
    rows = conn.execute(
        """
        SELECT r.*, u.name AS triggered_by_name
        FROM job_runs r
        LEFT JOIN users u ON u.id = r.triggered_by_user_id
        WHERE r.job_id = ?
        ORDER BY r.id DESC
        LIMIT ?
        """,
        (job_id, limit),
    ).fetchall()
    return [serialize_job_run_row(row) for row in rows]


def fetch_job_subscriber_count(conn: sqlite3.Connection, job_id: int) -> int:
