def structure_web_collection_rows(contract: dict[str, Any], documents: list[dict[str, Any]]) -> list[dict[str, Any]]:
    if not documents:
        raise ApiError('web_collection_no_documents', 409)
    reply_text, _ = call_hermes_messages(build_web_collection_rows_prompt(contract, documents), model_name=HERMES_API_MODEL)
    payload = extract_json_object(reply_text)
    rows = payload.get('rows') if isinstance(payload.get('rows'), list) else []
    normalized_rows: list[dict[str, Any]] = []
    fields = list(contract.get('fields') or [])
    for row in rows:
        if not isinstance(row, dict):
            continue
        normalized = {field: safe_text(row.get(field)) for field in fields}
        source_url = safe_text(row.get('source_url') or row.get('url') or '')
        if not source_url:
            source_url = safe_text(documents[min(len(normalized_rows), len(documents)-1)].get('final_url') or '')
        normalized['source_url'] = source_url
        normalized_rows.append(normalized)
    if normalized_rows:
        return normalized_rows
    fallback_rows: list[dict[str, Any]] = []
    for doc in documents:
        row = {field: '' for field in fields}
        row['source_url'] = safe_text(doc.get('final_url') or doc.get('requested_url'))
        fallback_rows.append(row)
    return fallback_rows


def build_collection_artifact_attachment(contract: dict[str, Any], rows: list[dict[str, Any]]) -> dict[str, Any]:
    export_format = safe_text(contract.get('output_format') or 'json').lower()
    subject = build_collection_task_slug(contract)
    stamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    base_dir = collection_task_artifacts_root('web') / 'artifacts'
    base_dir.mkdir(parents=True, exist_ok=True)
    fields = list(contract.get('fields') or [])
    column_order = [*fields]
    if 'source_url' not in column_order:
        column_order.append('source_url')
    file_path = base_dir / f'collection_{subject}_{stamp}.{export_format}'
    if export_format == 'json':
        payload = {'contract': contract, 'rows': rows}
        file_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding='utf-8')
        mime_type = 'application/json'
    elif export_format == 'csv':
        with file_path.open('w', encoding='utf-8', newline='') as handle:
            writer = csv.DictWriter(handle, fieldnames=column_order)
            writer.writeheader()
            for row in rows:
                writer.writerow({key: safe_text(row.get(key)) for key in column_order})
        mime_type = 'text/csv'
    elif export_format == 'xlsx':
        openpyxl_module = load_openpyxl_module()
        if openpyxl_module is None:
            raise ApiError('collection_xlsx_runtime_unavailable', 409)
        workbook = openpyxl_module.Workbook()
        sheet = workbook.active
        sheet.title = 'collection'
        sheet.append(column_order)
        for row in rows:
            sheet.append([safe_text(row.get(key)) for key in column_order])
        workbook.save(file_path)
        mime_type = 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
    else:
        raise ApiError('collection_output_format_unsupported', 409)
    size_bytes = file_path.stat().st_size
    return {
        'kind': 'collection_artifact',
        'original_name': file_path.name,
        'stored_name': file_path.name,
        'relative_path': str(file_path.relative_to(DATA_DIR)),
        'local_path': str(file_path),
        'mime_type': mime_type,
        'size_bytes': size_bytes,
        'download_url': f"{API_PREFIX}/artifacts/collection/{urllib.parse.quote(file_path.name)}",
    }


def build_web_shortlist_rows(
    source_manifest: dict[str, Any] | None,
    skipped_sources: list[dict[str, str]] | None,
    *,
    limit: int = 8,
) -> list[dict[str, Any]]:
    if not source_manifest:
        return []
    manifest_query = safe_text(source_manifest.get('query'))
    manifest_items = source_manifest.get('items') or []
    skipped_by_url = {
        safe_text(item.get('source_url')): safe_text(item.get('error'))
        for item in (skipped_sources or [])
        if isinstance(item, dict) and safe_text(item.get('source_url'))
    }
    shortlist_rows: list[dict[str, Any]] = []
    for item in manifest_items[: min(limit, len(manifest_items))]:
        if isinstance(item, str):
            normalized_url = normalize_web_source_url(item)
            parsed = urllib.parse.urlparse(normalized_url)
            shortlist_rows.append({
                'record_type': 'source_shortlist',
                'source_status': 'unavailable',
                'requested_url': normalized_url,
                'source_url': normalized_url,
                'title': '',
                'domain': safe_text(parsed.netloc).lower(),
                'path': safe_text(parsed.path) or '/',
                'query': manifest_query,
                'source_rank': '',
                'availability_level': 'discovered_only',
                'snippet': '',
                'error_reason': safe_text(skipped_by_url.get(normalized_url) or 'document_unavailable'),
                'status': 'unavailable',
            })
            continue
        requested_url = normalize_web_source_url(item.get('requested_url') or item.get('url') or '')
        parsed = urllib.parse.urlparse(requested_url)
        shortlist_rows.append({
            'record_type': 'source_shortlist',
            'source_status': 'unavailable',
            'requested_url': requested_url,
            'source_url': requested_url,
            'title': safe_text(item.get('title') or ''),
            'snippet': safe_text(item.get('snippet') or item.get('meta_description') or ''),
            'domain': safe_text(item.get('domain') or parsed.netloc).lower(),
            'path': safe_text(item.get('path') or parsed.path) or '/',
            'query': safe_text(item.get('query') or manifest_query),
            'source_rank': safe_text(item.get('source_rank')),
            'availability_level': safe_text(item.get('availability_level') or ('snippet_only' if safe_text(item.get('snippet') or item.get('meta_description')) else 'discovered_only')),
            'error_reason': safe_text(skipped_by_url.get(requested_url) or item.get('error_reason') or 'document_unavailable'),
            'status': 'unavailable',
        })
    return shortlist_rows


def build_hybrid_collection_rows(
    contract: dict[str, Any],
    rows: list[dict[str, Any]],
    shortlist_rows: list[dict[str, Any]],
) -> tuple[list[dict[str, Any]], list[str]]:
    base_fields = list(contract.get('fields') or [])
