        })


def response_looks_like_file_limitation(reply_text: str) -> bool:
    lowered = safe_text(reply_text).lower()
    if not lowered:
        return False
    return any(marker in lowered for marker in MESSAGE_EXPORT_LIMITATION_REPLY_MARKERS)


def response_looks_like_tool_transcript(reply_text: str) -> bool:
    lowered = safe_text(reply_text).lower()
    if not lowered:
        return False
    return any(marker in lowered for marker in FILE_GENERATION_TRANSCRIPT_MARKERS)


def is_benign_repeated_response_line(line: str) -> bool:
    lowered = safe_text(line).strip().lower()
    if not lowered:
        return True
    if lowered in {'---', '***', '___'}:
        return True
    normalized = lowered.lstrip('*-•#> 0123456789.').strip()
    normalized = normalized.replace('*', '').replace('_', '').replace('`', '').strip()
    return normalized in {'что делаем:', 'результат:', 'ценность:', 'суть:'}


def response_looks_like_generic_llm_failure(reply_text: str) -> bool:
    lowered = safe_text(reply_text).lower()
    if not lowered:
        return False
    if any(marker in lowered for marker in GENERIC_LLM_BAD_REPLY_MARKERS):
        return True
    stripped_lines = [line.strip() for line in safe_text(reply_text).splitlines() if line.strip()]
    if len(stripped_lines) >= 8:
        previous_key = None
        consecutive_count = 0
        for line in stripped_lines:
            if is_benign_repeated_response_line(line):
                previous_key = None
                consecutive_count = 0
                continue
            key = line.lower()
            if key == previous_key:
                consecutive_count += 1
            else:
                previous_key = key
                consecutive_count = 1
            if consecutive_count >= 4:
                return True
    return False


def text_cyrillic_ratio(text: str) -> float:
    raw = safe_text(text)
    if not raw:
        return 0.0
    letters = [ch for ch in raw if ch.isalpha()]
    if not letters:
        return 0.0
    cyrillic = sum(1 for ch in letters if 'а' <= ch.lower() <= 'я' or ch.lower() == 'ё')
    return cyrillic / max(1, len(letters))


def reply_violates_expected_language(reply_text: str, profile: dict[str, Any]) -> bool:
    language = safe_text(profile.get("language") or "").lower()
    if language != "ru":
        return False
    lowered = safe_text(reply_text).lower()
    if not lowered:
        return False
    ratio = text_cyrillic_ratio(lowered)
    if ratio >= 0.55:
        return False
    foreign_markers = [
        "based on the",
        "here is the information",
        "uma resposta detalhada",
        "estruturada",
        "sem enrolação",
        "conclusão direta",
        "próximo passo",
    ]
    return any(marker in lowered for marker in foreign_markers) or ratio < 0.35


def ensure_llm_reply_is_publishable(reply_text: str, *, generated_file: bool = False) -> None:
    if generated_file and response_looks_like_tool_transcript(reply_text):
        raise ApiError("llm_generated_tool_transcript", 502)
    if response_looks_like_generic_llm_failure(reply_text):
        raise ApiError("llm_reply_blocked_by_postguard", 502)


def preferred_model_for_generated_file(request_policy: dict[str, Any] | None = None) -> str:
    preference = normalize_chat_model_preference((request_policy or {}).get("model_preference"))
    if preference == CHAT_MODEL_DEEPSEEK_R1:
        return HERMES_REASONING_MODEL
    return HERMES_API_MODEL


def build_generated_file_messages(message_rows: list[sqlite3.Row], profile: dict[str, Any], thread_title: str, user_text: str, request_policy: dict[str, Any] | None = None) -> list[dict[str, str]]:
    base_messages = build_hermes_messages(message_rows, profile, thread_title, request_policy)
    source_request = ""
    source_answer = ""
    for row in reversed(message_rows):
        if not source_answer and row["role"] == "assistant":
            meta = json_loads(row["meta_json"], {}) if "meta_json" in row.keys() else {}
            message_kind = safe_text(meta.get("message_kind")).lower()
            if message_kind not in {"processing_status", "file_response", "clarification_request"}:
                candidate = build_message_display_text(safe_text(row["content"]))
                if candidate:
                    source_answer = candidate
        if not source_request and row["role"] == "user":
            row_meta = json_loads(row["meta_json"], {}) if "meta_json" in row.keys() else {}
            candidate = safe_text(row_meta.get("user_text") or row["content"]).strip()
            if candidate and candidate.strip().lower() != safe_text(user_text).strip().lower():
                source_request = candidate
        if source_request and source_answer:
            break
    context_block = (
        f"Исходный содержательный запрос пользователя:\n{source_request or '—'}\n\n"
        f"Опорный содержательный материал из диалога:\n{source_answer or '—'}"
    )
    instruction = (
        "Подготовь только финальное содержимое документа по последнему запросу пользователя. "
        "Это режим generate-and-attach-file: нужен сам текст документа, который потом будет упакован backend в файл. "
        "Пиши строго на русском языке, если пользователь явно не просил другой язык. "
        "Опирайся на суть обсуждения и опорный содержательный материал, а не только на последнюю короткую форматную реплику. "
        "Если пользователь просит по слайдам, по страницам или по таблицам — верни именно содержимое в этой структуре. "
        "Если пользователь просит документ или презентацию, не объясняй, что файл будет создан позже, и не пиши служебную отписку про то, что ты якобы всё сохранила. "
        "Не описывай инструменты, не вставляй tool_code, XML, JSON, Markdown-ограждения, служебные теги, логи, ошибки, apology-текст или объяснения про создание файла. "
        "Не пиши, что ты что-то сейчас создашь, перезапустишь или повторишь. Верни только готовый содержательный текст документа на языке запроса пользователя."
    )
    return [
        *base_messages,
        {"role": "user", "content": f"{instruction}\n\n{context_block}\n\nПоследний запрос пользователя:\n{safe_text(user_text)}"},
    ]


def call_generated_file_content(message_rows: list[sqlite3.Row], profile: dict[str, Any], thread_title: str, user_text: str, request_policy: dict[str, Any] | None = None) -> tuple[str, dict[str, Any]]:
    reply_text, meta = call_hermes_messages(
        build_generated_file_messages(message_rows, profile, thread_title, user_text, request_policy),
        model_name=preferred_model_for_generated_file(request_policy),
    )
    if response_looks_like_file_limitation(reply_text) or response_looks_like_tool_transcript(reply_text):
        raise ApiError("message_export_unfulfilled_by_model", 502)
    return reply_text, meta


def enforce_russian_retry(messages: list[dict[str, str]], reply_text: str, meta: dict[str, Any], profile: dict[str, Any], *, model_name: str) -> tuple[str, dict[str, Any]]:
    if not reply_violates_expected_language(reply_text, profile):
        return reply_text, meta
    retry_messages = [
        *messages,
        {
            "role": "system",
            "content": (
                "Критично: предыдущий ответ ушёл не на русском языке. "
                "Повтори ответ строго на русском, женским родом, без английских и португальских фрагментов, "
                "кроме неизбежных технических терминов, команд, URL и названий продуктов."
            ),
        },
    ]
    retried_text, retried_meta = call_hermes_messages(retry_messages, model_name=model_name)
    retried_meta = dict(retried_meta or {})
    retried_meta["language_retry"] = True
    retried_meta["language_retry_reason"] = "non_russian_output"
    if reply_violates_expected_language(retried_text, profile):
        raise ApiError("llm_reply_language_guard_failed", 502)
    return retried_text, retried_meta


def process_chat_task(task_id: int) -> bool:
    with _running_chat_tasks_lock:
        if task_id in _running_chat_tasks:
            return False
        _running_chat_tasks.add(task_id)
    try:
        with db_connect() as conn:
            task = conn.execute("SELECT * FROM chat_tasks WHERE id = ?", (task_id,)).fetchone()
            if not task:
                return False
            if task["status"] not in {"running", "pending"}:
                return False
            if task["status"] == "pending":
                task = conn.execute(
                    "UPDATE chat_tasks SET status = 'running', started_at = ?, last_error = '' WHERE id = ? AND status = 'pending' RETURNING *",
                    (now_iso(), task_id),
                ).fetchone() or task
            thread = conn.execute("SELECT * FROM threads WHERE id = ?", (task["thread_id"],)).fetchone()
            user_row = conn.execute("SELECT * FROM users WHERE id = ?", (task["user_id"],)).fetchone()
            if not thread or not user_row:
                raise ApiError("chat_task_context_missing", 404)
            profile = user_to_dict(user_row, conn)
            message_rows = conn.execute(
                "SELECT * FROM messages WHERE thread_id = ? AND id <> ? ORDER BY id ASC",
                (task["thread_id"], task["assistant_message_id"]),
            ).fetchall()
            user_message = conn.execute("SELECT * FROM messages WHERE id = ?", (task["user_message_id"],)).fetchone()
            attachments = json_loads(user_message["meta_json"], {}).get("attachments") or [] if user_message else []
            request_policy = json_loads(task["request_policy_json"], {})
            user_text = json_loads(user_message["meta_json"], {}).get("user_text") or (user_message["content"] if user_message else "")
            effective_user_text = infer_clarification_followup_request_text(message_rows, int(task["user_message_id"]), user_text)
            effective_user_text = infer_generated_file_followup_request_text(message_rows, int(task["user_message_id"]), effective_user_text)
            dashboard_request_text = infer_dashboard_followup_request_text(message_rows, int(task["user_message_id"]), effective_user_text)
            effective_collection_text = dashboard_request_text or effective_user_text
            effective_collection_text = infer_collection_followup_request_text(message_rows, int(task["user_message_id"]), effective_collection_text)
            requested_export_format = detect_message_export_format(effective_user_text)
            generate_and_attach_file = bool(requested_export_format and is_generate_and_attach_file_request(effective_user_text))
            recurring_route_priority = should_prioritize_recurring_job_route(message_rows, int(task["user_message_id"]), user_text)
            transformed_dashboard_reply = maybe_build_dashboard_from_previous_answer(message_rows, user_text)
            recurring_job_reply = maybe_create_recurring_job_from_chat(conn, task, user_row, message_rows, user_text) if recurring_route_priority else None
            collection_reply = None if transformed_dashboard_reply is not None or recurring_job_reply is not None else build_collection_clarification_or_contract_reply(effective_collection_text, attachments)
            export_reply = None if transformed_dashboard_reply is not None or collection_reply is not None else maybe_build_export_reply(message_rows, effective_user_text, thread["title"])
            collection_execution_reply = None
            if collection_reply is not None:
                collection_execution_reply = maybe_execute_collection_request(conn, task, user_row, message_rows, effective_collection_text, attachments)
            dashboard_reply = transformed_dashboard_reply if transformed_dashboard_reply is not None else (None if collection_reply is not None or collection_execution_reply is not None or export_reply is not None or recurring_job_reply is not None else maybe_build_dashboard_reply(conn, dashboard_request_text, attachments, request_policy))
            if recurring_job_reply is None:
                recurring_job_reply = None if collection_reply is not None or collection_execution_reply is not None or export_reply is not None or dashboard_reply is not None else maybe_create_recurring_job_from_chat(conn, task, user_row, message_rows, user_text)
        if collection_execution_reply is not None:
            reply_text, meta = collection_execution_reply
            meta.update({
                "personalization_used": False,
                "thread_title": thread["title"],
                "personalization_preview": "data-collection-execution-route",
            })
        elif collection_reply is not None:
            reply_text, meta = collection_reply
            meta.update({
                "personalization_used": False,
                "thread_title": thread["title"],
                "personalization_preview": "data-collection-contract-route",
            })
        elif export_reply is not None:
            reply_text, meta = export_reply
            meta.update({
                "personalization_used": False,
                "thread_title": thread["title"],
                "personalization_preview": "message-export-route",
            })
        elif dashboard_reply is not None:
            reply_text, meta = dashboard_reply
            meta.update({
                "personalization_used": False,
                "thread_title": thread["title"],
                "personalization_preview": "dashboard-route",
            })
        elif recurring_job_reply is not None:
            reply_text, meta = recurring_job_reply
            meta.update({
                "personalization_used": False,
                "thread_title": thread["title"],
                "personalization_preview": "chat-recurring-job-route",
            })
        else:
            if generate_and_attach_file and requested_export_format:
                reply_text, meta = call_generated_file_content(message_rows, profile, thread["title"], effective_user_text, request_policy)
            else:
                reply_text, meta = call_hermes_api(message_rows, profile, thread["title"], request_policy)
            ensure_llm_reply_is_publishable(reply_text, generated_file=bool(generate_and_attach_file and requested_export_format))
            if requested_export_format and response_looks_like_file_limitation(reply_text):
                raise ApiError("message_export_unfulfilled_by_model", 502)
            if generate_and_attach_file and requested_export_format:
                finished_at = now_iso()
                reply_text, meta = build_generated_file_reply(
                    assistant_message_id=int(task["assistant_message_id"]),
                    reply_text=reply_text,
                    reply_meta=meta,
                    thread_title=thread["title"],
                    export_format=requested_export_format,
                    created_at=finished_at,
                )
        with db_connect() as conn:
            if attachments and isinstance(meta, dict) and not meta.get("used_files"):
                meta["used_files"] = build_used_files_payload(attachments)
                meta["used_file_ids"] = [item.get("source_file_id") for item in meta["used_files"] if item.get("source_file_id") is not None]
            reply_text = postprocess_assistant_reply(user_text, reply_text, meta)
            reply_text, meta = enrich_assistant_meta(meta, reply_text, message_id=int(task["assistant_message_id"]))
            meta = attach_assistant_token_accounting(meta, reply_text)
            meta.update({
                "pending": False,
                "processing_status": "completed",
                "task_id": task_id,
                "status_label": "Готово",
            })
            finished_at = now_iso()
            conn.execute(
                "UPDATE messages SET content = ?, created_at = ?, meta_json = ? WHERE id = ?",
                (reply_text, finished_at, json.dumps(meta, ensure_ascii=False), task["assistant_message_id"]),
            )
            preview_source = user_text or (attachments[0]["original_name"] if attachments else "Сообщение")
            conn.execute("UPDATE threads SET preview = ?, updated_at = ? WHERE id = ?", (preview_source[:140], finished_at, task["thread_id"]))
            conn.execute(
                "UPDATE chat_tasks SET status = 'completed', finished_at = ?, last_error = '' WHERE id = ?",
                (finished_at, task_id),
            )
            maybe_log_degraded_chat_task_result(task, meta, reply_text)
        return True
    except Exception as exc:
        finalize_chat_task_error(task_id, int(task["assistant_message_id"]) if 'task' in locals() and task else 0, str(exc))
        return False
    finally:
        with _running_chat_tasks_lock:
            _running_chat_tasks.discard(task_id)


def process_pending_chat_tasks_once(max_tasks: int | None = None) -> int:
    claimed = claim_pending_chat_tasks(max_tasks=max_tasks)
    processed = 0
    for row in claimed:
        if process_chat_task(int(row["id"])):
            processed += 1
    return processed


def active_chat_task_slots() -> int:
    with _running_chat_tasks_lock:
        running = len(_running_chat_tasks)
    return max(0, CHAT_PROCESSOR_MAX_CONCURRENCY - running)


def dispatch_chat_task_now(task_id: int) -> bool:
    with _running_chat_tasks_lock:
        if task_id in _running_chat_tasks:
            return False
    with db_connect() as conn:
        task_row = conn.execute(
            "UPDATE chat_tasks SET status = 'running', started_at = COALESCE(started_at, ?), last_error = '' WHERE id = ? AND status = 'pending' RETURNING id",
            (now_iso(), task_id),
