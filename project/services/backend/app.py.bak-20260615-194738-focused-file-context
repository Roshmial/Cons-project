def normalize_dashboard_section_item(kind: str, item: Any) -> Any:
    if kind == "text_list":
        if isinstance(item, str):
            return item.strip()
        if isinstance(item, dict):
            text = safe_text(item.get("text") or item.get("label") or item.get("value") or item.get("title"))
            if not text:
                return None
            normalized = {"text": text}
            meta = safe_text(item.get("meta"))
            if meta:
                normalized["meta"] = meta
            return normalized
        value = safe_text(item)
        return value or None
    if kind == "post_list":
        if not isinstance(item, dict):
            title = safe_text(item)
            return {"title": title} if title else None
        title = safe_text(item.get("title") or item.get("label") or item.get("text") or item.get("value"))
        if not title:
            return None
        normalized = {"title": title}
        for key in ("subtitle", "meta", "url", "value"):
            value = safe_text(item.get(key))
            if value:
                normalized[key] = value
        return normalized
    if kind == "timeline_list":
        if not isinstance(item, dict):
            label = safe_text(item)
            return {"label": label} if label else None
        label = safe_text(item.get("label") or item.get("title") or item.get("date") or item.get("period") or item.get("text"))
        if not label:
            return None
        normalized = {"label": label}
        value = safe_text(item.get("value") or item.get("text") or item.get("summary"))
        if value:
            normalized["value"] = value
        meta = safe_text(item.get("meta") or item.get("date") or item.get("period"))
        if meta and meta != label:
            normalized["meta"] = meta
        return normalized
    if kind == "matrix_list":
        if not isinstance(item, dict):
            label = safe_text(item)
            return {"label": label, "value": "—"} if label else None
        label = safe_text(item.get("label") or item.get("row") or item.get("title") or item.get("segment"))
        value = safe_text(item.get("value") or item.get("summary") or item.get("column") or item.get("score"))
        if not label and not value:
            return None
        normalized = {"label": label or "Параметр", "value": value or "—"}
        meta = safe_text(item.get("meta"))
        if meta:
            normalized["meta"] = meta
        return normalized
    if not isinstance(item, dict):
        label = safe_text(item)
        if not label:
            return None
        return {"label": label, "value": label, "ratio": 0}
    label = safe_text(item.get("label") or item.get("title") or item.get("name") or item.get("text"))
    value = item.get("value")
    ratio_raw = item.get("ratio")
    try:
        ratio = float(ratio_raw) if ratio_raw is not None and ratio_raw != "" else 0.0
    except (TypeError, ValueError):
        ratio = 0.0
    normalized = {
        "label": label or "Пункт",
        "value": value if value not in (None, "") else safe_text(item.get("count") or item.get("share") or item.get("score") or "—"),
        "ratio": max(0.0, ratio),
    }
    meta = safe_text(item.get("meta"))
    if meta:
        normalized["meta"] = meta
    return normalized


def normalize_dashboard_section(section: Any, index: int) -> dict[str, Any] | None:
    if not isinstance(section, dict):
        text = safe_text(section)
        if not text:
            return None
        return {
            "kind": "text_list",
            "title": f"Блок {index + 1}",
            "items": [text],
        }
    kind = safe_text(section.get("kind") or "text_list")
    if kind not in EXTERNAL_DASHBOARD_ALLOWED_SECTION_KINDS:
        kind = "text_list"
    items = []
    for item in section.get("items") or []:
        normalized_item = normalize_dashboard_section_item(kind, item)
        if normalized_item not in (None, "", [], {}):
            items.append(normalized_item)
    if not items:
        return None
    normalized_section = {
        "kind": kind,
        "title": safe_text(section.get("title") or section.get("label") or f"Блок {index + 1}"),
        "items": items,
    }
    note = safe_text(section.get("note"))
    if note:
        normalized_section["note"] = note
    return normalized_section


def parse_ratio_like_value(value: Any) -> float | None:
    if value in (None, ""):
        return None
    if isinstance(value, (int, float)):
        numeric = float(value)
    else:
        text = safe_text(value).replace(",", ".")
        if not text:
            return None
        percent = text.endswith("%")
        if percent:
            text = text[:-1].strip()
        try:
            numeric = float(text)
        except (TypeError, ValueError):
            return None
        if percent:
            numeric /= 100.0
    if numeric > 1.0 and numeric <= 100.0:
        numeric /= 100.0
    if numeric < 0:
        return None
    return min(numeric, 1.0)


def build_share_visual_section(normalized_sections: list[dict[str, Any]]) -> dict[str, Any] | None:
    for section in normalized_sections:
        if section.get("kind") != "bar_list":
            continue
        items = section.get("items") or []
        if len(items) < 3 or len(items) > 8:
            continue
        ratios = [parse_ratio_like_value(item.get("ratio", item.get("value"))) for item in items if isinstance(item, dict)]
        if len(ratios) != len(items) or any(ratio is None for ratio in ratios):
            continue
        total = sum(ratio for ratio in ratios if ratio is not None)
        if not (0.85 <= total <= 1.15):
            continue
        return {
            "kind": "pie_list",
            "title": section.get("title") or "Структура долей",
            "note": section.get("note") or "Доли рынка удобнее считывать как состав целого.",
            "items": [
                {
                    "label": item.get("label") or f"Сегмент {index + 1}",
                    "value": item.get("value") or f"{round((ratios[index] or 0) * 100)}%",
                    "ratio": ratios[index] or 0.0,
                    **({"meta": item.get("meta")} if item.get("meta") else {}),
                }
                for index, item in enumerate(items)
            ],
        }
    return None


def build_factor_visual_sections(normalized_sections: list[dict[str, Any]]) -> list[dict[str, Any]]:
    visuals: list[dict[str, Any]] = []
    for section in normalized_sections:
        title = safe_text(section.get("title")).lower()
        note = safe_text(section.get("note")).lower()
        if "фактор" not in title and "factor" not in title and "фактор" not in note:
            continue
        items = section.get("items") or []
        normalized_items = []
        for index, item in enumerate(items):
            if isinstance(item, dict):
                label = safe_text(item.get("label") or item.get("text") or item.get("title") or item.get("value"))
                ratio = parse_ratio_like_value(item.get("ratio", item.get("meta")))
                meta = safe_text(item.get("meta"))
            else:
                label = safe_text(item)
                ratio = None
                meta = ""
            if not label or ratio is None:
                continue
            normalized_items.append({
                "label": label,
                "value": f"{round(ratio * 100)}%",
                "ratio": ratio,
                **({"meta": meta} if meta else {}),
            })
        if len(normalized_items) < 2:
            continue
        visuals.append({
            "kind": "bar_list",
            "title": section.get("title") or "Факторный анализ",
            "note": "Важность факторов показана визуально, а не только списком.",
            "items": normalized_items,
        })
    return visuals


def prioritize_dashboard_sections(
    normalized_sections: list[dict[str, Any]],
    blueprint: dict[str, Any],
    user_text: str,
) -> list[dict[str, Any]]:
    sections = list(normalized_sections)
    existing_signatures = {
        (section.get("kind"), safe_text(section.get("title")).strip().lower())
        for section in sections
    }

    share_visual = build_share_visual_section(sections)
    if share_visual is not None:
        signature = (share_visual.get("kind"), safe_text(share_visual.get("title")).strip().lower())
        if signature not in existing_signatures:
            sections.insert(0, share_visual)
            existing_signatures.add(signature)

    factor_visuals = build_factor_visual_sections(sections)
    insert_offset = 1 if share_visual is not None else 0
    for visual in factor_visuals:
        signature = (visual.get("kind"), safe_text(visual.get("title")).strip().lower())
        if signature in existing_signatures:
            continue
        sections.insert(insert_offset, visual)
        insert_offset += 1
        existing_signatures.add(signature)

    priority_order = {kind: index for index, kind in enumerate(blueprint.get("priority_blocks") or [])}
    weighted_sections = []
    for index, section in enumerate(sections):
        kind = section.get("kind") or "text_list"
        title = safe_text(section.get("title")).lower()
        bonus = 0
        if kind == "pie_list" and any(token in safe_text(user_text).lower() for token in ["дол", "структур", "распредел", "share"]):
            bonus -= 20
        if "фактор" in title and kind in {"bar_list", "bubble_list", "pie_list"}:
            bonus -= 15
        weighted_sections.append((priority_order.get(kind, 999) + bonus, index, section))
    weighted_sections.sort(key=lambda item: (item[0], item[1]))
    return [section for _, _, section in weighted_sections]


def normalize_external_dashboard_payload(
    dashboard: dict[str, Any],
    reply_text: str,
    source_meta: dict[str, Any],
    policy: dict[str, Any],
    user_text: str,
) -> dict[str, Any]:
    intent = infer_external_dashboard_intent(user_text)
    blueprint = build_external_dashboard_blueprint(intent)
    normalized_sections = []
    for index, section in enumerate(dashboard.get("sections") or []):
        normalized = normalize_dashboard_section(section, index)
        if normalized is not None:
            normalized_sections.append(normalized)
    normalized_sections = prioritize_dashboard_sections(normalized_sections, blueprint, user_text)
    if len(normalized_sections) < blueprint["minimum_sections"]:
        if not normalized_sections:
            normalized_sections.append({
                "kind": "text_list",
                "title": "Что удалось установить",
                "note": "Собрано из текущего ответа backend-маршрута",
                "items": [reply_text or "Структурированный ответ получен, но модель не вернула развернутые секции."],
            })
        normalized_sections.append({
            "kind": "text_list",
            "title": "Ограничения и оговорки",
            "items": [
                {"text": "Если точных чисел или локальных источников недостаточно, выводы остаются ориентировочными.", "meta": f"Режим: {safe_text(policy.get('source_mode') or DASHBOARD_SOURCE_MODE_LOCAL_FIRST)}"},
            ],
        })
    existing_kinds = {section["kind"] for section in normalized_sections}
    for visual_kind in blueprint["visual_sections"]:
        if visual_kind in existing_kinds:
            continue
        if visual_kind == "timeline_list":
            normalized_sections.append({
                "kind": "timeline_list",
                "title": "Ключевые сигналы по ходу сюжета",
                "note": "Fallback-секция, если модель не вернула отдельную динамику",
                "items": [{"label": "Сейчас", "value": reply_text or "Нужен дополнительный сбор данных для полноценной динамики."}],
            })
        elif visual_kind == "matrix_list":
            normalized_sections.append({
                "kind": "matrix_list",
                "title": "Карта сегментов",
                "note": "Fallback-секция, если исходный ответ не разложил тему по сегментам",
                "items": [{"label": "Текущий фокус", "value": safe_text(user_text)[:120] or "Запрос пользователя"}],
            })
        else:
            normalized_sections.append({
                "kind": visual_kind,
                "title": "Минимальная визуализация",
                "note": "Fallback-секция: backend сохранил визуальный каркас, даже если модель вернула мало структуры",
                "items": [{"label": safe_text(source_meta.get("label") or "Источник"), "value": safe_text(policy.get("source_mode") or DASHBOARD_SOURCE_MODE_LOCAL_FIRST), "ratio": 1.0, "meta": "Нужен дополнительный сбор данных для richer view"}],
            })
    summary_cards = []
    for card in dashboard.get("summary_cards") or []:
        if not isinstance(card, dict):
            continue
        label = safe_text(card.get("label"))
        value = safe_text(card.get("value"))
        if not label or not value:
            continue
        normalized_card = {"label": label, "value": value}
        note = safe_text(card.get("note"))
        if note:
            normalized_card["note"] = note
        summary_cards.append(normalized_card)
    if not summary_cards:
        summary_cards = [
            {"label": "Режим", "value": safe_text(policy.get("source_mode") or DASHBOARD_SOURCE_MODE_LOCAL_FIRST), "note": "Определяет приоритет источников"},
            {"label": "Тип задачи", "value": intent, "note": blueprint["goal"]},
            {"label": "Источник", "value": safe_text(source_meta.get("label") or source_meta.get("item_key") or "external")},
        ]
    normalized_sources = []
    for source in dashboard.get("sources") or []:
        if not isinstance(source, dict):
            continue
        label = safe_text(source.get("label") or source.get("title") or source.get("url"))
        url = safe_text(source.get("url"))
        if not label and not url:
            continue
        normalized_source = {}
        if label:
            normalized_source["label"] = label
        if url:
            normalized_source["url"] = url
        normalized_sources.append(normalized_source)
    if not normalized_sources:
        source_label = safe_text(source_meta.get("label") or source_meta.get("item_key") or "Внешний источник")
        normalized_sources.append({"label": source_label})
    return {
        "kind": safe_text(dashboard.get("kind") or "external_research_dashboard"),
        "grammar_version": EXTERNAL_DASHBOARD_GRAMMAR_VERSION,
        "intent": intent,
        "selection_policy": {
            "goal": blueprint["goal"],
            "priority_blocks": blueprint["priority_blocks"],
            "minimum_sections": blueprint["minimum_sections"],
        },
        "title": safe_text(dashboard.get("title") or source_meta.get("label") or "Внешний дашборд"),
        "subtitle": safe_text(dashboard.get("subtitle") or f"Adaptive grammar v1 · {blueprint['goal']}"),
        "summary_cards": summary_cards,
        "sections": normalized_sections,
        "sources": normalized_sources,
        "notes": safe_text(dashboard.get("notes") or ""),
    }


