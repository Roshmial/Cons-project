@app.patch(f"{API_PREFIX}/me")
def patch_me() -> Response:
    auth = require_auth()
    payload = request.get_json(force=True, silent=True) or {}
    editable = {
        "name": "name",
        "timezone": "timezone",
        "language": "language",
        "team": "team",
        "title": "title",
        "goals": "goals",
        "style": "style",
        "constraints": "constraints_text",
    }
    updates = []
    values: list[Any] = []
    pending_assistant_profile_payload = payload.get("assistant_profile") if isinstance(payload.get("assistant_profile"), dict) else None
    for api_key, db_key in editable.items():
        if api_key in payload:
            updates.append(f"{db_key} = ?")
            if api_key == "timezone":
                values.append(normalize_timezone(payload.get(api_key), "UTC"))
            else:
                values.append(safe_text(payload.get(api_key)))
    if "pinned" in payload:
        pinned = [safe_text(item) for item in (payload.get("pinned") or []) if safe_text(item)]
        updates.append("pinned_json = ?")
        values.append(json.dumps(pinned, ensure_ascii=False))
    if "onboarding_completed" in payload:
        updates.append("onboarding_completed = ?")
        values.append(1 if payload.get("onboarding_completed") else 0)
    if not updates and pending_assistant_profile_payload is None:
        raise ApiError("nothing_to_update", 400)
    with db_connect() as conn:
        existing_row = conn.execute("SELECT * FROM users WHERE id = ?", (auth.id,)).fetchone()
        if not existing_row:
            raise ApiError("user_not_found", 404)
        expected_version = payload.get("version")
        current_version = int(existing_row["version"] or 1)
        if expected_version is not None and int(expected_version) != current_version:
            raise ApiError("version_conflict", 409)
        effective_style = safe_text(payload.get("style") or existing_row["style"])
        if pending_assistant_profile_payload is not None:
            current_profile = assistant_profile_from_row(existing_row, conn)
            pending_assistant_profile = {
                "tone": safe_text(pending_assistant_profile_payload.get("tone") or current_profile["tone"]),
                "answer_depth": safe_text(pending_assistant_profile_payload.get("answer_depth") or current_profile["answer_depth"]),
                "interaction_mode": safe_text(pending_assistant_profile_payload.get("interaction_mode") or current_profile["interaction_mode"]),
                "about_user": safe_text(pending_assistant_profile_payload.get("about_user") or current_profile["about_user"]),
            }
            normalized_profile = validate_assistant_profile(conn, pending_assistant_profile, effective_style)
            updates.append("assistant_profile_json = ?")
            values.append(json.dumps(normalized_profile, ensure_ascii=False))
        next_version = current_version + 1
        updates.append("version = ?")
        values.append(next_version)
        values.extend([now_iso(), auth.id, current_version])
        updated = conn.execute(f"UPDATE users SET {', '.join(updates)}, updated_at = ? WHERE id = ? AND version = ? RETURNING id", values).fetchone()
        if not updated:
            raise ApiError("version_conflict", 409)
        write_user_change_log(conn, auth.id, auth.id, "self_update")
        row = conn.execute("SELECT * FROM users WHERE id = ?", (auth.id,)).fetchone()
        profile = user_to_dict(row, conn)
    return jsonify({"user": profile, "profile_summary": build_profile_summary(profile), "personalization": build_personalization_block(profile)})


