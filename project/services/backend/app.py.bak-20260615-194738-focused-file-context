def default_assistant_profile(style: str = "") -> dict[str, str]:
    style_text = (style or "").lower()
    depth = "balanced"
    if "крат" in style_text:
        depth = "short"
    elif "подроб" in style_text:
        depth = "detailed"
    mode = "compare_options" if "вариант" in style_text else "clarify_when_needed"
    tone = "business" if "дел" in style_text or "точ" in style_text else "friendly"
    return {
        "tone": tone,
        "answer_depth": depth,
        "interaction_mode": mode,
        "about_user": "",
    }


def backfill_profiles(conn: sqlite3.Connection) -> None:
    rows = conn.execute("SELECT id, style, assistant_profile_json FROM users").fetchall()
    for row in rows:
        if row["assistant_profile_json"] and row["assistant_profile_json"] != "{}":
            continue
        conn.execute(
            "UPDATE users SET assistant_profile_json = ?, onboarding_completed = COALESCE(onboarding_completed, 0) WHERE id = ?",
            (json.dumps(default_assistant_profile(row["style"]), ensure_ascii=False), row["id"]),
        )


def dedupe_job_threads(conn: sqlite3.Connection) -> None:
    duplicate_groups = conn.execute(
        """
        SELECT user_id, job_id, MIN(id) AS keep_id
        FROM threads
        WHERE job_id IS NOT NULL
        GROUP BY user_id, job_id
        HAVING COUNT(*) > 1
        """
    ).fetchall()
    for group in duplicate_groups:
        keep_id = int(group["keep_id"])
        duplicate_rows = conn.execute(
            "SELECT id FROM threads WHERE user_id = ? AND job_id = ? AND id <> ? ORDER BY id ASC",
            (group["user_id"], group["job_id"], keep_id),
        ).fetchall()
        for row in duplicate_rows:
            thread_id = int(row["id"])
            conn.execute("DELETE FROM user_files WHERE thread_id = ?", (thread_id,))
            conn.execute("DELETE FROM feedback WHERE message_id IN (SELECT id FROM messages WHERE thread_id = ?)", (thread_id,))
            conn.execute("DELETE FROM messages WHERE thread_id = ?", (thread_id,))
            conn.execute("DELETE FROM threads WHERE id = ?", (thread_id,))


