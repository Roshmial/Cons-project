                parameters_json = ?, self_subscribe_enabled = ?, self_subscribe_scope = ?, version = ?, next_run_at = ?, updated_at = ?
            WHERE id = ? AND version = ?
            RETURNING id
            """,
            (
                normalized["name"],
                normalized["display_name"],
                normalized["description"],
                normalized["job_type"],
                normalized["visibility"],
                normalized["status"],
                normalized["schedule_kind"],
