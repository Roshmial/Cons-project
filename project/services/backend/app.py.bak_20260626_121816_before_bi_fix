def latest_substantive_assistant_message_text(message_rows: list[sqlite3.Row]) -> str:
    for row in reversed(message_rows):
        if row["role"] != "assistant":
            continue
        content = safe_text(row["content"]).strip()
        if not content:
            continue
        lowered = content.lower()
        if lowered in {"готовлю ответ…", "готовлю ответ..."}:
            continue
        if lowered.startswith("не удалось получить ответ") or lowered.startswith("не удалось сформировать файл"):
