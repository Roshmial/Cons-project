def now_utc() -> datetime:
    return datetime.now(UTC)


def now_iso(value: datetime | None = None) -> str:
    current = value or now_utc()
    return current.astimezone(UTC).replace(microsecond=0).isoformat()


def parse_iso(value: str | None) -> datetime | None:
    if not value:
        return None
    normalized = value.replace("Z", "+00:00")
    try:
        dt = datetime.fromisoformat(normalized)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=UTC)
    return dt.astimezone(UTC)


def session_expires_at(last_seen_at: str | None) -> datetime | None:
    seen_at = parse_iso(last_seen_at)
    if not seen_at:
        return None
    return seen_at + SESSION_TTL


def should_touch_session(last_seen_at: str | None, *, now: datetime | None = None) -> bool:
    seen_at = parse_iso(last_seen_at)
    if not seen_at:
        return True
    current = now or now_utc()
    return (current - seen_at).total_seconds() >= SESSION_TOUCH_INTERVAL_SECONDS


def parse_date(value: str | None) -> date | None:
    if not value:
        return None
    try:
        return date.fromisoformat(value)
    except ValueError:
        return None


def normalize_time_of_day(value: str | None, fallback: str = "09:00") -> str:
    raw = (value or fallback).strip()
    parts = raw.split(":")
    if len(parts) != 2:
        return fallback
    try:
        hours = int(parts[0])
        minutes = int(parts[1])
    except ValueError:
        return fallback
    if not (0 <= hours <= 23 and 0 <= minutes <= 59):
        return fallback
    return f"{hours:02d}:{minutes:02d}"


def normalize_timezone(value: str | None, fallback: str = "UTC") -> str:
    candidate = (value or fallback).strip() or fallback
    try:
        ZoneInfo(candidate)
        return candidate
    except Exception:
        return fallback


def json_loads(value: str | None, fallback: Any) -> Any:
    if not value:
        return fallback
    try:
        parsed = json.loads(value)
    except json.JSONDecodeError:
        return fallback
    if isinstance(parsed, str):
        nested = parsed.strip()
        if nested.startswith('{') or nested.startswith('['):
            try:
                return json.loads(nested)
            except json.JSONDecodeError:
                return parsed
    return parsed


class DBRow(dict):
    def __getitem__(self, key):
        if isinstance(key, int):
            return list(self.values())[key]
        return super().__getitem__(key)


class DBCursor:
    def __init__(self, result: Any | None = None, lastrowid: int | None = None):
        self._result = result
        self.lastrowid = lastrowid

    def _columns(self) -> list[str]:
        if self._result is None or not getattr(self._result, 'description', None):
            return []
        return [item[0] for item in self._result.description]

    def fetchone(self):
        if self._result is None:
            return None
        row = self._result.fetchone()
        if row is None:
            return None
        columns = self._columns()
        if columns:
            return DBRow(zip(columns, row))
        return row

    def fetchall(self):
        if self._result is None:
            return []
        rows = self._result.fetchall()
        columns = self._columns()
        if columns:
            return [DBRow(zip(columns, row)) for row in rows]
        return rows


def _translate_qmark_to_pyformat(query: str) -> str:
    parts: list[str] = []
    in_single = False
    in_double = False
    i = 0
    while i < len(query):
        char = query[i]
        if char == "'" and not in_double:
            parts.append(char)
            if in_single and i + 1 < len(query) and query[i + 1] == "'":
                parts.append(query[i + 1])
                i += 2
                continue
            in_single = not in_single
            i += 1
            continue
        if char == '"' and not in_single:
            parts.append(char)
            if in_double and i + 1 < len(query) and query[i + 1] == '"':
                parts.append(query[i + 1])
                i += 2
                continue
            in_double = not in_double
            i += 1
            continue
        if char == '?' and not in_single and not in_double:
            parts.append('%s')
        else:
            parts.append(char)
        i += 1
    return ''.join(parts)


def _split_sql_script(script: str) -> list[str]:
    statements: list[str] = []
    current: list[str] = []
    in_single = False
    in_double = False
    i = 0
    while i < len(script):
        char = script[i]
        current.append(char)
        if char == "'" and not in_double:
            if in_single and i + 1 < len(script) and script[i + 1] == "'":
                current.append(script[i + 1])
                i += 2
                continue
            in_single = not in_single
        elif char == '"' and not in_single:
            if in_double and i + 1 < len(script) and script[i + 1] == '"':
                current.append(script[i + 1])
                i += 2
                continue
            in_double = not in_double
        elif char == ';' and not in_single and not in_double:
            statement = ''.join(current).strip()
            if statement:
                statements.append(statement)
            current = []
        i += 1
    tail = ''.join(current).strip()
    if tail:
        statements.append(tail)
    return statements


class DBConnection:
    def __init__(self, path: Path | None = None, dsn: str | None = None):
        last_error: Exception | None = None
        self._conn = None
        self.driver = DB_DRIVER
        self._path = path or DB_PATH
        self._dsn = dsn or DB_DSN
        for attempt in range(DB_CONNECT_RETRY_ATTEMPTS):
            conn = None
            try:
                if self.driver == 'postgres':
                    if psycopg is None:
                        raise RuntimeError('psycopg is required for postgres backend')
                    conn = psycopg.connect(self._dsn, autocommit=False)
                    with conn.cursor() as cur:
                        cur.execute(f"CREATE SCHEMA IF NOT EXISTS {APP_DB_SCHEMA}")
                        cur.execute(f"SET search_path TO {APP_DB_SCHEMA}")
                else:
                    conn = duckdb.connect(str(self._path))
                    global _duckdb_schema_initialized
                    if not _duckdb_schema_initialized:
                        with _duckdb_schema_init_lock:
                            if not _duckdb_schema_initialized:
                                conn.execute(f"CREATE SCHEMA IF NOT EXISTS {APP_DB_SCHEMA}")
                                _duckdb_schema_initialized = True
                    conn.execute(f"SET schema='{APP_DB_SCHEMA}'")
                self._conn = conn
                last_error = None
                break
            except Exception as exc:
                last_error = exc
                try:
                    if conn is not None:
                        conn.close()
                except Exception:
                    pass
                if attempt == DB_CONNECT_RETRY_ATTEMPTS - 1:
                    break
                time.sleep(DB_CONNECT_RETRY_DELAY_SECONDS * (attempt + 1))
        if self._conn is None:
            assert last_error is not None
            raise last_error

    def execute(self, query: str, params: tuple[Any, ...] | list[Any] | None = None) -> DBCursor:
        if self.driver == 'postgres':
            cur = self._conn.cursor()
            cur.execute(_translate_qmark_to_pyformat(query), list(params or []))
            return DBCursor(result=cur)
        result = self._conn.execute(query, params or [])
        return DBCursor(result=result)

    def executemany(self, query: str, rows: list[tuple[Any, ...]]) -> None:
        if not rows:
            return
        if self.driver == 'postgres':
            with self._conn.cursor() as cur:
                cur.executemany(_translate_qmark_to_pyformat(query), rows)
            return
        self._conn.executemany(query, rows)

    def executescript(self, script: str) -> None:
        if self.driver == 'postgres':
            with self._conn.cursor() as cur:
                for statement in _split_sql_script(script):
                    cur.execute(statement)
            return
        self._conn.execute(script)

    def commit(self) -> None:
        self._conn.commit()

    def rollback(self) -> None:
        self._conn.rollback()

    def close(self) -> None:
        self._conn.close()

    def __enter__(self):
        if self.driver != 'postgres':
            _duckdb_request_lock.acquire()
        return self

    def __exit__(self, exc_type, exc, tb):
        try:
            if exc_type is None:
                self.commit()
            else:
                try:
                    self.rollback()
                except Exception:
                    pass
        finally:
            try:
                self.close()
            finally:
                if self.driver != 'postgres':
                    _duckdb_request_lock.release()


def db_connect() -> DBConnection:
    return DBConnection(path=DB_PATH, dsn=DB_DSN)


def get_columns(conn: DBConnection, table: str) -> set[str]:
    rows = conn.execute(
        """
        SELECT column_name AS name
        FROM information_schema.columns
        WHERE table_schema = current_schema() AND table_name = ?
        """,
        (table,),
    ).fetchall()
    return {row["name"] for row in rows}


def ensure_column(conn: DBConnection, table: str, name: str, definition: str) -> None:
    if name not in get_columns(conn, table):
        try:
            conn.execute(f"ALTER TABLE {table} ADD COLUMN {name} {definition}")
        except Exception as error:
            message = str(error)
            if "Adding columns with constraints not yet supported" not in message:
                raise
            relaxed = definition.replace(" NOT NULL", "")
            conn.execute(f"ALTER TABLE {table} ADD COLUMN {name} {relaxed}")
            if "DEFAULT 1" in definition:
                conn.execute(f"UPDATE {table} SET {name} = 1 WHERE {name} IS NULL")
            if "DEFAULT 0" in definition:
                conn.execute(f"UPDATE {table} SET {name} = 0 WHERE {name} IS NULL")


def _legacy_sqlite_sequence_start(table: str) -> int:
    if not LEGACY_SQLITE_PATH.exists():
        return 1
    src = sqlite3.connect(LEGACY_SQLITE_PATH)
    try:
        row = src.execute(
            "SELECT name FROM sqlite_master WHERE type='table' AND name = ?",
            (table,),
        ).fetchone()
        if not row:
            return 1
        max_id = src.execute(f"SELECT COALESCE(MAX(id), 0) FROM {table}").fetchone()[0] or 0
        return int(max_id) + 1
    finally:
        src.close()


def migrate_legacy_sqlite_if_needed(conn: DBConnection) -> None:
    if conn.execute("SELECT COUNT(*) AS c FROM users").fetchone()["c"]:
        return
    if not LEGACY_SQLITE_PATH.exists():
        return

    src = sqlite3.connect(LEGACY_SQLITE_PATH)
    src.row_factory = sqlite3.Row
    try:
        for table, columns in APP_TABLE_COLUMNS.items():
            exists = src.execute(
                "SELECT name FROM sqlite_master WHERE type='table' AND name = ?",
                (table,),
            ).fetchone()
            if not exists:
                continue
            legacy_columns = {
                row[1]
                for row in src.execute(f"PRAGMA table_info({table})").fetchall()
            }
            selected_columns = [column for column in columns if column in legacy_columns]
            if not selected_columns:
                continue
            rows = src.execute(f"SELECT {', '.join(selected_columns)} FROM {table}").fetchall()
            if not rows:
                continue
            placeholders = ', '.join(['?'] * len(columns))
            insert_sql = f"INSERT INTO {table} ({', '.join(columns)}) VALUES ({placeholders})"
            prepared_rows = []
            for row in rows:
                payload: list[Any] = []
                for column in columns:
                    if column in selected_columns:
                        payload.append(row[column])
                    elif column == "version":
                        payload.append(1)
                    elif column == "assistant_profile_json":
                        payload.append(json.dumps(default_assistant_profile(""), ensure_ascii=False))
                    elif column == "display_name":
                        payload.append("")
                    elif column == "self_subscribe_enabled":
                        payload.append(0)
                    elif column == "self_subscribe_scope":
                        payload.append("disabled")
                    elif column == "onboarding_completed":
                        payload.append(0)
                    else:
                        payload.append(None)
                prepared_rows.append(tuple(payload))
            conn.executemany(insert_sql, prepared_rows)
    finally:
        src.close()


def _sync_postgres_sequences(conn: DBConnection) -> None:
    if getattr(conn, 'driver', 'duckdb') != 'postgres':
        return
    for table in [
