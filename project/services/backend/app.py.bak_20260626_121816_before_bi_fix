def materialize_telegram_task_config(contract: dict[str, Any]) -> dict[str, Any]:
    base_dir = collection_task_artifacts_root('telegram')
    base_dir.mkdir(parents=True, exist_ok=True)
    slug = build_collection_task_slug(contract)
    stamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    config_name = f'task_{slug}_{stamp}'
    config_path = base_dir / f'channels_{config_name}.yml'
    profile_name = safe_text(os.getenv('TG_API_DEFAULT_PROFILE') or 'profile_1')
    date_from = safe_text(contract.get('since_date') or date.today().isoformat())
    subject = safe_text(contract.get('subject') or '').replace('"', '\\"')
    limit_per_channel = max(10, int(os.getenv('HERMES_WEB_TELEGRAM_LIMIT_PER_CHANNEL', '150')))
    global_limit = max(limit_per_channel, int(os.getenv('HERMES_WEB_TELEGRAM_GLOBAL_LIMIT', '1000')))
    channel_lines = '\n'.join(
        f"      - username: {item}\n        task_subject: \"{subject}\""
        for item in (contract.get('source_items') or [])
    )
    yaml_text = (
        f"profiles:\n"
        f"  {profile_name}:\n"
        f"    session_name: {profile_name}\n"
        f"    mode: task\n"
        f"    date_from: \"{date_from}\"\n"
        f"    date_to: ''\n"
        f"    limit_per_channel: {limit_per_channel}\n"
        f"    global_limit: {global_limit}\n"
        f"    channels:\n{channel_lines}\n"
    )
    config_path.write_text(yaml_text, encoding='utf-8')
    return {
        'config_name': config_name,
        'config_path': str(config_path),
        'profile_name': profile_name,
        'channels': contract.get('source_items') or [],
    }


def telegram_api_base_url() -> str:
    return safe_text(os.getenv('TELEGRAM_API_BASE_URL') or os.getenv('TG_API_REMOTE_BASE_URL') or 'http://127.0.0.1:8001').rstrip('/')


def normalize_telegram_collection_rows(contract: dict[str, Any], messages: list[dict[str, Any]]) -> list[dict[str, Any]]:
    requested_fields = [safe_text(item) for item in (contract.get('fields') or []) if safe_text(item)]
    if not requested_fields:
        requested_fields = ['дата', 'канал', 'ссылка', 'summary']

    def clean_field_name(value: str) -> str:
        field = safe_text(value)
        field = re.sub(r'\s+с\s+\d{1,2}\.\d{1,2}\.\d{2,4}\s*$', '', field, flags=re.IGNORECASE)
        return field.strip(' .,:;')

    cleaned_fields: list[str] = []
    seen_fields: set[str] = set()
    for item in requested_fields:
        cleaned = clean_field_name(item)
        if not cleaned:
            continue
        key = cleaned.lower()
        if key in seen_fields:
            continue
        seen_fields.add(key)
        cleaned_fields.append(cleaned)
    if not cleaned_fields:
        cleaned_fields = ['дата', 'канал', 'ссылка', 'summary']

    rows: list[dict[str, Any]] = []
    for message in messages:
        text_value = safe_text(message.get('message'))
        summary_value = text_value.replace('\r', ' ').replace('\n', ' ').strip()
        row: dict[str, Any] = {'source_url': safe_text(message.get('original_url'))}
        for field in cleaned_fields:
            normalized = normalize_source_token(field)
            if normalized in {'дата', 'date'}:
                row[field] = safe_text(message.get('date'))
            elif normalized in {'канал', 'channel', 'chat', 'источник', 'source'}:
                row[field] = safe_text(message.get('chat'))
            elif normalized in {'ссылка', 'url', 'link', 'source_url'}:
                row[field] = safe_text(message.get('original_url'))
            elif normalized in {'summary', 'summary_text', 'текст', 'message', 'описание'}:
                row[field] = summary_value
            elif normalized in {'id', 'message_id'}:
                row[field] = safe_text(message.get('id'))
            elif normalized in {'views', 'просмотры'}:
                row[field] = safe_text(message.get('views'))
            elif normalized in {'forwards', 'репосты'}:
                row[field] = safe_text(message.get('forwards'))
            else:
                row[field] = safe_text(message.get(field))
        rows.append(row)
    contract['fields'] = cleaned_fields
    return rows


def execute_telegram_collection_contract(contract: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    config = materialize_telegram_task_config(contract)
    query = urllib.parse.urlencode({'profile': config['profile_name'], 'config': config['config_name']})
    target_url = f"{telegram_api_base_url()}/export?{query}"
    lock_wait_started = time.monotonic()
    acquired = _telegram_collection_lock.acquire(timeout=TELEGRAM_COLLECTION_LOCK_TIMEOUT)
    if not acquired:
        raise ApiError('telegram_collection_busy_timeout', 409)
    try:
        lock_wait_seconds = max(0.0, time.monotonic() - lock_wait_started)
        try:
            with urllib.request.urlopen(target_url, timeout=TELEGRAM_COLLECTION_API_TIMEOUT) as response:
                status_code = int(getattr(response, 'status', 200) or 200)
                body = response.read().decode('utf-8')
        except urllib.error.HTTPError as exc:
            raise ApiError(f'telegram_collection_api_failed:{exc.code}', 502) from exc
        except urllib.error.URLError as exc:
            raise ApiError('telegram_collection_api_unreachable', 502) from exc
    finally:
        _telegram_collection_lock.release()
    if status_code != 200:
        raise ApiError(f'telegram_collection_api_failed:{status_code}', 502)
    payload = json.loads(body or '{}')
    count = int(payload.get('count') or 0)
