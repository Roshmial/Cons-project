        if values:
            avg = sum(values) / len(values)
            peak = max(values)
            summary_cards.append(build_explanatory_summary_card('Средний риск-уровень', format_metric_value(avg), f'Даёт ориентир по общему рисковому фону; максимальное значение — {format_metric_value(peak)}'))
