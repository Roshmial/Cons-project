def infer_ratio_components(numeric_columns: list[str], numerator_markers: tuple[str, ...], denominator_markers: tuple[str, ...]) -> tuple[str | None, str | None]:
    numerator_col = find_first_matching_numeric_column(numeric_columns, numerator_markers)
    denominator_col = find_first_matching_numeric_column(numeric_columns, denominator_markers)
    if numerator_col and denominator_col and numerator_col != denominator_col:
        return numerator_col, denominator_col
    return None, None


def compute_safe_ratio(numerator_values: list[float], denominator_values: list[float]) -> float | None:
    if not numerator_values or not denominator_values:
        return None
    numerator_total = sum(numerator_values)
    denominator_total = sum(denominator_values)
    if abs(denominator_total) < 1e-9:
        return None
    return numerator_total / denominator_total


def infer_ageing_bucket_columns(columns: list[str]) -> list[str]:
    matched: list[str] = []
    for column in columns:
        lowered = safe_text(column).lower()
        if any(marker in lowered for marker in ('0-30', '31-60', '61-90', '90+', 'aging', 'ageing', 'bucket', 'overdue', 'days')):
            matched.append(column)
    return matched


def build_ageing_section(rows: list[dict[str, Any]], columns: list[str], *, title: str, note: str) -> dict[str, Any] | None:
    ageing_columns = infer_ageing_bucket_columns(columns)
    if not ageing_columns:
        return None
    items: list[dict[str, Any]] = []
    for column in ageing_columns[:8]:
        values = collect_numeric_values(rows, column)
        if not values:
            continue
        items.append({'label': humanize_metric_label(column), 'value': round(sum(values), 2), 'meta': 'Суммарный объём в возрастной корзине'})
    if not items:
        return None
    return {'kind': 'bar_list', 'title': title, 'note': note, 'items': items}


def build_rate_card_from_ratio(numerator_values: list[float], denominator_values: list[float], *, label: str, note: str) -> dict[str, Any] | None:
    ratio = compute_safe_ratio(numerator_values, denominator_values)
    if ratio is None:
        return None
    normalized = ratio * 100 if ratio <= 1.0 else ratio
    return build_explanatory_summary_card(label, format_metric_value(normalized, as_percent=True), note)


def append_plan_actual_section(sections: list[dict[str, Any]], rows: list[dict[str, Any]], plan_col: str | None, actual_col: str | None, *, title: str, note: str, topn: int = 8) -> bool:
    if not plan_col or not actual_col:
        return False
    items: list[dict[str, Any]] = []
    for index, row in enumerate(rows[:topn], start=1):
        if not isinstance(row, dict):
            continue
        plan = parse_numeric_like(row.get(plan_col))
        actual = parse_numeric_like(row.get(actual_col))
        if plan is None or actual is None:
            continue
        delta = actual - plan
        label = safe_text(row.get('category') or row.get('team') or row.get('period') or row.get('vendor') or row.get('feature') or f'Строка {index}')
        items.append({'label': label, 'value': round(delta, 2), 'meta': f'plan={round(plan, 2)}; actual={round(actual, 2)}'})
    if not items:
        return False
    sections.append({'kind': 'matrix_list', 'title': title, 'note': note, 'rows': items})
    return True


def infer_grouping_dimension(columns: list[str], preferred_markers: tuple[str, ...] = ('category', 'team', 'vendor', 'feature', 'manager', 'channel', 'priority', 'stage', 'period')) -> str | None:
    return find_first_matching_column(columns, preferred_markers)


def append_grouped_plan_actual_section(sections: list[dict[str, Any]], rows: list[dict[str, Any]], group_col: str | None, plan_col: str | None, actual_col: str | None, *, title: str, note: str, topn: int = 8) -> bool:
    if not group_col or not plan_col or not actual_col:
        return False
    grouped: dict[str, dict[str, float]] = defaultdict(lambda: {'plan': 0.0, 'actual': 0.0})
    for row in rows:
        if not isinstance(row, dict):
            continue
        group = safe_text(row.get(group_col))
        plan = parse_numeric_like(row.get(plan_col))
        actual = parse_numeric_like(row.get(actual_col))
        if not group or plan is None or actual is None:
            continue
        grouped[group]['plan'] += plan
        grouped[group]['actual'] += actual
    if not grouped:
        return False
    ranked = sorted(grouped.items(), key=lambda item: abs(item[1]['actual'] - item[1]['plan']), reverse=True)[:topn]
    rows_payload: list[dict[str, Any]] = []
    for group, payload in ranked:
        delta = payload['actual'] - payload['plan']
        rows_payload.append({'label': group, 'value': round(delta, 2), 'meta': f"plan={round(payload['plan'], 2)}; actual={round(payload['actual'], 2)}"})
    sections.append({'kind': 'matrix_list', 'title': title, 'note': note, 'rows': rows_payload})
    return True


def append_grouped_concentration_section(sections: list[dict[str, Any]], rows: list[dict[str, Any]], primary_group_col: str | None, category_col: str | None, numeric_col: str | None, *, title: str, note: str, topn_groups: int = 6) -> bool:
    if not primary_group_col or not category_col or primary_group_col == category_col:
        return False
    grouped: dict[str, dict[str, float]] = defaultdict(lambda: defaultdict(float))
    for row in rows:
        if not isinstance(row, dict):
            continue
        primary = safe_text(row.get(primary_group_col))
        category = safe_text(row.get(category_col))
        if not primary or not category:
            continue
        value = parse_numeric_like(row.get(numeric_col)) if numeric_col else 1.0
        if value is None:
            continue
        grouped[primary][category] += value
    items: list[dict[str, Any]] = []
    for primary, categories in grouped.items():
        total = sum(categories.values())
        if total <= 0:
            continue
        top_category, top_value = max(categories.items(), key=lambda item: item[1])
        share = (top_value / total) * 100
        items.append({'label': primary, 'value': round(share, 2), 'meta': f'{top_category} dominates with {round(share, 1)}%'})
    if not items:
        return False
    items = sorted(items, key=lambda item: float(item.get('value') or 0), reverse=True)[:topn_groups]
    sections.append({'kind': 'bar_list', 'title': title, 'note': note, 'items': items})
    return True


def infer_structured_source_shape(source_meta: dict[str, Any]) -> str:
    file_type = safe_text(source_meta.get('file_type')).lower()
    label = safe_text(source_meta.get('label') or source_meta.get('original_name')).lower()
    route = safe_text(source_meta.get('route') or source_meta.get('item_key')).lower()
    if file_type in ('csv', 'xlsx', 'xls', 'tsv') or any(label.endswith(ext) for ext in ('.csv', '.xlsx', '.xls', '.tsv')):
        return 'file_export'
    if any(marker in ' '.join([label, route]) for marker in ('web', 'research', 'scrape', 'search', 'internet')):
        return 'web_structured'
    return 'structured_source'


def infer_dataset_source_shape(source_meta: dict[str, Any]) -> str:
    return infer_structured_source_shape(source_meta)


def build_source_shape_card(source_meta: dict[str, Any]) -> dict[str, Any]:
    source_shape = infer_structured_source_shape(source_meta)
    mapping = {
        'file_export': ('Форма источника', 'File export', 'Показатели собраны из табличной выгрузки; качество выводов зависит от полноты полей и чистоты колонок'),
        'web_structured': ('Форма источника', 'Web structured', 'Показатели собраны из структурированного web-источника; часть бизнес-метрик может быть proxy, а не прямым KPI'),
        'structured_source': ('Форма источника', 'Structured source', 'Показатели собраны из структурированного источника; интерпретация зависит от явности полей и единиц измерения'),
    }
    label, value, note = mapping.get(source_shape, mapping['structured_source'])
