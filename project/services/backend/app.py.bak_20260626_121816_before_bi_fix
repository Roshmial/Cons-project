def build_reference_payload(conn: sqlite3.Connection, include_inactive: bool = False) -> dict[str, Any]:
    catalogs = conn.execute(
        """
        SELECT dataset_key, label, description, is_system
        FROM reference_catalogs
        WHERE scope = ?
        ORDER BY id ASC
        """,
        (REFERENCE_SCOPE_GLOBAL,),
    ).fetchall()
    payload: dict[str, Any] = {}
    for catalog in catalogs:
        items = [serialize_reference_item(row) for row in reference_items_for_dataset(conn, catalog["dataset_key"], include_inactive=include_inactive)]
        if catalog["dataset_key"] == REFERENCE_DATASET_DATA_SOURCES:
            items = apply_connector_group_overrides_to_data_sources(items)
        payload[catalog["dataset_key"]] = {
            "dataset_key": catalog["dataset_key"],
            "label": catalog["label"],
            "description": catalog["description"],
            "is_system": bool(catalog["is_system"]),
            "items": items,
        }
    return payload


def build_runtime_reference_views(conn: sqlite3.Connection) -> dict[str, Any]:
    references = build_reference_payload(conn, include_inactive=True)

    def active_items(dataset_key: str) -> list[dict[str, Any]]:
        items = references.get(dataset_key, {}).get("items", [])
        return [item for item in items if bool(item.get("is_active", True)) and not item.get("deleted_at")]

    starter_prompts = [item["label"] for item in active_items(REFERENCE_DATASET_STARTER_PROMPTS)]
    feedback_reasons = [item["label"] for item in active_items(REFERENCE_DATASET_FEEDBACK_REASONS)]
    help_articles = [
        {"title": item["label"], "points": item.get("points", []) if isinstance(item.get("points"), list) else []}
        for item in active_items(REFERENCE_DATASET_HELP_ARTICLES)
    ]
    job_templates = {
        item["item_key"]: {
            "label": item["label"],
            "description": safe_text(item.get("description") or ""),
            "fields": item.get("fields", []) if isinstance(item.get("fields"), list) else [],
        }
        for item in active_items(REFERENCE_DATASET_JOB_TEMPLATES)
    }
    return {
        "references": references,
        "starter_prompts": starter_prompts,
        "feedback_reasons": feedback_reasons,
        "help_articles": help_articles,
        "job_templates": job_templates,
    }


def get_runtime_reference_views_revision(conn: sqlite3.Connection) -> tuple[str, int, str, int]:
    row = conn.execute(
        """
        SELECT
            COALESCE((SELECT MAX(updated_at) FROM reference_items WHERE scope = ?), '') AS items_updated_at,
            (SELECT COUNT(*) FROM reference_items WHERE scope = ?) AS items_count,
            COALESCE((SELECT MAX(updated_at) FROM reference_catalogs WHERE scope = ?), '') AS catalogs_updated_at,
            (SELECT COUNT(*) FROM reference_catalogs WHERE scope = ?) AS catalogs_count
        """,
        (REFERENCE_SCOPE_GLOBAL, REFERENCE_SCOPE_GLOBAL, REFERENCE_SCOPE_GLOBAL, REFERENCE_SCOPE_GLOBAL),
    ).fetchone()
    return (
        safe_text(row["items_updated_at"]),
        int(row["items_count"] or 0),
        safe_text(row["catalogs_updated_at"]),
        int(row["catalogs_count"] or 0),
    )


def get_cached_runtime_reference_views(conn: sqlite3.Connection) -> dict[str, Any]:
    revision = get_runtime_reference_views_revision(conn)
    with _runtime_reference_views_cache_lock:
        if _runtime_reference_views_cache.get("revision") == revision and _runtime_reference_views_cache.get("value") is not None:
            return _runtime_reference_views_cache["value"]
    runtime_refs = build_runtime_reference_views(conn)
    with _runtime_reference_views_cache_lock:
        _runtime_reference_views_cache["revision"] = revision
        _runtime_reference_views_cache["value"] = runtime_refs
    return runtime_refs


def list_cached_hermes_jobs(force_refresh: bool = False) -> list[dict[str, Any]]:
    now_ts = time.monotonic()
    with _hermes_jobs_cache_lock:
        cached_jobs = _hermes_jobs_cache.get("jobs")
        expires_at = float(_hermes_jobs_cache.get("expires_at") or 0.0)
        if not force_refresh and cached_jobs is not None and expires_at > now_ts:
            return cached_jobs
    jobs = hermes_list_jobs()
    with _hermes_jobs_cache_lock:
        _hermes_jobs_cache["jobs"] = jobs
        _hermes_jobs_cache["expires_at"] = now_ts + HERMES_JOBS_CACHE_TTL_SECONDS
    return jobs


