    return set(reference_label_map(conn, dataset_key).keys())


def normalize_assistant_profile(profile: dict[str, Any], style: str, option_sets: dict[str, set[str]] | None = None) -> dict[str, str]:
    fallback = default_assistant_profile(style)
    normalized = {
        "tone": safe_text(profile.get("tone") or fallback["tone"]),
        "answer_depth": safe_text(profile.get("answer_depth") or fallback["answer_depth"]),
        "interaction_mode": safe_text(profile.get("interaction_mode") or fallback["interaction_mode"]),
        "about_user": safe_text(profile.get("about_user") or fallback["about_user"]),
    }
    if option_sets:
        for field, allowed in option_sets.items():
            if allowed and normalized[field] not in allowed:
                normalized[field] = fallback[field] if fallback[field] in allowed else sorted(allowed)[0]
    return normalized


def validate_assistant_profile(conn: sqlite3.Connection, profile: dict[str, Any], style: str) -> dict[str, str]:
    option_sets = {
        field: active_reference_keys(conn, dataset_key)
        for field, dataset_key in assistant_profile_dataset_map().items()
    }
    normalized = normalize_assistant_profile(profile, style, option_sets)
    for field, allowed in option_sets.items():
        requested = safe_text(profile.get(field) or "")
        if requested and allowed and requested not in allowed:
            raise ApiError(f"assistant_profile_invalid_{field}", 400)
    return normalized


def assistant_profile_from_row(row: sqlite3.Row, conn: sqlite3.Connection | None = None) -> dict[str, str]:
    profile = json_loads(row["assistant_profile_json"], default_assistant_profile(row["style"]))
    option_sets = None
    if conn is not None:
        option_sets = {
            field: active_reference_keys(conn, dataset_key)
            for field, dataset_key in assistant_profile_dataset_map().items()
        }
    return normalize_assistant_profile(profile, row["style"], option_sets)


