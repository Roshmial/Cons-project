    }


def recover_interrupted_chat_tasks() -> int:
    recovered = 0
    with db_connect() as conn:
        rows = conn.execute(
            "SELECT id, assistant_message_id FROM chat_tasks WHERE status = 'running' AND finished_at IS NULL"
        ).fetchall()
        for row in rows:
            conn.execute(
                "UPDATE chat_tasks SET status = 'pending', started_at = NULL, last_error = '' WHERE id = ?",
                (row["id"],),
            )
            pending_meta = build_pending_assistant_meta(int(row["id"]), status_label="Восстановлено после перезапуска")
            conn.execute(
                "UPDATE messages SET content = ?, meta_json = ? WHERE id = ?",
                ("Готовлю ответ…", json.dumps(pending_meta, ensure_ascii=False), row["assistant_message_id"]),
            )
            recovered += 1
    return recovered


def enqueue_chat_task(
    conn: sqlite3.Connection,
    *,
    thread_id: int,
    user_id: int,
    user_message_id: int,
    assistant_message_id: int,
    request_policy: dict[str, Any] | None = None,
) -> sqlite3.Row:
    created_at = now_iso()
    task_row = conn.execute(
        """
        INSERT INTO chat_tasks (
            thread_id, user_id, user_message_id, assistant_message_id, status, request_policy_json, created_at, started_at, finished_at, last_error
        ) VALUES (?, ?, ?, ?, 'pending', ?, ?, NULL, NULL, '')
        RETURNING *
        """,
        (thread_id, user_id, user_message_id, assistant_message_id, json.dumps(request_policy or {}, ensure_ascii=False), created_at),
    ).fetchone()
    pending_meta = build_pending_assistant_meta(int(task_row["id"]))
    conn.execute(
        "UPDATE messages SET content = ?, meta_json = ? WHERE id = ?",
        ("Готовлю ответ…", json.dumps(pending_meta, ensure_ascii=False), assistant_message_id),
    )
    return task_row


def claim_pending_chat_tasks(max_tasks: int | None = None) -> list[sqlite3.Row]:
    limit = max(1, int(max_tasks or CHAT_PROCESSOR_MAX_CONCURRENCY))
    claimed: list[sqlite3.Row] = []
    with db_connect() as conn:
        rows = conn.execute(
            "SELECT * FROM chat_tasks WHERE status = 'pending' ORDER BY created_at ASC, id ASC LIMIT ?",
            (limit,),
        ).fetchall()
        for row in rows:
            updated = conn.execute(
                "UPDATE chat_tasks SET status = 'running', started_at = ?, last_error = '' WHERE id = ? AND status = 'pending' RETURNING *",
                (now_iso(), row["id"]),
            ).fetchone()
            if updated:
                claimed.append(updated)
    return claimed


def finalize_chat_task_error(task_id: int, assistant_message_id: int, error_text: str) -> None:
    finished_at = now_iso()
    public_error_text = normalize_public_error_text(error_text)
    public_message = "Не удалось получить ответ. Проверьте отправку сообщения и повторите попытку."
    if public_error_text.startswith("Не удалось сформировать файл"):
        public_message = public_error_text
    with db_connect() as conn:
        conn.execute(
            "UPDATE chat_tasks SET status = 'error', finished_at = ?, last_error = ? WHERE id = ?",
            (finished_at, error_text, task_id),
        )
        meta = {
            "pending": False,
            "error": True,
            "processing_status": "error",
            "message_kind": "processing_status",
            "task_id": task_id,
            "status_label": "Ошибка обработки",
            "error_text": public_error_text,
            "internal_error_stored": True,
        }
        conn.execute(
            "UPDATE messages SET content = ?, created_at = ?, meta_json = ? WHERE id = ?",
            (public_message, finished_at, json.dumps(meta, ensure_ascii=False), assistant_message_id),
        )


def response_looks_like_file_limitation(reply_text: str) -> bool:
    lowered = safe_text(reply_text).lower()
    if not lowered:
        return False
    return any(marker in lowered for marker in MESSAGE_EXPORT_LIMITATION_REPLY_MARKERS)


def response_looks_like_tool_transcript(reply_text: str) -> bool:
    lowered = safe_text(reply_text).lower()
    if not lowered:
        return False
    return any(marker in lowered for marker in FILE_GENERATION_TRANSCRIPT_MARKERS)


def preferred_model_for_generated_file(request_policy: dict[str, Any] | None = None) -> str:
    preference = normalize_chat_model_preference((request_policy or {}).get("model_preference"))
    if preference == CHAT_MODEL_DEEPSEEK_R1:
        return HERMES_REASONING_MODEL
    return HERMES_API_MODEL


def is_substantive_generated_file_context_row(row: sqlite3.Row) -> bool:
    role = safe_text(row["role"]).lower()
    content = safe_text(row["content"]).strip()
    if not content:
        return False
    if role == "assistant":
        if not is_exportable_assistant_message(row):
            return False
        if len(content) < 1200:
            return False
        if response_looks_like_file_limitation(content) or response_looks_like_tool_transcript(content):
            return False
        return True
    if role == "user":
        if len(content) < 20:
            return False
        if detect_message_export_format(content) and text_matches_any(content, MESSAGE_EXPORT_REQUEST_MARKERS):
            return False
        return True
    return False


def select_generated_file_context_rows(message_rows: list[sqlite3.Row]) -> list[sqlite3.Row]:
    selected_indexes: set[int] = set()
    substantive_assistant_count = 0
    for idx in range(len(message_rows) - 1, -1, -1):
        row = message_rows[idx]
        if safe_text(row["role"]).lower() != "assistant":
            continue
        if not is_substantive_generated_file_context_row(row):
            continue
        selected_indexes.add(idx)
        substantive_assistant_count += 1
        for prev_idx in range(idx - 1, -1, -1):
            prev_row = message_rows[prev_idx]
            if safe_text(prev_row["role"]).lower() != "user":
                continue
            if is_substantive_generated_file_context_row(prev_row):
                selected_indexes.add(prev_idx)
                break
        if substantive_assistant_count >= 3:
            break
    if not selected_indexes:
        fallback_rows = [row for row in message_rows if safe_text(row["role"]).lower() in {"user", "assistant", "system"}]
        return fallback_rows[-8:]
    return [message_rows[idx] for idx in sorted(selected_indexes)]


def build_generated_file_messages(message_rows: list[sqlite3.Row], profile: dict[str, Any], thread_title: str, user_text: str, request_policy: dict[str, Any] | None = None) -> list[dict[str, str]]:
