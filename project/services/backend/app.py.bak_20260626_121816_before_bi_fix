def is_short_followup_confirmation(text: str) -> bool:
    lowered = safe_text(text).strip().lower()
    if not lowered:
        return False
    if len(lowered) > 40:
        return False
    normalized = re.sub(r"\s+", " ", lowered)
    if normalized in SHORT_FOLLOWUP_CONFIRMATION_PATTERNS:
        return True
    return normalized.startswith("да, ") and any(token in normalized for token in ("сделай", "давай", "запускай"))


def is_short_problem_followup(text: str) -> bool:
    lowered = safe_text(text).strip().lower()
    if not lowered:
        return False
    if len(lowered) > 80:
        return False
    normalized = re.sub(r"\s+", " ", lowered)
    return any(marker in normalized for marker in SHORT_PROBLEM_FOLLOWUP_PATTERNS)


def infer_dashboard_followup_request_text(message_rows: list[sqlite3.Row], current_user_message_id: int, current_user_text: str) -> str:
    normalized_current = re.sub(r"\s+", " ", safe_text(current_user_text).strip().lower())
    rerun_markers = (
        "снова", "ещё раз", "еще раз", "повтори", "перестрой", "заново", "теперь с информац",
        "по этой теме", "по этому", "по этому ответу", "на основе этого", "из этого", "из собранного",
    )
    is_dashboard_problem_followup = is_short_problem_followup(current_user_text) or (
        bool(normalized_current)
        and len(normalized_current) <= 120
        and "дашборд" in normalized_current
        and any(marker in normalized_current for marker in ("где", "не ", "нет", "пуст", "без дан", "не то"))
    )
    is_dashboard_rerun_followup = (
        bool(normalized_current)
        and len(normalized_current) <= 160
        and "дашборд" in normalized_current
        and any(marker in normalized_current for marker in rerun_markers)
    )
    if not is_dashboard_problem_followup and not is_dashboard_rerun_followup:
        return current_user_text
    previous_rows = [row for row in message_rows if int(row["id"]) < int(current_user_message_id)]
    previous_assistant = latest_substantive_assistant_row(previous_rows)
    if previous_assistant is None:
        return current_user_text
    previous_meta = json_loads(previous_assistant["meta_json"], {}) if "meta_json" in previous_assistant.keys() else {}
    if safe_text(previous_meta.get("message_kind")) != "dashboard_result":
        return current_user_text
    for row in reversed(previous_rows):
        if row["role"] != "user":
            continue
        row_meta = json_loads(row["meta_json"], {}) if "meta_json" in row.keys() else {}
        candidate_text = safe_text(row_meta.get("user_text") or row["content"]).strip()
        if not candidate_text:
            continue
        if is_short_problem_followup(candidate_text) or is_short_followup_confirmation(candidate_text):
            continue
        return candidate_text
    return current_user_text


def infer_collection_followup_request_text(message_rows: list[sqlite3.Row], current_user_message_id: int, current_user_text: str) -> str:
    normalized_current = re.sub(r"\s+", " ", safe_text(current_user_text).strip().lower())
    if not normalized_current or len(normalized_current) > 120:
        return current_user_text
    previous_rows = [row for row in message_rows if int(row["id"]) < int(current_user_message_id)]
    previous_assistant = latest_substantive_assistant_row(previous_rows)
    if previous_assistant is None:
        return current_user_text
    previous_meta = json_loads(previous_assistant["meta_json"], {}) if "meta_json" in previous_assistant.keys() else {}
    if safe_text(previous_meta.get("message_kind")) != "clarification_request":
        return current_user_text
    if safe_text(previous_meta.get("downstream")) != "chat:data_collection_clarification":
        return current_user_text
    current_contract = build_collection_contract_meta(current_user_text, None)
    current_source_kind = safe_text(current_contract.get("source_kind"))
    current_output_format = safe_text(current_contract.get("output_format"))
    current_fields = current_contract.get("fields") or []
    current_missing = [safe_text(item) for item in (current_contract.get("missing_fields") or []) if safe_text(item)]
    source_completion_followup = any(marker in normalized_current for marker in COLLECTION_SOURCE_COMPLETION_FOLLOWUP_PATTERNS)
    if (not current_source_kind or current_output_format or current_fields) and not source_completion_followup:
        return current_user_text
    if not source_completion_followup and "что именно собирать" not in current_missing and "формат результата" not in current_missing:
        return current_user_text
    for row in reversed(previous_rows):
        if row["role"] != "user":
            continue
        row_meta = json_loads(row["meta_json"], {}) if "meta_json" in row.keys() else {}
        candidate_text = safe_text(row_meta.get("user_text") or row["content"]).strip()
        if not candidate_text:
            continue
        candidate_normalized = re.sub(r"\s+", " ", candidate_text.lower())
        if candidate_normalized == normalized_current:
            continue
        if is_short_problem_followup(candidate_text) or is_short_followup_confirmation(candidate_text):
            continue
        return f"{candidate_text}. {current_user_text}".strip()
    return current_user_text


def infer_clarification_followup_request_text(message_rows: list[sqlite3.Row], current_user_message_id: int, current_user_text: str) -> str:
    normalized_current = re.sub(r"\s+", " ", safe_text(current_user_text).strip().lower())
    if not normalized_current or len(normalized_current) > 200:
        return current_user_text
    previous_rows = [row for row in message_rows if int(row["id"]) < int(current_user_message_id)]
    previous_assistant = latest_substantive_assistant_row(previous_rows)
    if previous_assistant is None:
        return current_user_text
    previous_meta = json_loads(previous_assistant["meta_json"], {}) if "meta_json" in previous_assistant.keys() else {}
    if safe_text(previous_meta.get("message_kind")) != "clarification_request":
        return current_user_text
    if detect_message_export_format(current_user_text):
        return current_user_text
    if not (is_short_followup_confirmation(current_user_text) or len(normalized_current) <= 80):
        return current_user_text
    for row in reversed(previous_rows):
        if row["role"] != "user":
            continue
        row_meta = json_loads(row["meta_json"], {}) if "meta_json" in row.keys() else {}
        candidate_text = safe_text(row_meta.get("user_text") or row["content"]).strip()
        if not candidate_text:
            continue
        candidate_normalized = re.sub(r"\s+", " ", candidate_text.lower())
        if candidate_normalized == normalized_current:
            continue
        if is_short_problem_followup(candidate_text) or is_short_followup_confirmation(candidate_text):
            continue
        if detect_message_export_format(candidate_text) and is_generate_and_attach_file_request(candidate_text):
            return f"{candidate_text}. {current_user_text}".strip()
    return current_user_text


def generated_file_followup_needs_context_restore(current_user_text: str) -> bool:
    normalized_current = re.sub(r"\s+", " ", safe_text(current_user_text).strip().lower())
    if not normalized_current or len(normalized_current) > 220:
        return False
    if any(marker in normalized_current for marker in GENERATED_FILE_STRUCTURE_FOLLOWUP_MARKERS):
        return True
    if len(normalized_current) <= 80 and any(marker in normalized_current for marker in GENERATED_FILE_FORMAT_ONLY_FOLLOWUP_MARKERS):
        return True
    if detect_message_export_format(normalized_current) and len(normalized_current) <= 60:
        return True
    return False


def infer_generated_file_followup_request_text(message_rows: list[sqlite3.Row], current_user_message_id: int, current_user_text: str) -> str:
    if not generated_file_followup_needs_context_restore(current_user_text):
        return current_user_text
    if detect_message_export_format(current_user_text) and not is_generate_and_attach_file_request(current_user_text):
        previous_rows = [row for row in message_rows if int(row["id"]) < int(current_user_message_id)]
        if select_export_target_message(previous_rows) is not None:
            return current_user_text
    previous_rows = [row for row in message_rows if int(row["id"]) < int(current_user_message_id)]
    for row in reversed(previous_rows):
        if row["role"] != "user":
            continue
        row_meta = json_loads(row["meta_json"], {}) if "meta_json" in row.keys() else {}
        candidate_text = safe_text(row_meta.get("user_text") or row["content"]).strip()
        if not candidate_text:
            continue
        if safe_text(candidate_text).strip().lower() == safe_text(current_user_text).strip().lower():
            continue
        if generated_file_followup_needs_context_restore(candidate_text):
            continue
        if is_short_problem_followup(candidate_text) or is_short_followup_confirmation(candidate_text):
            continue
        return f"{candidate_text}. {current_user_text}".strip()
    return current_user_text


def should_use_focused_followup_context(message_rows: list[sqlite3.Row], request_policy: dict[str, Any] | None = None) -> bool:
    if request_policy_has_explicit_constraints(request_policy):
        return False
    user_text = latest_user_message_text(message_rows)
    is_confirmation = is_short_followup_confirmation(user_text)
    is_problem = is_short_problem_followup(user_text)
    if not (is_confirmation or is_problem):
        return False
    assistant_text = latest_substantive_assistant_message_text(message_rows[:-1])
    if not assistant_text:
        return False
    if is_problem:
        return len(assistant_text) >= 60
    return len(assistant_text) >= 180


